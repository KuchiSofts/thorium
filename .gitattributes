# Set default behavior to automatically normalize line endings.
* text=auto
*.idl text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Build system Files
*.py text eol=lf
*.gn text
*.gni text
*.mak text eol=lf
*.diff text eol=lf
*.patch text eol=lf

# Keep scripts correct
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.rc text eol=crlf

# The browser source overlay is kept byte for byte: its tree hash is verified (tools/build/source_tree.py).
source/overlay/** -text
