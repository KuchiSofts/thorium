diff --git a/third_party/rust/chromium_crates_io/patches/flatbuffers-v25/0001-Never-enable-nightly-only-features.patch b/third_party/rust/chromium_crates_io/patches/flatbuffers-v25/0001-Never-enable-nightly-only-features.patch
new file mode 100644
index 0000000000000000000000000000000000000000..dec9451f749d64d2c1495b2804a1a498bd8bf870
--- /dev/null
+++ b/third_party/rust/chromium_crates_io/patches/flatbuffers-v25/0001-Never-enable-nightly-only-features.patch
@@ -0,0 +1,23 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: KuchiSofts <32385966+KuchiSofts@users.noreply.github.com>
+Date: Mon, 9 Nov 2026 00:00:00 +0000
+Subject: [PATCH] Never enable nightly-only features
+
+Chromium builds Rust with a nightly toolchain but allows only listed unstable
+features; use the stable code paths.
+
+diff --git a/third_party/rust/chromium_crates_io/vendor/flatbuffers-v25/build.rs b/third_party/rust/chromium_crates_io/vendor/flatbuffers-v25/build.rs
+index ed82da90992..b7a7987b80f 100644
+--- a/third_party/rust/chromium_crates_io/vendor/flatbuffers-v25/build.rs
++++ b/third_party/rust/chromium_crates_io/vendor/flatbuffers-v25/build.rs
+@@ -7,7 +7,7 @@ fn main() {
+     // #[cfg(nightly)]
+     // for nightly only features
+     println!("cargo:rustc-check-cfg=cfg(nightly)");
+-    if version_meta.channel == Channel::Nightly {
+-        println!("cargo:rustc-cfg=nightly")
+-    }
++    // Chromium (Thoron): its toolchain is a nightly build, but only allow-listed unstable features
++    // may be used, so the stable code paths are always taken.
++    let _ = version_meta.channel == Channel::Nightly;
+ }
