+//! What the browser's engine (engine.rs) and the build tool (compile_engine.rs) share: how the lists
+//! file becomes filters, and how filters are saved and loaded, so the engine saved at build time and
+//! one built in the browser treat every list the same way.
+
+use crate::header::HeaderRules;
+use crate::query::{Pattern, Query, Special};
+use crate::permissions::PermissionRules;
+use crate::popup::PopupRules;
+use crate::uritransform::TransformRules;
+use crate::urlskip::SkipRules;
+use adblock::lists::{FilterSet, ParseOptions};
+use adblock::request::Request;
+use adblock::resources::PermissionMask;
+
+/// Each list in the lists file starts with this comment line followed by the list's id
+/// (extract_lists.py, list_store.cc).
+pub const MARKER: &str = "! thoron-list: ";
+
+/// The permission assemble_resources.mjs gives the scriptlets and resources that uBlock Origin marks
+/// as needing trust: they can set cookies, click elements or rewrite responses.
+pub const TRUSTED: PermissionMask = PermissionMask::from_bits(1);
+
+/// uBlock Origin lets only its own lists use trusted scriptlets, and so does Thoron: a list gets the
+/// permission by its id, never by anything written inside the list.
+pub fn list_permissions(id: &str) -> PermissionMask {
+    if is_trusted(id) {
+        TRUSTED
+    } else {
+        PermissionMask::default()
+    }
+}
+
+/// True for uBlock Origin's own lists: the only ones that may use trusted scriptlets and the options
+/// that send a request somewhere else (`$urlskip`, `$uritransform`) or change what a page may use
+/// (`$permissions`).
+pub fn is_trusted(id: &str) -> bool {
+    id.starts_with("ublock-")
+}
+
+/// The lines of the trusted lists that hold `word`: where the rules come from that only such lists
+/// may bring (`$urlskip`, `$uritransform`, `$permissions`).
+fn trusted_lines(rules: &str, word: &str) -> String {
+    let mut lines = String::new();
+    for (id, text) in split_lists(rules) {
+        if is_trusted(id) {
+            for line in text.lines().filter(|l| l.contains(word)) {
+                lines.push_str(line);
+                lines.push('\n');
+            }
+        }
+    }
+    lines
+}
+
+/// The lists file by list, as (id, text). Text before the first marker has the id "".
+pub fn split_lists(text: &str) -> Vec<(&str, &str)> {
+    let mut lists = Vec::new();
+    let (mut id, mut start, mut pos) = ("", 0, 0);
+    for line in text.split_inclusive('\n') {
+        if let Some(rest) = line.strip_prefix(MARKER) {
+            if pos > start {
+                lists.push((id, &text[start..pos]));
+            }
+            id = rest.trim();
+            start = pos + line.len();
+        }
+        pos += line.len();
+    }
+    if pos > start {
+        lists.push((id, &text[start..pos]));
+    }
+    lists
+}
+
+/// The filter set of a lists file, each list parsed with the permission its id gives it.
+pub fn filter_set(rules: &str) -> FilterSet {
+    let mut set = FilterSet::new(false);
+    for (id, text) in split_lists(rules) {
+        let options = ParseOptions { permissions: list_permissions(id), ..Default::default() };
+        set.add_filter_list(text.to_string(), options);
+    }
+    set
+}
+
+/// A small engine over a few rewritten rules, or none when there are no such rules.
+fn small_engine(rules: &[String]) -> Option<adblock::Engine> {
+    if rules.is_empty() {
+        return None;
+    }
+    let mut set = FilterSet::new(false);
+    set.add_filter_list(rules.join("\n"), ParseOptions::default());
+    Some(adblock::Engine::new_with_filter_set(set))
+}
+
+fn matches(engine: Option<&adblock::Engine>, request: &Request) -> bool {
+    engine.is_some_and(|e| e.check_network_request(request).should_block())
+}
+
+/// The `$removeparam` rules adblock-rust does not apply itself (query.rs): each kind in a small
+/// engine of its own, which says where the rules match; what they then do is done here.
+#[derive(Default)]
+pub struct ParamRules {
+    /// Every rule of `strip_all` and `strip_patterns` together: one question settles, for nearly
+    /// every request, that none of them matches.
+    any_strip: Option<adblock::Engine>,
+    strip_all: Option<adblock::Engine>,
+    strip_patterns: Vec<(Pattern, adblock::Engine)>,
+    keep_all: Option<adblock::Engine>,
+    keep: Option<adblock::Engine>,
+    /// The rules as the lists wrote them, one per line: what is saved with the engine.
+    text: String,
+}
+
+impl ParamRules {
+    /// From list text; every line that is not a special `$removeparam` rule is skipped.
+    pub fn from_rules(rules: &str) -> ParamRules {
+        let (mut strip_all, mut keep_all, mut keep) = (Vec::new(), Vec::new(), Vec::new());
+        let mut by_pattern: Vec<(Pattern, Vec<String>)> = Vec::new();
+        let mut text = String::new();
+        for line in rules.lines().filter(|l| l.contains("removeparam")) {
+            let Some(special) = crate::query::special_rule(line) else { continue };
+            text.push_str(line.trim());
+            text.push('\n');
+            match special {
+                Special::StripAll(rule) => strip_all.push(rule),
+                Special::KeepAll(rule) => keep_all.push(rule),
+                Special::Keep(rule) => keep.push(rule),
+                Special::StripPattern(pattern, rule) => match by_pattern.iter_mut().find(|(p, _)| *p == pattern) {
+                    Some((_, rules)) => rules.push(rule),
+                    None => by_pattern.push((pattern, vec![rule])),
+                },
+            }
+        }
+        let mut any_strip = strip_all.clone();
+        any_strip.extend(by_pattern.iter().flat_map(|(_, rules)| rules.iter().cloned()));
+        ParamRules {
+            any_strip: small_engine(&any_strip),
+            strip_all: small_engine(&strip_all),
+            strip_patterns: by_pattern
+                .into_iter()
+                .filter_map(|(pattern, rules)| small_engine(&rules).map(|engine| (pattern, engine)))
+                .collect(),
+            keep_all: small_engine(&keep_all),
+            keep: small_engine(&keep),
+            text,
+        }
+    }
+
+    /// The address a request should go to instead of `url`, when rules remove parameters from it.
+    /// `engine_rewrite` is what the main engine made of the address (its `$removeparam=name`
+    /// rules). `None`: the address stays as it is.
+    pub fn clean(&self, request: &Request, url: &str, engine_rewrite: Option<&str>) -> Option<String> {
+        let query = Query::split(url)?;
+        let mut removed = match engine_rewrite {
+            Some(rewritten) => query.removed_in(rewritten),
+            None => vec![false; query.parameters.len()],
+        };
+        if matches(self.any_strip.as_ref(), request) {
+            if matches(self.strip_all.as_ref(), request) {
+                removed.fill(true);
+            }
+            for (pattern, engine) in &self.strip_patterns {
+                if matches(Some(engine), request) {
+                    for (gone, parameter) in removed.iter_mut().zip(&query.parameters) {
+                        // a parameter without "=" is tested as "name="
+                        let written =
+                            if parameter.contains('=') { parameter.to_string() } else { format!("{parameter}=") };
+                        *gone = *gone || pattern.matches(&written);
+                    }
+                }
+            }
+        }
+        if !removed.contains(&true) || matches(self.keep_all.as_ref(), request) {
+            return None;
+        }
+        if let Some(keep) = &self.keep {
+            if let Some(would_remove) = keep.check_network_request(request).rewritten_url {
+                for (gone, kept) in removed.iter_mut().zip(query.removed_in(&would_remove)) {
+                    *gone = *gone && !kept;
+                }
+            }
+        }
+        removed.contains(&true).then(|| query.without(&removed))
+    }
+}
+
+/// Everything built from the lists file.
+pub struct Filters {
+    pub engine: adblock::Engine,
+    pub params: ParamRules,
+    /// The `$header` rules.
+    pub headers: HeaderRules,
+    /// The `$popup` rules (and `$all`, which covers pop-ups).
+    pub popups: PopupRules,
+    /// The `$urlskip` rules of the trusted lists.
+    pub skips: SkipRules,
+    /// The `$permissions` rules of the trusted lists.
+    pub permissions: PermissionRules,
+    /// The `$uritransform` rules of the trusted lists.
+    pub transforms: TransformRules,
+    /// Hide rules for every site that are written with a procedural operator; found by the
+    /// engine (engine.rs) the first time a document asks, and never applied.
+    pub siteless: std::sync::OnceLock<std::collections::HashSet<String>>,
+}
+
+impl Filters {
+    fn new(
+        engine: adblock::Engine,
+        params: ParamRules,
+        headers: HeaderRules,
+        popups: PopupRules,
+        skips: SkipRules,
+        permissions: PermissionRules,
+        transforms: TransformRules,
+    ) -> Filters {
+        Filters { engine, params, headers, popups, skips, permissions, transforms, siteless: std::sync::OnceLock::new() }
+    }
+}
+
+/// Builds the filters from the lists file.
+pub fn build(rules: &str) -> Filters {
+    Filters::new(
+        adblock::Engine::new_with_filter_set(filter_set(rules)),
+        ParamRules::from_rules(rules),
+        HeaderRules::from_rules(rules),
+        PopupRules::from_rules(rules),
+        SkipRules::from_trusted_text(&trusted_lines(rules, "urlskip")),
+        PermissionRules::from_trusted_text(&trusted_lines(rules, "permissions")),
+        TransformRules::from_trusted_text(&trusted_lines(rules, "uritransform")),
+    )
+}
+
+/// True when the lists block the window or tab that the page at `opener_url` opens at `url`.
+pub fn blocks_popup(filters: &Filters, url: &str, opener_url: &str) -> bool {
+    filters.popups.blocks(url, opener_url)
+}
+
+/// True when the lists block the page at `url` itself, as uBlock Origin's strict blocking does. As
+/// there, adblock-rust applies to a page's own request a rule for whole pages (`$doc`, `$all`) and a
+/// rule that names the page's whole host and nothing more (`||ads.example^`), never a rule for a
+/// part of an address (`/ads/*`); an exception for the page or its host keeps it open.
+pub fn blocks_page(filters: &Filters, url: &str) -> bool {
+    Request::new(url, url, "document", "GET").is_ok_and(|page| filters.engine.check_network_request(&page).should_block())
+}
+
+/// The address a `$uritransform` rule makes of a request's own, or "".
+pub fn transform(filters: &Filters, url: &str, source_url: &str, request_type: &str) -> String {
+    filters.transforms.apply(url, source_url, request_type).unwrap_or_default()
+}
+
+/// Where a navigation to `url` should go instead (`$urlskip`), or "" when it stays as it is.
+pub fn skip(filters: &Filters, url: &str, source_url: &str) -> String {
+    let Ok(request) = Request::new(url, source_url, "document", "GET") else { return String::new() };
+    let blocked = filters.engine.check_network_request(&request).should_block();
+    filters.skips.skip(url, source_url, blocked).unwrap_or_default()
+}
+
+/// What to do with one request (the fields of the bridge's `RequestDecision`).
+pub struct Decision {
+    pub blocked: bool,
+    pub stand_in: String,
+    pub clean_url: String,
+    /// Only without `blocked`: what the answer is to be held against (header.rs). Nearly always "".
+    pub header_tests: String,
+    /// Only without `blocked`: the address a `$uritransform` rule makes of the request's own. "":
+    /// none. The caller checks it before it is used.
+    pub transformed_url: String,
+}
+
+/// The decision for a request. The clean address of a request that is blocked is only worked out
+/// with `clean_blocked`: a blocked request goes nowhere, so its address does not matter, except for
+/// a page's own navigation, which is never blocked. An address that is not one is allowed.
+pub fn decide(
+    filters: &Filters,
+    url: &str,
+    source_url: &str,
+    request_type: &str,
+    method: &str,
+    clean_blocked: bool,
+) -> Decision {
+    let allowed = Decision {
+        blocked: false,
+        stand_in: String::new(),
+        clean_url: String::new(),
+        header_tests: String::new(),
+        transformed_url: String::new(),
+    };
+    let Ok(request) = Request::new(url, source_url, request_type, method) else { return allowed };
+    let result = filters.engine.check_network_request(&request);
+    let blocked = result.should_block();
+    // `$header`: the answer will decide. An exception rule of the lists for the request spares it;
+    // the engine only looks for one after a blocking rule matched, so it is asked again.
+    let header_tests = if blocked {
+        String::new()
+    } else {
+        let excepted = || {
+            result.exception.is_some()
+                || filters.engine.check_network_request_subset(&request, true, true).exception.is_some()
+        };
+        filters.headers.tests(url, source_url, request_type, method, excepted)
+    };
+    let clean_url = if (!blocked || clean_blocked) && url.contains('?') {
+        filters.params.clean(&request, url, result.rewritten_url.as_deref()).unwrap_or_default()
+    } else {
+        String::new()
+    };
+    // a `redirect-rule` alone does not block: its stand-in is only for a blocked request
+    let stand_in = if blocked { result.redirect.unwrap_or_default() } else { String::new() };
+    let transformed_url =
+        if blocked { String::new() } else { filters.transforms.apply(url, source_url, request_type).unwrap_or_default() };
+    Decision { blocked, stand_in, clean_url, header_tests, transformed_url }
+}
+
+/// A `$csp` rule's policy becomes a response header: printable ASCII only, and not endless. As in
+/// uBlock Origin, a policy may not tell the page to send reports anywhere: a list could use that
+/// to learn what people load (adblock-rust lets such a rule through).
+pub fn safe_policy(policy: &str) -> bool {
+    let lower = policy.to_ascii_lowercase();
+    !policy.trim().is_empty()
+        && policy.len() <= 4096
+        && policy.chars().all(|c| c == ' ' || c.is_ascii_graphic())
+        && !lower.contains("report-uri")
+        && !lower.contains("report-to")
+}
+
+/// The content security policy `$csp` rules add to the document at `url`: the value of a
+/// Content-Security-Policy header. Empty: none.
+pub fn policy(filters: &Filters, url: &str, source_url: &str, main_frame: bool) -> String {
+    let request_type = if main_frame { "document" } else { "subdocument" };
+    let Ok(request) = Request::new(url, source_url, request_type, "GET") else { return String::new() };
+    // adblock-rust joins the policies of every matching rule with commas, as a header would
+    let Some(found) = filters.engine.get_csp_directives(&request) else { return String::new() };
+    let mut policies: Vec<&str> = found.split(',').map(str::trim).filter(|p| safe_policy(p)).collect();
+    policies.sort_unstable();
+    let header = policies.join(", ");
+    if header.len() <= 4096 {
+        header
+    } else {
+        String::new()
+    }
+}
+
+/// A saved engine starts with this: a name and the version of this layout. After it come two
+/// sections of rules as text, each after its length (four bytes, little endian), then the engine
+/// as adblock-rust saves it.
+const SAVED: &[u8; 8] = b"THRNAB\x00\x06";
+
+pub fn save(filters: &Filters) -> Vec<u8> {
+    // The rules adblock-rust does not keep, one per line, in two sections: those every list may
+    // bring (the `$removeparam` specials, `$header`, `$popup`), then the lines that only trusted lists may
+    // bring (`$urlskip`, `$permissions`, `$uritransform`). They are kept apart so that a line of
+    // the first can never count as one of the second.
+    let any_list = format!("{}{}{}", filters.params.text, filters.headers.text, filters.popups.text);
+    let any_list = any_list.as_bytes();
+    let trusted = format!("{}{}{}", filters.skips.text, filters.permissions.text, filters.transforms.text);
+    let engine = filters.engine.serialize();
+    let mut data = Vec::with_capacity(SAVED.len() + 8 + any_list.len() + trusted.len() + engine.len());
+    data.extend_from_slice(SAVED);
+    for section in [any_list, trusted.as_bytes()] {
+        data.extend_from_slice(&(section.len() as u32).to_le_bytes());
+        data.extend_from_slice(section);
+    }
+    data.extend_from_slice(&engine);
+    data
+}
+
+/// `None` for anything that is not a saved engine of this layout.
+pub fn load(data: &[u8]) -> Option<Filters> {
+    fn section(data: &[u8]) -> Option<(&str, &[u8])> {
+        let (length, rest) = data.split_first_chunk::<4>()?;
+        let length = u32::from_le_bytes(*length) as usize;
+        if length > rest.len() {
+            return None;
+        }
+        let (text, rest) = rest.split_at(length);
+        Some((std::str::from_utf8(text).ok()?, rest))
+    }
+    let (any_list, rest) = section(data.strip_prefix(SAVED)?)?;
+    // These lines were taken from trusted lists when the engine was built.
+    let (trusted, saved_engine) = section(rest)?;
+    let mut engine = adblock::Engine::default();
+    engine.deserialize(saved_engine).ok()?;
+    Some(Filters::new(
+        engine,
+        ParamRules::from_rules(any_list),
+        HeaderRules::from_rules(any_list),
+        PopupRules::from_rules(any_list),
+        SkipRules::from_trusted_text(trusted),
+        PermissionRules::from_trusted_text(trusted),
+        TransformRules::from_trusted_text(trusted),
+    ))
+}
