+
+#include "components/thoron_adblock/engine_service.h"
+
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/path_service.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/version_info/version_info.h"
+#include "components/thoron_adblock/list_fetch.h"
+#include "net/base/url_util.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "url/url_constants.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+constexpr base::FilePath::CharType kStoreDir[] =
+    FILE_PATH_LITERAL("Thoron Adblock");
+// Loopback-only list server for the automated update tests.
+constexpr char kListsUrlForTesting[] = "thoron-adblock-lists-url-for-testing";
+
+GURL ListsUrlForTesting() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (!cl->HasSwitch(kListsUrlForTesting)) {
+    return GURL();
+  }
+  GURL url(cl->GetSwitchValueASCII(kListsUrlForTesting));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !net::IsLocalhost(url)) {
+    return GURL();
+  }
+  return url;
+}
+
+bool IsBlockableScheme(const GURL& url) {
+  return url.SchemeIsHTTPOrHTTPS() || url.SchemeIsWSOrWSS();
+}
+
+// The engine only ever takes parameters out of an address. Whatever else it
+// might hand back is not used: the result must be `url` with another query.
+GURL CheckedClean(const GURL& url, std::string_view clean) {
+  if (clean.empty() || !url.SchemeIsHTTPOrHTTPS()) {
+    return GURL();
+  }
+  const GURL result(clean);
+  if (!result.is_valid() || result == url ||
+      result.scheme() != url.scheme() || result.host() != url.host() ||
+      result.port() != url.port() || result.path() != url.path() ||
+      result.username() != url.username() ||
+      result.password() != url.password() || result.ref() != url.ref() ||
+      result.query().size() >= url.query().size()) {
+    return GURL();
+  }
+  return result;
+}
+
+}  // namespace
+
+// static
+EngineService& EngineService::Get() {
+  static base::NoDestructor<EngineService> instance;
+  return *instance;
+}
+
+EngineService::EngineService() = default;
+EngineService::~EngineService() = default;
+
+void EngineService::Configure(const base::FilePath& user_data_dir,
+                              ListUpdater::FactoryGetter factory_getter) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (configured_ || started_ || user_data_dir.empty()) {
+    return;
+  }
+  configured_ = true;
+  store_dir_ = user_data_dir.Append(kStoreDir);
+  factory_getter_ = std::move(factory_getter);
+}
+
+StorePaths EngineService::Paths() const {
+  StorePaths paths;
+  base::PathService::Get(base::DIR_ASSETS, &paths.bundled_dir);
+  paths.store_dir = store_dir_;
+  paths.version = std::string(version_info::GetVersionNumber());
+  return paths;
+}
+
+void EngineService::EnsureStarted() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  // One sequence for every file of the engine and lists, so a load never
+  // reads a file an update is writing.
+  file_runner_ = base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&LoadEngine, Paths()),
+      base::BindOnce(&EngineService::OnBuilt, weak_factory_.GetWeakPtr()));
+}
+
+void EngineService::OnBuilt(std::optional<rust::Box<Engine>> engine) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (engine && (*engine)->is_valid()) {
+    engine_ = std::move(engine);
+  }
+  if (!configured_ || updater_) {
+    return;
+  }
+  updater_ = std::make_unique<ListUpdater>(
+      file_runner_, Paths(), factory_getter_,
+      // Unretained: the service is never destroyed (NoDestructor), and a
+      // weak pointer cannot carry a return value.
+      base::BindRepeating(&EngineService::ProbesBlocked,
+                          base::Unretained(this)),
+      base::BindRepeating(&EngineService::OnNewEngine,
+                          weak_factory_.GetWeakPtr()),
+      ListsUrlForTesting());
+  updater_->Start();
+}
+
+void EngineService::OnNewEngine(rust::Box<Engine> engine) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (engine->is_valid()) {
+    engine_ = std::move(engine);
+  }
+}
+
+std::vector<bool> EngineService::ProbesBlocked() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::vector<bool> blocked;
+  for (const Probe& p : Probes()) {
+    blocked.push_back(engine_ && (*engine_)->should_block(
+                                     rust::Str(p.url.data(), p.url.size()),
+                                     rust::Str(p.source.data(), p.source.size()),
+                                     rust::Str(p.type.data(), p.type.size())));
+  }
+  return blocked;
+}
+
+void EngineService::SetEngineForTesting(rust::Box<Engine> engine) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  started_ = true;
+  engine_ = std::move(engine);
+}
+
+EngineService::Decision EngineService::Check(
+    const GURL& url,
+    const GURL& source,
+    network::mojom::RequestDestination destination) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !IsBlockableScheme(url) || !source.is_valid()) {
+    return {};
+  }
+  const std::string& u = url.spec();
+  const std::string& s = source.spec();
+  const std::string_view t = RequestType(destination);
+  RequestDecision found = (*engine_)->check_request(
+      rust::Str(u.data(), u.size()), rust::Str(s.data(), s.size()),
+      rust::Str(t.data(), t.size()));
+  return {found.blocked, std::string(found.stand_in),
+          CheckedClean(url, std::string(found.clean_url))};
+}
+
+bool EngineService::BlocksWebSocket(const GURL& url, const GURL& source) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !url.SchemeIsWSOrWSS() || !source.is_valid()) {
+    return false;
+  }
+  const std::string& u = url.spec();
+  const std::string& s = source.spec();
+  constexpr std::string_view kType = "websocket";
+  return (*engine_)->should_block(rust::Str(u.data(), u.size()),
+                                  rust::Str(s.data(), s.size()),
+                                  rust::Str(kType.data(), kType.size()));
+}
+
+GURL EngineService::CleanUrl(const GURL& url,
+                             const GURL& source,
+                             bool main_frame) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !url.SchemeIsHTTPOrHTTPS() || !url.has_query() ||
+      !source.is_valid()) {
+    return GURL();
+  }
+  const std::string& u = url.spec();
+  const std::string& s = source.spec();
+  const std::string_view t = main_frame ? "document" : "subdocument";
+  return CheckedClean(
+      url, std::string((*engine_)->clean_url(rust::Str(u.data(), u.size()),
+                                             rust::Str(s.data(), s.size()),
+                                             rust::Str(t.data(), t.size()))));
+}
+
+GURL EngineService::SkipUrl(const GURL& url) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !url.SchemeIsHTTPOrHTTPS()) {
+    return GURL();
+  }
+  const std::string& u = url.spec();
+  const GURL target(std::string((*engine_)->skip_url(
+      rust::Str(u.data(), u.size()), rust::Str(u.data(), u.size()))));
+  // The engine found the address inside `url`, which anyone can write. It is
+  // only ever followed to a plain web address.
+  if (!target.is_valid() || !target.SchemeIsHTTPOrHTTPS() || target == url ||
+      target.has_username() || target.has_password() || !target.has_host()) {
+    return GURL();
+  }
+  return target;
+}
+
+std::string EngineService::DocumentPolicy(const GURL& url,
+                                          const GURL& source,
+                                          bool main_frame) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !url.SchemeIsHTTPOrHTTPS() || !source.is_valid()) {
+    return std::string();
+  }
+  const std::string& u = url.spec();
+  const std::string& s = source.spec();
+  return std::string((*engine_)->document_policy(
+      rust::Str(u.data(), u.size()), rust::Str(s.data(), s.size()),
+      main_frame));
+}
+
+EngineService::Document EngineService::ForDocument(const GURL& url) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !url.SchemeIsHTTPOrHTTPS()) {
+    return {};
+  }
+  const std::string& u = url.spec();
+  DocumentResources found =
+      (*engine_)->document_resources(rust::Str(u.data(), u.size()));
+  return {std::string(found.stylesheet), std::string(found.script),
+          std::string(found.isolated_script), !found.generichide};
+}
+
+std::string EngineService::GenericStylesheet(
+    const GURL& url,
+    const std::vector<std::string>& classes,
+    const std::vector<std::string>& ids) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  // rust::String needs UTF-8; a name that is not cannot match a rule anyway.
+  auto to_rust = [](const std::vector<std::string>& names) {
+    rust::Vec<rust::String> out;
+    out.reserve(names.size());
+    for (const std::string& name : names) {
+      if (base::IsStringUTF8(name)) {
+        out.push_back(rust::String(name));
+      }
+    }
+    return out;
+  };
+  const std::string& u = url.spec();
+  return std::string((*engine_)->generic_stylesheet(
+      rust::Str(u.data(), u.size()), to_rust(classes), to_rust(ids)));
+}
+
+// static
+std::string_view EngineService::RequestType(
+    network::mojom::RequestDestination destination) {
+  using D = network::mojom::RequestDestination;
+  switch (destination) {
+    case D::kScript:
+    case D::kServiceWorker:
+    case D::kSharedWorker:
+    case D::kWorker:
+    case D::kAudioWorklet:
+    case D::kPaintWorklet:
+      return "script";
+    case D::kStyle:
+    case D::kXslt:
+      return "stylesheet";
+    case D::kImage:
+      return "image";
+    case D::kFont:
+      return "font";
+    case D::kAudio:
+    case D::kVideo:
+    case D::kTrack:
+      return "media";
+    case D::kFrame:
+    case D::kIframe:
+    case D::kFencedframe:
+      return "subdocument";
+    case D::kObject:
+    case D::kEmbed:
+      return "object";
+    case D::kEmpty:
+      return "xmlhttprequest";
+    case D::kReport:
+      return "ping";
+    case D::kDocument:
+      return "document";
+    default:
+      return "other";
+  }
+}
+
+void EngineService::DescribeSettings(Described callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureStarted();
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&thoron_adblock::DescribeSettings, Paths()),
+      std::move(callback));
+}
+
+void EngineService::SetListEnabled(const std::string& id,
+                                   bool enabled,
+                                   Changed callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureStarted();
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&thoron_adblock::SetListEnabled, Paths(), id, enabled,
+                     base::Time::Now()),
+      base::BindOnce(&EngineService::OnChanged, weak_factory_.GetWeakPtr(),
+                     std::move(callback)));
+}
+
+void EngineService::AddList(const GURL& url, Changed callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureStarted();
+  if (!ListFetch::IsAllowed(url, ListsUrlForTesting().is_valid())) {
+    std::move(callback).Run("The address of a list must start with https://");
+    return;
+  }
+  if (add_fetch_) {
+    std::move(callback).Run(
+        "Another list is being added. Try again in a moment.");
+    return;
+  }
+  // The file sequence makes the folder the download goes into.
+  base::FilePath path =
+      store_dir_.Append(FILE_PATH_LITERAL("download"))
+          .AppendASCII(base::StrCat({CustomListId(url.spec()), ".add"}));
+  file_runner_->PostTaskAndReply(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& dir) { base::CreateDirectory(dir); },
+          path.DirName()),
+      base::BindOnce(&EngineService::StartAddFetch, weak_factory_.GetWeakPtr(),
+                     url, path, std::move(callback)));
+}
+
+void EngineService::StartAddFetch(GURL url,
+                                  base::FilePath path,
+                                  Changed callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      factory_getter_ ? factory_getter_.Run() : nullptr;
+  if (!factory || add_fetch_) {
+    std::move(callback).Run("The list could not be downloaded.");
+    return;
+  }
+  add_fetch_ = std::make_unique<ListFetch>(
+      url, path, std::move(factory), file_runner_,
+      ListsUrlForTesting().is_valid(),
+      base::BindOnce(&EngineService::OnListFetched, weak_factory_.GetWeakPtr(),
+                     url, std::move(callback)));
+}
+
+void EngineService::OnListFetched(GURL url,
+                                  Changed callback,
+                                  base::FilePath path) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  add_fetch_.reset();
+  if (path.empty()) {
+    std::move(callback).Run(
+        "The list could not be downloaded. Check the address and the "
+        "connection.");
+    return;
+  }
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&AddCustomList, Paths(), url, path, base::Time::Now()),
+      base::BindOnce(&EngineService::OnChanged, weak_factory_.GetWeakPtr(),
+                     std::move(callback)));
+}
+
+void EngineService::RemoveList(const std::string& id, Changed callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureStarted();
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&RemoveCustomList, Paths(), id, base::Time::Now()),
+      base::BindOnce(&EngineService::OnChanged, weak_factory_.GetWeakPtr(),
+                     std::move(callback)));
+}
+
+void EngineService::SetMyFilters(std::string text, Changed callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureStarted();
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const StorePaths& paths, const std::string& rules,
+             base::Time now) {
+            return thoron_adblock::SetMyFilters(paths, rules, now);
+          },
+          Paths(), std::move(text), base::Time::Now()),
+      base::BindOnce(&EngineService::OnChanged, weak_factory_.GetWeakPtr(),
+                     std::move(callback)));
+}
+
+void EngineService::UpdateNow(Changed callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureStarted();
+  if (!updater_) {
+    std::move(callback).Run(
+        "The blocker is still starting. Try again in a moment.");
+    return;
+  }
+  updater_->CheckNow(base::BindOnce(
+      [](Changed done, std::string summary) { std::move(done).Run(""); },
+      std::move(callback)));
+}
+
+void EngineService::OnChanged(Changed callback, ChangeResult change) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (change.error.empty() && change.engine && (*change.engine)->is_valid()) {
+    engine_ = std::move(change.engine);
+  }
+  std::move(callback).Run(std::move(change.error));
+}
+
+}  // namespace thoron_adblock
