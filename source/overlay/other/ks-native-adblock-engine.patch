+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_PROXYING_URL_LOADER_FACTORY_H_
+#define COMPONENTS_THORON_ADBLOCK_PROXYING_URL_LOADER_FACTORY_H_
+
+#include <string>
+
+#include "content/public/browser/content_browser_client.h"
+#include "content/public/browser/global_routing_id.h"
+#include "net/base/isolation_info.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_loader_factory.mojom.h"
+
+class GURL;
+class HostContentSettingsMap;
+
+namespace url {
+class Origin;
+}  // namespace url
+
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+// Sits in front of a page's subresource URLLoaderFactory and ends the requests
+// the native engine blocks with net::ERR_BLOCKED_BY_CLIENT, as an extension's
+// blocking would, or answers them with a harmless stand-in when a filter asks
+// for one (`$redirect`). A request with parameters the lists take out
+// (`$removeparam`) goes out without them. Every request that goes out gets a
+// RedirectWatcher, which puts the target of each redirect to the engine
+// again. Documents (a page, a frame) are not handled here but by
+// DocumentRequestInterceptor. Owns itself and goes away when its pipes close.
+class ProxyingURLLoaderFactory : public network::mojom::URLLoaderFactory {
+ public:
+  ProxyingURLLoaderFactory(const ProxyingURLLoaderFactory&) = delete;
+  ProxyingURLLoaderFactory& operator=(const ProxyingURLLoaderFactory&) = delete;
+
+  // Inserts the proxy when native ad blocking is enabled, the factory loads a
+  // document's, worker's or service worker's subresources or the script a
+  // worker or service worker is started from, and the person has not allowed
+  // ads on the top-level site (the per-site "Ads" setting in page info and
+  // Settings; null `settings` means no per-site choice).
+  static void MaybeProxy(content::ContentBrowserClient::URLLoaderFactoryType type,
+                         network::URLLoaderFactoryBuilder& factory_builder,
+                         const HostContentSettingsMap* settings,
+                         const net::IsolationInfo& isolation_info,
+                         const url::Origin& request_initiator,
+                         content::RenderFrameHost* frame);
+
+  // True when the person allowed ads on `top_site`, or on every site.
+  // How a blocked request ends: with ERR_BLOCKED_BY_CLIENT, and for an image,
+  // a frame or an embedded object also with the flag that collapses the
+  // element that asked, so the page shows no empty box where the ad was (as
+  // uBlock Origin hides the placeholders of blocked elements).
+  static network::URLLoaderCompletionStatus BlockedStatus(
+      network::mojom::RequestDestination destination);
+
+  // True when `url` is on another site than `top_site` (their registered
+  // names differ, or their hosts when there is none).
+  static bool IsThirdParty(const GURL& url, const GURL& top_site);
+
+  static bool AdsAllowedOn(const HostContentSettingsMap* settings,
+                           const GURL& top_site);
+
+  // Answers a blocked request with its stand-in (a data: URL from the engine:
+  // an empty script, a 1x1 image, an empty document for a frame) as a
+  // finished 200 response, so the page sees the request succeed and nothing
+  // reaches the network. False when the stand-in cannot be used; nothing was
+  // sent to `client` then.
+  static bool AnswerWithStandIn(const std::string& stand_in,
+                                const network::ResourceRequest& request,
+                                network::mojom::URLLoaderClient& client);
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override;
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override;
+
+ private:
+  ProxyingURLLoaderFactory(
+      content::GlobalRenderFrameHostId frame,
+      GURL top_site,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory);
+  ~ProxyingURLLoaderFactory() override;
+
+  void OnTargetFactoryDisconnect();
+  void OnProxyDisconnect();
+
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> proxy_receivers_;
+  mojo::Remote<network::mojom::URLLoaderFactory> target_factory_;
+  // The document whose page counts the blocked requests (none for workers).
+  const content::GlobalRenderFrameHostId frame_;
+  // The page the requests are for: its site's switches apply (the menu).
+  const GURL top_site_;
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_PROXYING_URL_LOADER_FACTORY_H_
diff --git a/components/thoron_adblock/query.rs b/components/thoron_adblock/query.rs
new file mode 100644
index 0000000000000000000000000000000000000000..93d4b7aef64a8427c748e773c0b2a3d03a38829d
--- /dev/null
+++ b/components/thoron_adblock/query.rs
@@ -0,0 +1,329 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `$removeparam` beyond what adblock-rust applies. The engine handles the common form,
+//! `$removeparam=name`, and drops the rest when it reads a list. Three of those forms matter:
+//!     ||ads.example^$removeparam                 no parameter survives
+//!     ||video.example^$removeparam=/^ad/         every parameter the pattern matches goes
+//!     @@||shop.example/book/$removeparam         an exception: nothing is removed here
+//!     @@||media.example^$removeparam=profile     an exception for one parameter
+//! This module finds such rules in a list, rewrites each into a rule adblock-rust can match (the
+//! matching itself stays with the engine: engine_core.rs), and does the work on the address.
+//!
+//! Nothing here depends on the engine, so the tests run on their own.
+
+/// What a special rule asks for, with the rule rewritten for adblock-rust.
+#[derive(Debug, PartialEq, Clone)]
+pub enum Special {
+    /// Remove every parameter where the (plain) rule matches.
+    StripAll(String),
+    /// Remove the parameters the pattern matches where the (plain) rule matches.
+    StripPattern(Pattern, String),
+    /// Remove nothing where the (plain) rule matches.
+    KeepAll(String),
+    /// A `$removeparam=name` rule: what it would remove is kept.
+    Keep(String),
+}
+
+/// The few shapes of regular expression the lists use for parameters: an optional "^", then one
+/// word or a group of words, then an optional "\b". Written out here so that no pattern from a
+/// list can make matching slow; anything else is not applied.
+#[derive(Debug, PartialEq, Clone)]
+pub struct Pattern {
+    anchored: bool,
+    words: Vec<String>,
+    boundary: bool,
+}
+
+fn is_word_char(c: char) -> bool {
+    c.is_ascii_alphanumeric() || c == '_'
+}
+
+impl Pattern {
+    /// From the text between the slashes of `removeparam=/.../`.
+    pub fn parse(source: &str) -> Option<Pattern> {
+        let (anchored, rest) = match source.strip_prefix('^') {
+            Some(rest) => (true, rest),
+            None => (false, source),
+        };
+        let (boundary, rest) = match rest.strip_suffix("\\b") {
+            Some(rest) => (true, rest),
+            None => (false, rest),
+        };
+        let inner = match rest.strip_prefix('(') {
+            Some(group) => group.strip_suffix(')')?,
+            None => rest,
+        };
+        let words: Vec<String> = inner.split('|').map(str::to_string).collect();
+        let plain = |w: &String| !w.is_empty() && w.chars().all(|c| is_word_char(c) || c == '=' || c == '-');
+        words.iter().all(plain).then_some(Pattern { anchored, words, boundary })
+    }
+
+    /// Tested against one parameter as written in the address: "name=value", or "name=".
+    pub fn matches(&self, parameter: &str) -> bool {
+        let ends_well = |after: &str| !self.boundary || !after.chars().next().is_some_and(is_word_char);
+        self.words.iter().any(|word| {
+            if self.anchored {
+                parameter.strip_prefix(word.as_str()).is_some_and(ends_well)
+            } else {
+                parameter.match_indices(word.as_str()).any(|(at, _)| ends_well(&parameter[at + word.len()..]))
+            }
+        })
+    }
+}
+
+/// Options that name a request type. A `$removeparam` rule without one applies to documents,
+/// frames and fetches (as in uBlock Origin and adblock-rust); a plain rule would apply to every
+/// type but documents, so a rewritten rule gets the three types spelled out.
+const TYPES: &[&str] = &[
+    "script", "image", "stylesheet", "css", "object", "xmlhttprequest", "xhr", "subdocument", "frame",
+    "document", "doc", "font", "media", "websocket", "ping", "beacon", "other", "all",
+];
+
+/// Splits a rule's options at commas, except those inside a `/regular expression/` value.
+fn split_options(options: &str) -> Vec<&str> {
+    let (mut parts, mut start, mut in_regex) = (Vec::new(), 0, false);
+    let b = options.as_bytes();
+    let mut i = 0;
+    while i < b.len() {
+        match b[i] {
+            b'\\' => i += 1,
+            b'/' if in_regex => in_regex = false,
+            b'/' if i > 0 && b[i - 1] == b'=' => in_regex = true,
+            b',' if !in_regex => {
+                parts.push(&options[start..i]);
+                start = i + 1;
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    parts.push(&options[start..]);
+    parts
+}
+
+/// A list line that is a special `$removeparam` rule, rewritten. `None` for every other line, the
+/// simple `$removeparam=name` rules among them (the main engine has those).
+pub fn special_rule(line: &str) -> Option<Special> {
+    let line = line.trim();
+    let at = line.find("removeparam")?;
+    if line.starts_with('!') || line.contains("##") || line.contains("#@#") || line.contains("#?#") {
+        return None;
+    }
+    let dollar = line[..at].rfind('$')?;
+    let (exception, pattern) = match line[..dollar].strip_prefix("@@") {
+        Some(rest) => (true, rest),
+        None => (false, &line[..dollar]),
+    };
+    let options = split_options(&line[dollar + 1..]);
+    let mut wanted: Option<&str> = None; // the value of the removeparam option; "" when bare
+    let mut others: Vec<&str> = Vec::new();
+    for option in options {
+        if option == "removeparam" {
+            wanted = Some("");
+        } else if let Some(value) = option.strip_prefix("removeparam=") {
+            wanted = Some(value);
+        } else {
+            others.push(option);
+        }
+    }
+    let value = wanted?;
+    if value.starts_with('~') {
+        return None; // "all but this one": not in the lists, not built
+    }
+    let simple = !value.is_empty() && !value.starts_with('/');
+    if simple && !exception {
+        return None; // the main engine's
+    }
+    if simple {
+        // an exception for one parameter: as the rule it cancels, so the engine reports the same
+        // parameters for it
+        return Some(Special::Keep(line[2..].to_string()));
+    }
+    if !others.iter().any(|o| TYPES.contains(o)) {
+        others.extend(["document", "subdocument", "xmlhttprequest"]);
+    }
+    let pattern = if pattern.is_empty() { "*" } else { pattern };
+    let plain = format!("{pattern}${}", others.join(","));
+    if value.is_empty() {
+        return Some(if exception { Special::KeepAll(plain) } else { Special::StripAll(plain) });
+    }
+    if exception {
+        return None; // an exception for a pattern: not in the lists, not built
+    }
+    let source = value.strip_prefix('/')?.strip_suffix('/')?;
+    Some(Special::StripPattern(Pattern::parse(source)?, plain))
+}
+
+/// An address taken apart at its query: `prefix?a=1&b=2#fragment`.
+#[derive(Debug, PartialEq)]
+pub struct Query<'a> {
+    /// Everything before the "?".
+    pub prefix: &'a str,
+    /// The parameters as written, "a=1".
+    pub parameters: Vec<&'a str>,
+    /// "#fragment", or empty.
+    pub fragment: &'a str,
+}
+
+impl<'a> Query<'a> {
+    /// `None` for an address without a query.
+    pub fn split(url: &'a str) -> Option<Query<'a>> {
+        let (rest, fragment) = match url.find('#') {
+            Some(at) => (&url[..at], &url[at..]),
+            None => (url, ""),
+        };
+        let (prefix, query) = rest.split_once('?')?;
+        Some(Query { prefix, parameters: query.split('&').collect(), fragment })
+    }
+
+    /// Which parameters are missing from `rewritten`, an address the engine made from this one by
+    /// taking parameters out (it never reorders or changes them).
+    pub fn removed_in(&self, rewritten: &str) -> Vec<bool> {
+        let kept = Query::split(rewritten).map(|q| q.parameters).unwrap_or_default();
+        let mut next = 0;
+        self.parameters
+            .iter()
+            .map(|p| {
+                if kept.get(next) == Some(p) {
+                    next += 1;
+                    false
+                } else {
+                    true
+                }
+            })
+            .collect()
+    }
+
+    /// The address without the parameters marked in `removed`.
+    pub fn without(&self, removed: &[bool]) -> String {
+        let kept: Vec<&str> =
+            self.parameters.iter().zip(removed).filter(|(_, gone)| !**gone).map(|(p, _)| *p).collect();
+        if kept.is_empty() {
+            format!("{}{}", self.prefix, self.fragment)
+        } else {
+            format!("{}?{}{}", self.prefix, kept.join("&"), self.fragment)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn simple_rules_and_other_lines_are_not_special() {
+        for line in [
+            "$removeparam=utm_source",
+            "||msn.com^$doc,removeparam=ei",
+            "||ads.example^",
+            "! $removeparam",
+            "example.com##.removeparam",
+            "||x.example^$removeparam=~keep",
+            "",
+        ] {
+            assert_eq!(special_rule(line), None, "{line}");
+        }
+    }
+
+    #[test]
+    fn a_bare_rule_removes_everything_where_it_matches() {
+        assert_eq!(
+            special_rule("||fastlane.rubiconproject.com^$removeparam,domain=aternos.org"),
+            Some(Special::StripAll(
+                "||fastlane.rubiconproject.com^$domain=aternos.org,document,subdocument,xmlhttprequest".into()
+            ))
+        );
+        // a type the rule names is kept, and no other is added
+        assert_eq!(
+            special_rule("||go.xlirdr.com^$xhr,removeparam"),
+            Some(Special::StripAll("||go.xlirdr.com^$xhr".into()))
+        );
+        assert_eq!(
+            special_rule("$removeparam,domain=a.example"),
+            Some(Special::StripAll("*$domain=a.example,document,subdocument,xmlhttprequest".into()))
+        );
+    }
+
+    #[test]
+    fn exceptions_keep_parameters() {
+        assert_eq!(
+            special_rule("@@||agoda.com/*/book/$removeparam"),
+            Some(Special::KeepAll("||agoda.com/*/book/$document,subdocument,xmlhttprequest".into()))
+        );
+        assert_eq!(
+            special_rule("@@||shop.example/*^cls=$doc,removeparam"),
+            Some(Special::KeepAll("||shop.example/*^cls=$doc".into()))
+        );
+        assert_eq!(
+            special_rule("@@||che168.com^$xhr,removeparam=s_cid"),
+            Some(Special::Keep("||che168.com^$xhr,removeparam=s_cid".into()))
+        );
+    }
+
+    #[test]
+    fn a_pattern_rule_keeps_its_pattern() {
+        let Some(Special::StripPattern(pattern, plain)) =
+            special_rule("||content.uplynk.com/api/*&ad=$xhr,removeparam=/^ad/,domain=abc.com|abc7.com")
+        else {
+            panic!()
+        };
+        assert_eq!(plain, "||content.uplynk.com/api/*&ad=$xhr,domain=abc.com|abc7.com");
+        assert!(pattern.matches("ad=1"));
+        assert!(pattern.matches("adNetworkId=7"));
+        assert!(!pattern.matches("load=ad"));
+
+        let Some(Special::StripPattern(pattern, _)) =
+            special_rule("||g.doubleclick.net/gampad/ads?$xhr,removeparam=/^(cookie|ga_|u_)/,domain=s.example")
+        else {
+            panic!()
+        };
+        assert!(pattern.matches("cookie=x") && pattern.matches("ga_sid=1") && pattern.matches("u_w=1920"));
+        assert!(!pattern.matches("url=x"));
+
+        // what the small matcher does not understand is not applied
+        for line in [
+            "||l.example/s$xhr,removeparam=/^((?!SMIL|formats).)*$/",
+            "||h.example/yuicombo?$script,removeparam=/_ui/shared/common/js/track.js",
+            "||x.example^$removeparam=/a.*b/",
+            "@@||x.example^$removeparam=/^ad/",
+        ] {
+            assert_eq!(special_rule(line), None, "{line}");
+        }
+    }
+
+    #[test]
+    fn patterns() {
+        let p = Pattern::parse("^ad\\b").unwrap();
+        assert!(p.matches("ad=1") && p.matches("ad") && !p.matches("adx=1") && !p.matches("bad=1"));
+        let p = Pattern::parse("web_only=").unwrap();
+        assert!(p.matches("web_only=true") && p.matches("x_web_only=1") && !p.matches("web_only"));
+        let p = Pattern::parse("^utm_").unwrap();
+        assert!(p.matches("utm_source=a") && !p.matches("xutm_source=a"));
+        for bad in ["", "^", "a.*", "(a|b", "[ab]", "a|", "^(?!x)"] {
+            assert_eq!(Pattern::parse(bad), None, "{bad}");
+        }
+    }
+
+    #[test]
+    fn an_address_is_taken_apart_and_put_back() {
+        let q = Query::split("https://a.example/p?x=1&gclid=abc&y&z=#top").unwrap();
+        assert_eq!(q.prefix, "https://a.example/p");
+        assert_eq!(q.parameters, vec!["x=1", "gclid=abc", "y", "z="]);
+        assert_eq!(q.fragment, "#top");
+        assert_eq!(q.without(&[false, true, false, false]), "https://a.example/p?x=1&y&z=#top");
+        assert_eq!(q.without(&[true, true, true, true]), "https://a.example/p#top");
+        assert_eq!(q.without(&[false, false, false, false]), "https://a.example/p?x=1&gclid=abc&y&z=#top");
+        assert_eq!(Query::split("https://a.example/p"), None);
+        assert_eq!(Query::split("https://a.example/p#a?b=1"), None);
+    }
+
+    #[test]
+    fn what_the_engine_removed_is_found_by_position() {
+        let q = Query::split("https://a.example/?a=1&b=2&a=1&c=3").unwrap();
+        assert_eq!(q.removed_in("https://a.example/?a=1&a=1&c=3"), vec![false, true, false, false]);
+        assert_eq!(q.removed_in("https://a.example/?b=2&c=3"), vec![true, false, true, false]);
+        assert_eq!(q.removed_in("https://a.example/"), vec![true, true, true, true]);
+        assert_eq!(q.removed_in("https://a.example/?a=1&b=2&a=1&c=3"), vec![false, false, false, false]);
+    }
+}
