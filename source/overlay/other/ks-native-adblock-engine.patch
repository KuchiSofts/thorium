@@ -0,0 +1,98 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_INTERCEPTOR_H_
+#define COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_INTERCEPTOR_H_
+
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "content/public/browser/url_loader_request_interceptor.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/http_request_headers_update_params.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "url/gurl.h"
+
+class HostContentSettingsMap;
+
+namespace thoron_adblock {
+
+// Looks at the request for a document before it goes out: at the start of a
+// navigation and again after every redirect, for a page and for a frame
+// inside one. One per navigation, on the UI thread.
+// - `$removeparam`: an address with parameters the lists name is answered
+//   with an internal redirect to the address without them, so the address
+//   bar, the history and the page see the clean address and the server never
+//   sees the parameter. If a site sends the browser back to the address just
+//   cleaned, it is loaded as it is, so a site that insists cannot make the
+//   navigation go in circles.
+// - A frame whose address the lists block ends with ERR_BLOCKED_BY_CLIENT, or
+//   is answered with a stand-in when a filter asks for one. A page's own
+//   request is never blocked.
+// Nothing is done on a site where the person allowed ads.
+class DocumentRequestInterceptor : public content::URLLoaderRequestInterceptor,
+                                   public network::mojom::URLLoader {
+ public:
+  // Null when native ad blocking is off.
+  static std::unique_ptr<content::URLLoaderRequestInterceptor> MaybeCreate(
+      scoped_refptr<HostContentSettingsMap> settings,
+      content::FrameTreeNodeId frame_tree_node_id);
+
+  DocumentRequestInterceptor(const DocumentRequestInterceptor&) = delete;
+  DocumentRequestInterceptor& operator=(const DocumentRequestInterceptor&) =
+      delete;
+  ~DocumentRequestInterceptor() override;
+
+  // content::URLLoaderRequestInterceptor:
+  void MaybeCreateLoader(
+      const network::ResourceRequest& tentative_resource_request,
+      content::BrowserContext* browser_context,
+      content::URLLoaderRequestInterceptor::LoaderCallback callback) override;
+
+ private:
+  DocumentRequestInterceptor(scoped_refptr<HostContentSettingsMap> settings,
+                             content::FrameTreeNodeId frame_tree_node_id);
+
+  // network::mojom::URLLoader. Nothing to do: after the redirect, or the
+  // refusal, the navigation drops this loader.
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams headers_update_params,
+      const std::optional<GURL>& new_url) override {}
+  void SetPriority(net::RequestPriority priority,
+                   int intra_priority_value) override {}
+
+  // Takes the request over (the two pipe ends of its loader).
+  void Bind(mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+            mojo::PendingRemote<network::mojom::URLLoaderClient> client);
+  void OnConnectionClosed();
+
+  // The ways a request is handled here.
+  void RedirectTo(const GURL& clean,
+                  const network::ResourceRequest& request,
+                  mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+                  mojo::PendingRemote<network::mojom::URLLoaderClient> client);
+  void Refuse(const std::string& stand_in,
+              const network::ResourceRequest& request,
+              mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+              mojo::PendingRemote<network::mojom::URLLoaderClient> client);
+
+  const scoped_refptr<HostContentSettingsMap> settings_;
+  const content::FrameTreeNodeId frame_tree_node_id_;
+  // Clean addresses this navigation was already sent to.
+  std::set<GURL> cleaned_;
+  mojo::Receiver<network::mojom::URLLoader> receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  base::WeakPtrFactory<DocumentRequestInterceptor> weak_factory_{this};
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_INTERCEPTOR_H_
diff --git a/components/thoron_adblock/dynamic.rs b/components/thoron_adblock/dynamic.rs
new file mode 100644
index 0000000000000000000000000000000000000000..80ad9efac012f9ea6daa2ef70ce7f24e87d47ac1
--- /dev/null
+++ b/components/thoron_adblock/dynamic.rs
@@ -0,0 +1,444 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! "My rules": uBlock Origin's dynamic filtering. A rule is four words,
+//!
+//!     source destination type action
+//!
+//! `source` is the site of the page (`*` for every site), `destination` the host a request goes to (`*`
+//! for any), `type` one of `*`, `3p`, `1p-script`, `3p-script`, `3p-frame`, `image`, `inline-script` (with
+//! a named destination only `*`), and `action` `block`, `allow` or `noop`. A host covers the hosts under
+//! it. As in uBlock Origin, the most specific rule decides: a named destination before any destination,
+//! then (for any destination) the type of the request before the party and before every type, and for each
+//! of these the most specific source. `block` blocks the request whatever the filter lists say, `allow`
+//! lets it through whatever they say, `noop` leaves it to the lists; with no rule the lists decide too.
+
+use std::collections::HashMap;
+
+/// What a rule does, as uBlock Origin numbers it; 0: no rule.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    None = 0,
+    Block = 1,
+    Allow = 2,
+    Noop = 3,
+}
+
+/// The types a rule may name, in the order of the slots of a cell.
+const TYPES: [&str; 7] = ["*", "3p", "1p-script", "3p-script", "3p-frame", "image", "inline-script"];
+
+/// The most rules kept; more are left out (a list of thousands would be a mistake, not a choice).
+const MAX_RULES: usize = 20_000;
+
+fn slot(name: &str) -> Option<usize> {
+    TYPES.iter().position(|t| *t == name)
+}
+
+/// A host name as a rule writes it: `*`, or lower-case letters, digits, "-", "_" and "." (an IP address
+/// too), not starting or ending with a dot.
+fn valid_host(host: &str) -> bool {
+    host == "*"
+        || (!host.is_empty()
+            && host.len() <= 253
+            && !host.starts_with('.')
+            && !host.ends_with('.')
+            && !host.contains("..")
+            && host.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"-_.".contains(&b)))
+}
+
+/// The next broader name: "a.b.example" -> "b.example" -> "example" -> "*" -> none.
+fn broader(host: &str) -> Option<&str> {
+    if host == "*" {
+        return None;
+    }
+    Some(host.split_once('.').map_or("*", |(_, rest)| rest))
+}
+
+/// The rules of "My rules".
+#[derive(Default)]
+pub struct DynamicRules {
+    /// (source, destination) -> the action of each type slot.
+    cells: HashMap<(String, String), [Action; TYPES.len()]>,
+    count: usize,
+}
+
+/// One line read as a rule: (source, destination, type slot, action). `None` for a comment, a blank
+/// line, or a line that is not a rule.
+fn parse_line(line: &str) -> Option<(String, String, usize, Action)> {
+    let line = line.trim();
+    if line.is_empty() || line.starts_with('#') || line.starts_with('!') {
+        return None;
+    }
+    let words: Vec<&str> = line.split_whitespace().collect();
+    let &[source, destination, kind, action] = words.as_slice() else { return None };
+    let (source, destination) = (source.to_ascii_lowercase(), destination.to_ascii_lowercase());
+    if !valid_host(&source) || !valid_host(&destination) {
+        return None;
+    }
+    let kind = slot(kind)?;
+    // with a named destination only every type, as uBlock Origin has it
+    if destination != "*" && kind != 0 {
+        return None;
+    }
+    let action = match action {
+        "block" => Action::Block,
+        "allow" => Action::Allow,
+        "noop" => Action::Noop,
+        _ => return None,
+    };
+    Some((source, destination, kind, action))
+}
+
+impl DynamicRules {
+    /// From the text of "My rules"; lines that are not rules are skipped (`problems` counts them).
+    pub fn from_text(text: &str) -> DynamicRules {
+        let mut rules = DynamicRules::default();
+        for line in text.lines() {
+            if rules.count >= MAX_RULES {
+                break;
+            }
+            if let Some((source, destination, kind, action)) = parse_line(line) {
+                let cell = rules.cells.entry((source, destination)).or_insert([Action::None; TYPES.len()]);
+                if cell[kind] == Action::None {
+                    rules.count += 1;
+                }
+                cell[kind] = action;
+            }
+        }
+        rules
+    }
+
+    /// How many rules were read.
+    pub fn len(&self) -> usize {
+        self.count
+    }
+
+    /// The lines of `text` that are neither rules nor comments nor blank: what the page points out.
+    pub fn problems(text: &str) -> Vec<String> {
+        text.lines()
+            .filter(|l| {
+                let t = l.trim();
+                !t.is_empty() && !t.starts_with('#') && !t.starts_with('!') && parse_line(t).is_none()
+            })
+            .map(|l| l.trim().chars().take(200).collect())
+            .collect()
+    }
+
+    fn cell(&self, source: &str, destination: &str, kind: usize) -> Action {
+        self.cells.get(&(source.to_string(), destination.to_string())).map_or(Action::None, |c| c[kind])
+    }
+
+    /// The source `source` or the first broader one that has a rule for (destination, type).
+    fn by_source(&self, source: &str, destination: &str, kind: usize) -> Action {
+        let mut z = Some(source);
+        while let Some(s) = z {
+            let found = self.cell(s, destination, kind);
+            if found != Action::None {
+                return found;
+            }
+            z = broader(s);
+        }
+        Action::None
+    }
+
+    /// What the rules say about a request from a page on `source` (its host) to `destination` (the
+    /// request's host). `request_type` is the blocker's name for it ("script", "subdocument", "image",
+    /// "object"...); `third_party` whether the two are different sites.
+    pub fn evaluate(&self, source: &str, destination: &str, request_type: &str, third_party: bool) -> Action {
+        if self.cells.is_empty() || destination.is_empty() {
+            return Action::None;
+        }
+        let source = if source.is_empty() { "*" } else { source };
+        // a named destination, any type
+        let mut d = Some(destination);
+        while let Some(host) = d {
+            if host == "*" {
+                break;
+            }
+            let found = self.by_source(source, host, 0);
+            if found != Action::None {
+                return found;
+            }
+            d = broader(host);
+        }
+        // any destination: the party and the type of the request
+        let mut asked: Vec<usize> = Vec::new();
+        if third_party {
+            match request_type {
+                "script" => asked.push(3),
+                "subdocument" | "object" => asked.push(4),
+                _ => {}
+            }
+            asked.push(1);
+        } else if request_type == "script" {
+            asked.push(2);
+        }
+        if request_type == "image" {
+            asked.push(5);
+        }
+        asked.push(0);
+        for kind in asked {
+            let found = self.by_source(source, "*", kind);
+            if found != Action::None {
+                return found;
+            }
+        }
+        Action::None
+    }
+
+    /// True when inline scripts are blocked on a page of `source` (`* * inline-script block`).
+    pub fn blocks_inline_scripts(&self, source: &str) -> bool {
+        !self.cells.is_empty() && self.by_source(if source.is_empty() { "*" } else { source }, "*", 6) == Action::Block
+    }
+
+    /// What the menu's grid shows in one cell, as uBlock Origin's popup works it out: for a named
+    /// destination (`kind` "*") the first rule of `source` or a broader source for `destination` or
+    /// a host above it; for `destination` "*" the rule of the type `kind`. The action, and whether
+    /// the rule is set in exactly this cell (shown strong) or comes from a broader one (light).
+    pub fn cell_state(&self, source: &str, destination: &str, kind: &str) -> (Action, bool) {
+        let Some(kind) = slot(kind) else { return (Action::None, false) };
+        if self.cells.is_empty() || (destination != "*" && kind != 0) {
+            return (Action::None, false);
+        }
+        let mut d = Some(destination);
+        while let Some(host) = d {
+            let mut z = Some(source);
+            while let Some(s) = z {
+                let found = self.cell(s, host, kind);
+                if found != Action::None {
+                    return (found, s == source && host == destination);
+                }
+                z = broader(s);
+            }
+            // a type rule is only asked for any destination
+            if destination == "*" {
+                break;
+            }
+            d = broader(host).filter(|h| *h != "*");
+        }
+        (Action::None, false)
+    }
+}
+
+/// One rule as "My rules" writes it, or `None` when the words do not make one.
+fn rule_line(source: &str, destination: &str, kind: &str, action: Action) -> Option<String> {
+    let word = match action {
+        Action::Block => "block",
+        Action::Allow => "allow",
+        Action::Noop => "noop",
+        Action::None => return None,
+    };
+    let line = format!("{source} {destination} {kind} {word}");
+    parse_line(&line).map(|_| line)
+}
+
+/// `text` with the rule of one cell set to `action` (`Action::None` removes it): the lines that
+/// set this cell are taken out, every other line (comments too) is kept as it is, and the new rule
+/// goes at the end. `text` comes back unchanged when the cell is not one a rule can name.
+pub fn with_cell(text: &str, source: &str, destination: &str, kind: &str, action: Action) -> String {
+    let (source, destination) = (source.to_ascii_lowercase(), destination.to_ascii_lowercase());
+    let Some(slot_of_kind) = slot(kind) else { return text.to_string() };
+    // a cell a rule can name: test it with a block rule
+    if rule_line(&source, &destination, kind, Action::Block).is_none() {
+        return text.to_string();
+    }
+    let mut out = String::with_capacity(text.len() + 64);
+    for line in text.lines() {
+        match parse_line(line) {
+            Some((s, d, k, _)) if s == source && d == destination && k == slot_of_kind => {}
+            _ => {
+                out.push_str(line);
+                out.push('\n');
+            }
+        }
+    }
+    if let Some(line) = rule_line(&source, &destination, kind, action) {
+        out.push_str(&line);
+        out.push('\n');
+    }
+    out
+}
+
+/// The cells uBlock Origin's padlock saves and its eraser reverts, for a page of `source` that
+/// asked `destinations`: every type for `* *` and `<source> *`, and `* <host>` and `<source>
+/// <host>` for each destination. `to` with those cells set as they are in `from`; only the cells
+/// that differ are rewritten, so `to` comes back unchanged when nothing differs.
+pub fn copy_cells(from: &str, to: &str, source: &str, destinations: &[String]) -> String {
+    let (a, b) = (DynamicRules::from_text(from), DynamicRules::from_text(to));
+    let source = source.to_ascii_lowercase();
+    let mut cells: Vec<(String, String, usize)> = Vec::new();
+    for s in ["*", source.as_str()] {
+        for kind in 0..TYPES.len() {
+            cells.push((s.to_string(), "*".to_string(), kind));
+        }
+        for d in destinations {
+            let d = d.to_ascii_lowercase();
+            if d != "*" && valid_host(&d) {
+                cells.push((s.to_string(), d, 0));
+            }
+        }
+    }
+    let mut out = to.to_string();
+    for (s, d, kind) in cells {
+        let wanted = a.cell(&s, &d, kind);
+        if wanted != b.cell(&s, &d, kind) {
+            out = with_cell(&out, &s, &d, TYPES[kind], wanted);
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MINE: &str = "\
+# my rules
+* * 3p-script block
+* * 3p-frame block
+news.example * 3p-script noop
+news.example cdn.example * allow
+* ads.example * block
+shop.example * 3p block
+shop.example pay.example * allow
+* * image allow
+quiet.example * inline-script block
+* tracker.example * noop
+this is not a rule
+* other.example image block
+";
+
+    fn rules() -> DynamicRules {
+        DynamicRules::from_text(MINE)
+    }
+
+    #[test]
+    fn rules_are_read_and_bad_lines_are_named() {
+        assert_eq!(rules().len(), 10);
+        assert_eq!(DynamicRules::problems(MINE), vec!["this is not a rule", "* other.example image block"]);
+    }
+
+    #[test]
+    fn a_named_destination_comes_first() {
+        let r = rules();
+        assert_eq!(r.evaluate("blog.example", "ads.example", "image", true), Action::Block);
+        assert_eq!(r.evaluate("blog.example", "x.ads.example", "script", true), Action::Block);
+        // the source's own rule for the destination before the general type rule
+        assert_eq!(r.evaluate("news.example", "cdn.example", "script", true), Action::Allow);
+        assert_eq!(r.evaluate("www.news.example", "img.cdn.example", "script", true), Action::Allow);
+    }
+
+    #[test]
+    fn third_party_scripts_and_frames_and_their_exceptions() {
+        let r = rules();
+        assert_eq!(r.evaluate("blog.example", "lib.example", "script", true), Action::Block);
+        assert_eq!(r.evaluate("blog.example", "lib.example", "subdocument", true), Action::Block);
+        assert_eq!(r.evaluate("blog.example", "blog.example", "script", false), Action::None);
+        assert_eq!(r.evaluate("news.example", "lib.example", "script", true), Action::Noop);
+        // a noop for a destination stops the rules, the lists decide
+        assert_eq!(r.evaluate("blog.example", "tracker.example", "script", true), Action::Noop);
+    }
+
+    #[test]
+    fn party_type_and_every_type() {
+        let r = rules();
+        // shop.example: every third-party request blocked, except its payment host
+        assert_eq!(r.evaluate("shop.example", "fonts.example", "font", true), Action::Block);
+        assert_eq!(r.evaluate("shop.example", "pay.example", "script", true), Action::Allow);
+        assert_eq!(r.evaluate("shop.example", "shop.example", "font", false), Action::None);
+        // images: as in uBlock Origin, the third-party rule of the source comes before the rule for images
+        assert_eq!(r.evaluate("shop.example", "img.example", "image", true), Action::Block);
+        assert_eq!(r.evaluate("blog.example", "img.example", "image", true), Action::Allow);
+    }
+
+    #[test]
+    fn inline_scripts() {
+        let r = rules();
+        assert!(r.blocks_inline_scripts("quiet.example"));
+        assert!(r.blocks_inline_scripts("www.quiet.example"));
+        assert!(!r.blocks_inline_scripts("blog.example"));
+    }
+
+    #[test]
+    fn no_rules_say_nothing() {
+        let r = DynamicRules::from_text("");
+        assert_eq!(r.evaluate("blog.example", "ads.example", "script", true), Action::None);
+        assert!(!r.blocks_inline_scripts("blog.example"));
+        assert_eq!(rules().evaluate("blog.example", "", "script", true), Action::None);
+    }
+
+    #[test]
+    fn hosts_are_checked_and_written_in_lower_case() {
+        let r = DynamicRules::from_text("* ADS.Example * block\n* bad..host * block\n* x * maybe\n");
+        assert_eq!(r.len(), 1);
+        assert_eq!(r.evaluate("a.example", "ads.example", "script", true), Action::Block);
+    }
+
+    #[test]
+    fn the_grid_shows_set_and_inherited_cells() {
+        let r = rules();
+        // set in exactly this cell
+        assert_eq!(r.cell_state("news.example", "cdn.example", "*"), (Action::Allow, true));
+        assert_eq!(r.cell_state("*", "*", "3p-script"), (Action::Block, true));
+        // from a broader source or destination: shown light
+        assert_eq!(r.cell_state("blog.example", "ads.example", "*"), (Action::Block, false));
+        assert_eq!(r.cell_state("blog.example", "x.ads.example", "*"), (Action::Block, false));
+        assert_eq!(r.cell_state("www.news.example", "*", "3p-script"), (Action::Noop, false));
+        assert_eq!(r.cell_state("blog.example", "*", "3p-frame"), (Action::Block, false));
+        // nothing, a type named with a destination, an unknown type
+        assert_eq!(r.cell_state("blog.example", "plain.example", "*"), (Action::None, false));
+        assert_eq!(r.cell_state("blog.example", "ads.example", "image"), (Action::None, false));
+        assert_eq!(r.cell_state("blog.example", "*", "font"), (Action::None, false));
+    }
+
+    #[test]
+    fn a_cell_is_set_and_removed_and_the_rest_is_kept() {
+        let text = "# mine\n* * 3p-script block\nshop.example pay.example * allow\n";
+        let set = with_cell(text, "Shop.example", "pay.example", "*", Action::Block);
+        assert_eq!(set, "# mine\n* * 3p-script block\nshop.example pay.example * block\n");
+        let removed = with_cell(&set, "shop.example", "pay.example", "*", Action::None);
+        assert_eq!(removed, "# mine\n* * 3p-script block\n");
+        let typed = with_cell(&removed, "*", "*", "3p-script", Action::Noop);
+        assert_eq!(typed, "# mine\n* * 3p-script noop\n");
+        // not a cell a rule can name: unchanged
+        for (s, d, k) in [("a..b", "*", "*"), ("*", "pay.example", "image"), ("*", "*", "font"), ("", "*", "*")] {
+            assert_eq!(with_cell(text, s, d, k, Action::Block), text, "{s} {d} {k}");
+        }
+        // no newline at the end, and a line that is not a rule, are kept
+        assert_eq!(with_cell("x y\n* a.example * allow", "*", "b.example", "*", Action::Block),
+                   "x y\n* a.example * allow\n* b.example * block\n");
+    }
+
+    #[test]
+    fn the_padlock_and_the_eraser_copy_only_the_cells_of_the_page() {
+        let permanent = "# kept\n* * 3p-frame block\nother.example * 3p block\n";
+        let session = "# kept\n* * 3p-frame block\nother.example * 3p allow\nnews.example ads.example * block\n\
+                       * cdn.example * allow\nnews.example * image block\nnews.example far.example * block\n";
+        let hosts = vec!["ads.example".to_string(), "cdn.example".to_string()];
+        let saved = copy_cells(session, permanent, "news.example", &hosts);
+        let s = DynamicRules::from_text(&saved);
+        assert_eq!(s.cell("news.example", "ads.example", 0), Action::Block);
+        assert_eq!(s.cell("*", "cdn.example", 0), Action::Allow);
+        assert_eq!(s.cell("news.example", "*", 5), Action::Block);
+        // not of this page: neither another site's rule nor a host the page did not ask
+        assert_eq!(s.cell("other.example", "*", 1), Action::Block);
+        assert_eq!(s.cell("news.example", "far.example", 0), Action::None);
+        assert!(saved.starts_with("# kept\n"));
+        // nothing differs any more: unchanged
+        assert_eq!(copy_cells(session, &saved, "news.example", &hosts), saved);
+        // the eraser: the session as the permanent rules for this page, other sites as they were
+        let reverted = copy_cells(permanent, session, "news.example", &hosts);
+        let r = DynamicRules::from_text(&reverted);
+        assert_eq!(r.cell("news.example", "ads.example", 0), Action::None);
+        assert_eq!(r.cell("*", "cdn.example", 0), Action::None);
+        assert_eq!(r.cell("other.example", "*", 1), Action::Allow);
+        assert_eq!(r.cell("news.example", "far.example", 0), Action::Block);
+    }
+
+    #[test]
+    fn the_last_rule_for_a_cell_wins() {
+        let r = DynamicRules::from_text("* * 3p-script block\n* * 3p-script allow\n");
+        assert_eq!(r.len(), 1);
+        assert_eq!(r.evaluate("a.example", "b.example", "script", true), Action::Allow);
+    }
+}
