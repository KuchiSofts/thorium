+// --- Backup, restore, reset (as uBlock Origin's) ---
+const BACKUP_FORMAT = 'thoron-adblock-backup';
+const SETTING_DEFAULTS = {badge: true, prefetch: false, 'hyperlink-auditing': false, webrtc: false,
+                          'block-csp-reports': false, 'default-cosmetic': false, 'default-media': false,
+                          'default-fonts': false, javascript: false, 'ignore-generic': false,
+                          'default-3p-script': false, 'default-3p-frame': false, 'auto-update': true,
+                          'context-menu': true, advanced: true, 'media-kb': 50};
+// a setting as the backup keeps it: a number for the one that is a number, else on or off
+const asSetting = (name, value) => (typeof SETTING_DEFAULTS[name] === 'number' ? Number(value) : !!value);
+
+async function makeBackup() {
+  const [state, sites, settings] = await Promise.all(
+      [sendWithPromise('getState'), sendWithPromise('getSites'), sendWithPromise('getSettings')]);
+  const switches = {};
+  for (const {host, names} of sites.switches) {
+    switches[host] = names;
+  }
+  return {
+    format: BACKUP_FORMAT,
+    version: 1,
+    created: new Date().toISOString(),
+    lists: {
+      disabled: state.lists.filter((l) => l.builtin && !l.enabled).map((l) => l.id),
+      added: state.lists.filter((l) => !l.builtin).map((l) => l.url),
+    },
+    myFilters: state.myFilters,
+    myRules: await sendWithPromise('getMyRules'),
+    allowed: sites.allowed,
+    switches,
+    settings: Object.fromEntries(Object.keys(SETTING_DEFAULTS).map((name) => [name, asSetting(name, settings[name])])),
+  };
+}
+
+// The checked parts of a backup; anything else is left out. Throws for a file that is not one.
+function readBackup(data) {
+  if (!data || data.format !== BACKUP_FORMAT || data.version !== 1) {
+    throw new Error('This file is not a backup of Thoron\'s ad blocking.');
+  }
+  const strings = (list) => (Array.isArray(list) ? list.filter((x) => typeof x === 'string') : []);
+  const switches = {};
+  if (data.switches && typeof data.switches === 'object') {
+    for (const [host, names] of Object.entries(data.switches)) {
+      switches[host] = strings(names);
+    }
+  }
+  const settings = {};
+  for (const name of Object.keys(SETTING_DEFAULTS)) {
+    const value = data.settings ? data.settings[name] : undefined;
+    if (typeof value === typeof SETTING_DEFAULTS[name] &&
+        (typeof value !== 'number' || (Number.isInteger(value) && value >= 1 && value <= 1048576))) {
+      settings[name] = value;
+    }
+  }
+  return {
+    disabled: new Set(strings(data.lists && data.lists.disabled)),
+    added: strings(data.lists && data.lists.added).filter((url) => url.startsWith('https://')),
+    myFilters: typeof data.myFilters === 'string' ? data.myFilters : '',
+    myRules: typeof data.myRules === 'string' ? data.myRules : '',
+    allowed: strings(data.allowed),
+    switches,
+    settings,
+  };
+}
+
+// Makes everything as `wanted` has it, one change at a time; the problems, if any.
+async function apply(wanted) {
+  const problems = [];
+  const step = async (name, ...args) => {
+    const error = await sendWithPromise(name, ...args);
+    if (error) {
+      problems.push(error);
+    }
+  };
+  for (const [name, on] of Object.entries(wanted.settings)) {
+    await step('setSetting', name, on);
+  }
+  const state = await sendWithPromise('getState');
+  for (const list of state.lists) {
+    if (list.builtin && list.enabled === wanted.disabled.has(list.id)) {
+      await step('setListEnabled', list.id, !wanted.disabled.has(list.id));
+    } else if (!list.builtin && !wanted.added.includes(list.url)) {
+      await step('removeList', list.id);
+    }
+  }
+  const have = new Set(state.lists.filter((l) => !l.builtin).map((l) => l.url));
+  for (const url of wanted.added) {
+    if (!have.has(url)) {
+      await step('addList', url);
+    }
+  }
+  if (state.myFilters !== wanted.myFilters) {
+    await step('setMyFilters', wanted.myFilters);
+  }
+  if ((await sendWithPromise('getMyRules')) !== wanted.myRules) {
+    await sendWithPromise('setMyRules', wanted.myRules);
+  }
+  const sites = await sendWithPromise('getSites');
+  for (const pattern of sites.allowed) {
+    if (!wanted.allowed.includes(pattern)) {
+      await sendWithPromise('forgetSite', pattern);
+    }
+  }
+  for (const pattern of wanted.allowed) {
+    if (!sites.allowed.includes(pattern)) {
+      await step('allowPattern', pattern);
+    }
+  }
+  for (const {host} of sites.switches) {
+    if (!(host in wanted.switches)) {
+      await sendWithPromise('clearSwitches', host);
+    }
+  }
+  for (const [host, names] of Object.entries(wanted.switches)) {
+    await step('setHostSwitches', host, names);
+  }
+  return problems;
+}
+
+async function finish(problems, done) {
+  await refresh();
+  await showSettings();
+  await refreshSites();
+  if (problems.length) {
+    say(`${done} Some parts could not be: ${problems.join(' ')}`, true);
+  } else {
+    say(done);
+  }
+}
