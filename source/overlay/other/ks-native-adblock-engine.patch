+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_PICKER_H_
+#define COMPONENTS_THORON_ADBLOCK_PICKER_H_
+
+#include <string>
+
+#include "content/public/browser/global_routing_id.h"
+#include "url/gurl.h"
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace thoron_adblock {
+
+// Starts the element picker (or with `zapper` the zapper) in the page of
+// `tab` (picker.js, in the isolated world of the procedural runner). Does
+// nothing for a tab that shows no web page.
+void StartPicker(content::WebContents* tab, bool zapper);
+
+// The picker on the element at (x, y), in CSS pixels of the page's viewport:
+// the page's context menu ("Block element...") opens its panel at once.
+void StartPickerAt(content::WebContents* tab, int x, int y);
+
+// The rule the picker in `frame` made, before it is added to "My filters":
+// accepted only from a page the person opened the picker in during the last
+// ten minutes (once per opening), only as one line of at most 2,000
+// characters, and only as a hide rule for that page's own site or a rule that
+// blocks an address. Returns the rule to add, or an empty string.
+std::string AcceptPickedRule(content::RenderFrameHost& frame,
+                             const std::string& rule);
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_PICKER_H_
diff --git a/components/thoron_adblock/picker.js b/components/thoron_adblock/picker.js
new file mode 100644
index 0000000000000000000000000000000000000000..85c1cfde2c6da4169e22f414dcd10aa4b3d2ec17
--- /dev/null
+++ b/components/thoron_adblock/picker.js
@@ -0,0 +1,350 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Thoron's element picker and zapper, started from the ad blocking menu. It runs in the same isolated
+// world as the procedural runner (procedural.js), so a page cannot reach it or replace the DOM functions
+// it uses. Its own parts live in a closed shadow tree; nothing it draws is styled by the page.
+//
+//   picker  hover shows the element; a click picks it; the panel offers rules for it, from specific to
+//           general (and the address of an image or frame); "Create" hands the chosen rule to the
+//           browser, which adds it to "My filters" (thoronPickerDone, given to this world by the
+//           browser); Esc or "Cancel" ends.
+//   zapper  hover shows the element; a click takes it out of the page until it is loaded again; Esc
+//           or the button ends.
+//
+// The browser sends this file followed by ("picker") or ("zapper"); from the page's context menu by ("picker",
+// {x, y}), the point that was clicked, whose element the panel opens on at once.
+(function(mode, at) {
+  'use strict';
+  if (window.__thoronPicker) {
+    window.__thoronPicker();
+  }
+  const doc = document;
+  const host = location.hostname;
+  const zapper = mode === 'zapper';
+
+  const box = doc.createElement('div');
+  box.style.cssText = 'all: initial; position: fixed; inset: 0; z-index: 2147483647; pointer-events: none;';
+  const root = box.attachShadow({mode: 'closed'});
+  const style = doc.createElement('style');
+  style.textContent = `
+    :host { all: initial; }
+    .mark { position: fixed; pointer-events: none; border: 2px solid #f3a; background: rgba(255,50,150,.18);
+            border-radius: 2px; transition: all .05s; display: none; }
+    .mark.locked { border-color: #a78bfa; background: rgba(167,139,250,.22); }
+    .panel { position: fixed; right: 16px; bottom: 16px; width: 420px; max-width: calc(100vw - 32px);
+             pointer-events: auto; font: 13px/1.4 system-ui, sans-serif; color: #e8eaed; background: #202124;
+             border: 1px solid #3c4043; border-radius: 12px; box-shadow: 0 8px 28px rgba(0,0,0,.45);
+             padding: 12px 14px; box-sizing: border-box; }
+    .panel h1 { font-size: 14px; font-weight: 600; margin: 0 0 6px; }
+    .panel p { margin: 0 0 8px; color: #9aa0a6; }
+    .panel textarea { width: 100%; box-sizing: border-box; min-height: 54px; resize: vertical; font: 12px/1.4 monospace;
+                      color: #e8eaed; background: #171717; border: 1px solid #3c4043; border-radius: 8px; padding: 6px; }
+    .panel ol { list-style: none; margin: 6px 0; padding: 0; max-height: 132px; overflow: auto; }
+    .panel li { font: 12px monospace; padding: 3px 6px; border-radius: 6px; cursor: pointer; overflow-wrap: anywhere; }
+    .panel li:hover { background: #303134; }
+    .panel li.on { background: #3b2f63; }
+    .row { display: flex; gap: 8px; align-items: center; margin-top: 8px; }
+    .row .count { color: #9aa0a6; margin-right: auto; }
+    button { font: inherit; border-radius: 16px; padding: 6px 14px; border: 1px solid #5f6368; background: transparent;
+             color: #e8eaed; cursor: pointer; }
+    button.main { background: #a78bfa; border-color: #a78bfa; color: #1b1036; }
+    button:disabled { opacity: .45; cursor: default; }
+    .hint { position: fixed; left: 50%; top: 12px; transform: translateX(-50%); pointer-events: auto;
+            font: 13px system-ui, sans-serif; color: #e8eaed; background: #202124; border: 1px solid #3c4043;
+            border-radius: 18px; padding: 6px 8px 6px 14px; display: flex; gap: 10px; align-items: center;
+            box-shadow: 0 4px 16px rgba(0,0,0,.4); }`;
+  root.append(style);
+  const mark = doc.createElement('div');
+  mark.className = 'mark';
+  root.append(mark);
+  const hint = doc.createElement('div');
+  hint.className = 'hint';
+  const hintText = doc.createElement('span');
+  hintText.textContent = zapper ? 'Click an element to remove it. Esc to stop.'
+                                : 'Click the element to block. Esc to stop.';
+  const stopButton = doc.createElement('button');
+  stopButton.textContent = 'Stop';
+  hint.append(hintText, stopButton);
+  root.append(hint);
+  (doc.documentElement || doc).append(box);
+
+  let hovered = null;
+  let picked = null;
+  let panel = null;
+  const previewed = new Map();
+
+  // (an event's path ends with the document and the window, which are not nodes inside the box)
+  const ours = (node) => node === box || (node instanceof Node && box.contains(node));
+  const show = (element, locked) => {
+    if (!element) {
+      mark.style.display = 'none';
+      return;
+    }
+    const r = element.getBoundingClientRect();
+    Object.assign(mark.style, {display: 'block', left: r.left + 'px', top: r.top + 'px',
+                               width: Math.max(r.width, 2) + 'px', height: Math.max(r.height, 2) + 'px'});
+    mark.classList.toggle('locked', !!locked);
+  };
+  const target = (event) => {
+    const element = doc.elementFromPoint(event.clientX, event.clientY);
+    return element && !ours(element) && element !== doc.documentElement && element !== doc.body ? element : null;
+  };
+
+  // --- rules for an element ---
+  const plain = (name) => /^[A-Za-z_][\w-]*$/.test(name) && !/\d{5,}/.test(name) && name.length <= 60;
+  const esc = (text) => CSS.escape(text);
+  const compound = (element) => {
+    if (element.id && plain(element.id)) {
+      return '#' + esc(element.id);
+    }
+    let selector = element.localName;
+    const classes = Array.from(element.classList).filter(plain).slice(0, 3);
+    if (classes.length) {
+      selector += classes.map((c) => '.' + esc(c)).join('');
+    } else {
+      for (const name of ['src', 'href', 'alt', 'title', 'data-ad', 'aria-label']) {
+        const value = element.getAttribute(name);
+        if (value && value.length <= 120 && !/["\\\n]/.test(value)) {
+          selector += `[${name}="${value}"]`;
+          break;
+        }
+      }
+    }
+    return selector;
+  };
+  const count = (selector) => {
+    try {
+      return doc.querySelectorAll(selector).length;
+    } catch (e) {
+      return 0;
+    }
+  };
+  const candidates = (element) => {
+    const out = [];
+    const src = element.currentSrc || element.src;
+    if (typeof src === 'string' && /^https?:/.test(src)) {
+      try {
+        const url = new URL(src);
+        out.push(`||${url.hostname}${url.pathname}^`);
+      } catch (e) {
+        // not an address
+      }
+    }
+    const chain = [];
+    for (let e = element; e && e !== doc.body && e !== doc.documentElement && chain.length < 6; e = e.parentElement) {
+      chain.push(e);
+    }
+    // the element itself, then each element around it, then a path with ">" for the element
+    for (const e of chain) {
+      out.push(`${host}##${compound(e)}`);
+    }
+    if (chain.length > 1) {
+      out.splice(out.length - chain.length + 1, 0,
+                 `${host}##${compound(chain[1])} > ${compound(chain[0])}`);
+    }
+    return Array.from(new Set(out));
+  };
+  const selectorOf = (rule) => {
+    const at = rule.indexOf('##');
+    return at >= 0 ? rule.slice(at + 2) : '';
+  };
+
+  // --- preview ---
+  const unpreview = () => {
+    for (const [element, value] of previewed) {
+      element.style.setProperty('display', value.value, value.priority);
+      if (!value.value) {
+        element.style.removeProperty('display');
+      }
+    }
+    previewed.clear();
+  };
+  const preview = (rule) => {
+    unpreview();
+    const selector = selectorOf(rule);
+    if (!selector) {
+      return;
+    }
+    let found = [];
+    try {
+      found = Array.from(doc.querySelectorAll(selector));
+    } catch (e) {
+      return;
+    }
+    for (const element of found) {
+      if (ours(element)) {
+        continue;
+      }
+      previewed.set(element, {value: element.style.getPropertyValue('display'),
+                              priority: element.style.getPropertyPriority('display')});
+      element.style.setProperty('display', 'none', 'important');
+    }
+  };
+
+  // --- the panel ---
+  const openPanel = (element) => {
+    picked = element;
+    show(element, true);
+    hint.style.display = 'none';
+    const list = candidates(element);
+    panel = doc.createElement('div');
+    panel.className = 'panel';
+    const title = doc.createElement('h1');
+    title.textContent = 'Block element';
+    const about = doc.createElement('p');
+    about.textContent = 'Choose a rule, or edit it. It is added to My filters on chrome://adblock.';
+    const text = doc.createElement('textarea');
+    text.spellcheck = false;
+    text.value = list.find((r) => r.includes('##')) || list[0] || '';
+    const options = doc.createElement('ol');
+    const counter = doc.createElement('span');
+    counter.className = 'count';
+    const update = () => {
+      const selector = selectorOf(text.value.trim());
+      const n = selector ? count(selector) : null;
+      counter.textContent = n === null ? 'Blocks the address' : n === 1 ? '1 element' : `${n} elements`;
+      for (const item of options.children) {
+        item.classList.toggle('on', item.textContent === text.value.trim());
+      }
+      create.disabled = !text.value.trim() || text.value.includes('\n') || text.value.length > 2000;
+    };
+    for (const rule of list) {
+      const item = doc.createElement('li');
+      item.textContent = rule;
+      item.addEventListener('click', () => {
+        text.value = rule;
+        update();
+        if (previewOn) {
+          preview(rule);
+        }
+      });
+      options.append(item);
+    }
+    let previewOn = false;
+    const previewButton = doc.createElement('button');
+    previewButton.textContent = 'Preview';
+    previewButton.addEventListener('click', () => {
+      previewOn = !previewOn;
+      previewButton.textContent = previewOn ? 'Stop preview' : 'Preview';
+      if (previewOn) {
+        show(null);
+        preview(text.value.trim());
+      } else {
+        unpreview();
+        show(picked, true);
+      }
+    });
+    const cancel = doc.createElement('button');
+    cancel.textContent = 'Cancel';
+    cancel.addEventListener('click', stop);
+    const create = doc.createElement('button');
+    create.className = 'main';
+    create.textContent = 'Create';
+    create.addEventListener('click', () => {
+      const rule = text.value.trim();
+      if (!rule || rule.includes('\n') || rule.length > 2000) {
+        return;
+      }
+      if (typeof thoronPickerDone === 'function') {
+        thoronPickerDone(rule);
+      }
+      // the rule is in use at once in the browser; on this page it hides what it matches now
+      preview(rule);
+      previewed.clear();
+      stop();
+    });
+    text.addEventListener('input', () => {
+      update();
+      if (previewOn) {
+        preview(text.value.trim());
+      }
+    });
+    // Enter creates the rule (a rule is one line); Shift+Enter is not needed
+    text.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter') {
+        event.preventDefault();
+        if (!create.disabled) {
+          create.click();
+        }
+      }
+    });
+    const row = doc.createElement('div');
+    row.className = 'row';
+    row.append(counter, previewButton, cancel, create);
+    panel.append(title, about, text, options, row);
+    root.append(panel);
+    update();
+    text.focus();
+  };
+
+  // --- events, caught before the page sees them ---
+  const onMove = (event) => {
+    if (picked) {
+      return;
+    }
+    hovered = target(event);
+    show(hovered, false);
+  };
+  const onClick = (event) => {
+    if (ours(event.target) || event.composedPath().some(ours)) {
+      return;
+    }
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    if (picked) {
+      return;
+    }
+    const element = target(event);
+    if (!element) {
+      return;
+    }
+    if (zapper) {
+      element.remove();
+      show(null);
+    } else {
+      openPanel(element);
+    }
+  };
+  const swallow = (event) => {
+    if (!ours(event.target) && !event.composedPath().some(ours)) {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+    }
+  };
+  const onKey = (event) => {
+    if (event.key === 'Escape') {
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      stop();
+    } else if (zapper && (event.key === 'Delete' || event.key === 'Backspace') && hovered) {
+      event.preventDefault();
+      hovered.remove();
+      hovered = null;
+      show(null);
+    }
+  };
+  const listeners = [['mousemove', onMove], ['click', onClick], ['mousedown', swallow], ['mouseup', swallow],
+                     ['pointerdown', swallow], ['pointerup', swallow], ['auxclick', swallow], ['keydown', onKey]];
+  for (const [type, handler] of listeners) {
+    addEventListener(type, handler, true);
+  }
+  stopButton.addEventListener('click', () => stop());
+
+  function stop() {
+    for (const [type, handler] of listeners) {
+      removeEventListener(type, handler, true);
+    }
+    unpreview();
+    box.remove();
+    window.__thoronPicker = null;
+  }
+  window.__thoronPicker = stop;
+
+  if (!zapper && at && Number.isFinite(at.x) && Number.isFinite(at.y)) {
+    const element = target({clientX: at.x, clientY: at.y});
+    if (element) {
+      openPanel(element);
+    }
+  }
+})
diff --git a/components/thoron_adblock/popup.rs b/components/thoron_adblock/popup.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bb5e6c8789e8a4e07c5d7069027b5132087dca17
--- /dev/null
+++ b/components/thoron_adblock/popup.rs
@@ -0,0 +1,183 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `$popup`: rules for the windows and tabs a page opens. adblock-rust does not read the option and
+//! leaves such rules out, so the lists' pop-up rules would be lost (EasyList has thousands, and
+//! uBlock Origin's `$all`, which its badware list uses, covers pop-ups too). They are read here:
+//! each becomes a `$document` rule in a small engine of its own, which is only asked about a new
+//! window: its address, and the page that opens it. As in uBlock Origin, a rule without `$popup`
+//! or `$all` never blocks a pop-up.
+
+use crate::header::{options_start, small_engine, split_options};
+use adblock::lists::{parse_filter, ParseOptions, ParsedLine};
+use adblock::request::Request;
+
+/// Options a pop-up rule keeps as they are: who opens the window (`domain=`, `from=`,
+/// `denyallow=`), whether it is on another site, and how the rule weighs.
+const KEPT: &[&str] = &[
+    "3p", "third-party", "~3p", "~third-party", "1p", "first-party", "~1p", "~first-party", "important",
+    "match-case", "badfilter",
+];
+
+/// Request types: a rule for one of them besides pop-ups is for the main engine there. Here only
+/// its pop-up part counts.
+const OTHER_TYPES: &[&str] = &[
+    "script", "xhr", "xmlhttprequest", "frame", "subdocument", "image", "css", "stylesheet", "font",
+    "media", "object", "object-subrequest", "other", "ping", "beacon", "websocket", "doc", "document",
+    "inline-script", "inline-font",
+];
+
+fn is_cosmetic(line: &str) -> bool {
+    ["##", "#@#", "#?#", "#$#", "#%#", "#@"].iter().any(|mark| line.contains(mark))
+}
+
+/// The `$document` rule the small engine reads for a pop-up rule of a list. `None` for every other
+/// line and for a rule that is not understood in full.
+fn rewrite(line: &str) -> Option<String> {
+    let line = line.trim();
+    if line.is_empty() || line.starts_with('!') || line.starts_with('[') || is_cosmetic(line) {
+        return None;
+    }
+    let dollar = options_start(line)?;
+    let mut for_popups = false;
+    let mut kept = Vec::new();
+    for option in split_options(&line[dollar + 1..]) {
+        let option = option.trim();
+        let name = option.split_once('=').map_or(option, |(name, _)| name);
+        match name {
+            "popup" | "all" if name == option => for_popups = true,
+            "domain" | "from" | "denyallow" if name != option => kept.push(option.to_string()),
+            _ if KEPT.contains(&option) => kept.push(option.to_string()),
+            _ if name == option && OTHER_TYPES.contains(&option.strip_prefix('~').unwrap_or(option)) => {}
+            // "~popup", "popunder", a value this file does not read, an option that changes what a
+            // match does ("redirect=", "csp="...): the rule is left out
+            _ => return None,
+        }
+    }
+    if !for_popups {
+        return None;
+    }
+    let mut filter = format!("{}$document", &line[..dollar]);
+    for option in &kept {
+        filter.push(',');
+        filter.push_str(option);
+    }
+    // adblock-rust must read it as written
+    matches!(parse_filter(&filter, false, ParseOptions::default()), Ok(ParsedLine::Network(_))).then_some(filter)
+}
+
+/// Every pop-up rule of the lists.
+#[derive(Default)]
+pub struct PopupRules {
+    engine: Option<adblock::Engine>,
+    /// The rules as the lists wrote them, one per line: what is saved with the engine.
+    pub text: String,
+}
+
+impl PopupRules {
+    /// From list text; every line that is not a pop-up rule is skipped.
+    pub fn from_rules(rules: &str) -> PopupRules {
+        let mut filters = Vec::new();
+        let mut text = String::new();
+        for line in rules.lines().filter(|l| l.contains("popup") || l.contains("all")) {
+            if let Some(filter) = rewrite(line) {
+                text.push_str(line.trim());
+                text.push('\n');
+                filters.push(filter);
+            }
+        }
+        PopupRules { engine: small_engine(&filters), text }
+    }
+
+    /// True when the lists block the window or tab that the page at `opener_url` opens at `url`.
+    pub fn blocks(&self, url: &str, opener_url: &str) -> bool {
+        let Some(engine) = &self.engine else { return false };
+        let Ok(request) = Request::new(url, opener_url, "document", "GET") else { return false };
+        engine.check_network_request(&request).should_block()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const LISTS: &str = "\
+||ads.example^$popup
+||bad.example^$all
+/earn.php?z=$popup,subdocument
+*$popup,3p,domain=news.example
+||promo.example^$popup,domain=shop.example|~deals.shop.example
+@@||ads.example/fine^$popup
+||script.example^$script
+||under.example^$popunder
+||never.example^$~popup,all
+||redirected.example^$popup,redirect=noop.js
+example.com##.popup
+||csp.example^$popup,csp=script-src 'none'
+";
+
+    fn rules() -> PopupRules {
+        PopupRules::from_rules(LISTS)
+    }
+
+    #[test]
+    fn popup_and_all_rules_block_a_new_window() {
+        let rules = rules();
+        assert!(rules.blocks("https://ads.example/x", "https://site.example/"));
+        assert!(rules.blocks("https://bad.example/", "https://site.example/"));
+        assert!(rules.blocks("https://anything.example/earn.php?z=1", "https://site.example/"));
+        assert!(!rules.blocks("https://plain.example/", "https://site.example/"));
+    }
+
+    #[test]
+    fn a_rule_without_popup_never_blocks_a_window() {
+        let rules = rules();
+        assert!(!rules.blocks("https://script.example/", "https://site.example/"));
+        assert!(!rules.blocks("https://under.example/", "https://site.example/"));
+        assert!(!rules.blocks("https://never.example/", "https://site.example/"));
+        assert!(!rules.blocks("https://redirected.example/", "https://site.example/"));
+        assert!(!rules.blocks("https://csp.example/", "https://site.example/"));
+    }
+
+    #[test]
+    fn the_page_that_opens_the_window_decides_domain_and_third_party() {
+        let rules = rules();
+        assert!(rules.blocks("https://other.example/", "https://news.example/a"));
+        assert!(!rules.blocks("https://news.example/b", "https://news.example/a"));
+        assert!(!rules.blocks("https://other.example/", "https://blog.example/"));
+        assert!(rules.blocks("https://promo.example/", "https://shop.example/"));
+        assert!(!rules.blocks("https://promo.example/", "https://deals.shop.example/"));
+        assert!(!rules.blocks("https://promo.example/", "https://site.example/"));
+    }
+
+    #[test]
+    fn an_exception_lets_a_window_open() {
+        let rules = rules();
+        assert!(!rules.blocks("https://ads.example/fine", "https://site.example/"));
+        assert!(rules.blocks("https://ads.example/other", "https://site.example/"));
+    }
+
+    #[test]
+    fn badfilter_cancels_a_popup_rule() {
+        let rules = PopupRules::from_rules("||ads.example^$popup\n||ads.example^$popup,badfilter\n");
+        assert!(!rules.blocks("https://ads.example/", "https://site.example/"));
+    }
+
+    #[test]
+    fn only_the_rules_read_are_kept_as_text() {
+        let rules = rules();
+        assert_eq!(rules.text.lines().count(), 6);
+        assert!(!rules.text.contains("script.example"));
+        assert!(!rules.text.contains("##"));
+        // what is saved builds the same rules again
+        let again = PopupRules::from_rules(&rules.text);
+        assert_eq!(again.text, rules.text);
+        assert!(again.blocks("https://ads.example/x", "https://site.example/"));
+    }
+
+    #[test]
+    fn no_rules_and_bad_addresses_block_nothing() {
+        assert!(!PopupRules::from_rules("").blocks("https://ads.example/", "https://site.example/"));
+        assert!(!rules().blocks("not a url", "https://site.example/"));
+    }
+}
diff --git a/components/thoron_adblock/popup_page.html b/components/thoron_adblock/popup_page.html
new file mode 100644
index 0000000000000000000000000000000000000000..0422887d918d1a79911da9537619601d65245a2a
--- /dev/null
+++ b/components/thoron_adblock/popup_page.html
@@ -0,0 +1,206 @@
+<!doctype html>
+<!-- Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+     found in the LICENSE file. -->
+<!-- The menu of Thoron's built-in ad blocking: what the shield button in the toolbar opens. Like
+     uBlock Origin's popup: the switch for the site, what was blocked, the tools and the per-site
+     switches. The text is set by popup_page.js; nothing here comes from a web page. -->
+<html lang="en" dir="ltr">
+<head>
+<meta charset="utf-8">
+<meta name="color-scheme" content="light dark">
+<title>Ad blocking</title>
+<style>
+  @import url(chrome://resources/css/text_defaults_md.css);
+  :root {
+    --line: color-mix(in srgb, currentColor 14%, transparent);
+    --soft: color-mix(in srgb, currentColor 60%, transparent);
+    --accent: #7235da;
+    --on: #1e8e3e;
+    --off: #9aa0a6;
+    --switch-on: #1a73e8;
+  }
+  @media (prefers-color-scheme: dark) {
+    :root { --accent: #b097fa; --on: #81c995; --switch-on: #8ab4f8; }
+  }
+  html, body { margin: 0; }
+  body { inline-size: 320px; font-size: 13px; user-select: none; }
+  header {
+    display: flex; align-items: center; gap: 8px; padding: 12px 14px 8px;
+    border-block-end: 1px solid var(--line);
+  }
+  header svg { flex: none; }
+  header .name { font-weight: 600; }
+  header .site { margin-inline-start: auto; color: var(--soft); overflow: hidden; text-overflow: ellipsis;
+                 white-space: nowrap; max-inline-size: 190px; }
+  #power-box { display: flex; flex-direction: column; align-items: center; padding: 14px 14px 6px; }
+  #power {
+    inline-size: 84px; block-size: 84px; border-radius: 50%; border: 2px solid var(--line);
+    background: transparent; color: var(--on); cursor: pointer; display: grid; place-items: center;
+    transition: color .15s, border-color .15s;
+  }
+  #power[aria-pressed=false] { color: var(--off); }
+  #power:disabled { cursor: default; opacity: .45; }
+  #power:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+  #state { margin: 8px 0 0; text-align: center; color: var(--soft); min-block-size: 18px; }
+  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 8px 14px 12px; }
+  .stat { text-align: center; border: 1px solid var(--line); border-radius: 10px; padding: 8px 4px; }
+  .stat b { display: block; font-size: 18px; font-weight: 600; }
+  .stat b small { font-size: 12px; font-weight: 400; opacity: 0.7; }
+  .stat > span { display: block; color: var(--soft); font-size: 11px; line-height: 1.3; }
+  .row { display: flex; justify-content: space-between; gap: 6px; padding: 8px 14px;
+         border-block-start: 1px solid var(--line); }
+  .tool, .switch {
+    flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 6px 2px;
+    border: 0; border-radius: 8px; background: transparent; color: inherit; cursor: pointer; font: inherit;
+    font-size: 11px;
+  }
+  .tool:hover, .switch:hover { background: var(--line); }
+  .tool:disabled, .switch:disabled { opacity: .4; cursor: default; background: transparent; }
+  .switch[aria-pressed=true] { color: var(--switch-on); }
+  .switch[aria-pressed=true] svg { stroke: var(--switch-on); }
+  .caption { color: var(--soft); font-size: 11px; padding: 6px 14px 0; }
+  details { border-block-start: 1px solid var(--line); padding: 8px 14px 12px; }
+  summary { cursor: pointer; color: var(--soft); }
+  ol { margin: 6px 0 0; padding: 0; list-style: none; max-block-size: 180px; overflow-y: auto; }
+  li { display: flex; justify-content: space-between; gap: 8px; padding: 3px 0; }
+  li .host { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  li .n { color: var(--soft); font-variant-numeric: tabular-nums; }
+  svg { stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+  /* uBlock Origin's grid of rules: a row per type and per domain, a cell for every site and one for
+     this site; a rule set in that cell is shown strong, one from a broader rule light */
+  :root { --allow: #1e8e3e; --block: #d93025; --noop: #80868b; --on-set: #fff; }
+  @media (prefers-color-scheme: dark) {
+    :root { --allow: #81c995; --block: #f28b82; --noop: #9aa0a6; --on-set: #202124; }
+  }
+  #grid-box[hidden] { display: none; }
+  #grid-changed { color: var(--block); }
+  .grid-head, .grid-row { display: grid; grid-template-columns: minmax(0, 1fr) 38px 56px 56px; gap: 6px;
+                          align-items: center; }
+  .grid-head { color: var(--soft); font-size: 10px; padding: 8px 0 2px; }
+  .grid-head span { text-align: center; }
+  #grid { max-block-size: 260px; overflow-y: auto; }
+  .grid-row { padding: 2px 0; }
+  .grid-row.first-host { border-block-start: 1px solid var(--line); margin-block-start: 4px; padding-block-start: 6px; }
+  .grid-row .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .grid-row.type .name { color: var(--soft); }
+  .grid-row.domain .name { font-weight: 600; }
+  .grid-row.host .name { padding-inline-start: 10px; }
+  .grid-row .n { color: var(--soft); font-size: 11px; text-align: end; font-variant-numeric: tabular-nums; }
+  .grid-row .n.some { color: var(--block); }
+  .cell { display: flex; gap: 2px; justify-content: center; }
+  .cell button { inline-size: 17px; block-size: 17px; padding: 0; border: 1px solid var(--line); border-radius: 4px;
+                 background: transparent; color: var(--soft); font: inherit; font-size: 10px; line-height: 15px;
+                 cursor: pointer; }
+  .cell button:hover { border-color: currentColor; }
+  .cell .allow.set { background: var(--allow); border-color: var(--allow); color: var(--on-set); }
+  .cell .block.set { background: var(--block); border-color: var(--block); color: var(--on-set); }
+  .cell .noop.set { background: var(--noop); border-color: var(--noop); color: var(--on-set); }
+  .cell .allow.inherited { background: color-mix(in srgb, var(--allow) 30%, transparent); color: inherit; }
+  .cell .block.inherited { background: color-mix(in srgb, var(--block) 30%, transparent); color: inherit; }
+  .cell .noop.inherited { background: color-mix(in srgb, var(--noop) 30%, transparent); color: inherit; }
+  .grid-actions { display: flex; gap: 6px; justify-content: flex-end; padding-block-start: 8px; }
+  .grid-actions button { border: 1px solid var(--line); border-radius: 6px; background: transparent; color: inherit;
+                         font: inherit; font-size: 12px; padding: 3px 10px; cursor: pointer; }
+  .grid-actions button:hover { background: var(--line); }
+  .grid-actions button:disabled { opacity: .4; cursor: default; background: transparent; }
+</style>
+</head>
+<body>
+<header>
+  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
+    <path d="M12 2.5 4.5 5.5v6c0 4.6 3.1 8.6 7.5 10 4.4-1.4 7.5-5.4 7.5-10v-6z"/>
+    <path d="m8.8 12 2.3 2.3 4.2-4.6"/>
+  </svg>
+  <span class="name">Thoron</span>
+  <span class="site" id="site"></span>
+</header>
+
+<div id="power-box">
+  <button id="power" aria-pressed="true" aria-describedby="state">
+    <svg width="44" height="44" viewBox="0 0 24 24" aria-hidden="true">
+      <path d="M12 3v8"/>
+      <path d="M6.3 6.8a8 8 0 1 0 11.4 0"/>
+    </svg>
+  </button>
+  <p id="state" aria-live="polite"></p>
+</div>
+
+<div class="stats">
+  <div class="stat"><b><span id="page-count">0</span> <small id="page-share"></small></b><span>blocked on this page</span></div>
+  <div class="stat"><b id="domains">0</b><span>domains connected</span></div>
+  <div class="stat"><b id="total-count">0</b><span>blocked since you started counting</span></div>
+</div>
+
+<div class="row" role="group" aria-label="Tools">
+  <button class="tool" id="picker" title="Pick an element on the page and make a rule that hides it">
+    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
+      <path d="M3 3l7 17 2.5-7.5L20 10z"/><path d="m13 13 6 6"/>
+    </svg>Block element</button>
+  <button class="tool" id="zapper" title="Click elements on the page to remove them until it reloads">
+    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
+      <path d="M13 2 4 14h7l-1 8 9-12h-7z"/>
+    </svg>Zapper</button>
+  <button class="tool" id="logger" title="See every request that was blocked on this tab">
+    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
+      <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
+    </svg>Logger</button>
+  <button class="tool" id="dashboard" title="Filter lists, your own rules and all settings">
+    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
+      <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
+      <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>
+    </svg>Settings</button>
