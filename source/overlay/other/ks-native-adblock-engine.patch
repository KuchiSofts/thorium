+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_WEBSOCKET_H_
+#define COMPONENTS_THORON_ADBLOCK_WEBSOCKET_H_
+
+#include <optional>
+#include <string>
+
+#include "content/public/browser/content_browser_client.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "services/network/public/mojom/websocket.mojom.h"
+
+class GURL;
+class HostContentSettingsMap;
+
+namespace content {
+class RenderFrameHost;
+}
+
+namespace thoron_adblock {
+
+// A WebSocket connection is not a URL load, so the request proxy never sees
+// it. Pages use that: an ad or tracking script that cannot fetch what it wants
+// opens a socket to the same host instead. The embedder is asked before each
+// connection of a frame while native ad blocking is on; these two functions
+// are its answer.
+
+// True when the lists block a WebSocket connection from `frame` to `url`, and
+// ads are not allowed on the page `frame` is in. Counts it for the page. The
+// caller then drops the handshake, which fails the connection as a blocked
+// request fails.
+bool BlocksWebSocket(content::RenderFrameHost& frame,
+                     const GURL& url,
+                     const HostContentSettingsMap* settings);
+
+// Opens a connection the way the browser does when nobody steps in: the
+// user agent the page's frame was given, and nothing else added.
+void ConnectWebSocket(
+    content::ContentBrowserClient::WebSocketFactory factory,
+    const GURL& url,
+    const std::optional<std::string>& user_agent,
+    mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+        handshake_client,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> header_client);
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_WEBSOCKET_H_
