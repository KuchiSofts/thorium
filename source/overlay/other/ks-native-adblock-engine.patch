+
+rust::Str ToStr(std::string_view s) {
+  return rust::Str(s.data(), s.size());
+}
+
+// rust::Str needs UTF-8; anything else is refused before it gets there.
+std::optional<std::string> ReadText(const base::FilePath& path,
+                                    size_t max_bytes) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, max_bytes) ||
+      !base::IsStringUTF8(text)) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+std::optional<rust::Box<Engine>> LoadSaved(const base::FilePath& path) {
+  std::string data;
+  if (!base::ReadFileToStringWithMaxSize(path, &data, kMaxEngineBytes) ||
+      data.empty()) {
+    return std::nullopt;
+  }
+  rust::Box<Engine> engine = engine_from_serialized(rust::Slice<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(data.data()), data.size()));
+  if (!engine->is_valid()) {
+    return std::nullopt;
+  }
+  return engine;
+}
+
+// The state file, only when this browser version wrote it.
+std::optional<base::DictValue> ReadState(const StorePaths& paths) {
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(paths.store_dir.Append(kStateFile),
+                                         &json, kMaxStateBytes)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> state =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!state) {
+    return std::nullopt;
+  }
+  const std::string* version = state->FindString("version");
+  if (!version || *version != paths.version) {
+    return std::nullopt;
+  }
+  return state;
+}
+
+// `result` says what the last check did, for people and tests reading the
+// file, and for the settings page. `settings` is the fingerprint of the
+// settings the saved engine was built for ("" for the defaults). `building`
+// is the fingerprint of settings whose lists are being read right now ("" when
+// none are): if the browser stops while reading them, the next start does not
+// try the same again.
+bool WriteState(const StorePaths& paths,
+                base::Time checked,
+                bool engine_saved,
+                base::DictValue lists,
+                const std::string& result,
+                const std::string& settings,
+                const std::string& building) {
+  base::DictValue state;
+  state.Set("version", paths.version);
+  state.Set("last_check", checked.InSecondsFSinceUnixEpoch());
+  state.Set("engine", engine_saved);
+  state.Set("lists", std::move(lists));
+  state.Set("result", result);
+  state.Set("settings", settings);
+  if (!building.empty()) {
+    state.Set("building", building);
+  }
+  std::optional<std::string> json = base::WriteJson(state);
+  return json && base::CreateDirectory(paths.store_dir) &&
+         base::ImportantFileWriter::WriteFileAtomically(
+             paths.store_dir.Append(kStateFile), *json);
+}
+
+std::string StateString(const std::optional<base::DictValue>& state,
+                        std::string_view key) {
+  const std::string* found = state ? state->FindString(key) : nullptr;
+  return found ? *found : std::string();
+}
+
+bool IsBuiltin(std::string_view id) {
+  for (const ListSource& source : kSources) {
+    if (source.id == id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Tells settings apart: "" for the defaults, so a state file written before
+// there were settings still matches them. Not a secret and not a security
+// check.
+std::string Fingerprint(const Settings& settings, std::string_view my_filters) {
+  if (settings.disabled.empty() && settings.custom.empty() &&
+      my_filters.empty()) {
+    return std::string();
+  }
+  std::string text;
+  for (const std::string& id : settings.disabled) {
+    base::StrAppend(&text, {"-", id, "\n"});
+  }
+  for (const CustomList& list : settings.custom) {
+    base::StrAppend(&text, {"+", list.url, "\n"});
+  }
+  base::StrAppend(&text, {"\n", my_filters});
+  return base::HexEncodeLower(base::SHA1HashString(text));
+}
+
+// A list's own name: its "! Title: ..." line, when it has one near the top.
+std::string TitleOf(std::string_view text) {
+  constexpr std::string_view kTitle = "! Title:";
+  std::string_view head = text.substr(0, kTitleSearchBytes);
+  size_t pos = 0;
+  while (pos < head.size()) {
+    size_t end = head.find('\n', pos);
+    if (end == std::string_view::npos) {
+      end = head.size();
+    }
+    std::string_view line =
+        base::TrimWhitespaceASCII(head.substr(pos, end - pos), base::TRIM_ALL);
+    if (base::StartsWith(line, kTitle, base::CompareCase::INSENSITIVE_ASCII)) {
+      std::string_view title = base::TrimWhitespaceASCII(
+          line.substr(kTitle.size()), base::TRIM_ALL);
+      return std::string(title.substr(0, kMaxTitleLength));
+    }
+    pos = end + 1;
+  }
+  return std::string();
+}
+
+base::FilePath StoredListPath(const StorePaths& paths, std::string_view id) {
+  return paths.store_dir.Append(kStoredLists)
+      .AppendASCII(base::StrCat({id, ".txt"}));
+}
+
+bool BlocksAllProbes(const Engine& engine,
+                     const std::vector<bool>& probes_blocked,
+                     std::string* missed) {
+  for (size_t i = 0; i < kProbes.size() && i < probes_blocked.size(); ++i) {
+    const Probe& p = kProbes[i];
+    if (probes_blocked[i] &&
+        !engine.should_block(ToStr(p.url), ToStr(p.source), ToStr(p.type))) {
+      *missed = std::string(p.url);
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+base::span<const ListSource> ListSources() {
+  return kSources;
+}
+
+base::span<const Probe> Probes() {
+  return kProbes;
+}
+
+std::map<std::string, std::string> SplitLists(std::string_view text) {
+  std::map<std::string, std::string> lists;
+  std::string* current = nullptr;
+  size_t pos = 0;
+  while (pos < text.size()) {
+    size_t end = text.find('\n', pos);
+    if (end == std::string_view::npos) {
+      end = text.size();
+    }
+    std::string_view line = text.substr(pos, end - pos);
+    if (base::StartsWith(line, kMarker)) {
+      current = &lists[std::string(line.substr(kMarker.size()))];
+    } else if (current) {
+      current->append(line);
+      current->push_back('\n');
+    }
+    pos = end + 1;
+  }
+  return lists;
+}
+
+std::optional<std::string> RefuseList(std::string_view text,
+                                      std::optional<size_t> previous_rules) {
+  if (text.size() > kMaxListBytes) {
+    return "too large";
+  }
+  if (!base::IsStringUTF8(text)) {
+    return "not text";
+  }
+  std::string_view start = base::TrimWhitespaceASCII(
+      text.substr(0, 1024), base::TRIM_LEADING);
+  if (base::StartsWith(start, "<")) {
+    return "a web page, not a filter list";
+  }
+  if (text.find(kMarker) != std::string_view::npos) {
+    return "holds a Thoron list marker";
+  }
+  const size_t rules = count_rules(ToStr(text));
+  if (rules == 0) {
+    return "no rules";
+  }
+  if (has_allow_all_rule(ToStr(text))) {
+    return "has a rule that allows every request";
+  }
+  if (previous_rules && rules * 100 < *previous_rules * kMinKeptPercent) {
+    return base::StrCat({"shrank from ", base::NumberToString(*previous_rules),
+                         " to ", base::NumberToString(rules), " rules"});
+  }
+  return std::nullopt;
+}
