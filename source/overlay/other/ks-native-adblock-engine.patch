index 0000000000000000000000000000000000000000..35dfb8efc9c94e06b21079cf1fa7c8cabb770353
--- /dev/null
+++ b/components/thoron_adblock/blocked_count.cc
@@ -0,0 +1,45 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/blocked_count.h"
+
+#include "base/logging.h"
+#include "components/content_settings/browser/page_specific_content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+
+namespace thoron_adblock {
+
+PAGE_USER_DATA_KEY_IMPL(BlockedCount);
+
+BlockedCount::BlockedCount(content::Page& page)
+    : content::PageUserData<BlockedCount>(page) {}
+
+BlockedCount::~BlockedCount() = default;
+
+// static
+void BlockedCount::Record(content::GlobalRenderFrameHostId frame) {
+  content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(frame);
+  if (!rfh) {
+    return;
+  }
+  content::Page& page = rfh->GetOutermostMainFrame()->GetPage();
+  BlockedCount* count = GetOrCreateForPage(page);
+  ++count->count_;
+  // For the automated checks (--vmodule=blocked_count=1); no URL is logged.
+  VLOG(1) << "Thoron native ad blocking: blocked on this page: "
+          << count->count_;
+  if (auto* settings =
+          content_settings::PageSpecificContentSettings::GetForFrame(rfh)) {
+    settings->OnContentBlocked(ContentSettingsType::ADS);
+  }
+}
+
+// static
+int BlockedCount::Get(content::Page& page) {
+  BlockedCount* count = GetForPage(page);
+  return count ? count->count_ : 0;
+}
+
+}  // namespace thoron_adblock
