+  link.href = URL.createObjectURL(blob);
+  link.download = `thoron-adblock-backup-${backup.created.slice(0, 10)}.json`;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(link.href), 10000);
+  say('The backup was saved as a file.');
