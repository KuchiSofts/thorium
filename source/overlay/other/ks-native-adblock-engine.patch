@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Build step: take uBlock Origin's scriptlets and redirect resources from the pinned CRX the build
+already downloads and write them as the resource list the native engine reads (assemble_resources.mjs
+does the conversion, run with the build's own Node.js). They are version-locked with the filter lists
+taken from the same CRX by extract_lists.py."""
+import argparse
+import io
+import json
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import zipfile
+
+# What the conversion needs: the scriptlet modules, the three modules they import, the index of the
+# redirect resources, and the resources themselves.
+PREFIXES = ("js/resources/", "web_accessible_resources/")
+FILES = ("js/redirect-resources.js", "js/urlskip.js", "js/arglist-parser.js", "js/jsonpath.js")
+MAX_FILE_BYTES = 4 * 1024 * 1024
+MIN_RESOURCES = 100
+
+
+def unpack(crx: bytes, dest: str) -> int:
+    if crx[:4] != b"Cr24":
+        raise ValueError("not a CRX file")
+    version, header_size = struct.unpack("<II", crx[4:12])
+    if version != 3:
+        raise ValueError(f"unsupported CRX version {version}")
+    archive = zipfile.ZipFile(io.BytesIO(crx[12 + header_size:]))
+    count = 0
+    for info in archive.infolist():
+        name = info.filename
+        if info.is_dir() or not (name in FILES or name.startswith(PREFIXES)):
+            continue
+        parts = name.split("/")
+        if ".." in parts or "\\" in name or name.startswith("/") or ":" in name:
+            raise ValueError(f"unsafe path in the CRX: {name}")
+        if info.file_size > MAX_FILE_BYTES:
+            raise ValueError(f"{name} is too large")
+        target = os.path.join(dest, *parts)
+        os.makedirs(os.path.dirname(target), exist_ok=True)
+        with open(target, "wb") as f:
+            f.write(archive.read(info))
+        count += 1
+    # the modules use import/export: mark the folder as ES modules for Node.js
+    with open(os.path.join(dest, "package.json"), "w", encoding="utf-8") as f:
+        f.write('{"type": "module"}\n')
+    return count
+
+
+def check(text: str) -> int:
+    """The number of resources in the assembled list; raises when it is not a usable list."""
+    resources = json.loads(text)
+    if not isinstance(resources, list) or len(resources) < MIN_RESOURCES:
+        raise ValueError("the assembled resource list is too short")
+    for r in resources:
+        if not (isinstance(r, dict) and isinstance(r.get("name"), str) and isinstance(r.get("content"), str)
+                and isinstance(r.get("kind"), dict)):
+            raise ValueError("an assembled resource is malformed")
+    return len(resources)
+
+
+def main(argv):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--crx", required=True)
+    p.add_argument("--node-dir", required=True, help="Chromium's third_party/node (its node.py finds the binary)")
+    p.add_argument("--assembler", required=True)
+    p.add_argument("--work", required=True, help="scratch folder (emptied first)")
+    p.add_argument("--out", required=True)
+    a = p.parse_args(argv)
+    shutil.rmtree(a.work, ignore_errors=True)
+    os.makedirs(a.work)
+    with open(a.crx, "rb") as f:
+        unpack(f.read(), a.work)
+    sys.path.insert(0, os.path.abspath(a.node_dir))
+    import node  # Chromium's own Node.js launcher
+    tmp = a.out + ".tmp"
+    done = subprocess.run([node.GetBinaryPath(), os.path.abspath(a.assembler), os.path.abspath(a.work), tmp],
+                          capture_output=True, text=True)
+    if done.returncode != 0:
+        sys.stderr.write(done.stdout + done.stderr)
+        return 1
+    with open(tmp, encoding="utf-8") as f:
+        check(f.read())
+    os.replace(tmp, a.out)
+    shutil.rmtree(a.work, ignore_errors=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
