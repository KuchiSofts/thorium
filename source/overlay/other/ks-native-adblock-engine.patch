+void EngineService::SaveSiteSwitches() {
+  EnsureStarted();
+  if (store_dir_.empty()) {
+    return;
+  }
+  base::DictValue dict;
+  for (const auto& [host, names] : site_switches_) {
+    base::ListValue list;
+    for (const std::string& name : names) {
+      list.Append(name);
+    }
+    dict.Set(host, std::move(list));
+  }
+  file_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&WriteJson, store_dir_.Append(kSiteSwitchesFile),
+                                base::Value(std::move(dict))));
+}
