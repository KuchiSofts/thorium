@@ -0,0 +1,103 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/picker.h"
+
+#include <map>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/time/time.h"
+#include "components/thoron_adblock/document_agent.mojom.h"
+#include "components/thoron_adblock/engine.rs.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+constexpr base::TimeDelta kPickerLifetime = base::Minutes(10);
+constexpr size_t kMaxRuleLength = 2000;
+
+// The documents a picker was opened in, and when. UI thread only.
+std::map<content::GlobalRenderFrameHostId, base::TimeTicks>& Opened() {
+  static base::NoDestructor<
+      std::map<content::GlobalRenderFrameHostId, base::TimeTicks>>
+      opened;
+  return *opened;
+}
+
+// True for "host##selector" where host is `site` or a site above it, and for
+// "||address^" (a rule that blocks an address). Anything else a picker never
+// makes.
+bool RuleFitsSite(const std::string& rule, const std::string& site) {
+  const size_t at = rule.find("##");
+  if (at != std::string::npos) {
+    const std::string host = rule.substr(0, at);
+    const std::string selector = rule.substr(at + 2);
+    if (host.empty() || selector.empty() ||
+        host.find_first_of(",~*/") != std::string::npos) {
+      return false;
+    }
+    return site == host || base::EndsWith(site, "." + host);
+  }
+  return base::StartsWith(rule, "||") && rule.size() > 3 &&
+         rule.find_first_of("$#") == std::string::npos;
+}
+
+}  // namespace
+
+namespace {
+
+// Sends the picker to the tab's page, followed by its arguments.
+void Start(content::WebContents* tab, const std::string& arguments) {
+  if (!tab) {
+    return;
+  }
+  content::RenderFrameHost* frame = tab->GetPrimaryMainFrame();
+  if (!frame || !frame->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() ||
+      !frame->IsRenderFrameLive()) {
+    return;
+  }
+  Opened()[frame->GetGlobalId()] = base::TimeTicks::Now();
+  std::string script(picker_js());
+  script += arguments;
+  mojo::AssociatedRemote<mojom::DocumentAgent> agent;
+  frame->GetRemoteAssociatedInterfaces()->GetInterface(&agent);
+  agent->StartPicker(script);
+}
+
+}  // namespace
+
+void StartPicker(content::WebContents* tab, bool zapper) {
+  Start(tab, zapper ? "(\"zapper\");\n" : "(\"picker\");\n");
+}
+
+void StartPickerAt(content::WebContents* tab, int x, int y) {
+  Start(tab, base::StringPrintf("(\"picker\", {x: %d, y: %d});\n", x, y));
+}
+
+std::string AcceptPickedRule(content::RenderFrameHost& frame,
+                             const std::string& rule) {
+  auto it = Opened().find(frame.GetGlobalId());
+  if (it == Opened().end()) {
+    return std::string();
+  }
+  const bool fresh = base::TimeTicks::Now() - it->second < kPickerLifetime;
+  Opened().erase(it);
+  const std::string line(base::TrimWhitespaceASCII(rule, base::TRIM_ALL));
+  const GURL url = frame.GetLastCommittedURL();
+  if (!fresh || line.empty() || line.size() > kMaxRuleLength ||
+      line.find_first_of("\r\n") != std::string::npos ||
+      !base::IsStringUTF8(line) || !url.SchemeIsHTTPOrHTTPS() ||
+      !RuleFitsSite(line, std::string(url.host()))) {
+    return std::string();
+  }
+  return line;
+}
+
+}  // namespace thoron_adblock
