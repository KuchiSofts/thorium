+namespace {
+
+// Gives `engine` the shipped resources. Without the file, or with one that is
+// not a resource list, the engine still blocks; it only has no stand-ins and
+// no scriptlets.
+void AddResources(const StorePaths& paths, Engine& engine) {
+  std::optional<std::string> json = ReadText(
+      paths.bundled_dir.Append(kBundledResources), kMaxResourcesBytes);
+  if (json && !json->empty()) {
+    engine.use_resources(ToStr(*json));
+  }
+}
+
+// The saved or shipped engine for the settings in use, or nullopt when there
+// is none. `rebuild` then says whether one has to be built from the lists the
+// settings name.
+std::optional<rust::Box<Engine>> LoadFilters(const StorePaths& paths,
+                                             bool* rebuild) {
+  *rebuild = false;
+  const std::string fingerprint =
+      Fingerprint(ReadSettings(paths), ReadMyFilters(paths));
+  std::optional<base::DictValue> state = ReadState(paths);
+  const bool engine_saved = state && state->FindBool("engine").value_or(false);
+  if (engine_saved && StateString(state, "settings") == fingerprint) {
+    if (auto engine = LoadSaved(paths.store_dir.Append(kStoredEngine))) {
+      return engine;
+    }
+  }
+  if (!fingerprint.empty()) {
+    if (StateString(state, "building") != fingerprint) {
+      *rebuild = true;
+      return std::nullopt;
+    }
+    // The browser stopped while it was reading the lists for these settings.
+    // Reading them again could stop it again, at every start. The engine of
+    // the settings before them is the safest one there is; the settings page
+    // says what happened.
+    if (engine_saved) {
+      if (auto engine = LoadSaved(paths.store_dir.Append(kStoredEngine))) {
+        return engine;
+      }
+    }
+  }
+  if (auto engine = LoadSaved(paths.bundled_dir.Append(kBundledEngine))) {
+    return engine;
+  }
+  std::optional<std::string> rules =
+      ReadText(paths.bundled_dir.Append(kBundledLists), kMaxAllListsBytes);
+  if (!rules || rules->empty()) {
+    return std::nullopt;
+  }
+  return engine_from_rules(ToStr(*rules));
+}
+
+// Builds the engine from the lists the settings name. For an update
+// (`settings_changed` false): checks each download, keeps the previous copy of
+// every list that fails a check, and builds only when a list changed and the
+// new engine passes the probes. For changed settings: builds in any case, from
+// the copies there are, and leaves the time of the last check as it was.
+UpdateResult Assemble(const StorePaths& paths,
+                      std::map<std::string, base::FilePath> downloads,
+                      std::vector<bool> probes_blocked,
+                      base::Time now,
+                      bool settings_changed) {
+  UpdateResult result;
+  const Settings settings = ReadSettings(paths);
+  const std::string my_filters = ReadMyFilters(paths);
+  const std::string fingerprint = Fingerprint(settings, my_filters);
+  std::optional<base::DictValue> state = ReadState(paths);
+  const base::DictValue* old_lists = state ? state->FindDict("lists") : nullptr;
+  const bool old_engine_saved =
+      state && state->FindBool("engine").value_or(false);
+  const std::string old_fingerprint = StateString(state, "settings");
+  base::Time checked = now;
+  if (settings_changed) {
+    std::optional<double> last =
+        state ? state->FindDouble("last_check") : std::nullopt;
+    checked = last ? base::Time::FromSecondsSinceUnixEpoch(*last) : base::Time();
+  }
+  // Put the work on record before any list is read. Reading one runs the Rust
+  // parser in this process, and a list that made it abort would take the
+  // browser down with it. With the record, the next update is kUpdateInterval
+  // away and changed settings are not read again at the next start; without
+  // it, both would happen at every start.
+  WriteState(paths, checked, old_engine_saved,
+             old_lists ? old_lists->Clone() : base::DictValue(),
+             "interrupted: the browser stopped while it was reading lists\n",
+             old_fingerprint, fingerprint);
+  std::optional<std::string> bundled_text =
+      ReadText(paths.bundled_dir.Append(kBundledLists), kMaxAllListsBytes);
+  std::map<std::string, std::string> bundled =
+      bundled_text ? SplitLists(*bundled_text) : decltype(bundled)();
+
+  std::string combined;
+  std::map<std::string, std::string> accepted;
+  base::DictValue new_lists;
+  for (const ActiveList& source : ActiveLists(settings)) {
+    const std::string& id = source.id;
+    // The copy in use now. A built-in list: an earlier update from this
+    // version, else the shipped one. A list the person added: its stored copy.
+    std::optional<std::string> previous;
+    std::string previous_from = "bundled";
+    const base::DictValue* old =
+        old_lists ? old_lists->FindDict(id) : nullptr;
+    const std::string* old_from = old ? old->FindString("source") : nullptr;
+    if (!source.builtin || (old_from && *old_from == "download")) {
+      previous = ReadText(StoredListPath(paths, id), kMaxListBytes);
+      previous_from = "download";
+    }
+    if (!previous && source.builtin && bundled.contains(id)) {
+      previous = bundled[id];
+      previous_from = "bundled";
+    }
+    std::optional<size_t> previous_rules;
+    if (previous) {
+      previous_rules = count_rules(ToStr(*previous));
+    }
+
+    std::string note;
+    const std::string* chosen = previous ? &*previous : nullptr;
+    std::string chosen_from = previous_from;
+    auto it = downloads.find(id);
+    if (it == downloads.end()) {
+      note = settings_changed ? "" : "kept: download failed";
+    } else if (std::string raw; !base::ReadFileToStringWithMaxSize(
+                   it->second, &raw, kMaxListBytes)) {
+      note = "kept: too large or unreadable";
+    } else if (auto why = RefuseList(raw, previous_rules)) {
+      note = base::StrCat({"kept: ", *why});
+    } else if (previous && raw == *previous) {
+      note = "unchanged";
+    } else {
+      accepted[id] = std::move(raw);
+      chosen = &accepted[id];
+      chosen_from = "download";
+      note = "updated";
+    }
+    if (settings_changed && note.empty()) {
+      // Not an update: the note of the last update stays.
+      const std::string* old_note = old ? old->FindString("note") : nullptr;
+      note = old_note ? *old_note : std::string();
+    }
+    if (!chosen) {
+      result.summary += base::StrCat({id, ": missing\n"});
+      continue;
+    }
+    base::StrAppend(&combined, {kMarker, id, "\n", *chosen, "\n"});
+    new_lists.Set(id, base::DictValue()
+                          .Set("source", chosen_from)
+                          .Set("rules", static_cast<int>(
+                                            count_rules(ToStr(*chosen))))
+                          .Set("note", note));
+    if (!note.empty()) {
+      result.summary += base::StrCat({id, ": ", note, "\n"});
+    }
+  }
+  for (const auto& [id, path] : downloads) {
+    base::DeleteFile(path);
+  }
+  // A built-in list that is switched off keeps its record: when it is switched
+  // on again it comes back with its updated copy, not with the shipped one.
+  if (old_lists) {
+    for (const auto [id, info] : *old_lists) {
+      if (IsBuiltin(id) && settings.disabled.contains(id) && info.is_dict()) {
+        new_lists.Set(id, info.Clone());
+      }
+    }
+  }
+  if (!my_filters.empty()) {
+    // The person's own rules, last, under an id that gives no trust.
+    base::StrAppend(&combined, {kMarker, kMyFiltersId, "\n", my_filters, "\n"});
+    new_lists.Set(kMyFiltersId,
+                  base::DictValue()
+                      .Set("source", "own")
+                      .Set("rules",
+                           static_cast<int>(count_rules(ToStr(my_filters))))
+                      .Set("note", ""));
+  }
+  if (settings_changed) {
+    result.summary += "settings changed: the filters were built again\n";
+  }
+
+  // The lists as they were, for when nothing new is used.
+  base::DictValue kept_lists =
+      old_lists ? old_lists->Clone() : base::DictValue();
+  if (accepted.empty() && !settings_changed) {
+    // Every list kept its copy, so the entries still name the right files.
+    WriteState(paths, checked, old_engine_saved, std::move(new_lists),
+               result.summary, old_fingerprint, std::string());
+    return result;
+  }
+
+  rust::Box<Engine> engine = engine_from_rules(ToStr(combined));
+  std::string missed;
+  if (!engine->is_valid() || !BlocksAllProbes(*engine, probes_blocked, &missed)) {
+    result.summary += base::StrCat(
+        {"all kept: the new engine no longer blocks ", missed, "\n"});
+    WriteState(paths, checked, old_engine_saved, std::move(kept_lists),
+               result.summary, old_fingerprint, std::string());
+    return result;
+  }
+
+  // Save the lists first and the state last, so a crash in between leaves the
+  // previous state, which only names files that were already complete.
+  bool lists_saved =
+      base::CreateDirectory(paths.store_dir.Append(kStoredLists));
+  for (const auto& [id, text] : accepted) {
+    lists_saved = lists_saved && base::ImportantFileWriter::WriteFileAtomically(
+                                     StoredListPath(paths, id), text);
+  }
+  rust::Vec<uint8_t> data = engine->serialize();
+  const bool engine_saved =
+      lists_saved && !data.empty() &&
+      engine_from_serialized(rust::Slice<const uint8_t>(data.data(),
+                                                        data.size()))
+          ->is_valid() &&
+      base::ImportantFileWriter::WriteFileAtomically(
+          paths.store_dir.Append(kStoredEngine),
+          std::string_view(reinterpret_cast<const char*>(data.data()),
+                           data.size()));
+  if (lists_saved) {
+    WriteState(paths, checked, engine_saved, std::move(new_lists),
+               result.summary, fingerprint, std::string());
+  } else {
+    result.summary += "not saved: the new lists could not be written\n";
+    WriteState(paths, checked, old_engine_saved, std::move(kept_lists),
+               result.summary, old_fingerprint, std::string());
+  }
+  AddResources(paths, *engine);
+  result.engine = std::move(engine);
+  return result;
+}
+
+// Saves the settings and builds the engine for them.
+ChangeResult Commit(const StorePaths& paths,
+                    const Settings& settings,
+                    base::Time now) {
+  base::DictValue dict;
+  base::ListValue disabled;
+  for (const std::string& id : settings.disabled) {
+    disabled.Append(id);
+  }
+  base::ListValue custom;
+  for (const CustomList& list : settings.custom) {
+    custom.Append(
+        base::DictValue().Set("url", list.url).Set("title", list.title));
+  }
+  dict.Set("disabled", std::move(disabled));
+  dict.Set("custom", std::move(custom));
+  std::optional<std::string> json = base::WriteJson(dict);
+  ChangeResult change;
+  if (!json || !base::CreateDirectory(paths.store_dir) ||
+      !base::ImportantFileWriter::WriteFileAtomically(
+          paths.store_dir.Append(kSettingsFile), *json)) {
+    change.error = "The settings could not be saved.";
+    return change;
+  }
+  change.engine = std::move(Assemble(paths, {}, {}, now, true).engine);
+  if (!change.engine) {
+    change.error =
+        "The filters could not be built again; the previous ones stay in use.";
+  }
+  return change;
+}
+
+}  // namespace
+
+std::optional<rust::Box<Engine>> LoadEngine(const StorePaths& paths) {
+  bool rebuild = false;
+  std::optional<rust::Box<Engine>> engine = LoadFilters(paths, &rebuild);
+  if (rebuild) {
+    // It comes with its resources.
+    return std::move(Assemble(paths, {}, {}, base::Time::Now(), true).engine);
+  }
+  if (engine && (*engine)->is_valid()) {
+    AddResources(paths, **engine);
+  }
+  return engine;
+}
+
+bool IsUpdateDue(const StorePaths& paths, base::Time now) {
+  std::optional<base::DictValue> state = ReadState(paths);
+  std::optional<double> last =
+      state ? state->FindDouble("last_check") : std::nullopt;
+  if (!last) {
+    return true;
+  }
+  const base::Time checked = base::Time::FromSecondsSinceUnixEpoch(*last);
+  // A clock that went backwards must not stop updates for long.
+  return now - checked >= kUpdateInterval || checked - now >= kUpdateInterval;
+}
+
+UpdateResult ApplyUpdate(const StorePaths& paths,
+                         std::map<std::string, base::FilePath> downloads,
+                         std::vector<bool> probes_blocked,
+                         base::Time now) {
+  return Assemble(paths, std::move(downloads), std::move(probes_blocked), now,
+                  false);
+}
+
+Settings ReadSettings(const StorePaths& paths) {
+  Settings settings;
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(paths.store_dir.Append(kSettingsFile),
+                                         &json, kMaxSettingsBytes)) {
+    return settings;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return settings;
+  }
+  if (const base::ListValue* disabled = dict->FindList("disabled")) {
+    for (const base::Value& id : *disabled) {
+      if (id.is_string() && IsBuiltin(id.GetString())) {
+        settings.disabled.insert(id.GetString());
+      }
+    }
+  }
+  if (const base::ListValue* custom = dict->FindList("custom")) {
+    for (const base::Value& entry : *custom) {
+      const base::DictValue* list = entry.GetIfDict();
+      const std::string* url = list ? list->FindString("url") : nullptr;
+      if (!url || settings.custom.size() >= kMaxCustomLists) {
+        continue;
+      }
+      const GURL parsed(*url);
+      if (!parsed.is_valid() || !parsed.SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      // The id is always worked out here: nothing in the file can give a list
+      // the id of a trusted one.
+      CustomList added;
+      added.url = parsed.spec();
+      added.id = CustomListId(added.url);
+      const std::string* title = list->FindString("title");
+      added.title = title ? title->substr(0, kMaxTitleLength) : std::string();
+      bool known = false;
+      for (const CustomList& other : settings.custom) {
+        known = known || other.id == added.id;
+      }
+      if (!known) {
+        settings.custom.push_back(std::move(added));
+      }
+    }
+  }
+  return settings;
+}
+
+std::string ReadMyFilters(const StorePaths& paths) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(paths.store_dir.Append(kMyFiltersFile),
+                                         &text, kMaxMyFiltersBytes) ||
+      RefuseMyFilters(text)) {
+    return std::string();
+  }
+  return text;
+}
+
+std::string CustomListId(std::string_view url) {
+  return base::StrCat(
+      {kCustomPrefix,
+       base::HexEncodeLower(base::SHA1HashString(url)).substr(0, 16)});
+}
+
+std::vector<ActiveList> ActiveLists(const Settings& settings) {
+  std::vector<ActiveList> lists;
+  for (const ListSource& source : kSources) {
+    if (!settings.disabled.contains(std::string(source.id))) {
+      lists.push_back({std::string(source.id), GURL(source.url),
+                       GURL(source.fallback_url), true});
+    }
+  }
+  for (const CustomList& list : settings.custom) {
+    lists.push_back({list.id, GURL(list.url), GURL(), false});
+  }
+  return lists;
+}
+
+std::optional<std::string> RefuseMyFilters(std::string_view text) {
+  if (text.size() > kMaxMyFiltersBytes) {
+    return "Your filters are larger than 1 MB.";
+  }
+  if (!base::IsStringUTF8(text)) {
+    return "Your filters are not plain text.";
+  }
+  if (text.find(kMarker) != std::string_view::npos) {
+    return "A line starts with \"! thoron-list:\", which Thoron keeps for "
+           "itself.";
+  }
+  if (has_allow_all_rule(ToStr(text))) {
+    return "One rule allows every request, which would turn blocking off. To "
+           "allow a site, write a rule like @@||example.com^";
+  }
+  return std::nullopt;
+}
+
+ChangeResult SetListEnabled(const StorePaths& paths,
+                            const std::string& id,
+                            bool enabled,
+                            base::Time now) {
+  if (!IsBuiltin(id)) {
+    ChangeResult change;
+    change.error = "There is no such list.";
+    return change;
+  }
+  Settings settings = ReadSettings(paths);
+  if (enabled) {
+    settings.disabled.erase(id);
+  } else {
+    settings.disabled.insert(id);
+  }
+  return Commit(paths, settings, now);
+}
+
+ChangeResult AddCustomList(const StorePaths& paths,
+                           const GURL& url,
+                           const base::FilePath& download,
+                           base::Time now) {
+  ChangeResult change;
+  std::string text;
+  const bool read =
+      !download.empty() &&
+      base::ReadFileToStringWithMaxSize(download, &text, kMaxListBytes);
+  if (!download.empty()) {
+    base::DeleteFile(download);
+  }
+  if (!read) {
+    change.error =
+        "The list could not be downloaded, or it is larger than 20 MB.";
+    return change;
+  }
+  if (auto why = RefuseList(text, std::nullopt)) {
+    change.error =
+        base::StrCat({"This is not a usable filter list: ", *why, "."});
+    return change;
+  }
+  Settings settings = ReadSettings(paths);
+  const std::string id = CustomListId(url.spec());
+  CustomList* known = nullptr;
+  for (CustomList& list : settings.custom) {
+    if (list.id == id) {
+      known = &list;
+    }
+  }
+  if (!known && settings.custom.size() >= kMaxCustomLists) {
+    change.error = "No more lists can be added. Remove one first.";
+    return change;
+  }
+  if (known) {
+    known->title = TitleOf(text);
+  } else {
+    settings.custom.push_back({id, url.spec(), TitleOf(text)});
+  }
+  if (!base::CreateDirectory(paths.store_dir.Append(kStoredLists)) ||
+      !base::ImportantFileWriter::WriteFileAtomically(StoredListPath(paths, id),
+                                                      text)) {
+    change.error = "The list could not be saved.";
+    return change;
+  }
+  return Commit(paths, settings, now);
+}
+
+ChangeResult RemoveCustomList(const StorePaths& paths,
+                              const std::string& id,
+                              base::Time now) {
+  Settings settings = ReadSettings(paths);
+  const size_t before = settings.custom.size();
+  std::erase_if(settings.custom,
+                [&id](const CustomList& list) { return list.id == id; });
+  if (settings.custom.size() == before) {
+    ChangeResult change;
+    change.error = "There is no such list.";
+    return change;
+  }
+  ChangeResult change = Commit(paths, settings, now);
+  if (change.error.empty()) {
+    base::DeleteFile(StoredListPath(paths, id));
+  }
+  return change;
+}
+
+ChangeResult SetMyFilters(const StorePaths& paths,
+                          std::string_view text,
+                          base::Time now) {
+  ChangeResult change;
+  if (auto why = RefuseMyFilters(text)) {
+    change.error = *why;
+    return change;
+  }
+  const base::FilePath path = paths.store_dir.Append(kMyFiltersFile);
+  const bool written =
+      text.empty() ? base::DeleteFile(path)
+                   : (base::CreateDirectory(paths.store_dir) &&
+                      base::ImportantFileWriter::WriteFileAtomically(path,
+                                                                     text));
+  if (!written) {
+    change.error = "Your filters could not be saved.";
+    return change;
+  }
+  return Commit(paths, ReadSettings(paths), now);
+}
+
+base::DictValue DescribeSettings(const StorePaths& paths) {
+  const Settings settings = ReadSettings(paths);
+  std::optional<base::DictValue> state = ReadState(paths);
+  const base::DictValue* state_lists =
+      state ? state->FindDict("lists") : nullptr;
+  // The shipped lists are read only for a rule count that is not on record.
+  std::optional<std::map<std::string, std::string>> bundled;
+  auto describe = [&](const std::string& id, std::string_view title,
+                      std::string_view url, bool enabled, bool builtin) {
+    base::DictValue list;
+    list.Set("id", id);
+    list.Set("title", title);
+    list.Set("url", url);
+    list.Set("enabled", enabled);
+    list.Set("builtin", builtin);
+    const base::DictValue* info =
+        state_lists ? state_lists->FindDict(id) : nullptr;
+    std::optional<int> rules = info ? info->FindInt("rules") : std::nullopt;
+    if (!rules && builtin) {
+      if (!bundled) {
+        std::optional<std::string> text = ReadText(
+            paths.bundled_dir.Append(kBundledLists), kMaxAllListsBytes);
+        bundled = text ? SplitLists(*text)
+                       : std::map<std::string, std::string>();
+      }
+      if (auto it = bundled->find(id); it != bundled->end()) {
+        rules = static_cast<int>(count_rules(ToStr(it->second)));
+      }
+    } else if (!rules) {
+      if (auto text = ReadText(StoredListPath(paths, id), kMaxListBytes)) {
+        rules = static_cast<int>(count_rules(ToStr(*text)));
+      }
+    }
+    list.Set("rules", rules.value_or(0));
+    const std::string* note = info ? info->FindString("note") : nullptr;
+    list.Set("note", note ? *note : std::string());
+    return list;
+  };
+  base::ListValue lists;
+  for (const ListSource& source : kSources) {
+    const std::string id(source.id);
+    lists.Append(describe(id, source.title, source.url,
+                          !settings.disabled.contains(id), true));
+  }
+  for (const CustomList& list : settings.custom) {
+    lists.Append(describe(list.id, list.title, list.url, true, false));
+  }
+  const std::string my_filters = ReadMyFilters(paths);
+  const std::string fingerprint = Fingerprint(settings, my_filters);
+  base::DictValue out;
+  out.Set("lists", std::move(lists));
+  out.Set("myFilters", my_filters);
+  out.Set("myFiltersRules", static_cast<int>(count_rules(ToStr(my_filters))));
+  out.Set("lastCheck",
+          state ? state->FindDouble("last_check").value_or(0.0) : 0.0);
+  out.Set("result", StateString(state, "result"));
+  out.Set("maxLists", static_cast<int>(kMaxCustomLists));
+  // True when the browser stopped while it was reading the lists for these
+  // settings, so they are not in use.
+  out.Set("notApplied", !fingerprint.empty() &&
+                            StateString(state, "building") == fingerprint);
+  return out;
+}
+
+}  // namespace thoron_adblock
diff --git a/components/thoron_adblock/list_store.h b/components/thoron_adblock/list_store.h
new file mode 100644
index 0000000000000000000000000000000000000000..68ae9a5baa21f8e0062cc5f83f8676d9c4f3de12
--- /dev/null
+++ b/components/thoron_adblock/list_store.h
@@ -0,0 +1,174 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_LIST_STORE_H_
+#define COMPONENTS_THORON_ADBLOCK_LIST_STORE_H_
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "components/thoron_adblock/engine.rs.h"
+#include "third_party/rust/cxx/v1/cxx.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+// One filter list that comes with the browser: uBlock Origin's id for it, the
+// name people know it by, and where updates come from (the same addresses
+// uBlock Origin uses).
+struct ListSource {
+  std::string_view id;
+  std::string_view title;
+  std::string_view url;
+  std::string_view fallback_url;
+};
+base::span<const ListSource> ListSources();
+
+// Where the engine and lists live. All file work runs on one background
+// sequence; nothing here touches profiles or anyone's browsing data.
+struct StorePaths {
+  base::FilePath bundled_dir;  // next to the browser: the shipped engine and lists
+  base::FilePath store_dir;    // <user data dir>/Thoron Adblock, the updated copies
+  std::string version;         // browser version; copies from another version are ignored
+};
+
+// The largest list accepted, and the most a list may shrink against its
+// previous copy.
+inline constexpr size_t kMaxListBytes = 20 * 1024 * 1024;
+inline constexpr size_t kMinKeptPercent = 50;
+// Lists are checked for updates at most this often.
+inline constexpr base::TimeDelta kUpdateInterval = base::Days(4);
+
+// What a person chose on the settings page (chrome://adblock). It is kept in
+// the store, for the whole browser like the lists themselves, never in a
+// profile.
+struct CustomList {
+  std::string id;     // always worked out from the address, never read from a file
+  std::string url;
+  std::string title;  // the list's own "! Title:" line, when it has one
+
+  bool operator==(const CustomList&) const = default;
+};
+struct Settings {
+  std::set<std::string> disabled;  // built-in lists that are switched off
+  std::vector<CustomList> custom;  // lists the person added
+
+  bool operator==(const Settings&) const = default;
+};
+// The most lists a person can add, and the largest "My filters" text.
+inline constexpr size_t kMaxCustomLists = 30;
+inline constexpr size_t kMaxMyFiltersBytes = 1024 * 1024;
+// The id the person's own rules are built in under. Like every id that does
+// not start with "ublock-", it gives no trust: such rules cannot use the
+// trusted scriptlets.
+inline constexpr std::string_view kMyFiltersId = "my-filters";
+
+// The settings as saved; the defaults when there are none or the file cannot
+// be read. Ids of built-in lists that do not exist are dropped.
+Settings ReadSettings(const StorePaths& paths);
+// The person's own rules, or "" when there are none.
+std::string ReadMyFilters(const StorePaths& paths);
+
+// The id of a list a person added: "custom-" and a hash of its address.
+std::string CustomListId(std::string_view url);
+
+// A list the engine is built from and the updater fetches: a built-in one
+// that is switched on, or one the person added.
+struct ActiveList {
+  std::string id;
+  GURL url;
+  GURL fallback_url;  // built-in lists only
+  bool builtin = true;
+};
+std::vector<ActiveList> ActiveLists(const Settings& settings);
+
+// Splits the bundled lists file at its "! thoron-list: <id>" lines.
+std::map<std::string, std::string> SplitLists(std::string_view text);
+
+// Why a downloaded list is refused, or nullopt when it is accepted.
+// `previous_rules` is the rule count of the copy it would replace.
+std::optional<std::string> RefuseList(std::string_view text,
+                                      std::optional<size_t> previous_rules);
+
+// Why a person's own rules are refused, or nullopt when they are accepted.
+std::optional<std::string> RefuseMyFilters(std::string_view text);
+
+// The engine to start with. With the default settings: the updated one when
+// it was written by this browser version and loads, else the shipped engine,
+// else one built from the shipped lists. With other settings: the engine
+// saved for exactly these settings, else one built from the lists the
+// settings name (and saved).
+std::optional<rust::Box<Engine>> LoadEngine(const StorePaths& paths);
+
+// True when the last list check is older than kUpdateInterval, or was made by
+// another browser version.
+bool IsUpdateDue(const StorePaths& paths, base::Time now);
+
+// Probe requests that every working engine blocks (ads and trackers that are
+// in the default lists). An update must still block each probe the current
+// engine blocks, so no update can turn blocking off.
+struct Probe {
+  std::string_view url;
+  std::string_view source;
+  std::string_view type;
+};
+base::span<const Probe> Probes();
+
+struct UpdateResult {
+  std::optional<rust::Box<Engine>> engine;  // set only when the engine changed
+  std::string summary;                      // per list: updated or kept, and why
+};
+
+// Checks each download (files in `downloads`, by list id; a missing id means
+// the download failed), keeps the previous copy of every list that fails a
+// check, and builds a new engine only when at least one list changed and the
+// new engine passes the probes. `probes_blocked` holds, per probe, whether the
+// current engine blocks it. Writes the accepted lists, the engine and a state
+// file atomically, and deletes the downloads.
+UpdateResult ApplyUpdate(const StorePaths& paths,
+                         std::map<std::string, base::FilePath> downloads,
+                         std::vector<bool> probes_blocked,
+                         base::Time now);
+
+// A change made on the settings page. `error` is empty when it was made, and
+// then `engine` is the engine built for the new settings. On an error nothing
+// was changed.
+struct ChangeResult {
+  std::string error;
+  std::optional<rust::Box<Engine>> engine;
+};
+// Switches a built-in list on or off.
+ChangeResult SetListEnabled(const StorePaths& paths,
+                            const std::string& id,
+                            bool enabled,
+                            base::Time now);
+// Adds the list at `url`, whose text was downloaded to `download` (deleted
+// here). The same checks as for an updated list apply.
+ChangeResult AddCustomList(const StorePaths& paths,
+                           const GURL& url,
+                           const base::FilePath& download,
+                           base::Time now);
+// Removes a list the person added, with its stored copy.
+ChangeResult RemoveCustomList(const StorePaths& paths,
+                              const std::string& id,
+                              base::Time now);
+// Replaces the person's own rules.
+ChangeResult SetMyFilters(const StorePaths& paths,
+                          std::string_view text,
+                          base::Time now);
+
+// What the settings page shows: every list with its name, address, state and
+// rule count, the person's own rules, and when and how the last update went.
+base::DictValue DescribeSettings(const StorePaths& paths);
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_LIST_STORE_H_
diff --git a/components/thoron_adblock/list_updater.cc b/components/thoron_adblock/list_updater.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b03c276e8a02db80c65690b6d896e1819061b903
--- /dev/null
+++ b/components/thoron_adblock/list_updater.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/list_updater.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/strcat.h"
+#include "base/task/task_runner.h"
+#include "base/time/time.h"
+#include "components/thoron_adblock/list_fetch.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+constexpr base::TimeDelta kFirstCheckDelay = base::Minutes(2);
+constexpr base::TimeDelta kFirstCheckDelayForTesting = base::Seconds(1);
+constexpr base::TimeDelta kCheckEvery = base::Hours(1);
+constexpr base::FilePath::CharType kDownloadDir[] =
+    FILE_PATH_LITERAL("download");
+
+// The lists to fetch, when a check is due (or asked for) and there is a
+// folder to download into.
+std::optional<std::vector<ActiveList>> ListsToFetch(const StorePaths& paths,
+                                                    base::Time now,
+                                                    bool forced) {
+  if ((!forced && !IsUpdateDue(paths, now)) ||
+      !base::CreateDirectory(paths.store_dir.Append(kDownloadDir))) {
+    return std::nullopt;
+  }
+  return ActiveLists(ReadSettings(paths));
+}
+
+}  // namespace
+
+ListUpdater::ListUpdater(scoped_refptr<base::SequencedTaskRunner> file_runner,
+                         StorePaths paths,
+                         FactoryGetter factory_getter,
+                         ProbeCheck probe_check,
+                         EngineCallback on_new_engine,
+                         GURL base_url_for_testing)
+    : file_runner_(std::move(file_runner)),
+      paths_(std::move(paths)),
+      factory_getter_(std::move(factory_getter)),
+      probe_check_(std::move(probe_check)),
+      on_new_engine_(std::move(on_new_engine)),
+      base_url_for_testing_(std::move(base_url_for_testing)) {}
+
+ListUpdater::~ListUpdater() = default;
+
+void ListUpdater::Start() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ScheduleCheck(base_url_for_testing_.is_valid() ? kFirstCheckDelayForTesting
+                                                 : kFirstCheckDelay);
+}
+
+void ListUpdater::CheckNow(base::OnceCallback<void(std::string)> done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  forced_ = true;
+  if (busy_) {
+    // The check that is running may be one that finds nothing due. This
+    // request gets a check of its own, right after it.
+    waiting_next_.push_back(std::move(done));
+    return;
+  }
+  waiting_.push_back(std::move(done));
+  timer_.Stop();
+  Check();
+}
+
+void ListUpdater::ScheduleCheck(base::TimeDelta delay) {
+  timer_.Start(FROM_HERE, delay,
+               base::BindOnce(&ListUpdater::Check, weak_factory_.GetWeakPtr()));
+}
+
+void ListUpdater::Check() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (busy_) {
+    return;
+  }
+  busy_ = true;
+  const bool forced = forced_;
+  forced_ = false;
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ListsToFetch, paths_, base::Time::Now(), forced),
+      base::BindOnce(&ListUpdater::OnDueChecked, weak_factory_.GetWeakPtr()));
+}
+
+void ListUpdater::OnDueChecked(std::optional<std::vector<ActiveList>> sources) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!sources) {
+    Finished("No check was due.\n");
+    return;
+  }
+  sources_ = std::move(*sources);
+  index_ = 0;
+  on_fallback_ = false;
+  downloads_.clear();
+  FetchNext();
+}
+
+GURL ListUpdater::UrlFor(const ActiveList& source, bool fallback) const {
+  const bool testing = base_url_for_testing_.is_valid();
+  if (!source.builtin) {
+    // A list a person added has one address, the one they gave.
+    return fallback || !ListFetch::IsAllowed(source.url, testing) ? GURL()
+                                                                  : source.url;
+  }
+  if (testing) {
+    return fallback ? GURL()
+                    : base_url_for_testing_.Resolve(
+                          base::StrCat({source.id, ".txt"}));
+  }
+  return fallback ? source.fallback_url : source.url;
+}
+
+void ListUpdater::FetchNext() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  while (index_ < sources_.size() &&
+         !UrlFor(sources_[index_], on_fallback_).is_valid()) {
+    ++index_;
+    on_fallback_ = false;
+  }
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      index_ < sources_.size() ? factory_getter_.Run() : nullptr;
+  if (!factory) {
+    FinishFetching();
+    return;
+  }
+  const ActiveList& source = sources_[index_];
+  const base::FilePath path =
+      paths_.store_dir.Append(kDownloadDir)
+          .AppendASCII(base::StrCat({source.id, ".part"}));
+  fetch_ = std::make_unique<ListFetch>(
+      UrlFor(source, on_fallback_), path, std::move(factory), file_runner_,
+      base_url_for_testing_.is_valid(),
+      base::BindOnce(&ListUpdater::OnFetched, weak_factory_.GetWeakPtr()));
+}
+
+void ListUpdater::OnFetched(base::FilePath path) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  fetch_.reset();
+  const bool ok = !path.empty();
+  if (ok) {
+    downloads_[sources_[index_].id] = std::move(path);
+  }
+  if (ok || on_fallback_) {
+    ++index_;
+    on_fallback_ = false;
+  } else {
+    on_fallback_ = true;
+  }
+  FetchNext();
+}
+
+void ListUpdater::FinishFetching() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (downloads_.empty()) {
+    // Offline or every host failed: try again in an hour; nothing changes.
+    Finished("No list could be downloaded.\n");
+    return;
+  }
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ApplyUpdate, paths_, std::move(downloads_),
+                     probe_check_.Run(), base::Time::Now()),
+      base::BindOnce(&ListUpdater::OnApplied, weak_factory_.GetWeakPtr()));
+  downloads_.clear();
+}
+
+void ListUpdater::OnApplied(UpdateResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  VLOG(1) << "Thoron ad-blocking list check:\n" << result.summary;
+  if (result.engine) {
+    on_new_engine_.Run(std::move(*result.engine));
+  }
+  Finished(result.summary);
+}
+
+void ListUpdater::Finished(const std::string& summary) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  busy_ = false;
+  std::vector<base::OnceCallback<void(std::string)>> waiting;
+  waiting.swap(waiting_);
+  for (auto& done : waiting) {
+    std::move(done).Run(summary);
+  }
+  // Asked for while this one ran: check once more right away.
+  waiting_.swap(waiting_next_);
+  ScheduleCheck(forced_ ? base::TimeDelta() : kCheckEvery);
+}
+
+}  // namespace thoron_adblock
