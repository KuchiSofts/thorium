+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/compiled_action.gni")
+import("//build/rust/rust_executable.gni")
+import("//build/rust/rust_static_library.gni")
+import("//mojo/public/tools/bindings/mojom.gni")
+
+# Thoron's native ad-blocking engine: adblock-rust (MPL-2.0) behind a small cxx bridge.
+rust_static_library("engine") {
+  crate_root = "engine.rs"
+  sources = [
+    crate_root,
+    "cosmetics.rs",
+    "dynamic.rs",
+    "engine_core.rs",
+    "procedural.rs",
+    "header.rs",
+    "permissions.rs",
+    "popup.rs",
+    "query.rs",
+    "uritransform.rs",
+    "urlskip.rs",
+  ]
+
+  # The page-side runner for procedural hide rules, and the settings page
+  # (chrome://adblock); engine.rs includes their text.
+  inputs = [
+    "procedural.js",
+    "settings_page.html",
+    "settings_page.js",
+    "popup_page.html",
+    "popup_page.js",
+    "picker.js",
+  ]
+  allow_unsafe = true  # the cxx bridge's generated glue
+  cxx_bindings = [ crate_root ]
+  deps = [
+    "//third_party/rust/adblock/v0_13:lib",
+    "//third_party/rust/base64/v0_22:lib",
+    "//third_party/rust/regex/v1:lib",
+    "//third_party/rust/serde_json/v1:lib",
+  ]
+  build_native_rust_unit_tests = true
+}
+
+# The ThoronNativeAdblock feature alone, for code that only asks whether native
+# ad blocking is on (page info).
+source_set("features") {
+  sources = [
+    "features.cc",
+    "features.h",
+  ]
+  deps = [ "//base" ]
+}
+
+# How the browser tells a frame what its next document needs.
+mojom("mojom") {
+  sources = [ "document_agent.mojom" ]
+}
+
+# The renderer side: applies a document's hide rules and scriptlets.
+source_set("renderer") {
+  sources = [
+    "renderer/document_agent.cc",
+    "renderer/document_agent.h",
+  ]
+  public_deps = [
+    ":mojom",
+    "//content/public/renderer",
+    "//mojo/public/cpp/bindings",
+  ]
+  deps = [
+    "//base",
+    "//third_party/blink/public:blink",
+    "//third_party/blink/public/common",
+    "//v8",
+  ]
+}
+
+# The browser side: engine service, list updates, the request proxy and the
+# sender of each document's resources (off unless the ThoronNativeAdblock
+# feature is enabled).
+static_library("thoron_adblock") {
+  sources = [
+    "blocked_count.cc",
+    "blocked_count.h",
+    "document_loader_throttle.cc",
+    "document_loader_throttle.h",
+    "subresource_loader_throttle.cc",
+    "subresource_loader_throttle.h",
+    "document_request.cc",
+    "document_request.h",
+    "document_request_interceptor.cc",
+    "document_request_interceptor.h",
+    "document_observer.cc",
+    "document_observer.h",
+    "engine_service.cc",
+    "engine_service.h",
+    "list_fetch.cc",
+    "list_fetch.h",
+    "picker.cc",
+    "picker.h",
+    "list_store.cc",
+    "list_store.h",
+    "list_updater.cc",
+    "list_updater.h",
+    "new_window.cc",
+    "new_window.h",
+    "page_block_throttle.cc",
+    "page_block_throttle.h",
+    "proxying_url_loader_factory.cc",
+    "proxying_url_loader_factory.h",
+    "redirect_watcher.cc",
+    "redirect_watcher.h",
+    "websocket.cc",
+    "websocket.h",
+  ]
+  public_deps = [
+    ":engine",
+    ":features",
+    "//base",
+    "//components/content_settings/core/browser",
+    "//components/content_settings/browser",
+    "//content/public/browser",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//url",
+  ]
+  deps = [
+    ":mojom",
+    "//base/version_info",
+    "//mojo/public/cpp/bindings",
+    "//third_party/blink/public/common",
+  ]
+  data_deps = [
+    ":compiled_engine",
+    ":lists",
+    ":resources",
+  ]
+}
+
+# The filter lists, taken from the pinned uBlock Origin CRX the build already
+# downloads, next to the browser (DIR_ASSETS).
+action("lists") {
+  script = "extract_lists.py"
+  _crx = "$root_gen_dir/chrome/browser/resources/ublock_origin/uBlock0_1.75.0.crx"
+  inputs = [ _crx ]
+  outputs = [ "$root_out_dir/thoron_adblock_lists.txt" ]
+  args = [
+    "--crx",
+    rebase_path(_crx, root_build_dir),
+    "--out",
+    rebase_path(outputs[0], root_build_dir),
+  ]
+  deps = [ "//chrome/browser/resources:download_ublock_origin" ]
+}
+
+# uBlock Origin's scriptlets and redirect resources (stand-ins), from the same
+# pinned CRX, in the form the engine reads, next to the browser (DIR_ASSETS).
+# They stay under uBlock Origin's licence (GPL-3.0); see CREDITS.md.
+action("resources") {
+  script = "extract_resources.py"
+  _crx = "$root_gen_dir/chrome/browser/resources/ublock_origin/uBlock0_1.75.0.crx"
+  inputs = [
+    _crx,
+    "assemble_resources.mjs",
+    "//third_party/node/node.py",
+  ]
+  outputs = [ "$root_out_dir/thoron_adblock_resources.json" ]
+  args = [
+    "--crx",
+    rebase_path(_crx, root_build_dir),
+    "--node-dir",
+    rebase_path("//third_party/node", root_build_dir),
+    "--assembler",
+    rebase_path("assemble_resources.mjs", root_build_dir),
+    "--work",
+    rebase_path("$target_gen_dir/resources_work", root_build_dir),
+    "--out",
+    rebase_path(outputs[0], root_build_dir),
+  ]
+  deps = [ "//chrome/browser/resources:download_ublock_origin" ]
+}
+
+# Build-machine tool that compiles the lists into a saved engine.
+rust_executable("compile_engine") {
+  crate_root = "compile_engine.rs"
+  sources = [
+    crate_root,
+    "engine_core.rs",
+    "header.rs",
+    "permissions.rs",
+    "popup.rs",
+    "query.rs",
+    "uritransform.rs",
+    "urlskip.rs",
+  ]
+  deps = [
+    "//third_party/rust/adblock/v0_13:lib",
+    "//third_party/rust/base64/v0_22:lib",
+    "//third_party/rust/regex/v1:lib",
+  ]
+}
+
+# Build-machine tool: feeds changed copies of real filter list lines to the
+# engine and to the code around it, to find input that makes them abort (a
+# Rust panic ends the browser). Not shipped. Run by hand:
+#   fuzz_lists <lists.txt> <seconds> [resources.json] [seed]
+rust_executable("fuzz_lists") {
+  crate_root = "fuzz_lists.rs"
+  sources = [
+    crate_root,
+    "cosmetics.rs",
+    "engine_core.rs",
+    "procedural.rs",
+    "header.rs",
+    "permissions.rs",
+    "popup.rs",
+    "query.rs",
+    "uritransform.rs",
+    "urlskip.rs",
+  ]
+  inputs = [ "procedural.js" ]
+  deps = [
+    "//third_party/rust/adblock/v0_13:lib",
+    "//third_party/rust/base64/v0_22:lib",
+    "//third_party/rust/regex/v1:lib",
+    "//third_party/rust/serde_json/v1:lib",
+  ]
+}
+
+# The saved engine next to the browser (DIR_ASSETS); it loads in a few
+# milliseconds. The lists stay as the fallback.
+compiled_action("compiled_engine") {
+  tool = ":compile_engine"
+  inputs = [ "$root_out_dir/thoron_adblock_lists.txt" ]
+  outputs = [ "$root_out_dir/thoron_adblock_engine.dat" ]
+  args = [
+    rebase_path(inputs[0], root_build_dir),
+    rebase_path(outputs[0], root_build_dir),
+  ]
+  deps = [ ":lists" ]
+}
diff --git a/components/thoron_adblock/assemble_resources.mjs b/components/thoron_adblock/assemble_resources.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f5da75eee11cccbbb2094285afb8a11e8f6f39fa
--- /dev/null
+++ b/components/thoron_adblock/assemble_resources.mjs
@@ -0,0 +1,95 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Build step (run by extract_resources.py with the build's own Node.js): turn uBlock Origin's scriptlets
+// and redirect resources, as unpacked from the pinned CRX, into the resource list adblock-rust reads.
+//
+//   node assemble_resources.mjs <unpacked uBlock Origin files> <out.json>
+//
+// The scriptlets are ES modules that register themselves; importing them runs only those registrations.
+// Each becomes { name, aliases, kind, content (base64), dependencies, permission }. A scriptlet that uBlock
+// Origin marks `requiresTrust` gets permission 1, which only filter lists parsed with that permission may
+// use (engine_core.rs gives it to uBlock Origin's own lists, as uBlock Origin does).
+// The scriptlets and resources stay under their own licence (GPL-3.0, uBlock Origin); see CREDITS.md.
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const TRUSTED = 1;
+const MIME = {
+  css: 'text/css', gif: 'image/gif', html: 'text/html', js: 'application/javascript',
+  json: 'application/json', mp3: 'audio/mp3', mp4: 'video/mp4', png: 'image/png', txt: 'text/plain',
+  xml: 'text/xml',
+};
+const TEXT = new Set(['application/javascript', 'text/html', 'text/plain']);
+
+function fail(message) {
+  console.error(`assemble_resources: ${message}`);
+  process.exit(1);
+}
+
+const [rootArg, outArg] = process.argv.slice(2);
+if (!rootArg || !outArg) fail('usage: assemble_resources.mjs <unpacked files> <out.json>');
+const root = path.resolve(rootArg);
+const load = (rel) => import(pathToFileURL(path.join(root, rel)).href);
+
+const { builtinScriptlets } = await load('js/resources/scriptlets.js');
+const redirects = (await load('js/redirect-resources.js')).default;
+if (!Array.isArray(builtinScriptlets) || !(redirects instanceof Map)) fail('unexpected uBlock Origin layout');
+
+const resources = [];
+const taken = new Map();
+function add(resource) {
+  for (const name of [resource.name, ...resource.aliases]) {
+    if (taken.has(name)) fail(`"${name}" is used by ${taken.get(name)} and ${resource.name}`);
+    taken.set(name, resource.name);
+  }
+  resources.push(resource);
+}
+
+for (const [name, details] of redirects) {
+  const file = path.join(root, 'web_accessible_resources', name);
+  if (path.basename(name) !== name || !fs.existsSync(file)) fail(`redirect resource ${name} is missing`);
+  const ext = name.includes('.') ? name.slice(name.lastIndexOf('.') + 1) : '';
+  // a name without an extension ("empty") is an empty text answer
+  const mime = MIME[ext] || (ext === '' ? 'text/plain' : 'application/octet-stream');
+  let bytes = fs.readFileSync(file);
+  if (TEXT.has(mime)) bytes = Buffer.from(bytes.toString('utf8').replaceAll('\r', ''), 'utf8');
+  add({
+    name,
+    aliases: details.alias === undefined ? [] : [].concat(details.alias),
+    kind: { mime },
+    content: bytes.toString('base64'),
+    ...(details.requiresTrust ? { permission: TRUSTED } : {}),
+  });
+}
+
+for (const details of builtinScriptlets) {
+  const { name, fn } = details;
+  if (typeof name !== 'string' || typeof fn !== 'function') fail('a scriptlet has no name or function');
+  const helper = name.endsWith('.fn');
+  if (!helper && !name.endsWith('.js')) fail(`unexpected scriptlet name ${name}`);
+  const source = fn.toString();
+  // adblock-rust calls a scriptlet by the name of its function declaration
+  if (!helper && !/^function\s+[^(){}\s]+\s*\(/.test(source)) fail(`${name} is not a function declaration`);
+  const dependencies = details.dependencies || [];
+  if (dependencies.some((d) => typeof d !== 'string')) fail(`${name} has an unresolved dependency`);
+  add({
+    name,
+    aliases: details.aliases || [],
+    kind: { mime: helper ? 'fn/javascript' : 'application/javascript' },
+    content: Buffer.from(source, 'utf8').toString('base64'),
+    ...(dependencies.length ? { dependencies } : {}),
+    ...(details.requiresTrust ? { permission: TRUSTED } : {}),
+  });
+}
+
+for (const resource of resources) {
+  for (const dep of resource.dependencies || []) {
+    if (taken.get(dep) !== dep) fail(`${resource.name} depends on ${dep}, which is not a resource name`);
+  }
+}
+
+resources.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
+fs.writeFileSync(outArg, JSON.stringify(resources) + '\n');
diff --git a/components/thoron_adblock/blocked_count.cc b/components/thoron_adblock/blocked_count.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2e49eb61fff37893ba5abfdd998b04f7a5c45d78
--- /dev/null
+++ b/components/thoron_adblock/blocked_count.cc
@@ -0,0 +1,219 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/blocked_count.h"
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/content_settings/browser/page_specific_content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace thoron_adblock {
+
+PAGE_USER_DATA_KEY_IMPL(BlockedCount);
+
+namespace {
+
+constexpr size_t kMaxHosts = 500;
+constexpr size_t kMaxRecent = 500;
+constexpr size_t kMaxUrlLength = 2048;
+
+base::RepeatingCallbackList<void(content::Page&)>& Observers() {
+  static base::NoDestructor<base::RepeatingCallbackList<void(content::Page&)>>
+      observers;
+  return *observers;
+}
+
+}  // namespace
+
+BlockedCount::BlockedCount(content::Page& page)
+    : content::PageUserData<BlockedCount>(page) {}
+
+BlockedCount::~BlockedCount() = default;
+
+namespace {
+
+base::TimeTicks& LastLoggerAsk() {
+  static base::TimeTicks last;
+  return last;
+}
+
+// The logger asks every two seconds while its page is open, and about once a
+// minute while that page is in a tab behind others (Chromium slows its timers).
+bool LoggerOpen() {
+  return !LastLoggerAsk().is_null() &&
+         base::TimeTicks::Now() - LastLoggerAsk() < base::Seconds(90);
+}
+
+// The domain of `url` as the menu counts it: the name its site registered, or
+// the host when there is none (an IP address, "localhost").
+std::string DomainOf(const GURL& url) {
+  std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return domain.empty() ? std::string(url.host()) : domain;
+}
+
+}  // namespace
+
+// static
+void BlockedCount::Allowed(content::GlobalRenderFrameHostId frame,
+                           const GURL& url) {
+  content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(frame);
+  if (!rfh || !url.has_host()) {
+    return;
+  }
+  BlockedCount* count =
+      GetOrCreateForPage(rfh->GetOutermostMainFrame()->GetPage());
+  ++count->requests_;
+  if (LoggerOpen()) {
+    count->recent_.push_back({base::Time::Now(),
+                              url.possibly_invalid_spec().substr(0, kMaxUrlLength),
+                              /*blocked=*/false});
+    if (count->recent_.size() > kMaxRecent) {
+      count->recent_.pop_front();
+    }
+  }
+  count->Asked(url, /*blocked=*/false);
+  const std::string domain = DomainOf(url);
+  if (count->domains_.size() < kMaxHosts) {
+    count->domains_.insert(domain);
+  }
+  if (count->connected_.size() < kMaxHosts) {
+    count->connected_.insert(domain);
+  }
+}
+
+// static
+void BlockedCount::LoggerAsked() {
+  LastLoggerAsk() = base::TimeTicks::Now();
+}
+
+// static
+BlockedCount::Summary BlockedCount::Totals(content::Page& page) {
+  BlockedCount* count = GetForPage(page);
+  if (!count) {
+    return {};
+  }
+  return {count->requests_, static_cast<int>(count->domains_.size()),
+          static_cast<int>(count->connected_.size())};
+}
+
+void BlockedCount::Asked(const GURL& url, bool blocked) {
+  if (!url.has_host()) {
+    return;
+  }
+  std::string host(url.host());
+  auto it = asked_.find(host);
+  if (it == asked_.end()) {
+    if (asked_.size() >= kMaxHosts) {
+      return;
+    }
+    it = asked_.emplace(std::move(host), std::make_pair(0, 0)).first;
+  }
+  ++it->second.first;
+  if (blocked) {
+    ++it->second.second;
+  }
+}
+
+// static
+std::vector<BlockedCount::HostRequests> BlockedCount::AskedHosts(
+    content::Page& page) {
+  BlockedCount* count = GetForPage(page);
+  std::vector<HostRequests> out;
+  if (!count) {
+    return out;
+  }
+  out.reserve(count->asked_.size());
+  for (const auto& [host, n] : count->asked_) {
+    out.push_back({host, n.first, n.second});
+  }
+  return out;
+}
+
+// static
+void BlockedCount::Record(content::GlobalRenderFrameHostId frame,
+                          const GURL& url) {
+  content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(frame);
+  if (!rfh) {
+    return;
+  }
+  content::Page& page = rfh->GetOutermostMainFrame()->GetPage();
+  BlockedCount* count = GetOrCreateForPage(page);
+  ++count->count_;
+  ++count->requests_;
+  count->Asked(url, /*blocked=*/true);
+  if (url.has_host() && count->domains_.size() < kMaxHosts) {
+    count->domains_.insert(DomainOf(url));
+  }
+  count->recent_.push_back(
+      {base::Time::Now(), url.possibly_invalid_spec().substr(0, kMaxUrlLength)});
+  if (count->recent_.size() > kMaxRecent) {
+    count->recent_.pop_front();
+  }
+  if (url.has_host()) {
+    const std::string host(url.host());
+    auto it = count->hosts_.find(host);
+    if (it != count->hosts_.end()) {
+      ++it->second;
+    } else if (count->hosts_.size() < kMaxHosts) {
+      count->hosts_.emplace(host, 1);
+    }
+  }
+  // For the automated checks (--vmodule=blocked_count=1); no URL is logged.
+  VLOG(1) << "Thoron native ad blocking: blocked on this page: "
+          << count->count_;
+  if (auto* settings =
+          content_settings::PageSpecificContentSettings::GetForFrame(rfh)) {
+    settings->OnContentBlocked(ContentSettingsType::ADS);
+  }
+  EngineService::Get().CountBlocked();
+  Observers().Notify(page);
+}
+
+// static
+std::vector<BlockedCount::Entry> BlockedCount::Recent(content::Page& page) {
+  BlockedCount* count = GetForPage(page);
+  if (!count) {
+    return {};
+  }
+  return std::vector<Entry>(count->recent_.rbegin(), count->recent_.rend());
+}
+
+// static
+int64_t BlockedCount::Total() {
+  return EngineService::Get().total_blocked();
+}
+
+// static
+base::CallbackListSubscription BlockedCount::AddObserver(Observer observer) {
+  return Observers().Add(std::move(observer));
+}
+
+// static
+int BlockedCount::Get(content::Page& page) {
+  BlockedCount* count = GetForPage(page);
+  return count ? count->count_ : 0;
+}
+
+// static
+std::vector<std::pair<std::string, int>> BlockedCount::Hosts(
+    content::Page& page) {
+  BlockedCount* count = GetForPage(page);
+  if (!count) {
+    return {};
+  }
+  std::vector<std::pair<std::string, int>> hosts(count->hosts_.begin(),
+                                                 count->hosts_.end());
+  std::stable_sort(hosts.begin(), hosts.end(),
+                   [](const auto& a, const auto& b) { return a.second > b.second; });
+  return hosts;
+}
+
+}  // namespace thoron_adblock
diff --git a/components/thoron_adblock/blocked_count.h b/components/thoron_adblock/blocked_count.h
new file mode 100644
index 0000000000000000000000000000000000000000..bd048d27aa3048effa0a940ca2fabaa2b1b2442b
--- /dev/null
+++ b/components/thoron_adblock/blocked_count.h
@@ -0,0 +1,106 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_BLOCKED_COUNT_H_
+#define COMPONENTS_THORON_ADBLOCK_BLOCKED_COUNT_H_
+
+#include <deque>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/page_user_data.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+// How many requests native ad blocking stopped on one page (the page and all
+// its frames), and to which hosts. Kept only in memory with the page: nothing
+// is stored or sent. UI thread only.
+class BlockedCount : public content::PageUserData<BlockedCount> {
+ public:
+  BlockedCount(const BlockedCount&) = delete;
+  BlockedCount& operator=(const BlockedCount&) = delete;
+  ~BlockedCount() override;
+
+  // Counts one blocked request to `url` of the document in `frame` and marks
+  // ads as blocked on its page, which shows the blocked-ads icon in the
+  // address bar.
+  static void Record(content::GlobalRenderFrameHostId frame, const GURL& url);
+
+  // The count for `page` (0 when nothing was blocked).
+  static int Get(content::Page& page);
+
+  // The hosts requests were blocked to on `page`, with how many each: the
+  // most first, then by name.
+  static std::vector<std::pair<std::string, int>> Hosts(content::Page& page);
+
+  // Counts one request of the document in `frame` that was let through, to
+  // `url`: what the menu weighs the blocked ones against.
+  static void Allowed(content::GlobalRenderFrameHostId frame, const GURL& url);
+  // For the menu, as uBlock Origin's: every request the blocker saw on `page`
+  // (let through or blocked), the domains they went to, and how many of those
+  // domains were reached at least once.
+  struct Summary {
+    int requests = 0;
+    int domains = 0;
+    int connected = 0;
+  };
+  static Summary Totals(content::Page& page);
+  // Every host the blocker saw `page` ask (the menu's grid of rules), with how
+  // many requests went there and how many of them were blocked; by name.
+  struct HostRequests {
+    std::string host;
+    int requests = 0;
+    int blocked = 0;
+  };
+  static std::vector<HostRequests> AskedHosts(content::Page& page);
+  // The last requests blocked on `page`, the newest first (the logger).
+  struct Entry {
+    base::Time time;
+    std::string url;
+    // false: the request was let through (kept only while the logger is open)
+    bool blocked = true;
+  };
+  // The logger asks every few seconds while it is open; only then are the
+  // requests let through kept as well, as in uBlock Origin's logger.
+  static void LoggerAsked();
+  static std::vector<Entry> Recent(content::Page& page);
+
+  // How many requests were blocked since counting started, on every page
+  // (EngineService keeps it).
+  static int64_t Total();
+
+  // Called on each blocked request with its page (the toolbar badge).
+  using Observer = base::RepeatingCallback<void(content::Page&)>;
+  static base::CallbackListSubscription AddObserver(Observer observer);
+
+ private:
+  friend class content::PageUserData<BlockedCount>;
+  explicit BlockedCount(content::Page& page);
+
+  int count_ = 0;
+  int requests_ = 0;
+  // Domains (the name a site registered, "example.co.uk"), at most kMaxHosts
+  // each: every one asked, and those reached.
+  std::set<std::string> domains_;
+  std::set<std::string> connected_;
+  // At most kMaxHosts; a page that asks more hosts than that is counted only.
+  std::map<std::string, int> hosts_;
+  // Host -> (requests, blocked), at most kMaxHosts hosts.
+  std::map<std::string, std::pair<int, int>> asked_;
+  void Asked(const GURL& url, bool blocked);
+  // At most kMaxRecent, the oldest first.
+  std::deque<Entry> recent_;
+  PAGE_USER_DATA_KEY_DECL();
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_BLOCKED_COUNT_H_
diff --git a/components/thoron_adblock/compile_engine.rs b/components/thoron_adblock/compile_engine.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8a78abf253c4d7e08d93e9e9215ef45b742494d7
--- /dev/null
+++ b/components/thoron_adblock/compile_engine.rs
@@ -0,0 +1,165 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Build step: compile the bundled filter lists into a saved engine, so the browser loads it in a few
+//! milliseconds instead of building it at the first page load. Runs on the build machine with the same
+//! adblock-rust version as the browser, so the saved format always matches.
+//!     compile_engine <lists.txt> <engine.dat>
+//! For looking at what the lists ask of a page (how many hide rules a document would be sent):
+//!     compile_engine --document <lists.txt> <url>
+
+// This tool uses only part of what it shares with the browser's engine.
+#[allow(dead_code)]
+mod engine_core;
+#[allow(dead_code)]
+mod header;
+#[allow(dead_code)]
+mod permissions;
+#[allow(dead_code)]
+mod popup;
+#[allow(dead_code)]
+mod query;
+#[allow(dead_code)]
+mod uritransform;
+#[allow(dead_code)]
+mod urlskip;
+
+use std::process::ExitCode;
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() == 4 && args[1] == "--document" {
+        return document(&args[2], &args[3]);
+    }
+    if args.len() == 4 && args[1] == "--skip" {
+        return skip(&args[2], &args[3]);
+    }
+    if args.len() == 4 && args[1] == "--header" {
+        return header(&args[2], &args[3]);
+    }
+    if args.len() == 3 && args[1] == "--time" {
+        return time(&args[2]);
+    }
+    if args.len() != 3 {
+        eprintln!("usage: compile_engine <lists.txt> <engine.dat>");
+        return ExitCode::FAILURE;
+    }
+    let rules = match std::fs::read_to_string(&args[1]) {
+        Ok(text) if !text.trim().is_empty() => text,
+        _ => {
+            eprintln!("compile_engine: cannot read filter lists from {}", args[1]);
+            return ExitCode::FAILURE;
+        }
+    };
+    // each list with the permission its id gives it, exactly as the browser builds an engine
+    let data = engine_core::save(&engine_core::build(&rules));
+    // Prove the saved engine loads before shipping it.
+    if engine_core::load(&data).is_none() {
+        eprintln!("compile_engine: the compiled engine does not load back");
+        return ExitCode::FAILURE;
+    }
+    if let Err(e) = std::fs::write(&args[2], &data) {
+        eprintln!("compile_engine: cannot write {}: {e}", args[2]);
+        return ExitCode::FAILURE;
+    }
+    ExitCode::SUCCESS
+}
+
+/// How many `$urlskip` rules of the lists are understood, and where a navigation to `url` goes.
+fn skip(lists: &str, url: &str) -> ExitCode {
+    let Ok(rules) = std::fs::read_to_string(lists) else {
+        eprintln!("compile_engine: cannot read filter lists from {lists}");
+        return ExitCode::FAILURE;
+    };
+    let filters = engine_core::build(&rules);
+    let written = rules.lines().filter(|l| l.contains("urlskip") && !l.trim_start().starts_with('!')).count();
+    println!("urlskip: {} of {written} rules of the lists are taken", filters.skips.text.lines().count());
+    let to = engine_core::skip(&filters, url, url);
+    println!("{url} -> {}", if to.is_empty() { "(stays)" } else { &to });
+    ExitCode::SUCCESS
+}
+
+/// How many `$header` rules of the lists are understood, and what the answer to a script request
+/// for `url` from another site would be held against.
+fn header(lists: &str, url: &str) -> ExitCode {
+    let Ok(rules) = std::fs::read_to_string(lists) else {
+        eprintln!("compile_engine: cannot read filter lists from {lists}");
+        return ExitCode::FAILURE;
+    };
+    let filters = engine_core::build(&rules);
+    let written = rules.lines().filter(|l| l.contains("header=") && !l.trim_start().starts_with('!')).count();
+    println!("header: {} of {written} rules of the lists are taken", filters.headers.text.lines().count());
+    let transforms = rules.lines().filter(|l| l.contains("uritransform") && !l.trim_start().starts_with('!')).count();
+    println!("uritransform: {} of {transforms} rules of the lists are taken", filters.transforms.text.lines().count());
+    for line in rules.lines().filter(|l| l.contains("header=") && !l.trim_start().starts_with('!')) {
+        if !filters.headers.text.lines().any(|taken| taken == line.trim()) {
+            println!("  not taken: {line}");
+        }
+    }
+    let d = engine_core::decide(&filters, url, "https://page.example/", "script", "GET", false);
+    println!("{url} -> blocked {}, tests {:?}", d.blocked, d.header_tests);
+    ExitCode::SUCCESS
+}
+
+/// How long the engine takes over one request, and how much of that the `$header` rules are.
+fn time(lists: &str) -> ExitCode {
+    let Ok(rules) = std::fs::read_to_string(lists) else {
+        eprintln!("compile_engine: cannot read filter lists from {lists}");
+        return ExitCode::FAILURE;
+    };
+    let mut filters = engine_core::build(&rules);
+    // what a page asks for: its own scripts and those of others, images, style sheets, fetches
+    let kinds = ["script", "image", "xmlhttprequest", "stylesheet", "script", "image", "font", "image"];
+    let requests: Vec<(String, &str)> = (0..400)
+        .map(|i| {
+            let kind = kinds[i % kinds.len()];
+            let url = match i % 5 {
+                0 => format!("https://www.site{i}example.com/assets/app{i}.min.js"),
+                1 => format!("https://cdn{i}.example.net/img/photo-{i}.png?w=640"),
+                2 => format!("https://news.example/api/v1/items?id={i}"),
+                3 => format!("https://static{i}.example.org/css/main.{i}.css"),
+                _ => format!("https://d{i}abc.cloudfront.net/lib/widget{i}.js"),
+            };
+            (url, kind)
+        })
+        .collect();
+    let run = |filters: &engine_core::Filters| {
+        let start = std::time::Instant::now();
+        let (mut blocked, mut with_tests) = (0u32, 0u32);
+        for _ in 0..50 {
+            for (url, kind) in &requests {
+                let d = engine_core::decide(filters, url, "https://news.example/story", kind, "GET", false);
+                blocked += d.blocked as u32;
+                with_tests += !d.header_tests.is_empty() as u32;
+            }
+        }
+        (start.elapsed().as_secs_f64() * 1e6 / (50.0 * requests.len() as f64), blocked / 50, with_tests / 50)
+    };
+    run(&filters); // the first round prepares the engine's regular expressions
+    let (with, blocked, with_tests) = run(&filters);
+    filters.headers = header::HeaderRules::default();
+    let (without, _, _) = run(&filters);
+    println!(
+        "{} requests: {blocked} blocked, {with_tests} wait for their answer; {with:.1} us a request, {without:.1} us without the header rules",
+        requests.len()
+    );
+    ExitCode::SUCCESS
+}
+
+fn document(lists: &str, url: &str) -> ExitCode {
+    let Ok(rules) = std::fs::read_to_string(lists) else {
+        eprintln!("compile_engine: cannot read filter lists from {lists}");
+        return ExitCode::FAILURE;
+    };
+    let engine = adblock::Engine::new_with_filter_set(engine_core::filter_set(&rules));
+    let found = engine.url_cosmetic_resources(url);
+    let bytes: usize = found.hide_selectors.iter().map(|s| s.len()).sum();
+    println!(
+        "{url}: {} hide selectors ({bytes} bytes), {} with an action, {} exceptions, generichide {}",
+        found.hide_selectors.len(),
+        found.procedural_actions.len(),
+        found.exceptions.len(),
+        found.generichide
+    );
+    ExitCode::SUCCESS
+}
diff --git a/components/thoron_adblock/cosmetics.rs b/components/thoron_adblock/cosmetics.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5c176c878685ebf34e1a9f79e7dd3f5644214dc7
--- /dev/null
+++ b/components/thoron_adblock/cosmetics.rs
@@ -0,0 +1,250 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! What a document gets from the lists besides request blocking: the elements to hide or restyle,
+//! the rules for the procedural runner, and the scriptlets to run. adblock-rust says which rules
+//! apply to a document; this module turns them into what the renderer is sent, and leaves out
+//! what could do more to a page than a list is allowed to.
+//!
+//! Used by the browser's engine (engine.rs) and by the list fuzzer (fuzz_lists.rs), so the fuzzer
+//! runs the very code the browser runs.
+
+use crate::engine_core::Filters;
+use crate::procedural::{self, Compiled, Program};
+use std::collections::HashSet;
+
+/// A selector from a filter list goes into a style sheet as `selector{display:none!important}`. One
+/// that could end its rule and start another, or comment out what follows, is left out: a list may
+/// hide elements, never add other CSS to a page. (adblock-rust is built without its CSS validation.)
+pub fn safe_selector(selector: &str) -> bool {
+    !selector.trim().is_empty()
+        && !selector.contains(['{', '}'])
+        && !selector.contains("/*")
+        && !selector.chars().any(|c| c.is_control())
+}
+
+pub fn stylesheet(selectors: &[String]) -> String {
+    selectors.iter().map(|s| format!("{s}{{display:none!important}}\n")).collect()
+}
+
+/// uBlock Origin runs a page's scriptlets inside one function with a shared `scriptletGlobals`.
+pub fn wrap_scriptlets(script: String) -> String {
+    if script.is_empty() {
+        return script;
+    }
+    format!("(function() {{\nconst scriptletGlobals = {{}};\n{script}\n}})();\n")
+}
+
+pub fn sorted(set: HashSet<String>) -> Vec<String> {
+    let mut list: Vec<String> = set.into_iter().collect();
+    list.sort_unstable();
+    list
+}
+
+/// The procedural runner (procedural.js) without its comment lines: a function expression that
+/// takes the rules of one document.
+fn runner() -> &'static str {
+    static RUNNER: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    RUNNER.get_or_init(|| {
+        let code: Vec<&str> =
+            include_str!("procedural.js").lines().filter(|l| !l.trim_start().starts_with("//")).collect();
+        code.join("\n").trim().to_string()
+    })
+}
+
+/// A mark: the name of an attribute the runner puts on the elements a procedural rule finds, for
+/// the style sheet to act on. Twelve random letters, new for every document, so that a page
+/// cannot know the name beforehand or tell this blocker by it.
+/// What a hidden element's style becomes.
+const HIDE: &str = "display:none!important";
+
+fn new_mark() -> String {
+    use std::hash::{BuildHasher, Hasher};
+    // std's hasher keys are random per thread and differ for every new state
+    let mut x = std::collections::hash_map::RandomState::new().build_hasher().finish();
+    (0..12)
+        .map(|_| {
+            let letter = (b'a' + (x % 26) as u8) as char;
+            x /= 26;
+            letter
+        })
+        .collect()
+}
+
+/// One of adblock-rust's "procedural or action" filters, which it keeps as JSON: the selector as
+/// one string (this build has no CSS parser in the engine) and the action's kind and argument.
+/// A filter without an action hides.
+fn parse_action(json: &str) -> Option<(String, String, String)> {
+    let value: serde_json::Value = serde_json::from_str(json).ok()?;
+    let selector = match value.get("selector")?.as_array()?.as_slice() {
+        [one] if one.get("type")?.as_str()? == "css-selector" => one.get("arg")?.as_str()?.to_string(),
+        _ => return None,
+    };
+    let (kind, arg) = match value.get("action") {
+        Some(action) => (
+            action.get("type")?.as_str()?.to_string(),
+            action.get("arg").and_then(|a| a.as_str()).unwrap_or_default().to_string(),
+        ),
+        None => ("hide".to_string(), String::new()),
+    };
+    Some((selector, kind, arg))
+}
+
+fn as_program(compiled: Compiled) -> Program {
+    match compiled {
+        Compiled::Css(selector) => Program { selector, tasks: Vec::new() },
+        Compiled::Procedural(program) => program,
+    }
+}
+
+/// Hide rules for every site ("##...") that are written with a procedural operator, or that
+/// cannot be read at all. uBlock Origin does not accept a procedural rule without a site, and
+/// neither does Thoron: one such rule in a list would put the runner, and the rule's cost, on
+/// every page of every site. They are found once, by asking the engine about a site that no list
+/// names, which returns exactly the rules for every site.
+fn siteless_procedural(filters: &Filters) -> &HashSet<String> {
+    filters.siteless.get_or_init(|| {
+        let everywhere = filters.engine.url_cosmetic_resources("https://thoron-no-such-site.invalid/");
+        everywhere
+            .hide_selectors
+            .into_iter()
+            .filter(|selector| !matches!(procedural::compile(selector), Some(Compiled::Css(_))))
+            .collect()
+    })
+}
+
+/// What a document's cosmetic rules come to, sorted into what a style sheet can do and what the
+/// runner has to do.
+#[derive(Default)]
+struct Cosmetics {
+    hide_selectors: Vec<String>,
+    /// Style rules other than plain hiding, ready for the style sheet.
+    more_css: String,
+    /// Rules for the runner, as JSON.
+    procedural: Vec<String>,
+    hide_mark: Option<String>,
+    /// Declarations of `:style()` rules with a procedural selector, and the mark for each.
+    style_marks: Vec<(String, String)>,
+}
+
+impl Cosmetics {
+    fn hide(&mut self, selector: &str) {
+        // most selectors are a few names and combinators: nothing to take apart
+        if !selector.contains([':', '[', '"', '\'', '\\']) {
+            if safe_selector(selector) {
+                self.hide_selectors.push(selector.trim().to_string());
+            }
+            return;
+        }
+        match procedural::compile(selector) {
+            Some(Compiled::Css(css)) if safe_selector(&css) => self.hide_selectors.push(css),
+            Some(Compiled::Procedural(program)) => {
+                let mark = self.hide_mark.get_or_insert_with(new_mark).clone();
+                self.procedural.push(program.filter_json(&["mark", &mark, HIDE]));
+            }
+            _ => {}
+        }
+    }
+
+    fn act(&mut self, selector: &str, kind: &str, arg: &str) {
+        if kind == "hide" {
+            return self.hide(selector);
+        }
+        let Some(compiled) = procedural::compile(selector) else { return };
+        match (compiled, kind) {
+            (Compiled::Css(css), "style") => {
+                if safe_selector(&css) && procedural::safe_style(arg) {
+                    self.more_css.push_str(&format!("{css}{{{arg}}}\n"));
+                }
+            }
+            (Compiled::Procedural(program), "style") => {
+                if !procedural::safe_style(arg) {
+                    return;
+                }
+                let mark = match self.style_marks.iter().find(|(declarations, _)| declarations == arg) {
+                    Some((_, mark)) => mark.clone(),
+                    None => {
+                        let mark = new_mark();
+                        self.more_css.push_str(&format!("[{mark}]{{{arg}}}\n"));
+                        self.style_marks.push((arg.to_string(), mark.clone()));
+                        mark
+                    }
+                };
+                self.procedural.push(program.filter_json(&["mark", &mark, arg]));
+            }
+            (compiled, "remove") => self.procedural.push(as_program(compiled).filter_json(&["remove"])),
+            (compiled, "remove-attr" | "remove-class") if procedural::safe_name(arg) => {
+                self.procedural.push(as_program(compiled).filter_json(&[kind, arg]))
+            }
+            _ => {}
+        }
+    }
+
+    fn stylesheet(&self) -> String {
+        let mut css = stylesheet(&self.hide_selectors);
+        css.push_str(&self.more_css);
+        if let Some(mark) = &self.hide_mark {
+            css.push_str(&format!("[{mark}]{{{HIDE}}}\n"));
+        }
+        css
+    }
+
+    fn isolated_script(&self) -> String {
+        if self.procedural.is_empty() {
+            return String::new();
+        }
+        format!("{}([{}]);\n", runner(), self.procedural.join(","))
+    }
+}
+
+/// What one document needs (the fields of the bridge's `DocumentResources`).
+pub struct Page {
+    pub stylesheet: String,
+    pub hide_selectors: Vec<String>,
+    pub procedural: Vec<String>,
+    pub exceptions: Vec<String>,
+    pub script: String,
+    pub isolated_script: String,
+    pub generichide: bool,
+}
+
+/// What the document at `url` needs. Nothing for an address that is not one.
+pub fn page(filters: &Filters, url: &str) -> Page {
+    let found = filters.engine.url_cosmetic_resources(url);
+    let siteless = siteless_procedural(filters);
+    let mut cosmetics = Cosmetics::default();
+    for selector in sorted(found.hide_selectors) {
+        if !siteless.contains(&selector) {
+            cosmetics.hide(&selector);
+        }
+    }
+    for action in sorted(found.procedural_actions) {
+        if let Some((selector, kind, arg)) = parse_action(&action) {
+            cosmetics.act(&selector, &kind, &arg);
+        }
+    }
+    Page {
+        stylesheet: cosmetics.stylesheet(),
+        isolated_script: cosmetics.isolated_script(),
+        hide_selectors: cosmetics.hide_selectors,
+        procedural: cosmetics.procedural,
+        exceptions: sorted(found.exceptions),
+        script: wrap_scriptlets(found.injected_script),
+        generichide: found.generichide,
+    }
+}
+
+/// Generic hide rules for the class names and ids a document at `url` uses: a style sheet, without
+/// the selectors the site has exceptions for. Empty when generic hiding is off for the document.
+pub fn generic_stylesheet(filters: &Filters, url: &str, classes: &Vec<String>, ids: &Vec<String>) -> String {
+    let document = filters.engine.url_cosmetic_resources(url);
+    if document.generichide {
+        return String::new();
+    }
+    let mut selectors = filters.engine.hidden_class_id_selectors(classes, ids, &document.exceptions);
+    selectors.sort_unstable();
+    selectors.dedup();
+    // generic rules are plain CSS; one written with a procedural operator is not applied
+    selectors.retain(|s| safe_selector(s) && matches!(procedural::compile(s), Some(Compiled::Css(css)) if css == *s));
+    stylesheet(&selectors)
+}
diff --git a/components/thoron_adblock/document_agent.mojom b/components/thoron_adblock/document_agent.mojom
