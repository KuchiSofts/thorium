+
+// The hosts a page asked, for the engine (they come from GURL: ASCII).
+rust::Vec<rust::String> HostsToRust(const std::vector<std::string>& hosts) {
+  rust::Vec<rust::String> out;
+  out.reserve(hosts.size());
+  for (const std::string& host : hosts) {
+    if (base::IsStringASCII(host)) {
+      out.push_back(rust::String(host));
+    }
+  }
+  return out;
+}
