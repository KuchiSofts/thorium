+
+class HostContentSettingsMap;
+
+namespace content {
+class NavigationHandle;
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace thoron_adblock {
+
+// Sends each document what it needs from native ad blocking (elements to
+// hide, scriptlets) when its navigation is ready to commit, and answers the
+// document's questions about generic hide rules. One per WebContents,
+// attached only while the ThoronNativeAdblock feature is on. Nothing is sent
+// or answered on a site where the person allowed ads (the per-site Ads
+// setting), nor for anything but http(s) documents.
+class DocumentObserver : public content::WebContentsObserver,
+                         public content::WebContentsUserData<DocumentObserver>,
+                         public mojom::DocumentHost {
+ public:
+  DocumentObserver(const DocumentObserver&) = delete;
+  DocumentObserver& operator=(const DocumentObserver&) = delete;
+  ~DocumentObserver() override;
+
+  // Connects a frame's DocumentHost to the observer of its WebContents (none
+  // while the feature is off: the frame then gets no answers).
+  static void BindDocumentHost(
+      mojo::PendingAssociatedReceiver<mojom::DocumentHost> receiver,
+      content::RenderFrameHost* frame);
+
+  // content::WebContentsObserver:
+  void ReadyToCommitNavigation(
+      content::NavigationHandle* navigation_handle) override;
+
+  // mojom::DocumentHost:
+  void GenericStylesheet(const std::vector<std::string>& classes,
+                         const std::vector<std::string>& ids,
+                         GenericStylesheetCallback callback) override;
+  void AddFilter(const std::string& rule) override;
+
+ private:
+  friend class content::WebContentsUserData<DocumentObserver>;
+  // `settings` holds the per-site choice (null: no per-site choice).
+  DocumentObserver(content::WebContents* web_contents,
+                   scoped_refptr<HostContentSettingsMap> settings);
+
+  const scoped_refptr<HostContentSettingsMap> settings_;
+  content::RenderFrameHostReceiverSet<mojom::DocumentHost> receivers_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_DOCUMENT_OBSERVER_H_
diff --git a/components/thoron_adblock/document_request.cc b/components/thoron_adblock/document_request.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0679a3aba7c2427dd1e90f5914eb3cf9f56b7ebf
--- /dev/null
+++ b/components/thoron_adblock/document_request.cc
@@ -0,0 +1,55 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/document_request.h"
+
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+
+namespace thoron_adblock {
+
+// static
+std::optional<DocumentRequest> DocumentRequest::From(
+    const network::ResourceRequest& request,
+    content::WebContents* web_contents,
+    content::FrameTreeNodeId frame_tree_node_id) {
+  using D = network::mojom::RequestDestination;
+  DocumentRequest out;
+  out.main_frame =
+      request.destination == D::kDocument && request.is_outermost_main_frame;
+  if (out.main_frame) {
+    return out;
+  }
+  if (request.destination != D::kDocument &&
+      request.destination != D::kIframe && request.destination != D::kFrame &&
+      request.destination != D::kFencedframe) {
+    return std::nullopt;
+  }
+  content::RenderFrameHost* host =
+      web_contents
+          ? web_contents->UnsafeFindFrameByFrameTreeNodeId(frame_tree_node_id)
+          : nullptr;
+  if (!host) {
+    return std::nullopt;
+  }
+  out.page_url = host->GetOutermostMainFrame()->GetLastCommittedURL();
+  if (!out.page_url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  out.frame = host->GetGlobalId();
+  if (request.request_initiator) {
+    out.source = request.request_initiator->GetURL();
+  }
+  return out;
+}
+
+GURL DocumentRequest::SourceFor(const GURL& url) const {
+  if (main_frame) {
+    return url;
+  }
+  return source.SchemeIsHTTPOrHTTPS() ? source : page_url;
+}
+
+}  // namespace thoron_adblock
