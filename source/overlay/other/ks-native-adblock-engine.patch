+
+// The script of chrome://adblock, the settings page of Thoron's built-in ad blocking. It asks the
+// browser (thoron_adblock_ui.cc) for the state and for each change; every answer to a change is ""
+// when it was made, else what went wrong. The page is built with DOM calls only: its security policy
+// allows no markup made from text.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+const $ = (id) => document.getElementById(id);
+
+/** The rules as they are saved, to tell whether the box was edited. */
+let savedFilters = '';
+let busy = false;
+
+function say(text, bad = false) {
+  const message = $('message');
+  message.textContent = text;
+  message.classList.toggle('bad', bad);
+}
+
+function make(tag, className, text) {
+  const element = document.createElement(tag);
+  if (className) {
+    element.className = className;
+  }
+  if (text) {
+    element.textContent = text;
+  }
+  return element;
+}
+
+function rulesText(count) {
+  return count === 1 ? '1 rule' : `${count.toLocaleString()} rules`;
+}
+
+// uBlock Origin's optional lists (its assets.json), in its groups. They are added like any list a person adds.
