diff --git a/components/thoron_adblock/popup_page.js b/components/thoron_adblock/popup_page.js
new file mode 100644
index 0000000000000000000000000000000000000000..9ecb3e824f44782be6f483a5414910bb2bb7cf0a
--- /dev/null
+++ b/components/thoron_adblock/popup_page.js
@@ -0,0 +1,210 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The script of the ad blocking menu (popup_page.html). It asks the browser (thoron_adblock_popup_ui.cc)
+// for the state of the tab the menu was opened for, every second while it is open, and passes on what
+// the person clicks. Built with DOM calls only.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+const $ = (id) => document.getElementById(id);
+const number = (n) => (n || 0).toLocaleString();
+
+let state = null;
+
+function show(next) {
+  state = next;
+  $('site').textContent = next.site || '';
+  const power = $('power');
+  power.disabled = !next.applicable;
+  power.setAttribute('aria-pressed', String(next.applicable && next.enabled));
+  power.setAttribute('aria-label', next.enabled ? 'Turn ad blocking off for this site'
+                                                : 'Turn ad blocking on for this site');
+  $('state').textContent = !next.applicable ? 'Nothing is blocked on this kind of page.'
+      : next.enabled ? 'Blocking is on for this site.'
+      : 'Ads and trackers are allowed on this site.';
+  $('page-count').textContent = number(next.pageCount);
+  // as uBlock Origin shows them: the share of the page's requests that was
+  // blocked, and the domains reached out of all the page asked
+  const requests = next.requests || 0;
+  $('page-share').textContent = requests ? `(${Math.round((100 * next.pageCount) / requests)}%)` : '';
+  $('domains').textContent = `${number(next.connected || 0)} of ${number(next.domains || 0)}`;
+  $('total-count').textContent = number(next.totalCount);
+  for (const button of document.querySelectorAll('.switch')) {
+    const name = button.dataset.switch;
+    button.disabled = !next.applicable || !(name in next.switches);
+    button.setAttribute('aria-pressed', String(!!next.switches[name]));
+  }
+  for (const id of ['picker', 'zapper']) {
+    $(id).disabled = !next.applicable || !next.enabled;
+  }
+  $('logger').disabled = !next.applicable;
+  if (next.mediaKb) {
+    document.querySelector('[data-switch="media"]').title =
+        `Block audio and video files larger than ${number(next.mediaKb)} KB on this site`;
+  }
+  showSites(next.sites);
+  showGrid(next.grid);
+}
+
+// --- uBlock Origin's grid of rules (dynamic filtering): a change is in force at once, for now; Save keeps
+// it in My rules (the padlock), Revert takes it back (the eraser).
+const TYPE_NAMES = {
+  '*': 'All requests', 'image': 'Images', '3p': '3rd-party', 'inline-script': 'Inline scripts',
+  '1p-script': '1st-party scripts', '3p-script': '3rd-party scripts', '3p-frame': '3rd-party frames',
+};
+// [action, class, word, glyph]
+const ACTIONS = [[2, 'allow', 'Allow', '✓'], [3, 'noop', 'Leave to the lists', '○'],
+                 [1, 'block', 'Block', '✕']];
+let gridShown = '';
+
+function gridCell(destination, kind, scope, value, name) {
+  const action = value & 3;
+  const exact = (value & 4) !== 0;
+  const box = document.createElement('span');
+  box.className = 'cell';
+  box.setAttribute('role', 'cell');
+  const where = scope === 'local' ? 'on this site' : 'on every site';
+  for (const [n, cls, word, glyph] of ACTIONS) {
+    const button = document.createElement('button');
+    const on = action === n;
+    button.className = cls + (on ? (exact ? ' set' : ' inherited') : '');
+    button.textContent = glyph;
+    button.dataset.key = `${destination} ${kind} ${scope} ${n}`;
+    button.setAttribute('aria-pressed', String(on && exact));
+    button.title = `${word}: ${name} ${where}` + (on && !exact ? ' (from a broader rule)' : '') +
+                   (on && exact ? ' (click again to remove the rule)' : '');
+    button.setAttribute('aria-label', button.title);
+    button.addEventListener('click', () => {
+      chrome.send('setGridCell', [destination, kind, scope, on && exact ? 0 : n]);
+      setTimeout(refresh, 100);
+    });
+    box.append(button);
+  }
+  return box;
+}
+
+function gridRow(name, destination, kind, global, local, rowClass, requests, blocked) {
+  const row = document.createElement('div');
+  row.className = `grid-row ${rowClass}`;
+  row.setAttribute('role', 'row');
+  const label = document.createElement('span');
+  label.className = 'name';
+  label.setAttribute('role', 'rowheader');
+  label.textContent = name;
+  label.title = name;
+  const n = document.createElement('span');
+  n.className = 'n' + (blocked ? ' some' : '');
+  if (requests) {
+    n.textContent = blocked ? `${number(blocked)}/${number(requests)}` : number(requests);
+    n.title = `${number(requests)} requests, ${number(blocked)} blocked`;
+  }
+  row.append(label, n, gridCell(destination, kind, 'global', global, name),
+             gridCell(destination, kind, 'local', local, name));
+  return row;
+}
+
+function showGrid(grid) {
+  const box = $('grid-box');
+  box.hidden = !grid;
+  if (!grid) {
+    return;
+  }
+  $('grid-changed').hidden = !grid.changed;
+  $('grid-save').disabled = !grid.changed;
+  $('grid-revert').disabled = !grid.changed;
+  const key = JSON.stringify([grid.types, grid.hosts]);
+  if (key === gridShown) {
+    return;
+  }
+  gridShown = key;
+  const focused = document.activeElement && document.activeElement.dataset
+      ? document.activeElement.dataset.key : undefined;
+  const rows = grid.types.map((t) => gridRow(TYPE_NAMES[t.kind] || t.kind, '*', t.kind, t.global, t.local, 'type'));
+  grid.hosts.forEach((h, i) => {
+    rows.push(gridRow(h.host, h.host, '*', h.global, h.local,
+                      (h.domain ? 'domain' : 'host') + (i === 0 ? ' first-host' : ''), h.requests, h.blocked));
+  });
+  $('grid').replaceChildren(...rows);
+  if (focused) {
+    const again = Array.from(document.querySelectorAll('.cell button')).find((b) => b.dataset.key === focused);
+    if (again) {
+      again.focus();
+    }
+  }
+}
+
+for (const [id, message] of [['grid-save', 'saveGrid'], ['grid-revert', 'revertGrid'], ['grid-reload', 'reloadTab']]) {
+  $(id).addEventListener('click', () => {
+    chrome.send(message);
+    setTimeout(refresh, 150);
+  });
+}
+// the grid stays open or closed from one opening of the menu to the next
+try {
+  $('grid-box').open = localStorage.getItem('thoron-grid-open') === '1';
+} catch (e) {
+  // no storage: closed
+}
+$('grid-box').addEventListener('toggle', () => {
+  try {
+    localStorage.setItem('thoron-grid-open', $('grid-box').open ? '1' : '0');
+  } catch (e) {
+    // no storage
+  }
+});
+
+function showSites(sites) {
+  $('sites-title').textContent = sites.length ? `Blocked on this page (${sites.length})` : 'Nothing blocked yet';
+  $('sites-box').classList.toggle('empty', sites.length === 0);
+  const list = $('sites');
+  list.replaceChildren(...sites.map(({host, count}) => {
+    const item = document.createElement('li');
+    const name = document.createElement('span');
+    name.className = 'host';
+    name.textContent = host;
+    name.title = host;
+    const n = document.createElement('span');
+    n.className = 'n';
+    n.textContent = number(count);
+    item.append(name, n);
+    return item;
+  }));
+}
+
+async function refresh() {
+  try {
+    show(await sendWithPromise('getPopupState'));
+  } catch (e) {
+    // the tab went away: the browser closes the menu
+  }
+}
+
+$('power').addEventListener('click', () => {
+  if (state && state.applicable) {
+    chrome.send('setSiteEnabled', [!state.enabled]);
+    setTimeout(refresh, 150);
+  }
+});
+for (const button of document.querySelectorAll('.switch')) {
+  button.addEventListener('click', () => {
+    if (!state) {
+      return;
+    }
+    const name = button.dataset.switch;
+    chrome.send('setSwitch', [name, !state.switches[name]]);
+    setTimeout(refresh, 150);
+  });
+}
+for (const [id, message] of [['picker', 'startPicker'], ['zapper', 'startZapper'], ['logger', 'openLogger'],
+                             ['dashboard', 'openDashboard']]) {
+  $(id).addEventListener('click', () => chrome.send(message));
+}
+document.addEventListener('keydown', (event) => {
+  if (event.key === 'Escape') {
+    chrome.send('closeMenu');
+  }
+});
+
+refresh().then(() => chrome.send('menuReady'));
+setInterval(refresh, 1000);
diff --git a/components/thoron_adblock/procedural.js b/components/thoron_adblock/procedural.js
new file mode 100644
index 0000000000000000000000000000000000000000..56dbc006a4d08d505444f31a5ccc6bdf299579ca
--- /dev/null
+++ b/components/thoron_adblock/procedural.js
@@ -0,0 +1,354 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Thoron's page-side runner for procedural hide rules. The engine (procedural.rs) hands it the rules
+// of one document as data: [{s: selector, t: [[operator, argument], ...], a: [action, ...]}, ...].
+// It finds the elements each rule describes and marks them (a style sheet the browser inserted hides
+// or restyles what carries the mark), removes them, or takes an attribute or class off them. It looks
+// again whenever the page changes. That style sheet does not reach into a shadow tree, so an element
+// found there (`:shadow()`) gets the mark's declarations in its own style while it is marked.
+//
+// It runs in an isolated world, so a page cannot replace the DOM functions it uses. The operators and
+// what they mean are uBlock Origin's filter syntax; the code is Thoron's own.
+//
+// The engine sends this file without its comment lines, followed by the rules in parentheses, so the
+// file must stay one function expression and no line of code may start with two slashes.
+(function(filters) {
+  'use strict';
+  const doc = document;
+
+  // An argument written as /re/flags is a regular expression; anything else is text, quoted or not.
+  const unquote = (text) => {
+    const quoted = /^(["'])(.*)\1$/s.exec(text);
+    return quoted ? quoted[2].replace(/\\(.)/g, '$1') : text;
+  };
+  const matcher = (text, whole) => {
+    const regex = /^\/(.+)\/([a-z]*)$/s.exec(text);
+    if (regex) {
+      try {
+        return new RegExp(regex[1], regex[2].replace(/[gy]/g, ''));
+      } catch (e) {
+        return null;
+      }
+    }
+    const literal = unquote(text).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    return new RegExp(whole ? '^' + literal + '$' : literal);
+  };
+
+  const all = (root, selector) => {
+    try {
+      return Array.from(root.querySelectorAll(selector));
+    } catch (e) {
+      return [];
+    }
+  };
+  const unique = (nodes) => Array.from(new Set(nodes));
+  const keep = (test) => (nodes) => nodes.filter(test);
+
+  // The node as its parent's n-th child, so a selector can go on from the node itself.
+  const self = (node, rest) => {
+    const parent = node.parentElement;
+    if (!parent) {
+      return [];
+    }
+    let position = 1;
+    for (let e = node.previousElementSibling; e; e = e.previousElementSibling) {
+      position++;
+    }
+    return all(parent, ':scope > :nth-child(' + position + ')' + rest);
+  };
+  // A selector that starts from `node`: "> a" its children, "+ a" and "~ a" its siblings, "a" what is
+  // inside it.
+  const relative = (node, selector) => {
+    const s = selector.trim();
+    if (s === '') {
+      return [node];
+    }
+    if (s[0] === '+' || s[0] === '~') {
+      return self(node, ' ' + s);
+    }
+    return all(node, s[0] === '>' ? ':scope ' + s : s);
+  };
+  // CSS written after an operator. Without a space before it (".x", ":not(.y)") it says more about
+  // the node itself.
+  const continued = (node, selector) =>
+    /^[.:\[#]/.test(selector) ? self(node, selector.trim()) : relative(node, selector);
+
+  const computed = (pseudo) => (arg) => {
+    const colon = arg.indexOf(':');
+    const name = arg.slice(0, colon).trim();
+    const value = matcher(arg.slice(colon + 1).trim(), true);
+    return keep((node) => {
+      const style = getComputedStyle(node, pseudo);
+      return value !== null && style !== null && value.test(style.getPropertyValue(name) || style[name] || '');
+    });
+  };
+
+  // The element's shadow tree, open or closed. `thoronShadowRoot` is the browser's: only this isolated
+  // world has it, and it hands back nothing a page could not already reach from its own world.
+  const shadowOf = (node) => {
+    if (typeof thoronShadowRoot === 'function') {
+      try {
+        return thoronShadowRoot(node);
+      } catch (e) {
+        return null;
+      }
+    }
+    return node.shadowRoot || null;
+  };
+
+  let watchAttributes = false;
+  const operators = {
+    'spath': (selector) => (nodes) => unique(nodes.flatMap((node) => continued(node, selector))),
+    'shadow': (selector) => (nodes) => unique(nodes.flatMap((node) => {
+      const root = shadowOf(node);
+      return root ? all(root, selector) : [];
+    })),
+    'has-text': (arg) => {
+      const text = matcher(arg, false);
+      return keep((node) => text !== null && text.test(node.textContent));
+    },
+    'min-text-length': (arg) => {
+      const least = parseInt(arg, 10);
+      return keep((node) => node.textContent.length >= least);
+    },
+    'matches-path': (arg) => {
+      const path = matcher(arg, false);
+      return (nodes) => (path !== null && path.test(location.pathname + location.search) ? nodes : []);
+    },
+    'matches-media': (arg) => {
+      let query = null;
+      try {
+        query = matchMedia(arg);
+        query.addEventListener('change', schedule);
+      } catch (e) {
+        query = null;
+      }
+      return (nodes) => (query !== null && query.matches ? nodes : []);
+    },
+    'matches-attr': (arg) => {
+      const parts = /^("[^"]*"|\/.+?\/[a-z]*|[^=]+)(?:=(.+))?$/s.exec(arg);
+      const name = parts ? matcher(parts[1], true) : null;
+      const value = parts && parts[2] !== undefined ? matcher(parts[2], true) : null;
+      const anyValue = parts !== null && parts[2] === undefined;
+      return keep((node) => name !== null && Array.from(node.attributes).some(
+          (a) => name.test(a.name) && (anyValue || (value !== null && value.test(a.value)))));
+    },
+    'matches-css': computed(null),
+    'matches-css-before': computed('::before'),
+    'matches-css-after': computed('::after'),
+    'upward': (arg) => {
+      const levels = /^\d+$/.test(arg) ? parseInt(arg, 10) : 0;
+      return (nodes) => unique(nodes.map((node) => {
+        if (levels === 0) {
+          try {
+            return node.parentElement && node.parentElement.closest(arg);
+          } catch (e) {
+            return null;
+          }
+        }
+        let e = node;
+        for (let i = 0; i < levels && e; i++) {
+          e = e.parentElement;
+        }
+        return e;
+      }).filter(Boolean));
+    },
+    'xpath': (arg) => (nodes) => unique(nodes.flatMap((node) => {
+      const found = [];
+      try {
+        const result = doc.evaluate(arg, node, null, XPathResult.UNORDERED_NODE_SNAPSHOT_TYPE, null);
+        for (let i = 0; i < result.snapshotLength; i++) {
+          const item = result.snapshotItem(i);
+          if (item.nodeType === 1) {
+            found.push(item);
+          }
+        }
+      } catch (e) {
+        found.length = 0;
+      }
+      return found;
+    })),
+    // Everything that is not one of the nodes, inside one, or around one.
+    'others': () => (nodes) => {
+      const chosen = new Set(nodes);
+      const around = new Set();
+      for (const node of nodes) {
+        for (let e = node.parentElement; e; e = e.parentElement) {
+          around.add(e);
+        }
+      }
+      const rest = [];
+      const visit = (element) => {
+        for (const child of element.children) {
+          if (chosen.has(child) || child.localName === 'head') {
+            continue;
+          }
+          if (around.has(child)) {
+            visit(child);
+          } else {
+            rest.push(child);
+          }
+        }
+      };
+      if (doc.documentElement && !chosen.has(doc.documentElement)) {
+        visit(doc.documentElement);
+      }
+      return rest;
+    },
+    'watch-attr': () => {
+      watchAttributes = true;
+      return (nodes) => nodes;
+    },
+    'has': (program) => {
+      const inner = build(program);
+      return keep((node) => inner(node).length > 0);
+    },
+    'not': (program) => {
+      const inner = build(program);
+      return keep((node) => inner(node).length === 0);
+    },
+  };
+
+  // A program as a function: the elements it finds, in the document or starting from `root`.
+  function build(program) {
+    const steps = program.t.map(([name, arg]) => operators[name](arg));
+    return (root) => {
+      let nodes;
+      if (root !== undefined) {
+        nodes = relative(root, program.s);
+      } else if (program.s === '') {
+        nodes = doc.documentElement ? [doc.documentElement] : [];
+      } else {
+        nodes = all(doc, program.s);
+      }
+      for (const step of steps) {
+        if (nodes.length === 0) {
+          break;
+        }
+        nodes = step(nodes);
+      }
+      return nodes;
+    };
+  }
+
+  const rules = filters.map((filter) => ({find: build(filter), action: filter.a}));
+  // mark (an attribute name) -> the elements that carry it since the last look
+  let marked = new Map();
+  // mark -> its declarations as [property, value, priority], for elements in a shadow tree
+  const declarations = new Map();
+  for (const {action} of rules) {
+    if (action[0] === 'mark' && typeof action[2] === 'string' && !declarations.has(action[1])) {
+      declarations.set(action[1], action[2].split(';').map((d) => {
+        const colon = d.indexOf(':');
+        const value = d.slice(colon + 1).trim();
+        const important = /!\s*important$/i.test(value);
+        return [d.slice(0, colon).trim(), value.replace(/!\s*important$/i, '').trim(), important ? 'important' : ''];
+      }).filter(([name, value]) => name !== '' && value !== ''));
+    }
+  }
+  // element in a shadow tree -> what its own style said before, to give back when the mark goes
+  const before = new Map();
+  const inShadow = (node) => node.getRootNode() !== doc;
+  const styleShadowed = (node, name) => {
+    if (!before.has(node)) {
+      before.set(node, node.getAttribute('style'));
+    }
+    for (const [property, value, priority] of declarations.get(name) || []) {
+      node.style.setProperty(property, value, priority);
+    }
+  };
+  const unstyleShadowed = (node) => {
+    if (!before.has(node)) {
+      return;
+    }
+    const style = before.get(node);
+    before.delete(node);
+    if (style === null) {
+      node.removeAttribute('style');
+    } else {
+      node.setAttribute('style', style);
+    }
+  };
+
+  const look = () => {
+    const now = new Map();
+    for (const {find, action} of rules) {
+      let nodes;
+      try {
+        nodes = find();
+      } catch (e) {
+        nodes = [];
+      }
+      const [kind, name] = action;
+      if (kind === 'mark') {
+        if (!now.has(name)) {
+          now.set(name, new Set());
+        }
+        for (const node of nodes) {
+          now.get(name).add(node);
+        }
+        continue;
+      }
+      for (const node of nodes) {
+        if (kind === 'remove') {
+          node.remove();
+        } else if (kind === 'remove-attr') {
+          node.removeAttribute(name);
+        } else if (kind === 'remove-class') {
+          node.classList.remove(name);
+        }
+      }
+    }
+    for (const [name, nodes] of now) {
+      for (const node of nodes) {
+        if (!node.hasAttribute(name)) {
+          node.setAttribute(name, '');
+        }
+        if (inShadow(node)) {
+          styleShadowed(node, name);
+        }
+      }
+    }
+    // an element a rule no longer describes gets its mark taken off
+    for (const [name, nodes] of marked) {
+      const still = now.get(name);
+      for (const node of nodes) {
+        if (!still || !still.has(node)) {
+          node.removeAttribute(name);
+          if (![...now.values()].some((other) => other.has(node))) {
+            unstyleShadowed(node);
+          }
+        }
+      }
+    }
+    marked = now;
+  };
+
+  // Looking costs time on a large page: the next look waits ten times as long as the last one took,
+  // at least 50 ms and at most 5 s, so this never takes more than about a tenth of the page's time.
+  let timer = 0;
+  let cost = 0;
+  const lookNow = () => {
+    clearTimeout(timer);
+    timer = 0;
+    const began = performance.now();
+    look();
+    cost = performance.now() - began;
+  };
+  function schedule() {
+    if (timer === 0) {
+      timer = setTimeout(lookNow, Math.min(Math.max(50, cost * 10), 5000));
+    }
+  }
+
+  new MutationObserver(schedule).observe(doc, {
+    childList: true,
+    subtree: true,
+    characterData: true,
+    attributes: watchAttributes,
+  });
+  doc.addEventListener('DOMContentLoaded', lookNow);
+  addEventListener('load', schedule);
+  schedule();
+})
