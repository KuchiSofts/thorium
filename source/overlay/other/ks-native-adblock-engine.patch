+class HttpResponseHeaders;
+}
+
+namespace thoron_adblock {
+
+class ListFetch;
+
+// The browser's one native ad-blocking engine. It is loaded on a background
+// thread the first time it is needed (the updated engine, else the shipped
+// one); until it is ready it blocks nothing. Once loaded, a ListUpdater keeps
+// the lists current. All calls are on the UI thread.
+class EngineService {
+ public:
+  static EngineService& Get();
+
+  EngineService(const EngineService&) = delete;
+  EngineService& operator=(const EngineService&) = delete;
+
+  // Where updated lists are kept (<user data dir>/Thoron Adblock) and how to
+  // reach the network for them. Only the first call counts; without it the
+  // shipped engine is used and never updated.
+  void Configure(const base::FilePath& user_data_dir,
+                 ListUpdater::FactoryGetter factory_getter);
+  bool is_configured() const { return configured_; }
+
+  // Starts loading the engine once (no-op afterwards).
+  void EnsureStarted();
+
+  // What to do with a request.
+  struct Decision {
+    // The request must not reach the network.
+    bool blocked = false;
+    // Only with `blocked`: a data: URL holding a harmless stand-in to answer
+    // with (a filter asked for it). Empty: end the request with an error.
+    std::string stand_in;
+    // Only without `blocked`: the address to ask for instead. The one a
+    // `$uritransform` rule of a trusted list makes of the request's own (for a
+    // page or a frame any web address, for anything else one of the same
+    // origin), else the request's own without the parameters `$removeparam`
+    // rules take out. Invalid (empty): the address stays as it is.
+    GURL clean_url;
+    // Only without `blocked`: `$header` rules could apply to the request, and
+    // this is what its answer is to be held against (HeaderTestsBlock). Empty,
+    // nearly always: the answer does not matter.
+    std::string header_tests;
+  };
+
+  // Only http(s) and ws(s) requests with a known initiator are considered;
+  // every other request is allowed. `method` is the HTTP method ("GET").
+  Decision Check(const GURL& url,
+                 const GURL& source,
+                 network::mojom::RequestDestination destination,
+                 std::string_view method) const;
+
+  // True when a server's answer with `headers` ends the request whose
+  // decision carried `tests` (Decision::header_tests). An answer the browser
+  // made up itself (an internal redirect) ends nothing. Needs no engine: any
+  // thread may ask.
+  static bool HeaderTestsBlock(const std::string& tests,
+                               const net::HttpResponseHeaders* headers);
+
+  // True when the lists block a WebSocket connection to `url` (ws or wss)
+  // from the document at `source`.
+  bool BlocksWebSocket(const GURL& url, const GURL& source) const;
+
+  // True when the lists' `$popup` rules (or `$all`) block the window or tab
+  // that the page at `opener` opens at `url` (http or https).
+  bool BlocksPopup(const GURL& url, const GURL& opener) const;
+
+  // Strict blocking: true when the lists block the page at `url` (http or
+  // https) itself, with a rule for whole pages or one for its whole host.
+  bool BlocksPage(const GURL& url) const;
+
+  // For a document's own request (a page, or a frame in one): the address
+  // without the parameters `$removeparam` rules take out. Invalid (empty)
+  // when nothing is to be removed. `source` is the page's own address for a
+  // page, and for a frame who asked or the page it is in.
+  GURL CleanUrl(const GURL& url, const GURL& source, bool main_frame) const;
+
+  // The address a `$uritransform` rule of a trusted list makes of the address
+  // of a page's own request. Empty when there is none. Always a plain http or
+  // https address without a user name, and never `url` itself.
+  GURL TransformUrl(const GURL& url) const;
+
+  // Where a navigation of the main frame to `url` should go instead, when a
+  // `$urlskip` rule of a trusted list finds the destination written inside
+  // the address of a redirector. Empty when the navigation stays as it is. The
+  // result is always a plain http or https address without a user name, and
+  // never `url` itself.
+  GURL SkipUrl(const GURL& url) const;
+
+  // The content security policy `$csp` rules add to a document: the value of
+  // a Content-Security-Policy header, or empty.
+  std::string DocumentPolicy(const GURL& url,
+                             const GURL& source,
+                             bool main_frame) const;
+
+  // The value of the Permissions-Policy header for a document: the features
+  // that `$permissions` rules of the trusted lists switch off. Empty when
+  // there are none. It can only take features away from a page.
+  std::string DocumentPermissions(const GURL& url,
+                                  const GURL& source,
+                                  bool main_frame) const;
+
+  // What a document needs besides request blocking.
+  struct Document {
+    // Hides elements; to insert as a user style sheet. Empty: nothing to hide.
+    std::string stylesheet;
+    // The document's scriptlets; to run in the page's world at document start.
+    // Empty: none.
+    std::string script;
+    // The runner for the document's procedural hide rules ("has-text",
+    // "upward", "remove"...); to run in an isolated world at document start.
+    // Empty: none.
+    std::string isolated_script;
+    // The document may ask for generic hide rules (GenericStylesheet): the
+    // engine is loaded and the site has not switched generic hiding off.
+    bool generic = false;
+  };
+
+  // For the http(s) document at `url`. Empty until the engine is loaded.
+  Document ForDocument(const GURL& url) const;
+
+  // The style sheet that hides, among the class names and ids the document
+  // at `url` uses, what generic hide rules ask for. Empty when nothing
+  // matches or generic hiding is off there.
+  std::string GenericStylesheet(const GURL& url,
+                                const std::vector<std::string>& classes,
+                                const std::vector<std::string>& ids) const;
+
+  bool is_ready() const { return engine_.has_value(); }
+
+  // The filter-list type name for a request destination ("script", "image"...).
+  static std::string_view RequestType(
+      network::mojom::RequestDestination destination);
+
+  // For tests: use this engine instead of the bundled lists.
+  void SetEngineForTesting(rust::Box<Engine> engine);
+
+  // What the settings page (chrome://adblock) asks for. The file work runs on
+  // the background sequence and the answer comes back on this one. A change
+  // that was made is in use at once: its engine replaces the one before.
+  using Described = base::OnceCallback<void(base::DictValue)>;
+  // Gets "" when the change was made, else what went wrong, in plain words.
+  using Changed = base::OnceCallback<void(std::string)>;
+  // Every list with its name, address, state and rule count, the person's own
+  // rules, and how the last update went (list_store.h).
+  void DescribeSettings(Described callback);
+  // Switches a built-in list on or off.
+  void SetListEnabled(const std::string& id, bool enabled, Changed callback);
+  // Downloads the list at `url` (HTTPS only), checks it like an updated list
+  // and adds it. Its rules get no trust: no trusted scriptlets.
+  void AddList(const GURL& url, Changed callback);
+  // Removes a list the person added.
+  void RemoveList(const std::string& id, Changed callback);
+  // Replaces the person's own rules.
+  void SetMyFilters(std::string text, Changed callback);
+  // Looks for newer lists now, whenever the last check was.
+  void UpdateNow(Changed callback);
+
+  // Adds one line to the person's own rules (a rule the element picker made,
+  // picker.h), unless it is there already.
+  void AddToMyFilters(const std::string& rule, Changed callback);
+
+  // The menu's switches for a site, by name: "popups" (no window the site
+  // opens), "media" (no audio or video file larger than 50 KB), "cosmetic"
+  // (nothing hidden on the site, no scriptlets), "fonts" (no fonts loaded),
+  // "3p-script" and "3p-frame" (no script, no frame from another site:
+  // uBlock Origin's "medium mode"). A
+  // switch set for a host counts for the hosts below it too. "media",
+  // "cosmetic" and "fonts" can be on for every site (the options "default-"
+  // and the name); a site is then kept out by "-" and the name. Kept in
+  // <store>/site-switches.json.
+  bool SiteSwitch(const GURL& site, std::string_view name) const;
+  // Sets the switch for the site's host, as set or as kept out, and only when
+  // that differs from what the host would have without it.
+  void SetSiteSwitch(const GURL& site, std::string_view name, bool on);
+  // Every host with a switch set, and its switches (the dashboard), and all
+  // switches of one host cleared.
+  const std::map<std::string, std::set<std::string>>& site_switches() const {
+    return site_switches_;
+  }
+  void ClearSiteSwitches(const std::string& host);
+  // The switches of one host as given (a restored backup): only known names;
+  // none clears them.
+  void SetHostSwitches(const std::string& host,
+                       const std::vector<std::string>& names);
+
+  // "My rules", uBlock Origin's dynamic filtering (dynamic.rs): the text, and
+  // replacing it (kept in <store>/my-rules.txt, at most 1 MB; the lines that
+  // are not rules come back).
+  const std::string& my_rules() const { return my_rules_text_; }
+  std::vector<std::string> SetMyRules(std::string text);
+  // What they say about a request from a page of `top_site` to `url`: 0 no
+  // rule, 1 block, 2 allow (the lists are not asked), 3 noop (they are).
+  int DynamicVerdict(const GURL& top_site,
+                     const GURL& url,
+                     network::mojom::RequestDestination destination) const;
+
+  // The menu's grid, as uBlock Origin's: what it changes is in force at once
+  // but only for now (not saved), until the padlock saves the cells of the
+  // page (SaveGrid) or the eraser takes them back (RevertGrid). `source` is
+  // the page's host, `destinations` the hosts it asked. GridCell: as
+  // DynamicRules::grid_cell, for the rules in force.
+  int GridCell(std::string_view source,
+               std::string_view destination,
+               std::string_view kind) const;
+  // `action`: 0 removes the rule of the cell, 1 block, 2 allow, 3 noop.
+  void SetGridCell(std::string_view source,
+                   std::string_view destination,
+                   std::string_view kind,
+                   int action);
+  bool GridChanged(std::string_view source,
+                   const std::vector<std::string>& destinations) const;
+  void SaveGrid(std::string_view source,
+                const std::vector<std::string>& destinations);
+  void RevertGrid(std::string_view source,
+                  const std::vector<std::string>& destinations);
+
+  // The settings of chrome://adblock, as in uBlock Origin, by name: "badge"
+  // (the shield shows what was blocked; on unless switched off),
+  // "block-csp-reports" (reports a page's security policy asks for are not
+  // sent), "ignore-generic" (hide rules for every site are not used), and
+  // "default-media", "default-cosmetic", "default-fonts" (the menu's switch of
+  // that name on for every site), "auto-update" (the lists are checked on
+  // their own), "context-menu" ("Block element..." in the page's context
+  // menu), "advanced" (the menu's grid of rules). Kept in
+  // <store>/options.json.
+  static bool KnownOption(std::string_view name);
+  bool Option(std::string_view name) const;
+  void SetOption(std::string_view name, bool on);
+  // "Block media elements larger than N kB": N (50 unless changed). False for
+  // a number out of range (1 to 1,048,576).
+  int large_media_kb() const;
+  bool SetLargeMediaKb(int kb);
+  // True once the saved switches, settings and rules were read (or there are
+  // none to read): before, a setting reads as its default.
+  bool saved_state_read() const { return saved_state_read_; }
+
+  // One more blocked request; how many since counting started. Kept in
+  // <store>/stats.json, written at most every 30 seconds.
+  void CountBlocked();
+  int64_t total_blocked() const { return total_blocked_; }
+
+ private:
+  friend class base::NoDestructor<EngineService>;
+  EngineService();
+  ~EngineService();
+
+  StorePaths Paths() const;
+  void OnBuilt(std::optional<rust::Box<Engine>> engine);
+  void OnNewEngine(rust::Box<Engine> engine);
+  // Per probe request (list_store.h), whether the current engine blocks it.
+  std::vector<bool> ProbesBlocked() const;
+  void StartAddFetch(GURL url, base::FilePath path, Changed callback);
+  void OnListFetched(GURL url, Changed callback, base::FilePath path);
+  void OnChanged(Changed callback, ChangeResult change);
+
+  struct SavedState {
+    SavedState();
+    SavedState(SavedState&&);
+    SavedState& operator=(SavedState&&);
+    ~SavedState();
+    std::map<std::string, std::set<std::string>> switches;
+    std::map<std::string, bool> options;
+    int media_kb = 0;
+    std::string my_rules;
