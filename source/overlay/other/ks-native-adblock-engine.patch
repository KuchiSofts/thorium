@@ -0,0 +1,683 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `$header`: a request is ended when the answer to it carries a header a rule names, as in
+//! `/^https:\/\/www\.[a-z]{8,14}\.com\/[a-z]{1,4}\.js$/$script,3p,match-case,header=x-powered-by:Express`.
+//! The lists use it against ad servers whose addresses change all the time but whose answers
+//! give them away.
+//!
+//! adblock-rust does not know the option. The work is in two steps:
+//!
+//! 1. When a request starts, it is known which rules could apply to it (its address, who asks, its
+//!    type and method). The rules are kept in a small engine of their own for that. adblock-rust
+//!    names only one matching rule per question, except for `$csp` rules, of which it names all:
+//!    so each rule is rewritten as a `$csp` rule whose "policy" is the rule's number. What those
+//!    rules ask of the answer goes with the request as a few lines of text (`HeaderRules::tests`);
+//!    for nearly every request there are none.
+//! 2. When the answer arrives, its headers are held against those lines (`blocked_by`). This step
+//!    needs no engine, so it can be done wherever the answer is seen.
+//!
+//! A rule can only end a request, like any blocking rule, so every list may bring such rules.
+//!
+//! Not supported: `requestheader=` (a test of what the browser sends; the cookies are added where
+//! this code does not see them). Such a rule is not used.
+
+use crate::urlskip::host_is_in;
+use adblock::lists::{parse_filter, FilterSet, ParseOptions, ParsedLine};
+use adblock::request::Request;
+use regex::bytes::{Regex, RegexBuilder};
+
+/// At most this many rules are carried with one request.
+const MAX_TESTS: usize = 16;
+/// The longest `header=` value that is read.
+const MAX_VALUE: usize = 1024;
+
+/// What a rule asks of one header of the answer. Read as uBlock Origin reads it (parseHeaderValue):
+/// "name" (the header is there), "name:text" (its value holds the text, in any case; `*` and `?`
+/// stand for any run of characters and for at most one), "name:/re/" or "name:/re/i" (its value
+/// matches), and "name:~..." for the opposite, which is also true without the header.
+pub struct Test {
+    name: Vec<u8>,
+    not: bool,
+    value: Option<Regex>,
+}
+
+impl Test {
+    pub fn parse(option: &str) -> Option<Test> {
+        let option = option.trim();
+        if option.len() > MAX_VALUE {
+            return None;
+        }
+        let (name, value) = option.split_once(':').unwrap_or((option, ""));
+        if name.is_empty() || !name.bytes().all(|b| b.is_ascii_graphic()) {
+            return None;
+        }
+        let (not, value) = match value.strip_prefix('~') {
+            Some(rest) => (true, rest),
+            None => (false, value),
+        };
+        if value.is_empty() {
+            // "name:~" asks for nothing that can be told
+            return (!not).then(|| Test { name: name.to_ascii_lowercase().into_bytes(), not, value: None });
+        }
+        let (source, any_case) = match regex_literal(value) {
+            Some(literal) => literal,
+            None => (glob(value), true),
+        };
+        // Bytes, not text: a header's value is whatever the server sent. The size limit keeps a
+        // rule from costing much to prepare; matching takes time in line with the value's length.
+        let value = RegexBuilder::new(&source).case_insensitive(any_case).unicode(false).size_limit(1 << 20).build().ok()?;
+        Some(Test { name: name.to_ascii_lowercase().into_bytes(), not, value: Some(value) })
+    }
+
+    /// `headers`: the answer's headers in the order they came, names in lower case. As in uBlock
+    /// Origin, the first header of the name is the one that counts.
+    fn passes(&self, headers: &[(Vec<u8>, &[u8])]) -> bool {
+        match headers.iter().find(|(name, _)| *name == self.name) {
+            None => self.not,
+            Some((_, value)) => match &self.value {
+                None => true,
+                Some(re) => re.is_match(value) != self.not,
+            },
+        }
+    }
+}
+
+/// "/re/" and "/re/i" as (the expression, whether the case is ignored).
+fn regex_literal(value: &str) -> Option<(String, bool)> {
+    let rest = value.strip_prefix('/')?;
+    let (source, any_case) = match rest.strip_suffix("/i") {
+        Some(source) => (source, true),
+        None => (rest.strip_suffix('/')?, false),
+    };
+    (!source.is_empty()).then(|| (source.to_string(), any_case))
+}
+
+/// Plain text with `*` and `?` as the expression that finds it; "\*" and "\?" are not wildcards.
+fn glob(value: &str) -> String {
+    let (mut out, mut literal, mut previous) = (String::new(), String::new(), '\0');
+    for c in value.chars() {
+        if (c == '*' || c == '?') && previous != '\\' {
+            out.push_str(&regex::escape(&literal));
+            literal.clear();
+            out.push_str(if c == '*' { ".*" } else { ".?" });
+        } else {
+            literal.push(c);
+        }
+        previous = c;
+    }
+    out.push_str(&regex::escape(&literal));
+    out
+}
+
+/// The request types a rule can name, as the lists write them and as the browser names them.
+pub(crate) const TYPES: &[(&str, &str)] = &[
+    ("script", "script"),
+    ("xhr", "xmlhttprequest"),
+    ("xmlhttprequest", "xmlhttprequest"),
+    ("frame", "subdocument"),
+    ("subdocument", "subdocument"),
+    ("image", "image"),
+    ("css", "stylesheet"),
+    ("stylesheet", "stylesheet"),
+    ("font", "font"),
+    ("media", "media"),
+    ("object", "object"),
+    ("object-subrequest", "object"),
+    ("other", "other"),
+    ("ping", "ping"),
+    ("beacon", "ping"),
+];
+
+/// One `$header` rule: what the small engine does not check for it.
+struct Rule {
+    /// The request types it is for (empty: all) and those it is not for.
+    only: Vec<&'static str>,
+    never: Vec<&'static str>,
+    /// `to=`: the hosts the request may go to (empty: any; "com" covers "shop.example.com") and
+    /// those it may not. adblock-rust reads the option and then leaves the whole rule out.
+    to: Vec<String>,
+    not_to: Vec<String>,
+    /// `strict1p`: the request goes to the very host of the document that asks; `strict3p`: not.
+    same_host: Option<bool>,
+    important: bool,
+    /// The value of `header=`, for `Test::parse`.
+    test: String,
+}
+
+impl Rule {
+    fn is_for(&self, request_type: &str, host: &str, same_host: impl Fn() -> bool) -> bool {
+        (self.only.is_empty() || self.only.contains(&request_type))
+            && !self.never.contains(&request_type)
+            && (self.to.is_empty() || host_is_in(host, &self.to))
+            && !host_is_in(host, &self.not_to)
+            && self.same_host.is_none_or(|wanted| wanted == same_host())
+    }
+}
+
+/// True when `text` reads as the start of an option: a name of lower-case letters, "1", "3" and
+/// "-" (or a run of "_"), then the end, a comma or "=". uBlock Origin's test (reNetOptionComma).
+fn option_starts(text: &[u8]) -> bool {
+    let blanks = text.iter().take_while(|&&b| b == b'_').count();
+    if blanks > 0 {
+        return blanks == text.len() || text[blanks] == b',';
+    }
+    let not = usize::from(text.first() == Some(&b'~'));
+    let name = text[not..].iter().take_while(|&&b| b.is_ascii_lowercase() || b == b'1' || b == b'3' || b == b'-').count();
+    name > 0 && matches!(text.get(not + name), None | Some(b',') | Some(b'='))
+}
+
+/// Where the options of a rule start: at the last "$" that an option follows, as in uBlock Origin
+/// (a pattern or a value may hold a "$" of its own).
+pub(crate) fn options_start(line: &str) -> Option<usize> {
+    line.rmatch_indices('$').map(|(at, _)| at).find(|&at| option_starts(&line.as_bytes()[at + 1..]))
+}
+
+/// The options of a rule, split as uBlock Origin splits them: a comma ends an option only when
+/// another option follows it, so a value may hold commas ("header=via:/, 1\.1 google$/"). "\," is
+/// a comma inside a value.
+pub(crate) fn split_options(options: &str) -> Vec<String> {
+    let bytes = options.as_bytes();
+    let mut out = Vec::new();
+    let mut start = 0;
+    for at in 0..bytes.len() {
+        if bytes[at] == b',' && option_starts(&bytes[at + 1..]) {
+            out.push(options[start..at].replace("\\,", ","));
+            start = at + 1;
+        }
+    }
+    out.push(options[start..].replace("\\,", ","));
+    out
+}
+
+/// A `$header` line of a list as the rule, the `$csp` rule the small engine reads for it, and
+/// whether it is an exception. `None` for every other line and for a rule that is not understood
+/// in full.
+fn rule(line: &str, number: usize) -> Option<(Rule, String, bool)> {
+    let line = line.trim();
+    if line.is_empty() || line.starts_with('!') || line.contains("##") || line.contains("#@#") {
+        return None;
+    }
+    let dollar = options_start(line)?;
+    let (pattern, exception) = match line[..dollar].strip_prefix("@@") {
+        Some(pattern) => (pattern, true),
+        None => (&line[..dollar], false),
+    };
+    let mut rule = Rule {
+        only: Vec::new(),
+        never: Vec::new(),
+        to: Vec::new(),
+        not_to: Vec::new(),
+        same_host: None,
+        important: false,
+        test: String::new(),
+    };
+    let mut kept = Vec::new();
+    for option in split_options(&line[dollar + 1..]) {
+        let option = option.trim();
+        let (negated, plain) = match option.strip_prefix('~') {
+            Some(plain) => (true, plain),
+            None => (false, option),
+        };
+        let (name, value) = match plain.split_once('=') {
+            Some((name, value)) => (name, Some(value)),
+            None => (plain, None),
+        };
+        match (name, value) {
+            ("header" | "responseheader", Some(value)) if !negated && rule.test.is_empty() => {
+                Test::parse(value)?;
+                rule.test = value.trim().to_string();
+            }
+            ("strict1p" | "strict3p", None) if !negated && rule.same_host.is_none() => {
+                rule.same_host = Some(name == "strict1p");
+            }
+            ("important", None) if !negated => rule.important = true,
+            ("3p" | "third-party" | "1p" | "first-party", None) => kept.push(option.to_string()),
+            ("match-case", None) if !negated => kept.push(option.to_string()),
+            ("to", Some(value)) if !negated && rule.to.is_empty() && rule.not_to.is_empty() => {
+                for host in value.split('|') {
+                    let (hosts, host) = match host.strip_prefix('~') {
+                        Some(host) => (&mut rule.not_to, host),
+                        None => (&mut rule.to, host),
+                    };
+                    // a name as it is; "shop.*" (any ending) is not read here
+                    if host.is_empty() || !host.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'.' || b == b'-') {
+                        return None;
+                    }
+                    hosts.push(host.to_ascii_lowercase());
+                }
+            }
+            ("from" | "domain" | "method", Some(value)) if !negated && !value.is_empty() && !value.contains(',') => {
+                kept.push(option.to_string());
+            }
+            (_, None) => {
+                // a request type, or an option that is not known here
+                let (_, named) = TYPES.iter().find(|(written, _)| *written == name)?;
+                (if negated { &mut rule.never } else { &mut rule.only }).push(*named);
+            }
+            _ => return None,
+        }
+    }
+    if rule.test.is_empty() {
+        return None;
+    }
+    let mut filter = format!("{pattern}$csp=h{number}");
+    for option in &kept {
+        filter.push(',');
+        filter.push_str(option);
+    }
+    // adblock-rust must read it as written
+    matches!(parse_filter(&filter, false, ParseOptions::default()), Ok(ParsedLine::Network(_))).then_some((rule, filter, exception))
+}
+
+/// The host of an address the browser wrote ("https://host:port/path").
+pub(crate) fn host_of(url: &str) -> &str {
+    let rest = url.split_once("://").map_or(url, |(_, rest)| rest);
+    let authority = rest.split(['/', '?', '#']).next().unwrap_or(rest);
+    let host = authority.rsplit_once('@').map_or(authority, |(_, host)| host);
+    match host.rsplit_once(':') {
+        Some((name, port)) if !port.is_empty() && port.bytes().all(|b| b.is_ascii_digit()) => name,
+        _ => host,
+    }
+}
+
+pub(crate) fn small_engine(filters: &[String]) -> Option<adblock::Engine> {
+    if filters.is_empty() {
+        return None;
+    }
+    let mut set = FilterSet::new(false);
+    set.add_filter_list(filters.join("\n"), ParseOptions::default());
+    Some(adblock::Engine::new_with_filter_set(set))
+}
+
+/// Every `$header` rule of the lists.
+#[derive(Default)]
+pub struct HeaderRules {
+    rules: Vec<Rule>,
+    /// The request types the rules are for, so that every other request is passed over at once
+    /// (the lists' rules are for scripts, fetches and frames). `None`: a rule is for every type.
+    types: Option<Vec<&'static str>>,
+    blocking: Option<adblock::Engine>,
+    allowing: Option<adblock::Engine>,
+    /// The rules as the lists wrote them, one per line: what is saved with the engine.
+    pub text: String,
+}
+
+impl HeaderRules {
+    /// From list text; every line that is not a `$header` rule is skipped.
+    pub fn from_rules(lines: &str) -> HeaderRules {
+        let mut found = HeaderRules::default();
+        let (mut blocking, mut allowing) = (Vec::new(), Vec::new());
+        for line in lines.lines().filter(|l| l.contains("header=")) {
+            let Some((rule, filter, exception)) = rule(line, found.rules.len()) else { continue };
+            found.text.push_str(line.trim());
+            found.text.push('\n');
+            found.rules.push(rule);
+            (if exception { &mut allowing } else { &mut blocking }).push(filter);
+        }
+        found.blocking = small_engine(&blocking);
+        found.allowing = small_engine(&allowing);
+        if found.rules.iter().all(|rule| !rule.only.is_empty()) {
+            let mut types: Vec<&'static str> = found.rules.iter().flat_map(|rule| rule.only.iter().copied()).collect();
+            types.sort_unstable();
+            types.dedup();
+            found.types = Some(types);
+        }
+        found
+    }
+
+    /// The rules of one of the small engines that apply to a request, in the order of the lists.
+    fn matching(&self, engine: Option<&adblock::Engine>, request: &Request, request_type: &str, hosts: (&str, &str)) -> Vec<&Rule> {
+        let Some(found) = engine.and_then(|engine| engine.get_csp_directives(request)) else { return Vec::new() };
+        let mut numbers: Vec<usize> = found.split(',').filter_map(|n| n.trim().strip_prefix('h')?.parse().ok()).collect();
+        numbers.sort_unstable();
+        numbers.dedup();
+        let host = host_of(hosts.0).to_ascii_lowercase();
+        let same_host = || host.eq_ignore_ascii_case(host_of(hosts.1));
+        numbers.into_iter().filter_map(|n| self.rules.get(n)).filter(|rule| rule.is_for(request_type, &host, same_host)).collect()
+    }
+
+    /// What the answer to a request is to be held against (`blocked_by`): one line per rule that
+    /// could apply, "" when none does. `request_type` is the browser's name for the type; a page's
+    /// own request is never ended. `excepted` says whether an exception rule of the lists matches
+    /// the request ("@@||site.example^"); it is only asked when a rule applies. Such a request is
+    /// spared, as in uBlock Origin, except by a rule marked `important`.
+    pub fn tests(&self, url: &str, source_url: &str, request_type: &str, method: &str, excepted: impl FnOnce() -> bool) -> String {
+        if self.rules.is_empty()
+            || request_type == "document"
+            || self.types.as_ref().is_some_and(|types| !types.contains(&request_type))
+        {
+            return String::new();
+        }
+        // The small engines only name `$csp` rules for a document; the type is checked here.
+        let Ok(request) = Request::new(url, source_url, "subdocument", method) else { return String::new() };
+        let hosts = (url, source_url);
+        let blocking = self.matching(self.blocking.as_ref(), &request, request_type, hosts);
+        if blocking.is_empty() {
+            return String::new();
+        }
+        let spared = excepted();
+        let mut lines: Vec<String> = blocking
+            .into_iter()
+            .filter(|rule| rule.important || !spared)
+            .map(|rule| format!("{}{}", if rule.important { 'B' } else { 'b' }, rule.test))
+            .collect();
+        if lines.is_empty() {
+            return String::new();
+        }
+        // exceptions of this kind count only when the answer is as they say
+        lines.extend(
+            self.matching(self.allowing.as_ref(), &request, request_type, hosts).into_iter().map(|rule| format!("a{}", rule.test)),
+        );
+        lines.truncate(MAX_TESTS);
+        lines.join("\n")
+    }
+}
+
+/// True when the answer with these headers ends the request. `tests` is what `HeaderRules::tests`
+/// gave for it; `headers` is one "name:value" per line, in the order the headers came.
+pub fn blocked_by(tests: &str, headers: &[u8]) -> bool {
+    let headers: Vec<(Vec<u8>, &[u8])> = headers
+        .split(|&b| b == b'\n')
+        .filter_map(|line| {
+            let colon = line.iter().position(|&b| b == b':')?;
+            Some((line[..colon].trim_ascii().to_ascii_lowercase(), line[colon + 1..].trim_ascii()))
+        })
+        .collect();
+    let (mut blocked, mut important, mut allowed) = (false, false, false);
+    for line in tests.lines().take(MAX_TESTS) {
+        let Some(kind) = line.chars().next() else { continue };
+        if !Test::parse(&line[kind.len_utf8()..]).is_some_and(|test| test.passes(&headers)) {
+            continue;
+        }
+        match kind {
+            'B' => important = true,
+            'b' => blocked = true,
+            'a' => allowed = true,
+            _ => {}
+        }
+    }
+    important || (blocked && !allowed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn passes(option: &str, headers: &str) -> bool {
+        // through `blocked_by`, as the browser asks
+        Test::parse(option).expect(option);
+        blocked_by(&format!("b{option}"), headers.as_bytes())
+    }
+
+    const ANSWER: &str = "Content-Type: text/javascript\nX-Powered-By: Express\nVia: 2.3 Tomcat\n\
+                          ETag: W/\"5e1c-18a2b\"\nLink: <https://adsco.re/>;rel=preconnect\nX-Request-ID: 0123456789abcdef0123456789abcdef\n";
+
+    #[test]
+    fn a_header_that_is_there() {
+        assert!(passes("x-powered-by", ANSWER));
+        assert!(passes("X-Powered-By", ANSWER));
+        assert!(!passes("x-77-pop", ANSWER));
+        assert!(!passes("x-powered", ANSWER)); // the whole name
+        assert!(!passes("x-powered-by", ""));
+    }
+
+    #[test]
+    fn a_value_in_plain_text_is_found_in_any_case() {
+        assert!(passes("x-powered-by:Express", ANSWER));
+        assert!(passes("x-powered-by:express", ANSWER));
+        assert!(passes("x-powered-by:pres", ANSWER));
+        assert!(passes("via:2.3 tomcat", ANSWER));
+        assert!(!passes("via:2x3 tomcat", ANSWER)); // "." is a dot
+        assert!(!passes("x-powered-by:PHP", ANSWER));
+        // "*" is any run of characters, "?" at most one
+        assert!(passes("etag:W/\"*-*\"", ANSWER));
+        assert!(passes("link:*adsco.re*", ANSWER));
+        assert!(passes("link:*/>;rel=preconnect", ANSWER));
+        assert!(passes("x-powered-by:Expres?s", ANSWER));
+        assert!(!passes("x-powered-by:Exp?ss", ANSWER));
+        assert!(!passes("etag:W/\"*_*\"", ANSWER));
+        // what the lists wrote without the closing "/" is plain text, and never found
+        assert!(!passes("via:/^2\\.\\d (apache|tomcat|nginx)$", ANSWER));
+    }
+
+    #[test]
+    fn a_value_as_a_regular_expression() {
+        assert!(passes("x-request-id:/^[0-9a-f]{32}$/", ANSWER));
+        assert!(!passes("x-request-id:/^[0-9a-f]{31}$/", ANSWER));
+        assert!(passes("link:/adsco\\.re\\/>;rel=preconnect/", ANSWER));
+        assert!(passes("etag:/^W\\/\"[0-9a-z]+-[0-9a-zA-Z]+(?:\\/[0-9a-zA-Z]+)?\"$/", ANSWER));
+        // the case counts unless the rule says otherwise
+        assert!(!passes("via:/tomcat/", ANSWER));
+        assert!(passes("via:/tomcat/i", ANSWER));
+        assert!(passes("via:/^2\\.\\d (apache|tomcat|nginx)$/i", ANSWER));
+    }
+
+    #[test]
+    fn the_opposite() {
+        assert!(passes("x-powered-by:~PHP", ANSWER));
+        assert!(!passes("x-powered-by:~Express", ANSWER));
+        assert!(passes("via:~/apache/i", ANSWER));
+        assert!(!passes("via:~/tomcat/i", ANSWER));
+        // without the header it is true as well
+        assert!(passes("server:~nginx", ANSWER));
+    }
+
+    #[test]
+    fn the_first_header_of_a_name_counts_and_values_are_bytes() {
+        assert!(passes("set-cookie:first", "Set-Cookie: first=1\nSet-Cookie: second=2\n"));
+        assert!(!passes("set-cookie:second", "Set-Cookie: first=1\nSet-Cookie: second=2\n"));
+        assert!(blocked_by("bserver:caf", b"Server: caf\xe9\xff\n"));
+        assert!(blocked_by("bserver:/^caf.{2}$/", b"Server: caf\xe9\xff\n"));
+        // a value with a colon, and lines that are not headers
+        assert!(passes("location:https://stg.*", "Location: https://stg.example.com/x\n\nnot a header\n"));
+    }
+
+    #[test]
+    fn a_test_that_is_not_understood_is_none() {
+        for bad in ["", ":value", "na me:value", "name:~", "name:/(?=x)y/", "name:/(x)\\1/", "name:/[/"] {
+            assert!(Test::parse(bad).is_none(), "{bad}");
+        }
+        assert!(Test::parse(&format!("name:{}", "x".repeat(MAX_VALUE))).is_none());
+        // too large to prepare
+        assert!(Test::parse("name:/(?:[a-z]{1000}){1000}/").is_none());
+    }
+
+    #[test]
+    fn a_rule_is_rewritten_for_the_small_engine() {
+        let (found, filter, exception) =
+            rule("/^https:\\/\\/www\\.[a-z]{8,14}\\.com\\/[a-z]{1,4}\\.js$/$script,3p,match-case,header=x-powered-by:Express,from=~edu|~gov,to=com|~photopea.com", 7)
+                .unwrap();
+        assert_eq!(
+            filter,
+            "/^https:\\/\\/www\\.[a-z]{8,14}\\.com\\/[a-z]{1,4}\\.js$/$csp=h7,3p,match-case,from=~edu|~gov"
+        );
+        assert_eq!((found.only, found.never, found.same_host, found.important, exception), (vec!["script"], vec![], None, false, false));
+        assert_eq!((found.to, found.not_to), (vec!["com".to_string()], vec!["photopea.com".to_string()]));
+        assert_eq!(found.test, "x-powered-by:Express");
+
+        let (found, filter, _) = rule("/^https?:\\/\\/[^\\/]+\\/_fd$/$xhr,1p,strict1p,header=X-Request-Id:/^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/", 0).unwrap();
+        assert_eq!(filter, "/^https?:\\/\\/[^\\/]+\\/_fd$/$csp=h0,1p");
+        assert_eq!((found.only, found.same_host), (vec!["xmlhttprequest"], Some(true)));
+        assert_eq!(found.test, "X-Request-Id:/^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/");
+
+        // the option first, a comma inside its value, an exception, other names for it
+        let (found, filter, exception) = rule("@@||cdn.example^$responseheader=vary:/^referer\\,accept/i,script,~image,important", 3).unwrap();
+        assert_eq!((filter.as_str(), exception, found.important), ("||cdn.example^$csp=h3", true, true));
+        assert_eq!((found.only, found.never), (vec!["script"], vec!["image"]));
+        assert_eq!(found.test, "vary:/^referer,accept/i");
+        let (found, filter, _) = rule("://www.*.css|$script,xhr,3p,to=com,method=get|head,header=popads-node", 1).unwrap();
+        assert_eq!(filter, "://www.*.css|$csp=h1,3p,method=get|head");
+        assert_eq!(found.only, vec!["script", "xmlhttprequest"]);
+        assert_eq!(found.to, vec!["com".to_string()]);
+    }
+
+    #[test]
+    fn the_options_are_found_and_split_as_ublock_origin_does() {
+        // the last "$" that an option follows
+        let options = |line: &'static str| options_start(line).map(|at| &line[at + 1..]);
+        assert_eq!(options(r"/^https?:\/\/[a-z]{8,15}\.com\/$/$xhr,3p,header=name:/x$/"), Some("xhr,3p,header=name:/x$/"));
+        assert_eq!(
+            options(r"||x.example^$script,header=via:/^2\.\d (apache|nginx)$"),
+            Some(r"script,header=via:/^2\.\d (apache|nginx)$")
+        );
+        assert_eq!(options("/[$&]/$3p,header=x"), Some("3p,header=x"));
+        assert_eq!(options("||x.example^$~third-party"), Some("~third-party"));
+        assert_eq!(options("||x.example/a$b"), Some("b"));
+        assert_eq!(options("||x.example/a$B"), None);
+        assert_eq!(options("||x.example/a$"), None);
+        assert_eq!(options("||x.example^"), None);
+        // a comma ends an option only when another option follows
+        assert_eq!(split_options("script,3p,header=via:/, 1\\.1 google$/"), ["script", "3p", "header=via:/, 1\\.1 google$/"]);
+        assert_eq!(split_options("header=etag:/^W\\/\"[0-9a-f]{8,}\"$/,from=~edu|~gov"), ["header=etag:/^W\\/\"[0-9a-f]{8,}\"$/", "from=~edu|~gov"]);
+        assert_eq!(split_options("header=vary:/^referer\\,accept/i,script"), ["header=vary:/^referer,accept/i", "script"]);
+        assert_eq!(split_options("script,_,~image,__"), ["script", "_", "~image", "__"]);
+        assert_eq!(split_options("header=a:b,c d,1p"), ["header=a:b,c d", "1p"]);
+        assert_eq!(split_options(""), [""]);
+
+        let (found, filter, _) = rule("/_static/delivery.js?nonce=$script,1p,header=via:/, 1\\.1 google$/", 0).unwrap();
+        assert_eq!((filter.as_str(), found.test.as_str()), ("/_static/delivery.js?nonce=$csp=h0,1p", "via:/, 1\\.1 google$/"));
+        assert!(blocked_by("bvia:/, 1\\.1 google$/", b"Via: 1.1 varnish, 1.1 google\n"));
+    }
+
+    #[test]
+    fn a_rule_that_is_not_understood_is_left_out() {
+        for not_taken in [
+            "||ads.example^$script",
+            "||ads.example/header=x^$script",
+            "! ||ads.example^$script,header=x",
+            "news.example##.header=x",
+            "||ads.example^$script,header=",
+            "||ads.example^$script,header=x,header=y",
+            "||ads.example^$script,~header=x",
+            "||ads.example^$script,requestheader=cookie:*x*",
+            "||ads.example^$script,header=x,requestheader=cookie",
+            "||ads.example^$doc,header=x",
+            "||ads.example^$script,header=x,redirect=noopjs",
+            "||ads.example^$script,header=x,removeparam=y",
+            "||ads.example^$script,header=x,csp=script-src 'none'",
+            "||ads.example^$script,header=x,ipaddress=1.2.3.4",
+            "||ads.example^$script,header=x,denyallow=y.example",
+            "||ads.example^$script,header=x,strict1p,strict3p",
+            "||ads.example^$script,header=x,to=shop.*",
+            "||ads.example^$script,header=x,to=a.example,to=b.example",
+            "||ads.example^$script,header=x,to=",
+            "||ads.example^$script,header=x:/(?=y)z/",
+            "||ads.example^$header=x,match-case", // adblock-rust: only with a regular expression
+            "||ads.example^$script, header=x",
+            "/ads.js?api_key=*&header=$all",
+        ] {
+            assert!(rule(not_taken, 0).is_none(), "{not_taken}");
+        }
+    }
+
+    const PAGE: &str = "https://news.example/story";
+
+    fn rules() -> HeaderRules {
+        HeaderRules::from_rules(
+            "||ads.example^\n\
+             ://www.*.css|$script,xhr,3p,to=com,header=popads-node\n\
+             ://www.*.css|$script,xhr,3p,to=com,header=x-77-pop\n\
+             ||cdn.example/lib.js$script,header=server:/^openresty\\//\n\
+             /^https?:\\/\\/[^\\/]+\\/_fd$/$xhr,1p,strict1p,header=x-request-id\n\
+             ||api.example^$method=head,header=x-partner\n\
+             ||loud.example^$important,header=x-ad\n\
+             ||wide.example^$script,to=~cdn.wide.example|~wide.example.net,header=x-wide\n\
+             @@||cdn.example^$script,header=x-safe:yes\n\
+             ||odd.example^$script,requestheader=cookie\n",
+        )
+    }
+
+    fn tests_for(rules: &HeaderRules, url: &str, request_type: &str, method: &str) -> String {
+        rules.tests(url, PAGE, request_type, method, || false)
+    }
+
+    #[test]
+    fn the_rules_that_could_apply_go_with_the_request() {
+        let rules = rules();
+        assert_eq!(rules.text.lines().count(), 8, "{}", rules.text);
+        // two rules for the same address
+        assert_eq!(tests_for(&rules, "https://www.pop.com/a.css", "script", "GET"), "bpopads-node\nbx-77-pop");
+        assert_eq!(tests_for(&rules, "https://www.pop.com/a.css", "xmlhttprequest", "GET"), "bpopads-node\nbx-77-pop");
+        // not the type, not a .com host, not another site's request
+        assert_eq!(tests_for(&rules, "https://www.pop.com/a.css", "image", "GET"), "");
+        assert_eq!(tests_for(&rules, "https://www.pop.net/a.css", "script", "GET"), "");
+        assert_eq!(rules.tests("https://www.pop.com/a.css", "https://www.pop.com/", "script", "GET", || false), "");
+        // an exception of this kind goes along
+        assert_eq!(tests_for(&rules, "https://cdn.example/lib.js", "script", "GET"), "bserver:/^openresty\\//\nax-safe:yes");
+        assert_eq!(tests_for(&rules, "https://cdn.example/other.js", "script", "GET"), "");
+        // hosts the rule is not for
+        assert_eq!(tests_for(&rules, "https://wide.example/a.js", "script", "GET"), "bx-wide");
+        assert_eq!(tests_for(&rules, "https://img.wide.example/a.js", "script", "GET"), "bx-wide");
+        assert_eq!(tests_for(&rules, "https://cdn.wide.example/a.js", "script", "GET"), "");
+        assert_eq!(tests_for(&rules, "https://a.cdn.wide.example/a.js", "script", "GET"), "");
+        // the method
+        assert_eq!(tests_for(&rules, "https://api.example/", "xmlhttprequest", "HEAD"), "bx-partner");
+        assert_eq!(tests_for(&rules, "https://api.example/", "xmlhttprequest", "GET"), "");
+        // a page's own request is never ended
+        assert_eq!(tests_for(&rules, "https://api.example/", "document", "HEAD"), "");
+        assert_eq!(tests_for(&rules, "https://plain.example/x.js", "script", "GET"), "");
+        assert_eq!(tests_for(&rules, "not an address", "script", "GET"), "");
+        assert_eq!(HeaderRules::default().tests("https://www.pop.com/a.css", PAGE, "script", "GET", || false), "");
+    }
+
+    #[test]
+    fn a_request_of_a_type_no_rule_is_for_is_passed_over() {
+        let some = HeaderRules::from_rules("||a.example^$script,header=x\n||b.example^$xhr,frame,script,header=y\n");
+        assert_eq!(some.types, Some(vec!["script", "subdocument", "xmlhttprequest"]));
+        assert_eq!(tests_for(&some, "https://a.example/x", "script", "GET"), "bx");
+        assert_eq!(tests_for(&some, "https://a.example/x", "image", "GET"), "");
+        // a rule for every type: every request is looked at
+        assert_eq!(rules().types, None);
+        let all = HeaderRules::from_rules("||a.example^$header=x\n");
+        assert_eq!(tests_for(&all, "https://a.example/x", "image", "GET"), "bx");
+        assert_eq!(HeaderRules::default().types, None);
+    }
+
+    #[test]
+    fn strict1p_wants_the_very_host_of_the_document() {
+        let rules = rules();
+        assert_eq!(rules.tests("https://news.example/_fd", PAGE, "xmlhttprequest", "GET", || false), "bx-request-id");
+        // the same site, another host
+        assert_eq!(rules.tests("https://api.news.example/_fd", PAGE, "xmlhttprequest", "GET", || false), "");
+        assert_eq!(host_of("https://News.Example:8443/a?b#c"), "News.Example");
+        assert_eq!(host_of("https://user:pw@localhost:8443/a"), "localhost");
+        assert_eq!(host_of("http://[::1]:8080/"), "[::1]");
+        assert_eq!(host_of("http://[::1]/"), "[::1]");
+        assert_eq!(host_of("https://news.example"), "news.example");
+    }
+
+    #[test]
+    fn an_exception_rule_of_the_lists_spares_the_request_unless_the_rule_is_important() {
+        let rules = rules();
+        assert_eq!(rules.tests("https://www.pop.com/a.css", PAGE, "script", "GET", || true), "");
+        assert_eq!(rules.tests("https://loud.example/a.js", PAGE, "script", "GET", || true), "Bx-ad");
+        assert_eq!(rules.tests("https://loud.example/a.js", PAGE, "script", "GET", || false), "Bx-ad");
+        // the lists are only asked about exceptions when a rule applies
+        assert_eq!(rules.tests("https://plain.example/x.js", PAGE, "script", "GET", || panic!("asked")), "");
+    }
+
+    #[test]
+    fn the_answer_decides() {
+        assert!(blocked_by("bpopads-node\nbx-77-pop", b"Content-Type: text/css\nX-77-Pop: 1\n"));
+        assert!(!blocked_by("bpopads-node\nbx-77-pop", b"Content-Type: text/css\n"));
+        assert!(!blocked_by("", b"X-77-Pop: 1\n"));
+        // an exception whose header is there spares the request, but not from an important rule
+        let tests = "bserver:/^openresty\\//\nax-safe:yes";
+        assert!(blocked_by(tests, b"Server: openresty/1.2\n"));
+        assert!(!blocked_by(tests, b"Server: openresty/1.2\nX-Safe: yes\n"));
+        assert!(!blocked_by(tests, b"Server: nginx\n"));
+        assert!(blocked_by("Bx-ad\nax-safe", b"X-Ad: 1\nX-Safe: yes\n"));
+        // lines that are not tests are passed over, and only so many are read
+        assert!(!blocked_by("?x-ad\n\nbname:/[/", b"X-Ad: 1\nName: x\n"));
+        let many = format!("{}bx-ad", "bnone\n".repeat(MAX_TESTS));
+        assert!(!blocked_by(&many, b"X-Ad: 1\n"));
+    }
+
+    #[test]
+    fn at_most_so_many_rules_go_with_one_request() {
+        let lines: String = (0..40).map(|n| format!("||many.example^$script,header=x-{n}\n")).collect();
+        let rules = HeaderRules::from_rules(&lines);
+        assert_eq!(tests_for(&rules, "https://many.example/a.js", "script", "GET").lines().count(), MAX_TESTS);
+    }
+}
