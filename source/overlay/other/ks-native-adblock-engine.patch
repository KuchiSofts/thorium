@@ -0,0 +1,96 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_RENDERER_DOCUMENT_AGENT_H_
+#define COMPONENTS_THORON_ADBLOCK_RENDERER_DOCUMENT_AGENT_H_
+
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "components/thoron_adblock/document_agent.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/public/renderer/render_frame_observer_tracker.h"
+#include "mojo/public/cpp/bindings/associated_receiver.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "mojo/public/cpp/bindings/pending_associated_receiver.h"
+
+namespace thoron_adblock {
+
+// The renderer side of native cosmetic filtering and scriptlets, one per
+// frame. It applies what the browser sent for the document being committed:
+// a style sheet that hides elements, a script that runs before any page
+// script, and a script for procedural hide rules that runs in an isolated
+// world. For generic hide rules it tells the browser which class names and
+// ids the document uses, a few times while the page builds, and inserts the
+// style sheet that comes back. It deletes itself with its frame.
+class DocumentAgent : public content::RenderFrameObserver,
+                      public content::RenderFrameObserverTracker<DocumentAgent>,
+                      public mojom::DocumentAgent {
+ public:
+  // `isolated_world_id`: the embedder's world for the procedural runner.
+  DocumentAgent(content::RenderFrame* render_frame, int32_t isolated_world_id);
+  DocumentAgent(const DocumentAgent&) = delete;
+  DocumentAgent& operator=(const DocumentAgent&) = delete;
+  ~DocumentAgent() override;
+
+  // Called by the embedder when the frame's document element exists and no
+  // page script has run yet. Applies the document's resources once.
+  void RunAtDocumentStart();
+
+  base::WeakPtr<DocumentAgent> AsWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  struct Resources {
+    std::string stylesheet;
+    std::string script;
+    std::string isolated_script;
+    bool generic = false;
+  };
+
+  // content::RenderFrameObserver:
+  void DidCreateNewDocument() override;
+  void DidDispatchDOMContentLoadedEvent() override;
+  void DidFinishLoad() override;
+  void OnDestruct() override;
+
+  // mojom::DocumentAgent:
+  void SetForNextCommittedLoad(const std::string& stylesheet,
+                               const std::string& script,
+                               const std::string& isolated_script,
+                               bool generic) override;
+
+  void Bind(mojo::PendingAssociatedReceiver<mojom::DocumentAgent> receiver);
+
+  // Generic hide rules: looks through the document for class names and ids
+  // not reported yet and asks the browser about them.
+  void Survey();
+  // Surveys again later while the page may still be adding content;
+  // `step` counts the follow-ups.
+  void SurveyLater(int step);
+  void OnGenericStylesheet(const std::string& stylesheet);
+  void InsertStylesheet(const std::string& stylesheet);
+
+  const int32_t isolated_world_id_;
+  // For the document that commits next, and for the one that just did.
+  std::optional<Resources> next_;
+  std::optional<Resources> current_;
+  // The current document may ask for generic hide rules.
+  bool generic_ = false;
+  // Class names and ids of the current document the browser was asked about.
+  std::set<std::string> seen_classes_;
+  std::set<std::string> seen_ids_;
+  mojo::AssociatedRemote<mojom::DocumentHost> host_;
+  mojo::AssociatedReceiver<mojom::DocumentAgent> receiver_{this};
+  // Invalidated with each new document, so nothing asked for an earlier
+  // document is applied to the next.
+  base::WeakPtrFactory<DocumentAgent> document_factory_{this};
+  base::WeakPtrFactory<DocumentAgent> weak_factory_{this};
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_RENDERER_DOCUMENT_AGENT_H_
