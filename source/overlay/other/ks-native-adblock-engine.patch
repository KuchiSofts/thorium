@@ -0,0 +1,227 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/redirect_watcher.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/no_destructor.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "net/base/net_errors.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+// One sequence for every watcher: they only pass messages on.
+scoped_refptr<base::SequencedTaskRunner> WatcherRunner() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  return *runner;
+}
+
+// On the UI thread, where the engine is: what to do with a redirect to `url`.
+EngineService::Decision CheckOnUI(GURL url, RedirectWatcher::Context context) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  EngineService::Decision decision =
+      EngineService::Get().Check(url, context.source, context.destination);
+  if (decision.blocked && context.frame) {
+    BlockedCount::Record(context.frame);
+  }
+  return decision;
+}
+
+}  // namespace
+
+// static
+void RedirectWatcher::Start(
+    Context context,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    mojo::PendingRemote<network::mojom::URLLoader> target_loader,
+    mojo::PendingReceiver<network::mojom::URLLoaderClient>
+        target_client_receiver) {
+  WatcherRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](Context context,
+             mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+             mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+             mojo::PendingRemote<network::mojom::URLLoader> target_loader,
+             mojo::PendingReceiver<network::mojom::URLLoaderClient>
+                 target_client_receiver) {
+            // Owns itself (DeleteIfDone).
+            new RedirectWatcher(std::move(context), std::move(loader_receiver),
+                                std::move(client), std::move(target_loader),
+                                std::move(target_client_receiver));
+          },
+          std::move(context), std::move(loader_receiver), std::move(client),
+          std::move(target_loader), std::move(target_client_receiver)));
+}
+
+RedirectWatcher::RedirectWatcher(
+    Context context,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    mojo::PendingRemote<network::mojom::URLLoader> target_loader,
+    mojo::PendingReceiver<network::mojom::URLLoaderClient>
+        target_client_receiver)
+    : context_(std::move(context)) {
+  // base::Unretained is safe: the pipe ends are members, and a handler does
+  // not run once its pipe end is reset or destroyed.
+  loader_receiver_.Bind(std::move(loader_receiver));
+  loader_receiver_.set_disconnect_with_reason_handler(
+      base::BindOnce(&RedirectWatcher::OnLoaderClosedByRenderer,
+                     base::Unretained(this)));
+  client_.Bind(std::move(client));
+  client_.set_disconnect_handler(base::BindOnce(
+      &RedirectWatcher::OnClientClosedByRenderer, base::Unretained(this)));
+  target_loader_.Bind(std::move(target_loader));
+  target_loader_.set_disconnect_handler(base::BindOnce(
+      &RedirectWatcher::OnLoaderClosedByNetwork, base::Unretained(this)));
+  target_client_receiver_.Bind(std::move(target_client_receiver));
+  target_client_receiver_.set_disconnect_handler(base::BindOnce(
+      &RedirectWatcher::OnClientClosedByNetwork, base::Unretained(this)));
+}
+
+RedirectWatcher::~RedirectWatcher() = default;
+
+void RedirectWatcher::OnReceiveEarlyHints(
+    network::mojom::EarlyHintsPtr early_hints) {
+  client_->OnReceiveEarlyHints(std::move(early_hints));
+}
+
+void RedirectWatcher::OnReceiveResponse(
+    network::mojom::URLResponseHeadPtr head,
+    mojo::ScopedDataPipeConsumerHandle body,
+    std::optional<mojo_base::BigBuffer> cached_metadata) {
+  client_->OnReceiveResponse(std::move(head), std::move(body),
+                             std::move(cached_metadata));
+}
+
+void RedirectWatcher::OnReceiveRedirect(
+    const net::RedirectInfo& redirect_info,
+    network::mojom::URLResponseHeadPtr head) {
+  // Nothing more from the network for this request until the engine has
+  // answered, so the client hears everything in the order it happened.
+  target_client_receiver_.Pause();
+  content::GetUIThreadTaskRunner({})->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&CheckOnUI, redirect_info.new_url, context_),
+      base::BindOnce(&RedirectWatcher::OnRedirectChecked,
+                     weak_factory_.GetWeakPtr(), redirect_info,
+                     std::move(head)));
+}
+
+void RedirectWatcher::OnRedirectChecked(
+    net::RedirectInfo redirect_info,
+    network::mojom::URLResponseHeadPtr head,
+    EngineService::Decision decision) {
+  if (!client_.is_bound() || !target_client_receiver_.is_bound()) {
+    return;  // the request ended meanwhile
+  }
+  if (decision.blocked) {
+    client_->OnComplete(
+        network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+    // The network must not follow the redirect: both sides are closed.
+    CloseLoader();
+    CloseClient();
+    DeleteIfDone();
+    return;
+  }
+  // The network service only follows a redirect to another address of the
+  // same origin, and to none that carries a user name or password.
+  if (decision.clean_url.is_valid() && !decision.clean_url.has_username() &&
+      !decision.clean_url.has_password()) {
+    clean_redirect_ = decision.clean_url;
+    redirect_info.new_url = decision.clean_url;
+  }
+  target_client_receiver_.Resume();
+  client_->OnReceiveRedirect(redirect_info, std::move(head));
+}
+
+void RedirectWatcher::OnUploadProgress(int64_t current_position,
+                                       int64_t total_size,
+                                       OnUploadProgressCallback callback) {
+  client_->OnUploadProgress(current_position, total_size, std::move(callback));
+}
+
+void RedirectWatcher::OnTransferSizeUpdated(int32_t transfer_size_diff) {
+  client_->OnTransferSizeUpdated(transfer_size_diff);
+}
+
+void RedirectWatcher::OnComplete(
+    const network::URLLoaderCompletionStatus& status) {
+  client_->OnComplete(status);
+}
+
+void RedirectWatcher::FollowRedirect(
+    network::HttpRequestHeadersUpdateParams headers_update_params,
+    const std::optional<GURL>& new_url) {
+  if (!target_loader_.is_bound()) {
+    return;
+  }
+  // The client was told the redirect leads to the clean address; now the
+  // network is told to go there.
+  const std::optional<GURL> target =
+      clean_redirect_ ? std::exchange(clean_redirect_, std::nullopt) : new_url;
+  target_loader_->FollowRedirect(std::move(headers_update_params), target);
+}
+
+void RedirectWatcher::SetPriority(net::RequestPriority priority,
+                                  int intra_priority_value) {
+  if (target_loader_.is_bound()) {
+    target_loader_->SetPriority(priority, intra_priority_value);
+  }
+}
+
+void RedirectWatcher::OnLoaderClosedByRenderer(uint32_t reason,
+                                               const std::string& text) {
+  loader_receiver_.reset();
+  if (target_loader_.is_bound()) {
+    target_loader_.ResetWithReason(reason, text);
+  }
+  DeleteIfDone();
+}
+
+void RedirectWatcher::OnLoaderClosedByNetwork() {
+  CloseLoader();
+  DeleteIfDone();
+}
+
+void RedirectWatcher::OnClientClosedByRenderer() {
+  CloseClient();
+  DeleteIfDone();
+}
+
+void RedirectWatcher::OnClientClosedByNetwork() {
+  CloseClient();
+  DeleteIfDone();
+}
+
+void RedirectWatcher::CloseLoader() {
+  loader_receiver_.reset();
+  target_loader_.reset();
+}
+
+void RedirectWatcher::CloseClient() {
+  client_.reset();
+  target_client_receiver_.reset();
+}
+
+void RedirectWatcher::DeleteIfDone() {
+  if (!loader_receiver_.is_bound() && !target_loader_.is_bound() &&
+      !client_.is_bound() && !target_client_receiver_.is_bound()) {
+    delete this;
+  }
+}
+
+}  // namespace thoron_adblock
