+// static
+EngineService::SavedState EngineService::ReadSavedState(base::FilePath dir) {
+  SavedState out;
+  std::string text;
+  if (base::ReadFileToStringWithMaxSize(dir.Append(kSiteSwitchesFile), &text,
+                                        2 * 1024 * 1024)) {
+    std::optional<base::Value> value = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+    if (value && value->is_dict()) {
+      for (const auto [host, names] : value->GetDict()) {
+        if (!names.is_list() || out.switches.size() >= kMaxSwitchHosts) {
+          continue;
+        }
+        for (const base::Value& name : names.GetList()) {
+          if (name.is_string() && KnownSwitch(name.GetString())) {
+            out.switches[host].insert(name.GetString());
+          }
+        }
+      }
+    }
+  }
+  text.clear();
+  if (base::ReadFileToStringWithMaxSize(dir.Append(kMyRulesFile), &text,
+                                        kMaxMyRulesBytes) &&
+      base::IsStringUTF8(text)) {
+    out.my_rules = text;
+  }
+  text.clear();
+  if (base::ReadFileToStringWithMaxSize(dir.Append(kOptionsFile), &text, 4096)) {
+    std::optional<base::Value> value = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+    if (value && value->is_dict()) {
+      for (const auto [name, on] : value->GetDict()) {
+        if (on.is_bool() && KnownOption(name)) {
+          out.options[name] = on.GetBool();
+        }
+      }
+      std::optional<int> kb = value->GetDict().FindInt("media-kb");
+      if (kb && *kb >= 1 && *kb <= kMaxMediaKb) {
+        out.media_kb = *kb;
+      }
+    }
+  }
+  text.clear();
+  if (base::ReadFileToStringWithMaxSize(dir.Append(kStatsFile), &text, 4096)) {
+    std::optional<base::Value> value = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+    if (value && value->is_dict()) {
+      if (std::optional<double> total = value->GetDict().FindDouble("blocked");
+          total && *total > 0 && *total < 9e15) {
+        out.total = static_cast<int64_t>(*total);
+      }
+    }
+  }
+  return out;
+}
+
+void EngineService::OnSavedStateRead(SavedState state) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // switches set before the file was read win
+  for (auto& [host, names] : state.switches) {
+    site_switches_.emplace(host, std::move(names));
+  }
+  for (const auto& [name, on] : state.options) {
+    options_.emplace(name, on);
+  }
+  if (media_kb_ == 0) {
+    media_kb_ = state.media_kb;
+  }
+  // rules set before the file was read win
+  if (!my_rules_ && !state.my_rules.empty()) {
+    my_rules_text_ = std::move(state.my_rules);
+    UseSessionRules(my_rules_text_);
+  }
+  saved_state_read_ = true;
+  total_blocked_ += state.total;
+}
