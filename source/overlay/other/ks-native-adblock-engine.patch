@@ -0,0 +1,85 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_SUBRESOURCE_LOADER_THROTTLE_H_
+#define COMPONENTS_THORON_ADBLOCK_SUBRESOURCE_LOADER_THROTTLE_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+#include "url/gurl.h"
+
+class HostContentSettingsMap;
+
+namespace net {
+class HttpResponseHeaders;
+}
+
+namespace network {
+struct ResourceRequest;
+}
+
+namespace thoron_adblock {
+
+// The files a page needs that the browser fetches itself, before the page or
+// without it, and so not through the request proxy: above all the preloads a
+// server announces with "103 Early Hints" while the page is still on its way
+// (Chromium's NavigationEarlyHintsManager). They are put to the engine like
+// any request of the page: one the lists block is not made, and one whose
+// answer gives an ad server away (`$header`) is ended. Nothing is done on a
+// site where the person allowed ads.
+class SubresourceLoaderThrottle : public blink::URLLoaderThrottle {
+ public:
+  // Null when native ad blocking is off, or `request` is not one of these:
+  // a script, style sheet, font, image, track or media file a page asked for,
+  // over http(s). Documents, worker scripts and downloads are left to the
+  // pieces that handle them.
+  static std::unique_ptr<blink::URLLoaderThrottle> MaybeCreate(
+      const network::ResourceRequest& request,
+      scoped_refptr<HostContentSettingsMap> settings);
+
+  SubresourceLoaderThrottle(const SubresourceLoaderThrottle&) = delete;
+  SubresourceLoaderThrottle& operator=(const SubresourceLoaderThrottle&) =
+      delete;
+  ~SubresourceLoaderThrottle() override;
+
+  // True for the request destinations this throttle looks at. Public for
+  // tests.
+  static bool IsForDestination(network::mojom::RequestDestination destination);
+
+ private:
+  SubresourceLoaderThrottle(scoped_refptr<HostContentSettingsMap> settings,
+                            const network::ResourceRequest& request);
+
+  // blink::URLLoaderThrottle:
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override;
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override;
+  void WillProcessResponse(const GURL& response_url,
+                           network::mojom::URLResponseHead* response_head,
+                           bool* defer) override;
+
+  // Puts the request for `url` to the engine; true when it was ended.
+  bool Ended(const GURL& url, const std::string& method);
+  // True when the answer with `headers` ends the request (`$header`).
+  bool EndedByAnswer(const net::HttpResponseHeaders* headers);
+
+  const scoped_refptr<HostContentSettingsMap> settings_;
+  const network::mojom::RequestDestination destination_;
+  // The page the request is for.
+  const GURL source_;
+  // What the current address's answer is held against (`$header`).
+  std::string header_tests_;
+  bool allowed_ = false;
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_SUBRESOURCE_LOADER_THROTTLE_H_
diff --git a/components/thoron_adblock/uritransform.rs b/components/thoron_adblock/uritransform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4f326f1763efc75d7c771facbe8aeaae9ff03fd7
--- /dev/null
+++ b/components/thoron_adblock/uritransform.rs
@@ -0,0 +1,482 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `$uritransform`: a request goes to the address a rule makes of its own, by a regular expression
+//! and a replacement, as in `||shop.example/dp/*/ref=$doc,uritransform=/\/ref=[^\/?#]+//`, which
+//! takes the tracking part out of a product page's address. uBlock Origin's lists use it against
+//! tracking in addresses and to answer an anti-blocker's check ("adblock=true" to "false").
+//!
+//! As uBlock Origin does it (static-net-filtering.js, transformURL):
+//!
+//! - The value is `/pattern/replacement/flags`. "\/" is a "/" inside the pattern or the
+//!   replacement, "\$" and "\," are a "$" and a ",". An empty pattern stands for the rule's own
+//!   address pattern, which must then be a regular expression (`/re/$xhr,uritransform=//$1$2/`).
+//! - The pattern is tried on the whole address. The first match is replaced (every match with the
+//!   flag "g"); "$1", "$&" and "$$" in the replacement are what they are in JavaScript.
+//! - Of the rules that match a request, the first one, in the order of the lists, that changes the
+//!   address is used. An exception (`@@...$uritransform` takes every such rule away from the
+//!   request, `@@...$uritransform=<value>` the rules with that value).
+//! - Only rules of trusted lists count (engine_core.rs): a rule can send a request somewhere else.
+//!   The browser checks what comes out (engine_service.cc): a page or a frame is sent on by a
+//!   redirect it sees; any other request may only go to another address of the same origin.
+//!
+//! Which rules match a request is said by a small engine of their own, with each rule as a `$csp`
+//! rule whose value is the rule's number: of `$csp` rules adblock-rust names all that match
+//! (header.rs does the same).
+
+use crate::header::{host_of, options_start, small_engine, split_options, TYPES};
+use crate::urlskip::host_is_in;
+use adblock::lists::{parse_filter, ParseOptions, ParsedLine};
+use adblock::request::Request;
+use regex::{Regex, RegexBuilder};
+
+/// The longest address that is made.
+const MAX_URL: usize = 8192;
+
+/// What a rule does to an address.
+struct Transform {
+    re: Regex,
+    replacement: String,
+    all: bool,
+}
+
+impl Transform {
+    /// From the value `/pattern/replacement/flags`; `own` is the rule's address pattern when it is
+    /// a regular expression ("/re/"), for an empty pattern. `None` when it is not understood.
+    fn parse(value: &str, own: Option<&str>) -> Option<Transform> {
+        let rest = value.strip_prefix('/')?;
+        let (pattern, rest) = until_slash(rest)?;
+        let (replacement, flags) = until_slash(rest)?;
+        let pattern = if pattern.is_empty() { own?.to_string() } else { pattern };
+        let (mut any_case, mut all) = (false, false);
+        for flag in flags.chars() {
+            match flag {
+                'i' if !any_case => any_case = true,
+                'g' if !all => all = true,
+                _ => return None,
+            }
+        }
+        // the size limit keeps a rule from costing much to prepare; matching is linear in time
+        let re = RegexBuilder::new(&pattern).case_insensitive(any_case).size_limit(1 << 20).build().ok()?;
+        Some(Transform { replacement: js_replacement(&replacement, re.captures_len() - 1)?, re, all })
+    }
+
+    fn apply(&self, url: &str) -> Option<String> {
+        if !self.re.is_match(url) {
+            return None;
+        }
+        let out = if self.all {
+            self.re.replace_all(url, self.replacement.as_str())
+        } else {
+            self.re.replace(url, self.replacement.as_str())
+        };
+        (out != url && out.len() <= MAX_URL).then(|| out.into_owned())
+    }
+}
+
+/// Text up to the next "/" that is not after a backslash, and the text after it. Escaped "/", "$"
+/// and "," lose their backslash (ArglistParser.normalizeArg); every other backslash stays.
+fn until_slash(text: &str) -> Option<(String, &str)> {
+    let mut out = String::new();
+    let mut chars = text.char_indices().peekable();
+    while let Some((at, c)) = chars.next() {
+        match c {
+            '\\' => match chars.peek() {
+                Some(&(_, next @ ('/' | '$' | ','))) => {
+                    out.push(next);
+                    chars.next();
+                }
+                Some(&(_, next)) => {
+                    out.push('\\');
+                    out.push(next);
+                    chars.next();
+                }
+                None => out.push('\\'),
+            },
+            '/' => return Some((out, &text[at + 1..])),
+            _ => out.push(c),
+        }
+    }
+    None
+}
+
+/// A JavaScript replacement string as the `regex` crate writes it: "$1" and "$12" (when there are
+/// so many groups) are groups, "$&" the whole match, "$$" a "$", any other "$" itself. `None` for
+/// what the `regex` crate has no word for ("$`", "$'", "$<name>").
+fn js_replacement(text: &str, groups: usize) -> Option<String> {
+    let bytes = text.as_bytes();
+    let mut out = String::new();
+    let mut at = 0;
+    while at < bytes.len() {
+        if bytes[at] != b'$' {
+            let next = text[at..].find('$').map_or(text.len(), |n| at + n);
+            out.push_str(&text[at..next]);
+            at = next;
+            continue;
+        }
+        match bytes.get(at + 1) {
+            Some(b'$') => {
+                out.push_str("$$");
+                at += 2;
+            }
+            Some(b'&') => {
+                out.push_str("${0}");
+                at += 2;
+            }
+            Some(b'`' | b'\'' | b'<') => return None,
+            Some(d) if d.is_ascii_digit() => {
+                let one = (d - b'0') as usize;
+                let two = bytes.get(at + 2).filter(|b| b.is_ascii_digit()).map(|b| one * 10 + (b - b'0') as usize);
+                match two {
+                    Some(n) if (1..=groups).contains(&n) => {
+                        out.push_str(&format!("${{{n}}}"));
+                        at += 3;
+                    }
+                    _ if (1..=groups).contains(&one) => {
+                        out.push_str(&format!("${{{one}}}"));
+                        at += 2;
+                    }
+                    _ => {
+                        out.push_str("$$");
+                        at += 1;
+                    }
+                }
+            }
+            _ => {
+                out.push_str("$$");
+                at += 1;
+            }
+        }
+    }
+    Some(out)
+}
+
+/// A `to=` entry: "shop.example" (and what is below it), "~shop.example" (not there), or
+/// "www.amazon.*" (that name under any ending, as uBlock Origin's entities).
+fn host_matches(host: &str, entry: &str) -> bool {
+    match entry.strip_suffix(".*") {
+        Some(name) => {
+            let mut from = 0;
+            while let Some(found) = host[from..].find(name) {
+                let start = from + found;
+                let end = start + name.len();
+                if (start == 0 || host.as_bytes()[start - 1] == b'.')
+                    && host.as_bytes().get(end) == Some(&b'.')
+                    && end + 1 < host.len()
+                {
+                    return true;
+                }
+                from = start + 1;
+            }
+            false
+        }
+        None => host_is_in(host, &[entry.to_string()]),
+    }
+}
+
+/// One `$uritransform` rule: what the small engine does not check for it.
+struct Rule {
+    only: Vec<&'static str>,
+    never: Vec<&'static str>,
+    to: Vec<String>,
+    not_to: Vec<String>,
+    /// The value as written, for exceptions that name it.
+    value: String,
+    /// `None` for an exception.
+    transform: Option<Transform>,
+}
+
+impl Rule {
+    fn is_for(&self, request_type: &str, host: &str) -> bool {
+        (self.only.is_empty() || self.only.contains(&request_type))
+            && !self.never.contains(&request_type)
+            && (self.to.is_empty() || self.to.iter().any(|entry| host_matches(host, entry)))
+            && !self.not_to.iter().any(|entry| host_matches(host, entry))
+    }
+}
+
+/// A `$uritransform` line of a list as the rule, the `$csp` rule the small engine reads for it and
+/// whether it is an exception. `None` for every other line and for a rule not understood in full.
+fn rule(line: &str, number: usize) -> Option<(Rule, String, bool)> {
+    let line = line.trim();
+    if line.is_empty() || line.starts_with('!') || line.contains("##") || line.contains("#@#") {
+        return None;
+    }
+    let dollar = options_start(line)?;
+    let (pattern, exception) = match line[..dollar].strip_prefix("@@") {
+        Some(pattern) => (pattern, true),
+        None => (&line[..dollar], false),
+    };
+    let own = pattern.strip_prefix('/').and_then(|p| p.strip_suffix('/')).filter(|p| !p.is_empty());
+    let mut rule =
+        Rule { only: Vec::new(), never: Vec::new(), to: Vec::new(), not_to: Vec::new(), value: String::new(), transform: None };
+    let (mut found, mut kept) = (false, Vec::new());
+    for option in split_options(&line[dollar + 1..]) {
+        let option = option.trim();
+        let (negated, plain) = match option.strip_prefix('~') {
+            Some(plain) => (true, plain),
+            None => (false, option),
+        };
+        let (name, value) = match plain.split_once('=') {
+            Some((name, value)) => (name, Some(value)),
+            None => (plain, None),
+        };
+        match (name, value) {
+            ("uritransform", value) if !negated && !found => {
+                found = true;
+                match value {
+                    Some(value) if !exception => {
+                        rule.transform = Some(Transform::parse(value, own)?);
+                        rule.value = value.to_string();
+                    }
+                    Some(value) => rule.value = value.to_string(),
+                    None if exception => {}
+                    None => return None,
+                }
+            }
+            ("doc" | "document", None) if !negated => rule.only.push("document"),
+            ("to", Some(value)) if !negated && rule.to.is_empty() && rule.not_to.is_empty() => {
+                for host in value.split('|') {
+                    let (hosts, host) = match host.strip_prefix('~') {
+                        Some(host) => (&mut rule.not_to, host),
+                        None => (&mut rule.to, host),
+                    };
+                    let name = host.strip_suffix(".*").unwrap_or(host);
+                    if name.is_empty() || !name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'.' || b == b'-') {
+                        return None;
+                    }
+                    hosts.push(host.to_ascii_lowercase());
+                }
+            }
+            ("3p" | "third-party" | "1p" | "first-party", None) => kept.push(option.to_string()),
+            ("match-case", None) if !negated => kept.push(option.to_string()),
+            ("from" | "domain", Some(value)) if !negated && !value.is_empty() => kept.push(option.to_string()),
+            (_, None) => {
+                let (_, named) = TYPES.iter().find(|(written, _)| *written == name)?;
+                (if negated { &mut rule.never } else { &mut rule.only }).push(*named);
+            }
+            _ => return None,
+        }
+    }
+    if !found {
+        return None;
+    }
+    // an exception is asked about the same way, in an engine of its own
+    let mut filter = format!("{pattern}$csp=t{number}");
+    for option in &kept {
+        filter.push(',');
+        filter.push_str(option);
+    }
+    matches!(parse_filter(&filter, false, ParseOptions::default()), Ok(ParsedLine::Network(_)))
+        .then_some((rule, filter, exception))
+}
+
+/// Every `$uritransform` rule of the trusted lists.
+#[derive(Default)]
+pub struct TransformRules {
+    rules: Vec<Rule>,
+    changing: Option<adblock::Engine>,
+    sparing: Option<adblock::Engine>,
+    /// The rules as the lists wrote them, one per line: what is saved with the engine.
+    pub text: String,
+}
+
+impl TransformRules {
+    /// From lines of trusted lists; every line that is not a `$uritransform` rule is skipped.
+    pub fn from_trusted_text(lines: &str) -> TransformRules {
+        let mut found = TransformRules::default();
+        let (mut changing, mut sparing) = (Vec::new(), Vec::new());
+        for line in lines.lines().filter(|l| l.contains("uritransform")) {
+            let Some((rule, filter, exception)) = rule(line, found.rules.len()) else { continue };
+            found.text.push_str(line.trim());
+            found.text.push('\n');
+            found.rules.push(rule);
+            (if exception { &mut sparing } else { &mut changing }).push(filter);
+        }
+        found.changing = small_engine(&changing);
+        found.sparing = small_engine(&sparing);
+        found
+    }
+
+    /// The rules of one of the small engines that apply to a request, in the order of the lists.
+    fn matching(&self, engine: Option<&adblock::Engine>, request: &Request, request_type: &str, host: &str) -> Vec<&Rule> {
+        let Some(found) = engine.and_then(|engine| engine.get_csp_directives(request)) else { return Vec::new() };
+        let mut numbers: Vec<usize> = found.split(',').filter_map(|n| n.trim().strip_prefix('t')?.parse().ok()).collect();
+        numbers.sort_unstable();
+        numbers.dedup();
+        numbers.into_iter().filter_map(|n| self.rules.get(n)).filter(|rule| rule.is_for(request_type, host)).collect()
+    }
+
+    /// The address a request for `url` is to go to instead, or `None`. `request_type` is the
+    /// browser's name for it ("document" for a page, "subdocument" for a frame).
+    pub fn apply(&self, url: &str, source_url: &str, request_type: &str) -> Option<String> {
+        self.changing.as_ref()?;
+        // The small engines only name `$csp` rules for a document; the type is checked here.
+        let request = Request::new(url, source_url, "subdocument", "GET").ok()?;
+        let host = host_of(url).to_ascii_lowercase();
+        let changing = self.matching(self.changing.as_ref(), &request, request_type, &host);
+        if changing.is_empty() {
+            return None;
+        }
+        let spared: Vec<&str> =
+            self.matching(self.sparing.as_ref(), &request, request_type, &host).into_iter().map(|r| r.value.as_str()).collect();
+        if spared.contains(&"") {
+            return None;
+        }
+        changing.into_iter().filter(|r| !spared.contains(&r.value.as_str())).find_map(|r| r.transform.as_ref()?.apply(url))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn transform(value: &str, url: &str) -> Option<String> {
+        Transform::parse(value, None).expect(value).apply(url)
+    }
+
+    #[test]
+    fn a_value_is_read_as_ublock_origin_reads_it() {
+        // the rules of the lists
+        assert_eq!(
+            transform(r"/\/ref=[^\/?#]+//", "https://www.shop.example/dp/B01/ref=sr_1_1?k=x").as_deref(),
+            Some("https://www.shop.example/dp/B01?k=x")
+        );
+        assert_eq!(
+            transform(r"/\.html\/[^?#]+/.html/", "https://www.photo.example/c/product/123-REG/x.html/overview").as_deref(),
+            Some("https://www.photo.example/c/product/123-REG/x.html")
+        );
+        assert_eq!(
+            transform(r"/\/subscribers\/[-0-9a-f]+\/archive\//\/archive\//", "https://mail.example/l/subscribers/0a-1f/archive/p").as_deref(),
+            Some("https://mail.example/l/archive/p")
+        );
+        assert_eq!(
+            transform("/adblock%3Dtrue/adblock%3Dfalse/", "https://check.example/v?q=adblock%3Dtrue").as_deref(),
+            Some("https://check.example/v?q=adblock%3Dfalse")
+        );
+        assert_eq!(transform("/#Echobox=[\\d]{10}$//", "https://news.example/a#Echobox=1234567890").as_deref(), Some("https://news.example/a"));
+        // nothing to change
+        assert_eq!(transform("/reklama=1/reklama=0/", "https://news.example/video.aspx?reklama=0"), None);
+        // what never matches a whole address, as in uBlock Origin
+        assert_eq!(transform(r"/^\/ref\/[^\/]+//", "https://shop.example/ref/abc/x"), None);
+    }
+
+    #[test]
+    fn the_first_match_or_every_match_and_the_case() {
+        assert_eq!(transform("/o/0/", "https://x.test/ooo").as_deref(), Some("https://x.test/0oo"));
+        assert_eq!(transform("/o/0/g", "https://x.test/ooo").as_deref(), Some("https://x.test/000"));
+        assert_eq!(transform("/O/0/", "https://x.test/ooo"), None);
+        assert_eq!(transform("/O/0/i", "https://x.test/ooo").as_deref(), Some("https://x.test/0oo"));
+    }
+
+    #[test]
+    fn replacements_mean_what_they_mean_in_javascript() {
+        assert_eq!(js_replacement("$1$2", 2).as_deref(), Some("${1}${2}"));
+        assert_eq!(js_replacement("$1abc", 1).as_deref(), Some("${1}abc"));
+        assert_eq!(js_replacement("$12", 2).as_deref(), Some("${1}2"));
+        assert_eq!(js_replacement("$12", 12).as_deref(), Some("${12}"));
+        assert_eq!(js_replacement("$&!", 0).as_deref(), Some("${0}!"));
+        assert_eq!(js_replacement("$$5 and $9 and $", 1).as_deref(), Some("$$5 and $$9 and $$"));
+        for unsupported in ["$`", "$'", "$<name>"] {
+            assert!(js_replacement(unsupported, 1).is_none(), "{unsupported}");
+        }
+        assert_eq!(
+            Transform::parse("//$1$2/", Some(r"(.*\/Get\?.*)%2CCue(.*)")).unwrap().apply("https://x.example/Get?a=1%2CCue&b=2").as_deref(),
+            Some("https://x.example/Get?a=1&b=2")
+        );
+    }
+
+    #[test]
+    fn escapes_and_values_not_understood() {
+        assert_eq!(until_slash(r"a\/b\$c\,d\.e/rest"), Some((r"a/b$c,d\.e".to_string(), "rest")));
+        assert_eq!(until_slash("no end"), None);
+        for bad in ["", "x/y/", "/a/b", "/a", "/(/x/", "/a/b/x", "/a/b/ii", "//b/", "/a/$'/", "/(?=x)y/z/"] {
+            assert!(Transform::parse(bad, None).is_none(), "{bad}");
+        }
+        // too large to prepare
+        assert!(Transform::parse("/(?:[a-z]{1000}){1000}/x/", None).is_none());
+    }
+
+    #[test]
+    fn to_names_hosts_and_entities() {
+        assert!(host_matches("www.amazon.co.uk", "www.amazon.*"));
+        assert!(host_matches("www.amazon.de", "www.amazon.*"));
+        assert!(!host_matches("www.amazon", "www.amazon.*"));
+        assert!(!host_matches("xwww.amazon.de", "www.amazon.*"));
+        assert!(host_matches("news.hs.fi", "hs.fi"));
+        assert!(!host_matches("ths.fi", "hs.fi"));
+    }
+
+    const LISTS: &str = r"||shop.example/dp/*/ref=$doc,uritransform=/\/ref=[^\/?#]+//
+/dp/*/ref=$doc,uritransform=/\/ref=[^\/?#]+//,to=www.amazon.*|www.amazon.co.uk
+||news.example/video.aspx$script,uritransform=/reklama=1/reklama=0/
+/(.*\/Get\?.*)%2CCue(.*)/$xhr,uritransform=//$1$2/,domain=video.example
+$uritransform=/#Echobox=[\d]{10}$//,to=iltalehti.fi|hs.fi
+||first.example^$doc,uritransform=/qq/ww/
+||first.example^$doc,uritransform=/ww/zz/
+||spared.example^$doc,uritransform=/x/y/
+@@||spared.example^$uritransform
+||half.example^$doc,uritransform=/x/y/
+||half.example^$doc,uritransform=/z/w/
+@@||half.example^$uritransform=/x/y/
+||ads.example^$script,uritransform=/x/y/,redirect=noopjs
+";
+
+    #[test]
+    fn the_rules_of_the_lists_apply_where_they_say() {
+        let rules = TransformRules::from_trusted_text(LISTS);
+        assert_eq!(rules.text.lines().count(), 12, "{}", rules.text);
+        let page = |url: &str| rules.apply(url, url, "document");
+        assert_eq!(page("https://shop.example/dp/B01/ref=sr_1?k=x").as_deref(), Some("https://shop.example/dp/B01?k=x"));
+        assert_eq!(page("https://www.amazon.de/dp/B01/ref=x").as_deref(), Some("https://www.amazon.de/dp/B01"));
+        assert_eq!(page("https://www.other.example/dp/B01/ref=x"), None);
+        // the type
+        assert_eq!(rules.apply("https://shop.example/dp/B01/ref=x", "https://shop.example/", "subdocument"), None);
+        assert_eq!(
+            rules.apply("https://news.example/video.aspx?reklama=1", "https://news.example/", "script").as_deref(),
+            Some("https://news.example/video.aspx?reklama=0")
+        );
+        assert_eq!(rules.apply("https://news.example/video.aspx?reklama=1", "https://news.example/", "image"), None);
+        // the rule's own pattern, and the site of the page
+        assert_eq!(
+            rules.apply("https://api.example/Get?a=1%2CCue&b=2", "https://video.example/", "xmlhttprequest").as_deref(),
+            Some("https://api.example/Get?a=1&b=2")
+        );
+        assert_eq!(rules.apply("https://api.example/Get?a=1%2CCue&b=2", "https://other.example/", "xmlhttprequest"), None);
+        // a rule for every address of some hosts
+        assert_eq!(page("https://www.hs.fi/a#Echobox=1234567890").as_deref(), Some("https://www.hs.fi/a"));
+        assert_eq!(page("https://www.other.fi/a#Echobox=1234567890"), None);
+    }
+
+    #[test]
+    fn the_first_rule_that_changes_the_address_and_exceptions() {
+        let rules = TransformRules::from_trusted_text(LISTS);
+        let page = |url: &str| rules.apply(url, url, "document");
+        // the first rule that changes the address, not both
+        assert_eq!(page("https://first.example/qqww").as_deref(), Some("https://first.example/wwww"));
+        assert_eq!(page("https://first.example/ww").as_deref(), Some("https://first.example/zz"));
+        assert_eq!(page("https://spared.example/x"), None);
+        assert_eq!(page("https://half.example/xz").as_deref(), Some("https://half.example/xw"));
+        assert_eq!(page("not an address"), None);
+        assert_eq!(TransformRules::default().apply("https://first.example/qq", "https://first.example/", "document"), None);
+    }
+
+    #[test]
+    fn a_rule_that_is_not_understood_is_left_out() {
+        for not_taken in [
+            "||x.example^$uritransform",
+            "||x.example^$uritransform=",
+            "||x.example^$uritransform=/a/",
+            "||x.example^$doc,uritransform=//x/",
+            "||x.example^$doc,uritransform=/a/b/,uritransform=/c/d/",
+            "||x.example^$doc,~uritransform=/a/b/",
+            "||x.example^$doc,uritransform=/a/b/,to=shop.*x",
+            "||x.example^$doc,uritransform=/a/b/,csp=script-src 'none'",
+            "||x.example^$doc,uritransform=/a/b/,method=post",
+            "! ||x.example^$doc,uritransform=/a/b/",
+            "x.example##.uritransform",
