+
+namespace thoron_adblock {
+
+namespace {
+
+constexpr base::TimeDelta kDownloadTimeout = base::Minutes(2);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("thoron_adblock_lists", R"(
+        semantics {
+          sender: "Thoron native ad blocking"
+          description:
+            "Downloads the public filter lists the built-in ad blocker uses "
+            "(EasyList, EasyPrivacy, uBlock Origin's own lists and the URLhaus "
+            "malware list), from the addresses uBlock Origin uses, at most "
+            "every 4 days, and the lists a person added on chrome://adblock, "
+            "from the addresses that person gave."
+          trigger:
+            "The ThoronNativeAdblock feature is on and the last list check is "
+            "more than 4 days old, or a person adds a list or asks for an "
+            "update on chrome://adblock."
+          data: "None. A plain GET of a public file, without cookies or any "
+                "other credentials."
+          destination: OTHER
+          destination_other:
+            "ublockorigin.github.io, ublockorigin.pages.dev, "
+            "malware-filter.gitlab.io, curbengh.github.io, and the hosts of "
+            "lists a person added."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Off unless the ThoronNativeAdblock feature is on."
+          policy_exception_justification: "No policy yet."
+        })");
+
+}  // namespace
+
+// static
+bool ListFetch::IsAllowed(const GURL& url, bool allow_loopback) {
+  return url.is_valid() && (url.SchemeIs(url::kHttpsScheme) ||
+                            (allow_loopback && net::IsLocalhost(url)));
+}
+
+ListFetch::ListFetch(const GURL& url,
+                     const base::FilePath& path,
+                     scoped_refptr<network::SharedURLLoaderFactory> factory,
+                     scoped_refptr<base::SequencedTaskRunner> file_runner,
+                     bool allow_loopback,
+                     Done done)
+    : allow_loopback_(allow_loopback),
+      file_runner_(std::move(file_runner)),
+      done_(std::move(done)) {
+  if (!factory || !IsAllowed(url, allow_loopback_)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ListFetch::Finish,
+                                  weak_factory_.GetWeakPtr(), base::FilePath()));
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->SetTimeoutDuration(kDownloadTimeout);
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      &ListFetch::OnRedirect, weak_factory_.GetWeakPtr()));
+  loader_->DownloadToFile(
+      factory.get(),
+      base::BindOnce(&ListFetch::OnDownloaded, weak_factory_.GetWeakPtr()),
+      path, static_cast<int64_t>(kMaxListBytes));
+}
+
+ListFetch::~ListFetch() = default;
+
+void ListFetch::OnRedirect(const GURL& url_before_redirect,
+                           const net::RedirectInfo& redirect_info,
+                           const network::mojom::URLResponseHead& response_head,
+                           std::vector<std::string>* removed_headers) {
+  if (IsAllowed(redirect_info.new_url, allow_loopback_)) {
+    return;
+  }
+  loader_.reset();  // cancels the request
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ListFetch::Finish, weak_factory_.GetWeakPtr(),
+                                base::FilePath()));
+}
+
+void ListFetch::OnDownloaded(base::FilePath path) {
+  bool ok = false;
+  if (loader_ && !path.empty()) {
+    const network::mojom::URLResponseHead* head = loader_->ResponseInfo();
+    ok = head && head->headers && head->headers->response_code() == 200 &&
+         IsAllowed(loader_->GetFinalURL(), allow_loopback_);
+  }
+  loader_.reset();
+  if (!ok && !path.empty()) {
+    file_runner_->PostTask(FROM_HERE,
+                           base::GetDeleteFileCallback(std::move(path)));
+    path.clear();
+  }
+  Finish(ok ? std::move(path) : base::FilePath());
+}
+
+void ListFetch::Finish(base::FilePath path) {
+  if (done_) {
+    std::move(done_).Run(std::move(path));  // may delete this
+  }
+}
+
+}  // namespace thoron_adblock
