+std::vector<std::string> EngineService::SetMyRules(std::string text) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::vector<std::string> problems;
+  if (text.size() > kMaxMyRulesBytes) {
+    problems.push_back("Your rules are larger than 1 MB: nothing was saved.");
+    return problems;
+  }
+  if (!base::IsStringUTF8(text)) {
+    problems.push_back("Your rules are not plain text: nothing was saved.");
+    return problems;
+  }
+  for (const rust::String& line :
+       dynamic_rules_problems(rust::Str(text.data(), text.size()))) {
+    problems.emplace_back(line);
+  }
+  my_rules_text_ = std::move(text);
+  // saved text replaces what the menu's grid changed for now
+  UseSessionRules(my_rules_text_);
+  WriteMyRules();
+  return problems;
+}
