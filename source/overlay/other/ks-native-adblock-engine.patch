+<!doctype html>
+<!-- Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+     found in the LICENSE file.
+     The settings page of Thoron's built-in ad blocking, chrome://adblock. Plain HTML and one module
+     script (settings_page.js): the page's security policy allows no inline script. -->
+<html lang="en" dir="ltr">
+<head>
+<meta charset="utf-8">
+<meta name="color-scheme" content="light dark">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Ad blocking</title>
+<link rel="icon" href="chrome://theme/current-channel-logo@2x">
+<style>
+  @import url(chrome://resources/css/text_defaults_md.css);
+  :root {
+    --line: color-mix(in srgb, currentColor 16%, transparent);
+    --soft: color-mix(in srgb, currentColor 62%, transparent);
+    --accent: #7235da;
+    --bad: #c5221f;
+  }
+  @media (prefers-color-scheme: dark) {
+    :root { --accent: #b097fa; --bad: #f28b82; }
+  }
+  body { margin: 0; }
+  main { box-sizing: border-box; max-width: 860px; margin: 0 auto; padding: 32px 24px 64px; }
+  h1 { font-size: 28px; font-weight: 500; margin: 0 0 8px; }
+  h2 { font-size: 16px; font-weight: 500; margin: 0 0 6px; }
+  p { margin: 0 0 12px; line-height: 1.5; }
+  .lead, .note, .url, #last-check, #my-count { color: var(--soft); }
+  section { border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin: 18px 0; }
+  .list { display: flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-top: 1px solid var(--line); }
+  .list:first-child { border-top: 0; }
+  .list input { margin-top: 3px; inline-size: 16px; block-size: 16px; accent-color: var(--accent); }
+  .list .about { flex: 1; min-inline-size: 0; }
+  .list .title { font-weight: 500; }
+  .list .url { display: block; font-size: 12px; overflow-wrap: anywhere; }
+  .list .count { font-size: 12px; color: var(--soft); }
+  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0 0; }
+  button, .button {
+    font: inherit; padding: 7px 16px; border-radius: 16px; border: 1px solid var(--line);
+    background: transparent; color: inherit; cursor: pointer; text-decoration: none; display: inline-block;
+  }
+  button.main { background: var(--accent); border-color: var(--accent); color: #fff; }
+  @media (prefers-color-scheme: dark) { button.main { color: #1b1036; } }
+  button:disabled { opacity: .5; cursor: default; }
+  button:focus-visible, .button:focus-visible, input:focus-visible, textarea:focus-visible {
+    outline: 2px solid var(--accent); outline-offset: 2px;
+  }
+  form { display: flex; gap: 10px; }
+  input[type=url] {
+    flex: 1; min-inline-size: 0; font: inherit; padding: 7px 10px; border-radius: 8px;
+    border: 1px solid var(--line); background: transparent; color: inherit;
+  }
+  textarea {
+    box-sizing: border-box; inline-size: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--line);
+    background: transparent; color: inherit; resize: vertical;
+    font: 13px/1.5 ui-monospace, Consolas, "Liberation Mono", monospace;
+  }
+  code { font: 13px ui-monospace, Consolas, "Liberation Mono", monospace; }
+  #message { position: sticky; inset-block-end: 12px; margin: 18px 0 0; padding: 10px 14px; border-radius: 8px;
+             border: 1px solid var(--line); background: Canvas; min-block-size: 1.5em; }
+  #message:empty { visibility: hidden; }
+  #message.bad, #not-applied { border-color: var(--bad); color: var(--bad); }
+  #not-applied { border: 1px solid var(--bad); border-radius: 8px; padding: 10px 14px; }
+  [hidden] { display: none !important; }
+  details { margin-top: 12px; }
+  pre { margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font: 12px/1.5 ui-monospace, Consolas, monospace;
+        color: var(--soft); }
+  body.busy button, body.busy input, body.busy textarea { pointer-events: none; opacity: .6; }
+  nav.bar { position: sticky; inset-block-start: 0; z-index: 1; display: flex; gap: 6px; flex-wrap: wrap;
+            padding: 10px 0; background: Canvas; border-block-end: 1px solid var(--line); }
+  nav.bar a { padding: 6px 14px; border-radius: 16px; color: inherit; text-decoration: none;
+              border: 1px solid var(--line); }
+  nav.bar a:hover, nav.bar a:focus-visible { border-color: var(--accent); }
+  #total { color: var(--soft); }
+  #settings h3 { font-size: 13px; font-weight: 600; color: var(--soft); margin: 18px 0 4px; }
+  .option { display: flex; gap: 10px; align-items: flex-start; padding: 5px 0; }
+  .option input { margin-top: 3px; accent-color: var(--accent); }
+  div.option { align-items: center; gap: 6px; }
+  div.option label { display: flex; gap: 10px; align-items: flex-start; }
+  #media-kb { inline-size: 7em; margin-top: 0; font: inherit; color: inherit; background: transparent;
+              border: 1px solid var(--line); border-radius: 4px; padding: 1px 4px; }
+  #catalog details { border-top: 1px solid var(--line); padding: 8px 0; margin: 0; }
+  #catalog details:first-child { border-top: 0; }
+  #catalog summary { cursor: pointer; font-weight: 500; }
+  #catalog summary .on { color: var(--soft); font-weight: 400; }
+  #catalog label { display: flex; gap: 10px; align-items: flex-start; padding: 6px 0 6px 4px; }
+  #catalog label input { margin-top: 3px; accent-color: var(--accent); }
+  #catalog .url { display: block; font-size: 12px; color: var(--soft); overflow-wrap: anywhere; }
+  .site-row { display: flex; gap: 12px; align-items: center; padding: 8px 0; border-top: 1px solid var(--line); }
+  .site-row:first-child { border-top: 0; }
+  .site-row .name { flex: 1; min-inline-size: 0; overflow-wrap: anywhere; }
+  .site-row .what { color: var(--soft); font-size: 12px; }
+  .empty { color: var(--soft); }
+  #log { max-block-size: 460px; overflow: auto; margin-top: 10px; border: 1px solid var(--line); border-radius: 8px; }
+  #log table { inline-size: 100%; border-collapse: collapse; font-size: 12px; }
+  #log td { padding: 4px 8px; border-top: 1px solid var(--line); vertical-align: top; }
+  #log td.time { white-space: nowrap; color: var(--soft); }
+  #log td.url { overflow-wrap: anywhere; font-family: ui-monospace, Consolas, monospace; }
+  #log td.kind { white-space: nowrap; font-weight: 600; }
+  #log tr.blocked td.kind { color: #d93025; }
+  #log tr.allowed td.kind { color: var(--soft); }
+  #log td.act button { padding: 2px 10px; font-size: 12px; }
+  select { font: inherit; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--line); background: Canvas;
+           color: inherit; max-inline-size: 100%; }
+</style>
+</head>
+<body>
+<main>
+  <h1>Ad blocking</h1>
+  <nav class="bar" aria-label="Sections">
+    <a href="#settings">Settings</a>
+    <a href="#lists-section">Filter lists</a>
+    <a href="#more-lists">More lists</a>
+    <a href="#mine">My filters</a>
+    <a href="#rules">My rules</a>
+    <a href="#sites">Sites</a>
+    <a href="#logger">Logger</a>
+  </nav>
+  <p id="total"></p>
+  <p class="lead">Thoron blocks ads and trackers inside the browser, with the filter lists below. What you
+    choose here stays on this computer. A list is downloaded from its address every few days, without
+    cookies or anything that tells who you are.</p>
+
+  <p id="not-applied" hidden>Your last change is not in use: the browser stopped while it was reading it.
+    Change the setting again, or remove the list or the rules you added last.</p>
+
+  <section>
+    <h2>On, off and allowed sites</h2>
+    <p>Blocking is switched on or off for all sites, and sites are allowed one by one, in the site settings.
+      On a page, the icon in the address bar does the same for that site.</p>
+    <a class="button" id="site-settings" href="chrome://settings/content/ads">Open "Ads and trackers" in Settings</a>
+  </section>
+
+  <section id="settings">
+    <h2>Settings</h2>
+    <p>As in uBlock Origin. A change is in use at once.</p>
+    <h3>Appearance</h3>
+    <label class="option"><input type="checkbox" data-setting="badge">
+      <span>Show the number of blocked requests on the shield</span></label>
+    <label class="option"><input type="checkbox" data-setting="context-menu">
+      <span>Make use of the context menu: "Block element..." when you right-click a page</span></label>
+    <h3>Privacy</h3>
+    <label class="option"><input type="checkbox" data-setting="prefetch">
+      <span>Disable pre-fetching, so that blocked requests make no connection at all</span></label>
+    <label class="option"><input type="checkbox" data-setting="hyperlink-auditing">
+      <span>Disable hyperlink auditing (the pings a link sends when it is clicked)</span></label>
+    <label class="option"><input type="checkbox" data-setting="webrtc">
+      <span>Prevent WebRTC from leaking local IP addresses</span></label>
+    <label class="option"><input type="checkbox" data-setting="block-csp-reports">
+      <span>Block CSP reports (what a page's security policy reports to its servers)</span></label>
+    <h3>Default behavior</h3>
+    <p>For every site. The switches in the menu of the shield change it for one site.</p>
+    <label class="option"><input type="checkbox" data-setting="default-cosmetic">
+      <span>Disable cosmetic filtering: nothing is hidden</span></label>
+    <div class="option"><label><input type="checkbox" data-setting="default-media">
+      <span>Block media elements larger than</span></label>
+      <input type="number" id="media-kb" min="1" max="1048576" step="1" aria-label="Largest media size in kB"><span>kB</span></div>
+    <label class="option"><input type="checkbox" data-setting="default-fonts">
+      <span>Block remote fonts</span></label>
+    <label class="option"><input type="checkbox" data-setting="javascript">
+      <span>Disable JavaScript</span></label>
+    <label class="option"><input type="checkbox" data-setting="default-3p-script">
+      <span>Block third-party scripts (uBlock Origin's "medium mode", with the next one)</span></label>
+    <label class="option"><input type="checkbox" data-setting="default-3p-frame">
+      <span>Block third-party frames</span></label>
+    <h3>Filtering</h3>
+    <label class="option"><input type="checkbox" data-setting="ignore-generic">
+      <span>Ignore generic cosmetic filters (hide rules written for every site)</span></label>
+    <h3>Advanced</h3>
+    <label class="option"><input type="checkbox" data-setting="advanced">
+      <span>I am an advanced user: the menu of the shield shows the grid of rules for the page</span></label>
+    <h3>Backup</h3>
+    <p>A file with your lists, your own rules, allowed sites, switches and these settings. It stays where
+      you save it; nothing is sent anywhere.</p>
+    <div class="row">
+      <button id="backup" type="button">Back up to file</button>
+      <button id="restore" type="button">Restore from file</button>
+      <input id="restore-file" type="file" accept=".json,application/json" hidden>
+      <button id="reset" type="button">Reset to default settings</button>
+    </div>
+  </section>
+
+  <section id="lists-section">
+    <h2>Filter lists</h2>
+    <p>A list that is switched off is neither used nor downloaded.</p>
+    <div id="lists" role="list"></div>
+    <label class="option"><input type="checkbox" data-setting="auto-update">
+      <span>Auto-update filter lists (otherwise only "Update now" downloads them)</span></label>
+    <div class="row">
+      <button id="update-now" type="button">Update now</button>
+      <span id="last-check"></span>
+    </div>
+    <details id="result-box" hidden>
+      <summary>What the last update did</summary>
+      <pre id="result"></pre>
+    </details>
+  </section>
+
+  <section id="more-lists">
+    <h2>More lists</h2>
+    <p>The lists uBlock Origin offers besides its defaults: cookie notices and other annoyances, more privacy, and
+      lists for regions and languages. A list you switch on is downloaded from its address and is in use at once.</p>
+    <div id="catalog"></div>
+  </section>
+
+  <section>
+    <h2>Add a list</h2>
+    <p>Give the address of a filter list. It must be a secure address.</p>
+    <form id="add-form">
+      <input id="add-url" type="url" required aria-label="Address of the list">
+      <button id="add-button" class="main" type="submit">Add</button>
+    </form>
+    <p class="note row">Rules of a list you add block and hide like any other. They cannot use the powerful
+      scripts that only uBlock Origin's own lists may use.</p>
+  </section>
+
+  <section id="mine">
+    <h2>My filters</h2>
+    <p>Your own rules, one per line, written like the rules of the lists. <code>||ads.example.com^</code>
+      blocks a host, <code>example.com##.banner</code> hides something on a site, and
+      <code>@@||example.com^</code> allows a site.</p>
+    <textarea id="my-filters" rows="12" spellcheck="false" aria-label="My filters"></textarea>
+    <div class="row">
+      <button id="save-filters" class="main" type="button">Save</button>
+      <button id="revert-filters" type="button">Undo changes</button>
+      <span id="my-count"></span>
+    </div>
+  </section>
+
+  <section id="rules">
+    <h2>My rules</h2>
+    <p>uBlock Origin's dynamic filtering: one rule per line, <code>source destination type action</code>.
+      <code>* * 3p-script block</code> blocks scripts from other sites everywhere,
+      <code>example.com * 3p-script noop</code> leaves them to the lists on example.com,
+      <code>* ads.example.com * block</code> blocks a host, <code>example.com cdn.example.net * allow</code>
+      lets a host through on a site whatever the lists say. Types: <code>*</code>, <code>3p</code>,
+      <code>1p-script</code>, <code>3p-script</code>, <code>3p-frame</code>, <code>image</code>,
+      <code>inline-script</code>; actions: <code>block</code>, <code>allow</code>, <code>noop</code>. The most
+      specific rule decides.</p>
+    <textarea id="my-rules" rows="10" spellcheck="false" aria-label="My rules"></textarea>
+    <div class="row">
+      <button id="save-rules" class="main" type="button">Save</button>
+      <span id="rules-note"></span>
+    </div>
+  </section>
+
+  <section id="sites">
+    <h2>Sites</h2>
+    <p>Ads and trackers are allowed on these sites: nothing is blocked or hidden there.</p>
+    <div id="allowed" role="list"></div>
+    <form id="allow-form" class="row">
+      <input id="allow-host" type="text" required aria-label="Site to allow" placeholder="example.com">
+      <button type="submit">Allow</button>
+    </form>
+    <h2 class="row">Switches from the menu</h2>
+    <p>What the menu of the shield in the toolbar changed for a site: no pop-ups, no large media, no hiding,
+      no remote fonts or no JavaScript.</p>
+    <div id="switches" role="list"></div>
+  </section>
+
+  <section id="logger">
+    <h2>Logger</h2>
+    <p>The requests of the open tabs, the newest first: every blocked one, and while this page is open also
+      those let through. It is kept only in memory: nothing is stored or sent. "Block" adds a rule for a host
+      to My filters; "Allow" lets a blocked host through on that site.</p>
+    <div class="row">
+      <select id="log-tab" aria-label="Tab"></select>
+      <select id="log-kind" aria-label="Show">
+        <option value="">All</option>
+        <option value="blocked">Blocked</option>
+        <option value="allowed">Let through</option>
+      </select>
+      <input id="log-filter" type="text" aria-label="Show only addresses with" placeholder="Filter">
+      <span id="log-count"></span>
+    </div>
+    <div id="log"><table><tbody id="log-rows"></tbody></table></div>
+  </section>
+
+  <p id="message" role="status" aria-live="polite"></p>
+</main>
+<script type="module" src="adblock.js"></script>
+</body>
+</html>
