@@ -0,0 +1,74 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_LIST_FETCH_H_
+#define COMPONENTS_THORON_ADBLOCK_LIST_FETCH_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "url/gurl.h"
+
+namespace net {
+struct RedirectInfo;
+}  // namespace net
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+namespace mojom {
+class URLResponseHead;
+}  // namespace mojom
+}  // namespace network
+
+namespace thoron_adblock {
+
+// One download of a filter list: a plain GET with no cookies or other
+// credentials, not from and not into the HTTP cache, of at most kMaxListBytes.
+// It must be answered with 200 and must never leave HTTPS, not by a redirect
+// either. This is the only way a list reaches the browser, for the built-in
+// lists and for a list a person adds.
+class ListFetch {
+ public:
+  // Gets the file the list was written to, or an empty path when the download
+  // failed or was refused. The callback may delete this object.
+  using Done = base::OnceCallback<void(base::FilePath)>;
+
+  // True for an address a list may be fetched from: HTTPS, and with
+  // `allow_loopback` (tests only) also a loopback address.
+  static bool IsAllowed(const GURL& url, bool allow_loopback);
+
+  ListFetch(const GURL& url,
+            const base::FilePath& path,
+            scoped_refptr<network::SharedURLLoaderFactory> factory,
+            scoped_refptr<base::SequencedTaskRunner> file_runner,
+            bool allow_loopback,
+            Done done);
+  ListFetch(const ListFetch&) = delete;
+  ListFetch& operator=(const ListFetch&) = delete;
+  ~ListFetch();
+
+ private:
+  void OnRedirect(const GURL& url_before_redirect,
+                  const net::RedirectInfo& redirect_info,
+                  const network::mojom::URLResponseHead& response_head,
+                  std::vector<std::string>* removed_headers);
+  void OnDownloaded(base::FilePath path);
+  void Finish(base::FilePath path);
+
+  const bool allow_loopback_;
+  scoped_refptr<base::SequencedTaskRunner> file_runner_;
+  Done done_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::WeakPtrFactory<ListFetch> weak_factory_{this};
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_LIST_FETCH_H_
