@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Build step: take the filter lists from the pinned uBlock Origin CRX the build already downloads, so
+the native engine uses exactly the lists people already trust, version-locked with the build."""
+import argparse
+import io
+import struct
+import sys
+import zipfile
+
+# EasyList, EasyPrivacy, uBlock filters, privacy, badware, quick fixes, unbreak, URLhaus malware, by uBlock
+# Origin's list id. The ids must match kLists in list_updater.cc: each list starts with a
+# "! thoron-list: <id>" comment line, so a list update can compare a download with its bundled copy.
+LISTS = (
+    ("easylist", "assets/thirdparties/easylist/easylist.txt"),
+    ("easyprivacy", "assets/thirdparties/easylist/easyprivacy.txt"),
+    ("ublock-filters", "assets/ublock/filters.min.txt"),
+    ("ublock-privacy", "assets/ublock/privacy.min.txt"),
+    ("ublock-badware", "assets/ublock/badware.min.txt"),
+    ("ublock-quick-fixes", "assets/ublock/quick-fixes.min.txt"),
+    ("ublock-unbreak", "assets/ublock/unbreak.min.txt"),
+    ("urlhaus-1", "assets/thirdparties/urlhaus-filter/urlhaus-filter-online.txt"),
+)
+MARKER = "! thoron-list: "
+MAX_LIST_BYTES = 20 * 1024 * 1024
+
+
+def extract(crx: bytes) -> bytes:
+    if crx[:4] != b"Cr24":
+        raise ValueError("not a CRX file")
+    version, header_size = struct.unpack("<II", crx[4:12])
+    if version != 3:
+        raise ValueError(f"unsupported CRX version {version}")
+    archive = zipfile.ZipFile(io.BytesIO(crx[12 + header_size:]))
+    parts = []
+    for list_id, name in LISTS:
+        info = archive.getinfo(name)
+        if info.file_size > MAX_LIST_BYTES:
+            raise ValueError(f"{name} is too large")
+        text = archive.read(info).decode("utf-8").replace("\r\n", "\n")
+        if MARKER in text:
+            raise ValueError(f"{name} already holds a list marker")
+        parts.append(f"{MARKER}{list_id}\n{text}")
+    return "\n".join(parts).encode("utf-8")
+
+
+def main(argv):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--crx", required=True)
+    p.add_argument("--out", required=True)
+    a = p.parse_args(argv)
+    with open(a.crx, "rb") as f:
+        data = extract(f.read())
+    with open(a.out, "wb") as f:
+        f.write(data)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/components/thoron_adblock/extract_resources.py b/components/thoron_adblock/extract_resources.py
new file mode 100644
index 0000000000000000000000000000000000000000..e43f64705886c70364ba42faa0bde82365744468
