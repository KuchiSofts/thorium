+int EngineService::DynamicVerdict(
+    const GURL& top_site,
+    const GURL& url,
+    network::mojom::RequestDestination destination) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!my_rules_ || (*my_rules_)->rule_count() == 0 || !url.has_host()) {
+    return 0;
+  }
+  const std::string source = top_site.has_host() ? std::string(top_site.host())
+                                                 : std::string("*");
+  const std::string destination_host(url.host());
+  const std::string_view type = RequestType(destination);
+  const bool third_party = ProxyingURLLoaderFactory::IsThirdParty(url, top_site);
+  return (*my_rules_)->verdict(
+      rust::Str(source.data(), source.size()),
+      rust::Str(destination_host.data(), destination_host.size()),
+      rust::Str(type.data(), type.size()), third_party);
+}
