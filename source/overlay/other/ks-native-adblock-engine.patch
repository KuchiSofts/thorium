+++ b/components/thoron_adblock/page_block_throttle.cc
@@ -0,0 +1,150 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/page_block_throttle.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "net/base/net_errors.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+// Plain HTML, styled inline, without scripts: error pages are shown as they
+// are. Light and dark follow the system.
+constexpr char kPageStart[] = R"(<!doctype html>
+<html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Thoron blocked this page</title>
+<style>
+:root { color-scheme: light dark; --bg: #f7f8fa; --fg: #1f2328; --soft: #59636e; --card: #ffffff;
+  --line: #d8dee4; --accent: #0b7f86; }
+@media (prefers-color-scheme: dark) { :root { --bg: #16181c; --fg: #e6e8eb; --soft: #9aa3ad;
+  --card: #1f2227; --line: #343a42; --accent: #3cc6cf; } }
+body { margin: 0; background: var(--bg); color: var(--fg);
+  font: 15px/1.55 system-ui, "Segoe UI", sans-serif; }
+main { max-width: 640px; margin: 12vh auto 0; padding: 0 20px; }
+.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 28px; }
+h1 { font-size: 22px; margin: 0 0 12px; }
+.shield { color: var(--accent); }
+.url, code { font-family: ui-monospace, Consolas, monospace; font-size: 13px; overflow-wrap: anywhere; }
+.url { display: block; padding: 10px 12px; border-radius: 8px; background: var(--bg); margin: 8px 0 16px; }
+a.url { color: var(--accent); }
+p { margin: 0 0 12px; } .soft { color: var(--soft); }
+</style></head><body><main><div class="card">
+<h1><span class="shield">&#x1F6E1;</span> Thoron blocked this page</h1>
+<p>The built-in ad blocker did not open this page, because your filter lists block it:</p>
+<span class="url">)";
+
+}  // namespace
+
+// static
+void PageBlockThrottle::MaybeAdd(content::NavigationThrottleRegistry& registry,
+                                 HostContentSettingsMap* settings) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock) || !settings ||
+      !registry.GetNavigationHandle().IsInOutermostMainFrame()) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<PageBlockThrottle>(
+      registry, base::WrapRefCounted(settings)));
+}
+
+PageBlockThrottle::PageBlockThrottle(
+    content::NavigationThrottleRegistry& registry,
+    scoped_refptr<HostContentSettingsMap> settings)
+    : content::NavigationThrottle(registry), settings_(std::move(settings)) {}
+
+PageBlockThrottle::~PageBlockThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+PageBlockThrottle::WillStartRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+PageBlockThrottle::WillRedirectRequest() {
+  return Check();
+}
+
+const char* PageBlockThrottle::GetNameForLogging() {
+  return "ThoronPageBlockThrottle";
+}
+
+content::NavigationThrottle::ThrottleCheckResult PageBlockThrottle::Check() {
+  const GURL& url = navigation_handle()->GetURL();
+  if (!url.SchemeIsHTTPOrHTTPS() ||
+      ProxyingURLLoaderFactory::AdsAllowedOn(settings_.get(), url)) {
+    return PROCEED;
+  }
+  const EngineService& engine = EngineService::Get();
+  if (!engine.BlocksPage(url)) {
+    return PROCEED;
+  }
+  // A redirector that a `$urlskip` rule goes past is not opened anyway: the
+  // navigation goes straight to where it sends on to (DocumentRequest-
+  // Interceptor), as in uBlock Origin.
+  if (!navigation_handle()->IsPost() && engine.SkipUrl(url).is_valid()) {
+    return PROCEED;
+  }
+  GURL onward = Onward(url);
+  if (onward.is_valid() && engine.BlocksPage(onward)) {
+    onward = GURL();
+  }
+  return {BLOCK_REQUEST, net::ERR_BLOCKED_BY_CLIENT,
+          BlockedPage(url, onward)};
+}
+
+// static
+GURL PageBlockThrottle::Onward(const GURL& url) {
+  for (net::QueryIterator it(url); !it.IsAtEnd(); it.Advance()) {
+    const GURL candidate(it.GetUnescapedValue());
+    if (candidate.is_valid() && candidate.SchemeIsHTTPOrHTTPS() &&
+        !candidate.has_username() && !candidate.has_password() &&
+        candidate.host() != url.host()) {
+      return candidate;
+    }
+  }
+  return GURL();
+}
+
+// static
+std::string PageBlockThrottle::BlockedPage(const GURL& url,
+                                           const GURL& onward) {
+  const std::string why = base::StrCat(
+      {"<p>A rule of your lists names the site <code>",
+       base::EscapeForHTML(url.host()),
+       "</code> as a whole, or this very page. Such rules name sites that "
+       "serve ads or track you, and pages known to be harmful: malware, "
+       "scams, phishing.</p>"});
+  const std::string onward_text =
+      onward.is_valid()
+          ? base::StrCat({"<p>It would send you on to this address, which is "
+                          "not blocked. To go there directly, use the link:"
+                          "</p><a class=\"url\" href=\"",
+                          base::EscapeForHTML(onward.spec()), "\">",
+                          base::EscapeForHTML(onward.spec()), "</a>"})
+          : std::string();
+  return base::StrCat(
+      {kPageStart, base::EscapeForHTML(url.possibly_invalid_spec()), "</span>",
+       why, onward_text,
+       "<p>To open it anyway, click the shield in the toolbar and switch "
+       "blocking off for this site with the big button, then reload. Or go "
+       "back with the Back button.</p>"
+       "<p class=\"soft\">Your lists and your own rules are on "
+       "<code>chrome://adblock</code>.</p></div></main></body></html>"});
+}
+
+}  // namespace thoron_adblock
