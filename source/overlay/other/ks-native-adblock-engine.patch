+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_ENGINE_SERVICE_H_
+#define COMPONENTS_THORON_ADBLOCK_ENGINE_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/sequence_checker.h"
+#include "base/values.h"
+#include "components/thoron_adblock/engine.rs.h"
+#include "components/thoron_adblock/list_updater.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "third_party/rust/cxx/v1/cxx.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+class ListFetch;
+
+// The browser's one native ad-blocking engine. It is loaded on a background
+// thread the first time it is needed (the updated engine, else the shipped
+// one); until it is ready it blocks nothing. Once loaded, a ListUpdater keeps
+// the lists current. All calls are on the UI thread.
+class EngineService {
+ public:
+  static EngineService& Get();
+
+  EngineService(const EngineService&) = delete;
+  EngineService& operator=(const EngineService&) = delete;
+
+  // Where updated lists are kept (<user data dir>/Thoron Adblock) and how to
+  // reach the network for them. Only the first call counts; without it the
+  // shipped engine is used and never updated.
+  void Configure(const base::FilePath& user_data_dir,
+                 ListUpdater::FactoryGetter factory_getter);
+  bool is_configured() const { return configured_; }
+
+  // Starts loading the engine once (no-op afterwards).
+  void EnsureStarted();
+
+  // What to do with a request.
+  struct Decision {
+    // The request must not reach the network.
+    bool blocked = false;
+    // Only with `blocked`: a data: URL holding a harmless stand-in to answer
+    // with (a filter asked for it). Empty: end the request with an error.
+    std::string stand_in;
+    // Only without `blocked`: the address to ask for instead, the request's
+    // own without the parameters `$removeparam` rules take out. Invalid
+    // (empty): the address stays as it is.
+    GURL clean_url;
+  };
+
+  // Only http(s) and ws(s) requests with a known initiator are considered;
+  // every other request is allowed.
+  Decision Check(const GURL& url,
+                 const GURL& source,
+                 network::mojom::RequestDestination destination) const;
+
+  // True when the lists block a WebSocket connection to `url` (ws or wss)
+  // from the document at `source`.
+  bool BlocksWebSocket(const GURL& url, const GURL& source) const;
+
+  // For a document's own request (a page, or a frame in one): the address
+  // without the parameters `$removeparam` rules take out. Invalid (empty)
+  // when nothing is to be removed. `source` is the page's own address for a
+  // page, and for a frame who asked or the page it is in.
+  GURL CleanUrl(const GURL& url, const GURL& source, bool main_frame) const;
+
+  // Where a navigation of the main frame to `url` should go instead, when a
+  // `$urlskip` rule of a trusted list finds the destination written inside
+  // the address of a redirector. Empty when the navigation stays as it is. The
+  // result is always a plain http or https address without a user name, and
+  // never `url` itself.
+  GURL SkipUrl(const GURL& url) const;
+
+  // The content security policy `$csp` rules add to a document: the value of
+  // a Content-Security-Policy header, or empty.
+  std::string DocumentPolicy(const GURL& url,
+                             const GURL& source,
+                             bool main_frame) const;
+
+  // What a document needs besides request blocking.
+  struct Document {
+    // Hides elements; to insert as a user style sheet. Empty: nothing to hide.
+    std::string stylesheet;
+    // The document's scriptlets; to run in the page's world at document start.
+    // Empty: none.
+    std::string script;
+    // The runner for the document's procedural hide rules ("has-text",
+    // "upward", "remove"...); to run in an isolated world at document start.
+    // Empty: none.
+    std::string isolated_script;
+    // The document may ask for generic hide rules (GenericStylesheet): the
+    // engine is loaded and the site has not switched generic hiding off.
+    bool generic = false;
+  };
+
+  // For the http(s) document at `url`. Empty until the engine is loaded.
+  Document ForDocument(const GURL& url) const;
+
+  // The style sheet that hides, among the class names and ids the document
+  // at `url` uses, what generic hide rules ask for. Empty when nothing
+  // matches or generic hiding is off there.
+  std::string GenericStylesheet(const GURL& url,
+                                const std::vector<std::string>& classes,
+                                const std::vector<std::string>& ids) const;
+
+  bool is_ready() const { return engine_.has_value(); }
+
+  // The filter-list type name for a request destination ("script", "image"...).
+  static std::string_view RequestType(
+      network::mojom::RequestDestination destination);
+
+  // For tests: use this engine instead of the bundled lists.
+  void SetEngineForTesting(rust::Box<Engine> engine);
+
+  // What the settings page (chrome://adblock) asks for. The file work runs on
+  // the background sequence and the answer comes back on this one. A change
+  // that was made is in use at once: its engine replaces the one before.
+  using Described = base::OnceCallback<void(base::DictValue)>;
+  // Gets "" when the change was made, else what went wrong, in plain words.
+  using Changed = base::OnceCallback<void(std::string)>;
+  // Every list with its name, address, state and rule count, the person's own
+  // rules, and how the last update went (list_store.h).
+  void DescribeSettings(Described callback);
+  // Switches a built-in list on or off.
+  void SetListEnabled(const std::string& id, bool enabled, Changed callback);
+  // Downloads the list at `url` (HTTPS only), checks it like an updated list
+  // and adds it. Its rules get no trust: no trusted scriptlets.
+  void AddList(const GURL& url, Changed callback);
+  // Removes a list the person added.
+  void RemoveList(const std::string& id, Changed callback);
+  // Replaces the person's own rules.
+  void SetMyFilters(std::string text, Changed callback);
+  // Looks for newer lists now, whenever the last check was.
+  void UpdateNow(Changed callback);
+
+ private:
+  friend class base::NoDestructor<EngineService>;
+  EngineService();
+  ~EngineService();
+
+  StorePaths Paths() const;
+  void OnBuilt(std::optional<rust::Box<Engine>> engine);
+  void OnNewEngine(rust::Box<Engine> engine);
+  // Per probe request (list_store.h), whether the current engine blocks it.
+  std::vector<bool> ProbesBlocked() const;
+  void StartAddFetch(GURL url, base::FilePath path, Changed callback);
+  void OnListFetched(GURL url, Changed callback, base::FilePath path);
+  void OnChanged(Changed callback, ChangeResult change);
+
+  bool started_ = false;
+  bool configured_ = false;
+  base::FilePath store_dir_;
+  ListUpdater::FactoryGetter factory_getter_;
+  scoped_refptr<base::SequencedTaskRunner> file_runner_;
+  std::unique_ptr<ListUpdater> updater_;
+  // The download of a list that is being added; one at a time.
+  std::unique_ptr<ListFetch> add_fetch_;
+  std::optional<rust::Box<Engine>> engine_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<EngineService> weak_factory_{this};
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_ENGINE_SERVICE_H_
