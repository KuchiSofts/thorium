+  const switches = $('switches');
+  switches.replaceChildren(...sites.switches.map(({host, names}) =>
+      siteRow(host, names.map((n) => SWITCH_NAMES[n] || n).join(', '), async () => {
+        await sendWithPromise('clearSwitches', host);
+        refreshSites();
+        say(`The switches for ${host} are off.`);
