+  // "My rules" as saved, and the rules in force (with what the menu's grid
+  // changed for now); `my_rules_` is read from the second.
+  std::string my_rules_text_;
+  std::string session_rules_text_;
+  std::optional<rust::Box<DynamicRules>> my_rules_;
+  bool saved_state_read_ = false;
+  int64_t total_blocked_ = 0;
+  bool stats_save_pending_ = false;
+
+  bool started_ = false;
