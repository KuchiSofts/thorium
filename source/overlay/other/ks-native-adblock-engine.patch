+
+bool EngineService::HostSwitch(std::string_view host,
+                               std::string_view name,
+                               bool* found) const {
+  const std::string on(name);
+  const std::string out = "-" + on;
+  *found = false;
+  while (!host.empty()) {
+    if (auto it = site_switches_.find(std::string(host));
+        it != site_switches_.end()) {
+      if (it->second.contains(on)) {
+        *found = true;
+        return true;
+      }
+      if (it->second.contains(out)) {
+        *found = true;
+        return false;
+      }
+    }
+    const size_t dot = host.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    host.remove_prefix(dot + 1);
+  }
+  return false;
+}
+
+bool EngineService::SiteSwitch(const GURL& site, std::string_view name) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!site.has_host()) {
+    return false;
+  }
+  bool found = false;
+  const bool on = HostSwitch(site.host(), name, &found);
+  if (found) {
+    return on;
+  }
+  return HasDefault(name) && Option(base::StrCat({"default-", name}));
+}
+
+void EngineService::SetSiteSwitch(const GURL& site,
+                                  std::string_view name,
+                                  bool on) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!site.has_host() || !KnownSwitch(name)) {
+    return;
+  }
+  if (name.starts_with('-')) {
+    return;
+  }
+  const std::string host(site.host());
+  if (auto it = site_switches_.find(host); it != site_switches_.end()) {
+    it->second.erase(std::string(name));
+    it->second.erase(base::StrCat({"-", name}));
+    if (it->second.empty()) {
+      site_switches_.erase(it);
+    }
+  }
+  // what the host has without a setting of its own: from a host it is under,
+  // or the default for every site
+  if (SiteSwitch(site, name) != on) {
+    if (site_switches_.size() >= kMaxSwitchHosts &&
+        !site_switches_.contains(host)) {
+      return;
+    }
+    site_switches_[host].insert(on ? std::string(name)
+                                   : base::StrCat({"-", name}));
+  }
+  SaveSiteSwitches();
+}
+
+void EngineService::ClearSiteSwitches(const std::string& host) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (site_switches_.erase(host)) {
+    SaveSiteSwitches();
+  }
+}
+
+void EngineService::SetHostSwitches(const std::string& host,
+                                    const std::vector<std::string>& names) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::set<std::string> known;
+  for (const std::string& name : names) {
+    if (KnownSwitch(name)) {
+      known.insert(name);
+    }
+  }
+  site_switches_.erase(host);
+  if (!known.empty() && (site_switches_.size() < kMaxSwitchHosts)) {
+    site_switches_.emplace(host, std::move(known));
+  }
+  SaveSiteSwitches();
+}
