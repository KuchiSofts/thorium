@@ -0,0 +1,116 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/document_observer.h"
+
+#include <utility>
+
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "base/functional/callback_helpers.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/picker.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+// More names than any real page reports in one question (the renderer sends
+// at most 4000). A frame that sends more gets no answer.
+constexpr size_t kMaxNames = 8000;
+
+}  // namespace
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DocumentObserver);
+
+DocumentObserver::DocumentObserver(
+    content::WebContents* web_contents,
+    scoped_refptr<HostContentSettingsMap> settings)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<DocumentObserver>(*web_contents),
+      settings_(std::move(settings)),
+      receivers_(web_contents, this) {}
+
+DocumentObserver::~DocumentObserver() = default;
+
+// static
+void DocumentObserver::BindDocumentHost(
+    mojo::PendingAssociatedReceiver<mojom::DocumentHost> receiver,
+    content::RenderFrameHost* frame) {
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  DocumentObserver* observer =
+      web_contents ? FromWebContents(web_contents) : nullptr;
+  if (observer) {
+    observer->receivers_.Bind(frame, std::move(receiver));
+  }
+}
+
+void DocumentObserver::ReadyToCommitNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (navigation_handle->IsSameDocument() || navigation_handle->IsErrorPage()) {
+    return;
+  }
+  const GURL& url = navigation_handle->GetURL();
+  content::RenderFrameHost* frame = navigation_handle->GetRenderFrameHost();
+  if (!url.SchemeIsHTTPOrHTTPS() || !frame) {
+    return;
+  }
+  // The per-site switch belongs to the page: for a frame inside a page, the
+  // page's address; for the page itself, the address it is about to show.
+  const GURL top = navigation_handle->IsInOutermostMainFrame()
+                       ? url
+                       : frame->GetOutermostMainFrame()->GetLastCommittedURL();
+  if (ProxyingURLLoaderFactory::AdsAllowedOn(settings_.get(), top)) {
+    return;
+  }
+  EngineService::Get().EnsureStarted();
+  // The menu's "no hiding" switch for the site: nothing hidden, no scriptlets.
+  if (EngineService::Get().SiteSwitch(top, "cosmetic")) {
+    return;
+  }
+  EngineService::Document document = EngineService::Get().ForDocument(url);
+  if (document.stylesheet.empty() && document.script.empty() &&
+      document.isolated_script.empty() && !document.generic) {
+    return;
+  }
+  mojo::AssociatedRemote<mojom::DocumentAgent> agent;
+  frame->GetRemoteAssociatedInterfaces()->GetInterface(&agent);
+  agent->SetForNextCommittedLoad(document.stylesheet, document.script,
+                                 document.isolated_script, document.generic);
+}
+
+void DocumentObserver::GenericStylesheet(
+    const std::vector<std::string>& classes,
+    const std::vector<std::string>& ids,
+    GenericStylesheetCallback callback) {
+  // The answer depends on where the asking frame really is, not on anything
+  // it says.
+  content::RenderFrameHost& frame = receivers_.CurrentTargetFrame();
+  const GURL& url = frame.GetLastCommittedURL();
+  const GURL& top = frame.GetOutermostMainFrame()->GetLastCommittedURL();
+  if (classes.size() + ids.size() > kMaxNames || !url.SchemeIsHTTPOrHTTPS() ||
+      ProxyingURLLoaderFactory::AdsAllowedOn(settings_.get(), top) ||
+      EngineService::Get().SiteSwitch(top, "cosmetic")) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  std::move(callback).Run(
+      EngineService::Get().GenericStylesheet(url, classes, ids));
+}
+
+void DocumentObserver::AddFilter(const std::string& rule) {
+  const std::string line =
+      AcceptPickedRule(receivers_.CurrentTargetFrame(), rule);
+  if (!line.empty()) {
+    EngineService::Get().AddToMyFilters(line, base::DoNothing());
+  }
+}
+
+}  // namespace thoron_adblock
