+// static
+bool EngineService::KnownOption(std::string_view name) {
+  for (const OptionDefault& option : kOptions) {
+    if (name == option.name) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool EngineService::Option(std::string_view name) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (auto it = options_.find(std::string(name)); it != options_.end()) {
+    return it->second;
+  }
+  for (const OptionDefault& option : kOptions) {
+    if (name == option.name) {
+      return option.value;
+    }
+  }
+  return false;
+}
+
+void EngineService::SetOption(std::string_view name, bool on) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!KnownOption(name)) {
+    return;
+  }
+  options_[std::string(name)] = on;
+  SaveOptions();
+}
