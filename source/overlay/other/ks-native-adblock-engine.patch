+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_REDIRECT_WATCHER_H_
+#define COMPONENTS_THORON_ADBLOCK_REDIRECT_WATCHER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/http_request_headers_update_params.h"
+#include "services/network/public/mojom/early_hints.mojom.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+// A request the engine let through can still be redirected to something the
+// lists block, or to an address with parameters they take out. A watcher sits
+// between one request's loader in the network service and its client in the
+// renderer, only to look at redirects: each redirect target is put to the
+// engine before the client hears of it.
+// - blocked: the request ends with ERR_BLOCKED_BY_CLIENT, as it would have had
+//   the page asked for that address itself;
+// - parameters to take out: the client is told the redirect leads to the
+//   clean address, and the network follows it there.
+// Everything else passes through untouched, both ways.
+//
+// Watchers live on one background sequence, so the browser's UI thread is not
+// in the path of every response; only a redirect asks the UI thread, where the
+// engine is. A watcher deletes itself when both sides of the request have
+// closed.
+class RedirectWatcher : public network::mojom::URLLoaderClient,
+                        public network::mojom::URLLoader {
+ public:
+  // What the engine needs to judge the targets of one request's redirects.
+  struct Context {
+    // The document that asked.
+    GURL source;
+    network::mojom::RequestDestination destination =
+        network::mojom::RequestDestination::kEmpty;
+    // The document whose page counts a blocked request (none for workers).
+    content::GlobalRenderFrameHostId frame;
+  };
+
+  // Called on the UI thread with the four pipe ends of one request:
+  // `loader_receiver` and `client` lead to the renderer, `target_loader` and
+  // `target_client_receiver` to the network service.
+  static void Start(
+      Context context,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      mojo::PendingRemote<network::mojom::URLLoader> target_loader,
+      mojo::PendingReceiver<network::mojom::URLLoaderClient>
+          target_client_receiver);
+
+  RedirectWatcher(const RedirectWatcher&) = delete;
+  RedirectWatcher& operator=(const RedirectWatcher&) = delete;
+
+ private:
+  RedirectWatcher(
+      Context context,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      mojo::PendingRemote<network::mojom::URLLoader> target_loader,
+      mojo::PendingReceiver<network::mojom::URLLoaderClient>
+          target_client_receiver);
+  ~RedirectWatcher() override;
+
+  // network::mojom::URLLoaderClient (from the network service):
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr early_hints) override;
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> cached_metadata) override;
+  void OnReceiveRedirect(const net::RedirectInfo& redirect_info,
+                         network::mojom::URLResponseHeadPtr head) override;
+  void OnUploadProgress(int64_t current_position,
+                        int64_t total_size,
+                        OnUploadProgressCallback callback) override;
+  void OnTransferSizeUpdated(int32_t transfer_size_diff) override;
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override;
+
+  // network::mojom::URLLoader (from the renderer):
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams headers_update_params,
+      const std::optional<GURL>& new_url) override;
+  void SetPriority(net::RequestPriority priority,
+                   int intra_priority_value) override;
+
+  void OnRedirectChecked(net::RedirectInfo redirect_info,
+                         network::mojom::URLResponseHeadPtr head,
+                         EngineService::Decision decision);
+
+  // Each side of the request closes on its own; what closes on one end is
+  // closed on the other, as if the watcher were not there.
+  void OnLoaderClosedByRenderer(uint32_t reason, const std::string& text);
+  void OnLoaderClosedByNetwork();
+  void OnClientClosedByRenderer();
+  void OnClientClosedByNetwork();
+  void CloseLoader();
+  void CloseClient();
+  void DeleteIfDone();
+
+  const Context context_;
+  // Set while a redirect to a cleaned address waits to be followed.
+  std::optional<GURL> clean_redirect_;
+  mojo::Receiver<network::mojom::URLLoader> loader_receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  mojo::Remote<network::mojom::URLLoader> target_loader_;
+  mojo::Receiver<network::mojom::URLLoaderClient> target_client_receiver_{this};
+  base::WeakPtrFactory<RedirectWatcher> weak_factory_{this};
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_REDIRECT_WATCHER_H_
diff --git a/components/thoron_adblock/renderer/document_agent.cc b/components/thoron_adblock/renderer/document_agent.cc
new file mode 100644
index 0000000000000000000000000000000000000000..dfa7b4f9e4b22fcef6a6825e10c3e59b5d09c4d7
--- /dev/null
+++ b/components/thoron_adblock/renderer/document_agent.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/renderer/document_agent.h"
+
+#include <array>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_registry.h"
+#include "third_party/blink/public/platform/task_type.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_css_origin.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_element.h"
+#include "third_party/blink/public/web/web_element_collection.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+// After the page has loaded, look again this long after the previous look,
+// for content the page adds late (most ads are); then stop.
+constexpr std::array<base::TimeDelta, 4> kFollowUps = {
+    base::Seconds(1), base::Seconds(2), base::Seconds(4), base::Seconds(8)};
+// Bounds for one question to the browser and for one document. Longer names
+// are not what generic rules are written for.
+constexpr size_t kMaxNameLength = 128;
+constexpr size_t kMaxNamesPerQuestion = 4000;
+constexpr size_t kMaxNamesPerDocument = 40000;
+
+}  // namespace
+
+DocumentAgent::DocumentAgent(content::RenderFrame* render_frame,
+                             int32_t isolated_world_id)
+    : content::RenderFrameObserver(render_frame),
+      content::RenderFrameObserverTracker<DocumentAgent>(render_frame),
+      isolated_world_id_(isolated_world_id) {
+  // base::Unretained is safe: the registry belongs to the frame, and this
+  // object is deleted with the frame (OnDestruct).
+  render_frame->GetAssociatedInterfaceRegistry()
+      ->AddInterface<mojom::DocumentAgent>(base::BindRepeating(
+          &DocumentAgent::Bind, base::Unretained(this)));
+}
+
+DocumentAgent::~DocumentAgent() = default;
+
+void DocumentAgent::Bind(
+    mojo::PendingAssociatedReceiver<mojom::DocumentAgent> receiver) {
+  receiver_.reset();
+  receiver_.Bind(std::move(receiver));
+}
+
+void DocumentAgent::SetForNextCommittedLoad(const std::string& stylesheet,
+                                            const std::string& script,
+                                            const std::string& isolated_script,
+                                            bool generic) {
+  next_ = Resources{stylesheet, script, isolated_script, generic};
+}
+
+void DocumentAgent::DidCreateNewDocument() {
+  // A document the browser sent nothing for gets nothing: what was sent for
+  // an earlier navigation never carries over, and nothing still on its way
+  // for the previous document is applied to this one.
+  document_factory_.InvalidateWeakPtrs();
+  seen_classes_.clear();
+  seen_ids_.clear();
+  current_ = std::move(next_);
+  next_.reset();
+  generic_ = current_ && current_->generic;
+}
+
+void DocumentAgent::RunAtDocumentStart() {
+  if (!current_) {
+    return;
+  }
+  const Resources resources = std::move(*current_);
+  current_.reset();
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+  InsertStylesheet(resources.stylesheet);
+  if (!resources.isolated_script.empty()) {
+    // Procedural hide rules. The runner only watches the document and looks
+    // through it; it runs no page code, and the page cannot reach it.
+    frame->ExecuteScriptInIsolatedWorld(
+        isolated_world_id_,
+        blink::WebScriptSource(
+            blink::WebString::FromUtf8(resources.isolated_script)),
+        blink::BackForwardCacheAware::kAllow);
+  }
+  if (!resources.script.empty()) {
+    // The page's own world, as uBlock Origin's scriptlets run. This may
+    // delete the frame, so nothing follows it.
+    frame->ExecuteScript(blink::WebScriptSource(
+        blink::WebString::FromUtf8(resources.script)));
+  }
+}
+
+void DocumentAgent::InsertStylesheet(const std::string& stylesheet) {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame || stylesheet.empty()) {
+    return;
+  }
+  // A user style sheet: the page's own styles cannot take it back.
+  frame->GetDocument().InsertStyleSheet(blink::WebString::FromUtf8(stylesheet),
+                                        nullptr, blink::WebCssOrigin::kUser);
+}
+
+void DocumentAgent::DidDispatchDOMContentLoadedEvent() {
+  Survey();
+}
+
+void DocumentAgent::DidFinishLoad() {
+  Survey();
+  SurveyLater(0);
+}
+
+void DocumentAgent::SurveyLater(int step) {
+  if (!generic_ || step >= static_cast<int>(kFollowUps.size())) {
+    return;
+  }
+  render_frame()
+      ->GetTaskRunner(blink::TaskType::kInternalDefault)
+      ->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<DocumentAgent> agent, int step) {
+                if (agent) {
+                  agent->Survey();
+                  agent->SurveyLater(step + 1);
+                }
+              },
+              document_factory_.GetWeakPtr(), step),
+          kFollowUps[step]);
+}
+
+void DocumentAgent::Survey() {
+  blink::WebLocalFrame* frame = generic_ ? render_frame()->GetWebFrame()
+                                         : nullptr;
+  if (!frame ||
+      seen_classes_.size() + seen_ids_.size() >= kMaxNamesPerDocument) {
+    return;
+  }
+  std::vector<std::string> classes;
+  std::vector<std::string> ids;
+  const blink::WebString class_attribute = blink::WebString::FromAscii("class");
+  blink::WebElementCollection all = frame->GetDocument().All();
+  for (blink::WebElement element = all.FirstItem(); !element.IsNull();
+       element = all.NextItem()) {
+    if (classes.size() + ids.size() >= kMaxNamesPerQuestion) {
+      break;  // the rest at the next look
+    }
+    const blink::WebString id = element.GetIdAttribute();
+    if (!id.IsEmpty()) {
+      std::string name = id.Utf8();
+      if (name.size() <= kMaxNameLength && seen_ids_.insert(name).second) {
+        ids.push_back(std::move(name));
+      }
+    }
+    if (!element.HasAttribute(class_attribute)) {
+      continue;
+    }
+    const std::string names = element.GetAttribute(class_attribute).Utf8();
+    for (std::string_view name : base::SplitStringPiece(
+             names, base::kWhitespaceASCII, base::TRIM_WHITESPACE,
+             base::SPLIT_WANT_NONEMPTY)) {
+      if (name.size() <= kMaxNameLength &&
+          seen_classes_.insert(std::string(name)).second) {
+        classes.emplace_back(name);
+      }
+    }
+  }
+  if (classes.empty() && ids.empty()) {
+    return;
+  }
+  if (!host_.is_bound()) {
+    render_frame()->GetRemoteAssociatedInterfaces()->GetInterface(&host_);
+  }
+  host_->GenericStylesheet(
+      classes, ids,
+      base::BindOnce(&DocumentAgent::OnGenericStylesheet,
+                     document_factory_.GetWeakPtr()));
+}
+
+void DocumentAgent::OnGenericStylesheet(const std::string& stylesheet) {
+  InsertStylesheet(stylesheet);
+}
+
+void DocumentAgent::OnDestruct() {
+  delete this;
+}
+
+}  // namespace thoron_adblock
