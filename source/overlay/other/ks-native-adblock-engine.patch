+  EnsureStarted();
+  // not before the saved rules are read: the padlock would write over them
+  if (!saved_state_read_ || action < 0 || action > 3 ||
+      !base::IsStringASCII(source) || !base::IsStringASCII(destination) ||
+      !base::IsStringASCII(kind)) {
+    return;
+  }
+  std::string text(dynamic_rules_with_cell(
+      ToRust(session_rules_text_), ToRust(source), ToRust(destination),
+      ToRust(kind), static_cast<uint8_t>(action)));
+  if (text.size() <= kMaxMyRulesBytes) {
+    UseSessionRules(std::move(text));
+  }
