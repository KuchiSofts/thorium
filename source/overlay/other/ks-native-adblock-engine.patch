+function showLog() {
+  const select = $('log-tab');
+  const chosen = select.value;
+  select.replaceChildren(...log.map((tab, i) => {
+    const option = make('option', '', `${tab.title || tab.url} (${tab.entries.length})`);
+    option.value = String(i);
+    return option;
+  }));
+  if (!log.length) {
+    select.append(make('option', '', 'No tab has requests to show yet'));
+  }
+  if (chosen && Number(chosen) < log.length) {
+    select.value = chosen;
+  }
+  const tab = log[Number(select.value)] || {entries: []};
+  const filter = $('log-filter').value.trim().toLowerCase();
+  const kind = $('log-kind').value;
+  const entries = tab.entries.filter((e) => (!filter || e.url.toLowerCase().includes(filter)) &&
+                                            (!kind || (kind === 'blocked') === (e.blocked !== false)));
+  $('log-count').textContent = `${entries.length} shown`;
+  let site = '';
+  try {
+    site = new URL(tab.url).hostname;
+  } catch {
+    site = '';
+  }
+  $('log-rows').replaceChildren(...entries.map((e) => {
+    const blocked = e.blocked !== false;
+    const row = make('tr', blocked ? 'blocked' : 'allowed');
+    let host = '';
+    try {
+      host = new URL(e.url).hostname;
+    } catch {
+      host = '';
+    }
+    const act = make('td', 'act');
+    if (host) {
+      // as uBlock Origin's logger: a rule for the host, everywhere; or the host allowed on this tab's site
+      const rule = blocked ? `@@||${host}^${site ? `$domain=${site}` : ''}` : `||${host}^`;
+      const button = make('button', '', blocked ? 'Allow' : 'Block');
+      button.type = 'button';
+      button.title = rule;
+      button.addEventListener('click', () => change('addFilter', [rule], `${rule} was added to My filters.`));
+      act.append(button);
+    }
+    row.append(make('td', 'time', new Date(e.time).toLocaleTimeString()),
+               make('td', 'kind', blocked ? 'blocked' : 'let through'), make('td', 'url', e.url), act);
+    return row;
+  }));
+}
