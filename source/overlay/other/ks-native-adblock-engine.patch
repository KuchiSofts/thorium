+  // The switch for `host` or a host it is under; `found` is false when none of
+  // them has it set either way.
+  bool HostSwitch(std::string_view host, std::string_view name,
+                  bool* found) const;
+
+  // Host -> the names of its switches that are set: "media" on, "-media" kept
+  // out of a switch that is on for every site.
+  std::map<std::string, std::set<std::string>> site_switches_;
+  // The options changed from their defaults (KnownOption).
