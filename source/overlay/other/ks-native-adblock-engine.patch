@@ -0,0 +1,56 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_H_
+#define COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_H_
+
+#include <optional>
+
+#include "content/public/browser/frame_tree_node_id.h"
+#include "content/public/browser/global_routing_id.h"
+#include "url/gurl.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace network {
+struct ResourceRequest;
+}
+
+namespace thoron_adblock {
+
+// What the request for a document is to the engine: a page's own request, or
+// the request of a frame inside a page. Shared by the pieces that act on
+// document requests (DocumentRequestInterceptor, DocumentLoaderThrottle).
+struct DocumentRequest {
+  // Null when `request` is not for a document, or it is for a frame whose
+  // page cannot be found or is not an http(s) page (no per-site switch to
+  // read there, so nothing is done).
+  static std::optional<DocumentRequest> From(
+      const network::ResourceRequest& request,
+      content::WebContents* web_contents,
+      content::FrameTreeNodeId frame_tree_node_id);
+
+  // The address whose per-site switch decides for the document at `url`: the
+  // page's own for a page, the page a frame is in for a frame.
+  const GURL& SiteFor(const GURL& url) const {
+    return main_frame ? url : page_url;
+  }
+
+  // What the engine treats as the request's origin: for a page its own
+  // address, for a frame whoever started the navigation, else its page.
+  GURL SourceFor(const GURL& url) const;
+
+  bool main_frame = false;
+  // For a frame: the address of the page it is in. Empty for a page.
+  GURL page_url;
+  // For a frame: who asked for the navigation (may be empty).
+  GURL source;
+  // For a frame: the frame, for the page's count of blocked requests.
+  content::GlobalRenderFrameHostId frame;
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_H_
diff --git a/components/thoron_adblock/document_request_interceptor.cc b/components/thoron_adblock/document_request_interceptor.cc
new file mode 100644
index 0000000000000000000000000000000000000000..450dbd5a08dbc0954648caeb4c6a3c8fb711cb16
--- /dev/null
+++ b/components/thoron_adblock/document_request_interceptor.cc
@@ -0,0 +1,209 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/document_request_interceptor.h"
+
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/time/time.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/thoron_adblock/document_request.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/new_window.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_status_code.h"
+#include "net/http/http_util.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace thoron_adblock {
+
+// static
+std::unique_ptr<content::URLLoaderRequestInterceptor>
+DocumentRequestInterceptor::MaybeCreate(
+    scoped_refptr<HostContentSettingsMap> settings,
+    content::FrameTreeNodeId frame_tree_node_id) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock)) {
+    return nullptr;
+  }
+  return base::WrapUnique(
+      new DocumentRequestInterceptor(std::move(settings), frame_tree_node_id));
+}
+
+DocumentRequestInterceptor::DocumentRequestInterceptor(
+    scoped_refptr<HostContentSettingsMap> settings,
+    content::FrameTreeNodeId frame_tree_node_id)
+    : settings_(std::move(settings)), frame_tree_node_id_(frame_tree_node_id) {}
+
+DocumentRequestInterceptor::~DocumentRequestInterceptor() = default;
+
+void DocumentRequestInterceptor::MaybeCreateLoader(
+    const network::ResourceRequest& tentative_resource_request,
+    content::BrowserContext* browser_context,
+    content::URLLoaderRequestInterceptor::LoaderCallback callback) {
+  const GURL& url = tentative_resource_request.url;
+  const std::optional<DocumentRequest> document =
+      url.SchemeIsHTTPOrHTTPS()
+          ? DocumentRequest::From(
+                tentative_resource_request,
+                content::WebContents::FromFrameTreeNodeId(frame_tree_node_id_),
+                frame_tree_node_id_)
+          : std::nullopt;
+  // A window a page opened blank and now sends to a pop-up ad is closed; the
+  // site of the page that opened it decides, so this comes first.
+  if (document && document->main_frame) {
+    content::WebContents* tab =
+        content::WebContents::FromFrameTreeNodeId(frame_tree_node_id_);
+    if (tab && ClosesOpenedWindow(*tab, url, settings_.get())) {
+      std::move(callback).Run(
+          base::BindOnce(&DocumentRequestInterceptor::Refuse,
+                         weak_factory_.GetWeakPtr(), std::string()));
+      return;
+    }
+  }
+  if (!document || ProxyingURLLoaderFactory::AdsAllowedOn(
+                       settings_.get(), document->SiteFor(url))) {
+    std::move(callback).Run({});
+    return;
+  }
+
+  GURL clean;
+  if (document->main_frame) {
+    // A page's own request is never blocked. Its address may be rewritten by a
+    // `$uritransform` rule. A navigation to a redirector goes straight to the
+    // address written inside its own address ($urlskip); any other address is
+    // still cleaned. (The same order as in uBlock Origin.)
+    clean = EngineService::Get().TransformUrl(url);
+    if (!clean.is_valid() &&
+        tentative_resource_request.method == net::HttpRequestHeaders::kGetMethod) {
+      clean = EngineService::Get().SkipUrl(url);
+    }
+    if (!clean.is_valid()) {
+      clean = EngineService::Get().CleanUrl(url, url, /*main_frame=*/true);
+    }
+  } else {
+    const GURL site = document->SiteFor(url);
+    // "My rules" first (block, allow), as for every other request
+    const int dynamic = EngineService::Get().DynamicVerdict(
+        site, url, tentative_resource_request.destination);
+    EngineService::Decision decision =
+        dynamic == 2
+            ? EngineService::Decision()
+            : EngineService::Get().Check(
+                  url, document->SourceFor(url),
+                  tentative_resource_request.destination,
+                  tentative_resource_request.method);
+    if (dynamic == 1) {
+      decision.blocked = true;
+      decision.stand_in.clear();
+    }
+    // uBlock Origin's "medium mode": no frame from another site than the
+    // page's.
+    // (an allow rule of "My rules" beats it, as in uBlock Origin)
+    if (!decision.blocked && dynamic != 2 &&
+        ProxyingURLLoaderFactory::IsThirdParty(url, site) &&
+        EngineService::Get().SiteSwitch(site, "3p-frame")) {
+      decision.blocked = true;
+      decision.stand_in.clear();
+    }
+    if (decision.blocked) {
+      if (document->frame) {
+        BlockedCount::Record(document->frame, url);
+      }
+      std::move(callback).Run(
+          base::BindOnce(&DocumentRequestInterceptor::Refuse,
+                         weak_factory_.GetWeakPtr(), decision.stand_in));
+      return;
+    }
+    clean = decision.clean_url;
+  }
+  // `insert` is false for an address this navigation was already sent to: the
+  // site sent the browser back to the address with the parameter. It is
+  // loaded as it is then.
+  if (clean.is_valid() && cleaned_.insert(clean).second) {
+    std::move(callback).Run(
+        base::BindOnce(&DocumentRequestInterceptor::RedirectTo,
+                       weak_factory_.GetWeakPtr(), clean));
+    return;
+  }
+  std::move(callback).Run({});
+}
+
+void DocumentRequestInterceptor::Bind(
+    mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  // Both may still be bound from an earlier leg of the same navigation.
+  receiver_.reset();
+  client_.reset();
+  receiver_.Bind(std::move(receiver));
+  receiver_.set_disconnect_handler(
+      base::BindOnce(&DocumentRequestInterceptor::OnConnectionClosed,
+                     weak_factory_.GetWeakPtr()));
+  client_.Bind(std::move(client));
+}
+
+void DocumentRequestInterceptor::OnConnectionClosed() {
+  // The navigation moved on, or was cancelled.
+  receiver_.reset();
+  client_.reset();
+}
+
+void DocumentRequestInterceptor::RedirectTo(
+    const GURL& clean,
+    const network::ResourceRequest& request,
+    mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  Bind(std::move(receiver), std::move(client));
+  // An internal redirect that keeps the method (307), as the browser's own
+  // upgrade to https is done.
+  auto head = network::mojom::URLResponseHead::New();
+  head->encoded_data_length = 0;
+  head->request_start = base::TimeTicks::Now();
+  head->response_start = head->request_start;
+  const std::string headers = base::StringPrintf(
+      "HTTP/1.1 %i Internal Redirect\n"
+      "Location: %s\n"
+      "Non-Authoritative-Reason: ThoronAdblock\n",
+      net::HTTP_TEMPORARY_REDIRECT, clean.spec().c_str());
+  head->headers = base::MakeRefCounted<net::HttpResponseHeaders>(
+      net::HttpUtil::AssembleRawHeaders(headers));
+  const net::RedirectInfo redirect_info = net::RedirectInfo::ComputeRedirectInfo(
+      request.method, request.url, request.site_for_cookies,
+      request.update_first_party_url_on_redirect
+          ? net::RedirectInfo::FirstPartyURLPolicy::UPDATE_URL_ON_REDIRECT
+          : net::RedirectInfo::FirstPartyURLPolicy::NEVER_CHANGE_URL,
+      request.referrer_policy, request.referrer.spec(),
+      request.request_initiator, net::HTTP_TEMPORARY_REDIRECT, clean,
+      /*referrer_policy_header=*/std::nullopt,
+      /*insecure_scheme_was_upgraded=*/false);
+  client_->OnReceiveRedirect(redirect_info, std::move(head));
+}
+
+void DocumentRequestInterceptor::Refuse(
+    const std::string& stand_in,
+    const network::ResourceRequest& request,
+    mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  Bind(std::move(receiver), std::move(client));
+  if (stand_in.empty() || !ProxyingURLLoaderFactory::AnswerWithStandIn(
+                              stand_in, request, *client_)) {
+    // a frame the lists block leaves no empty box in its page
+    client_->OnComplete(
+        ProxyingURLLoaderFactory::BlockedStatus(request.destination));
+  }
+}
+
+}  // namespace thoron_adblock
