index 0000000000000000000000000000000000000000..ae75ba6a7482ac7e0d8a32bc5936943cc9ad5015
--- /dev/null
+++ b/components/thoron_adblock/subresource_loader_throttle.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/subresource_loader_throttle.h"
+
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/memory/ptr_util.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+constexpr char kReason[] = "ThoronAdblock";
+
+}  // namespace
+
+// static
+bool SubresourceLoaderThrottle::IsForDestination(
+    network::mojom::RequestDestination destination) {
+  using D = network::mojom::RequestDestination;
+  // What a "Link: rel=preload" can ask for, except `as=fetch` (an empty
+  // destination, which downloads have too).
+  return destination == D::kScript || destination == D::kStyle ||
+         destination == D::kFont || destination == D::kImage ||
+         destination == D::kTrack || destination == D::kAudio ||
+         destination == D::kVideo;
+}
+
+// static
+std::unique_ptr<blink::URLLoaderThrottle> SubresourceLoaderThrottle::MaybeCreate(
+    const network::ResourceRequest& request,
+    scoped_refptr<HostContentSettingsMap> settings) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock) ||
+      !IsForDestination(request.destination) ||
+      !request.url.SchemeIsHTTPOrHTTPS() || !request.request_initiator ||
+      request.request_initiator->opaque()) {
+    return nullptr;
+  }
+  return base::WrapUnique(
+      new SubresourceLoaderThrottle(std::move(settings), request));
+}
+
+SubresourceLoaderThrottle::SubresourceLoaderThrottle(
+    scoped_refptr<HostContentSettingsMap> settings,
+    const network::ResourceRequest& request)
+    : settings_(std::move(settings)),
+      destination_(request.destination),
+      source_(request.request_initiator->GetURL()) {}
+
+SubresourceLoaderThrottle::~SubresourceLoaderThrottle() = default;
+
+bool SubresourceLoaderThrottle::Ended(const GURL& url,
+                                      const std::string& method) {
+  if (allowed_) {
+    return false;
+  }
+  const EngineService::Decision decision =
+      EngineService::Get().Check(url, source_, destination_, method);
+  header_tests_ = decision.header_tests;
+  if (!decision.blocked) {
+    return false;
+  }
+  delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, kReason);
+  return true;
+}
+
+void SubresourceLoaderThrottle::WillStartRequest(
+    network::ResourceRequest* request,
+    bool* defer) {
+  // The page's site decides, as for every other request of the page.
+  allowed_ = ProxyingURLLoaderFactory::AdsAllowedOn(settings_.get(), source_);
+  Ended(request->url, request->method);
+}
+
+void SubresourceLoaderThrottle::WillRedirectRequest(
+    net::RedirectInfo* redirect_info,
+    const network::mojom::URLResponseHead& response_head,
+    bool* defer,
+    network::HttpRequestHeadersUpdateParams* headers_update_params) {
+  // A redirect is an answer too, and its target is a new request.
+  if (EndedByAnswer(response_head.headers.get())) {
+    return;
+  }
+  Ended(redirect_info->new_url, redirect_info->new_method);
+}
+
+void SubresourceLoaderThrottle::WillProcessResponse(
+    const GURL& response_url,
+    network::mojom::URLResponseHead* response_head,
+    bool* defer) {
+  if (response_head) {
+    EndedByAnswer(response_head->headers.get());
+  }
+}
+
+bool SubresourceLoaderThrottle::EndedByAnswer(
+    const net::HttpResponseHeaders* headers) {
+  if (allowed_ || !EngineService::HeaderTestsBlock(header_tests_, headers)) {
+    return false;
+  }
+  delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, kReason);
+  return true;
+}
+
+}  // namespace thoron_adblock
