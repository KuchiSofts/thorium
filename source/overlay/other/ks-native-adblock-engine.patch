@@ -0,0 +1,155 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/document_loader_throttle.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/feature_list.h"
+#include "base/memory/ptr_util.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/content_security_policy/content_security_policy.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/parsed_headers.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+constexpr char kPolicyHeader[] = "Content-Security-Policy";
+
+}  // namespace
+
+// static
+std::unique_ptr<blink::URLLoaderThrottle> DocumentLoaderThrottle::MaybeCreate(
+    const network::ResourceRequest& request,
+    scoped_refptr<HostContentSettingsMap> settings,
+    content::WebContents* web_contents,
+    content::FrameTreeNodeId frame_tree_node_id) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock)) {
+    return nullptr;
+  }
+  std::optional<DocumentRequest> document =
+      DocumentRequest::From(request, web_contents, frame_tree_node_id);
+  if (!document) {
+    return nullptr;
+  }
+  return base::WrapUnique(new DocumentLoaderThrottle(
+      std::move(settings), std::move(*document), request));
+}
+
+DocumentLoaderThrottle::DocumentLoaderThrottle(
+    scoped_refptr<HostContentSettingsMap> settings,
+    DocumentRequest document,
+    const network::ResourceRequest& request)
+    : settings_(std::move(settings)),
+      document_(std::move(document)),
+      destination_(request.destination),
+      url_(request.url),
+      method_(request.method) {}
+
+DocumentLoaderThrottle::~DocumentLoaderThrottle() = default;
+
+bool DocumentLoaderThrottle::EndedByAnswer(
+    const net::HttpResponseHeaders* headers) {
+  // A page's own request is never ended, and nothing is on a site where the
+  // person allowed ads.
+  if (document_.main_frame || !headers || !url_.SchemeIsHTTPOrHTTPS() ||
+      ProxyingURLLoaderFactory::AdsAllowedOn(settings_.get(),
+                                             document_.SiteFor(url_))) {
+    return false;
+  }
+  const EngineService::Decision decision = EngineService::Get().Check(
+      url_, document_.SourceFor(url_), destination_, method_);
+  if (!EngineService::HeaderTestsBlock(decision.header_tests, headers)) {
+    return false;
+  }
+  if (document_.frame) {
+    BlockedCount::Record(document_.frame, url_);
+  }
+  delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, "ThoronAdblock");
+  return true;
+}
+
+void DocumentLoaderThrottle::WillRedirectRequest(
+    net::RedirectInfo* redirect_info,
+    const network::mojom::URLResponseHead& response_head,
+    bool* defer,
+    network::HttpRequestHeadersUpdateParams* headers_update_params) {
+  // A redirect is an answer too.
+  if (EndedByAnswer(response_head.headers.get())) {
+    return;
+  }
+  url_ = redirect_info->new_url;
+  method_ = redirect_info->new_method;
+}
+
+void DocumentLoaderThrottle::WillProcessResponse(
+    const GURL& response_url,
+    network::mojom::URLResponseHead* response_head,
+    bool* defer) {
+  if (response_head && EndedByAnswer(response_head->headers.get())) {
+    return;
+  }
+  if (!response_head || !response_url.SchemeIsHTTPOrHTTPS() ||
+      ProxyingURLLoaderFactory::AdsAllowedOn(
+          settings_.get(), document_.SiteFor(response_url))) {
+    return;
+  }
+  const std::string policy = EngineService::Get().DocumentPolicy(
+      response_url, document_.SourceFor(response_url), document_.main_frame);
+  if (!policy.empty()) {
+    AddPolicy(policy, response_url, response_head);
+  }
+  // Features the lists switch off for the document ($permissions). The engine
+  // only ever returns "name=()" entries, so this header can take a feature
+  // away from the page and never give one. The renderer reads the header when
+  // the document commits; a later entry for a feature overrides the site's.
+  const std::string permissions = EngineService::Get().DocumentPermissions(
+      response_url, document_.SourceFor(response_url), document_.main_frame);
+  if (!permissions.empty() && response_head->headers) {
+    response_head->headers->AddHeader("Permissions-Policy", permissions);
+  }
+}
+
+// static
+void DocumentLoaderThrottle::AddPolicy(
+    const std::string& policy,
+    const GURL& response_url,
+    network::mojom::URLResponseHead* response_head) {
+  // Only the lists' own text is parsed here (plain ASCII, bounded: engine.rs);
+  // the site's headers were parsed by the network service and stay as they
+  // are. A policy can only take permissions away from the page.
+  std::vector<network::mojom::ContentSecurityPolicyPtr> parsed =
+      network::ParseContentSecurityPolicies(
+          policy, network::mojom::ContentSecurityPolicyType::kEnforce,
+          network::mojom::ContentSecurityPolicySource::kHTTP, response_url);
+  if (parsed.empty()) {
+    return;
+  }
+  if (!response_head->parsed_headers) {
+    response_head->parsed_headers = network::mojom::ParsedHeaders::New();
+  }
+  for (auto& one : parsed) {
+    response_head->parsed_headers->content_security_policy.push_back(
+        std::move(one));
+  }
+  if (response_head->headers) {
+    response_head->headers->AddHeader(kPolicyHeader, policy);
+  }
+}
+
+}  // namespace thoron_adblock
