+$('log-kind').addEventListener('change', showLog);
+$('log-filter').addEventListener('input', showLog);
+// Also while this tab is in the background: the browser keeps the requests let through only while the
+// logger asks (a background tab's timers may run only once a minute).
+setInterval(refreshLog, 2000);
+
+function show(state) {
+  showLists(state.lists);
+  $('not-applied').hidden = !state.notApplied;
+
+  $('last-check').textContent = state.lastCheck > 0 ?
+      `Last looked for updates: ${new Date(state.lastCheck * 1000).toLocaleString()}` :
+      'The lists that came with the browser are in use.';
+  $('result').textContent = state.result;
+  $('result-box').hidden = !state.result;
+
+  const box = $('my-filters');
+  if (box.value === savedFilters) {  // never overwrite what is being typed
+    box.value = state.myFilters;
+  }
+  savedFilters = state.myFilters;
+  $('my-count').textContent = state.myFiltersRules > 0 ? `${rulesText(state.myFiltersRules)} in use` : '';
+  showDirty();
+}
+
+function showDirty() {
+  const dirty = $('my-filters').value !== savedFilters;
+  $('save-filters').disabled = !dirty;
+  $('revert-filters').disabled = !dirty;
+}
+
+async function refresh() {
+  show(await sendWithPromise('getState'));
+}
+
+/** Asks the browser for one change, says how it went, and shows the new state. */
+async function change(name, args, done) {
+  if (busy) {
+    return;
+  }
+  busy = true;
+  document.body.classList.add('busy');
+  say('Working...');
+  let error = '';
+  try {
+    error = await sendWithPromise(name, ...args);
+  } catch (e) {
+    error = 'The browser did not answer. Reload the page and try again.';
+  }
+  busy = false;
+  document.body.classList.remove('busy');
+  await refresh();
+  say(error || done, !!error);
+  return !error;
+}
+
+$('add-url').placeholder = 'https' + '://example.com/filters.txt';
+
+$('add-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const input = $('add-url');
+  const url = input.value.trim();
+  if (url && await change('addList', [url], 'The list was added and is in use.')) {
+    input.value = '';
+  }
+});
+
+$('update-now').addEventListener('click', () => {
+  change('updateNow', [], 'Looked for newer lists.');
+});
+
+$('my-filters').addEventListener('input', showDirty);
+
+$('save-filters').addEventListener('click', () => {
+  // When the browser refuses the rules, the box keeps what was typed.
+  change('setMyFilters', [$('my-filters').value], 'Your filters were saved and are in use.');
+});
+
+$('revert-filters').addEventListener('click', () => {
+  $('my-filters').value = savedFilters;
+  showDirty();
+  say('');
+});
+
+window.addEventListener('beforeunload', (event) => {
+  if ($('my-filters').value !== savedFilters) {
+    event.preventDefault();
+  }
+});
+
+refresh();
+showSettings();
+showMyRules();
+refreshSites();
+refreshLog();
