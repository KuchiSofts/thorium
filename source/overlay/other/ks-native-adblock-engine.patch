+
+#ifndef COMPONENTS_THORON_ADBLOCK_DOCUMENT_OBSERVER_H_
+#define COMPONENTS_THORON_ADBLOCK_DOCUMENT_OBSERVER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "components/thoron_adblock/document_agent.mojom.h"
+#include "content/public/browser/render_frame_host_receiver_set.h"
