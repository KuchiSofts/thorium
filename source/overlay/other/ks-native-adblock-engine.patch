+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_NEW_WINDOW_H_
+#define COMPONENTS_THORON_ADBLOCK_NEW_WINDOW_H_
+
+class GURL;
+class HostContentSettingsMap;
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace thoron_adblock {
+
+// True when native ad blocking keeps the document in `opener` from opening a
+// window or tab at `target_url` (window.open(), a link with a target): the
+// lists' `$popup` rules (or `$all`, which covers pop-ups) block the address
+// for the site of the tab, or the person switched pop-ups off on that site
+// (the menu's "no pop-ups", which, as in uBlock Origin, stops every window the
+// site opens, also one a click opens). A window kept from opening is counted
+// on the opener's page. False when native ad blocking is off, or ads are
+// allowed on the site. UI thread only.
+bool BlocksNewWindow(content::RenderFrameHost& opener,
+                     const GURL& target_url,
+                     const HostContentSettingsMap* settings);
+
+// For the first navigation of a window or tab that a page opened (`tab`), to
+// `url`: true when the lists' `$popup` rules block the address for the site
+// of the page that opened it. This is the page that opens a blank window and
+// sends it to an ad afterwards, which BlocksNewWindow cannot see. The window
+// is then closed soon after, and counted on the opener's page. UI thread only.
+bool ClosesOpenedWindow(content::WebContents& tab,
+                        const GURL& url,
+                        const HostContentSettingsMap* settings);
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_NEW_WINDOW_H_
