new file mode 100644
index 0000000000000000000000000000000000000000..f80c48ce79a22ba9ad0a569887711c065abc9af0
--- /dev/null
+++ b/components/thoron_adblock/fuzz_lists.rs
@@ -0,0 +1,283 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Build-machine tool: looks for filter list text that makes the engine, or Thoron's code around
+//! it, abort. The browser downloads filter lists and reads them in its own process, and a Rust
+//! panic there ends the browser, so the reading has to survive any text.
+//!
+//! It takes real list lines, changes some of them (cuts, swaps, operators and odd characters put
+//! in), builds an engine from each small list as the browser does, and asks it everything the
+//! browser asks: what to do with requests of every type, which policy a document gets, what a
+//! document needs (with the invariants a style sheet and a rule for the page-side runner must
+//! keep), generic hide rules, and saving and loading the engine. Not shipped.
+//!
+//!     fuzz_lists <lists.txt> <seconds> [resources.json] [seed]
+//!     fuzz_lists --replay <input.txt> [resources.json]
+//!
+//! Before each round the list is written to `fuzz_lists_last.txt` in the working directory. After
+//! an abort that file is the input that caused it; `--replay` runs it again.
+
+// This tool uses only part of what it shares with the browser's engine.
+#[allow(dead_code)]
+mod cosmetics;
+#[allow(dead_code)]
+mod engine_core;
+#[allow(dead_code)]
+mod procedural;
+#[allow(dead_code)]
+mod query;
+#[allow(dead_code)]
+mod urlskip;
+
+use adblock::resources::Resource;
+use std::process::ExitCode;
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        // xorshift64*: the same numbers for the same seed, on every machine
+        self.0 ^= self.0 >> 12;
+        self.0 ^= self.0 << 25;
+        self.0 ^= self.0 >> 27;
+        self.0.wrapping_mul(0x2545F4914F6CDD1D)
+    }
+
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n.max(1) as u64) as usize
+    }
+}
+
+/// Pieces of filter syntax and characters that parsers trip over.
+const BITS: &[&str] = &[
+    "##", "#@#", "#?#", "##+js(", "##^", "$", ",", "|", "||", "^", "*", "@@", "~", "=", "!", "[", "]", "(", ")",
+    "{", "}", "\"", "'", "\\", "/", ":", ";", " ", "\t", "\u{0}", "\u{e9}", "\u{1F600}", "\u{202e}",
+    ":has-text(", ":upward(", ":xpath(", ":matches-css(", ":has(", ":not(", ":-abp-has(", ":others(", ":style(",
+    ":remove()", ":remove-attr(", ":remove-class(", "removeparam", "removeparam=", "removeparam=/^(a|b)/", "csp=",
+    "redirect=", "redirect-rule=", "domain=", "from=", "to=", "denyallow=", "important", "badfilter", "match-case",
+    "third-party", "document", "generichide", "elemhide", "all", "/^[a-z]{2,}$/", "*$", "$$", "\n",
+    "! thoron-list: ublock-filters\n", "! thoron-list: easylist\n",
+];
+
+fn mutate(rng: &mut Rng, line: &str, other: &str) -> String {
+    let mut chars: Vec<char> = line.chars().collect();
+    for _ in 0..1 + rng.below(4) {
+        let at = rng.below(chars.len() + 1);
+        match rng.below(7) {
+            0 => {
+                if !chars.is_empty() {
+                    chars.remove(at.min(chars.len() - 1));
+                }
+            }
+            1 => chars.truncate(at),
+            2 => {
+                let bit: Vec<char> = BITS[rng.below(BITS.len())].chars().collect();
+                chars.splice(at..at, bit);
+            }
+            3 => {
+                let o: Vec<char> = other.chars().collect();
+                let from = rng.below(o.len() + 1);
+                chars.splice(at..at, o[from..].iter().copied());
+            }
+            4 => {
+                if !chars.is_empty() {
+                    let i = at.min(chars.len() - 1);
+                    chars[i] = char::from_u32(rng.below(0x250) as u32).unwrap_or('x');
+                }
+            }
+            5 => {
+                let copy: Vec<char> = chars.iter().copied().take(at).collect();
+                chars.splice(at..at, copy);
+            }
+            _ => chars.reverse(),
+        }
+        chars.truncate(800);
+    }
+    chars.into_iter().collect()
+}
+
+/// A small list for one round: real lines, some of them changed.
+fn compose(rng: &mut Rng, lines: &[&str]) -> String {
+    let mut text = String::new();
+    for _ in 0..40 + rng.below(80) {
+        let line = lines[rng.below(lines.len())];
+        if rng.below(10) < 4 {
+            let other = lines[rng.below(lines.len())];
+            text.push_str(&mutate(rng, line, other));
+        } else {
+            text.push_str(line);
+        }
+        text.push('\n');
+    }
+    text
+}
+
+/// Host names, class names and ids the list's own rules speak of, so the questions hit its rules.
+fn names(text: &str) -> (Vec<String>, Vec<String>, Vec<String>) {
+    let plain = |s: &str| !s.is_empty() && s.len() < 60 && s.chars().all(|c| c.is_ascii_alphanumeric() || "-_.".contains(c));
+    let (mut hosts, mut classes, mut ids) = (vec!["news.example".to_string()], Vec::new(), Vec::new());
+    for line in text.lines() {
+        if let Some((before, after)) = line.split_once("##") {
+            hosts.extend(before.split(',').filter(|h| plain(h) && h.contains('.')).take(2).map(str::to_string));
+            if let Some(class) = after.strip_prefix('.').filter(|c| plain(c) && !c.contains('.')) {
+                classes.push(class.to_string());
+            } else if let Some(id) = after.strip_prefix('#').filter(|i| plain(i) && !i.contains('.')) {
+                ids.push(id.to_string());
+            }
+        } else if let Some(rest) = line.strip_prefix("||") {
+            let host: String = rest.chars().take_while(|c| c.is_ascii_alphanumeric() || "-.".contains(*c)).collect();
+            if plain(&host) && host.contains('.') {
+                hosts.push(host);
+            }
+        }
+    }
+    hosts.truncate(8);
+    classes.truncate(40);
+    ids.truncate(40);
+    (hosts, classes, ids)
+}
+
+const TYPES: &[&str] = &["document", "subdocument", "script", "image", "stylesheet", "xmlhttprequest", "websocket", "other"];
+
+#[derive(Default)]
+struct Totals {
+    rounds: u64,
+    decisions: u64,
+    blocked: u64,
+    cleaned: u64,
+    policies: u64,
+    pages_with_runner: u64,
+    reload_differences: u64,
+    first_difference: Option<String>,
+}
+
+/// Everything the browser asks of an engine built from `text`. Panics when an answer breaks a rule
+/// it must keep; adblock-rust's own panics come from inside the calls.
+fn exercise(text: &str, resources: Option<&Vec<Resource>>, totals: &mut Totals) {
+    let mut filters = engine_core::build(text);
+    let reloaded = engine_core::load(&engine_core::save(&filters)).expect("a saved engine must load again");
+    if let Some(resources) = resources {
+        filters.engine.use_resources(resources.clone());
+    }
+    let (hosts, classes, ids) = names(text);
+    for (i, host) in hosts.iter().enumerate() {
+        let source = format!("https://{}/", hosts[(i + 1) % hosts.len()]);
+        let urls = [
+            format!("https://{host}/"),
+            format!("https://{host}/path/ads.js?utm_source=a&gclid=b&ad=1&x#top"),
+            format!("wss://{host}/socket?id=1"),
+            format!("http://{host}/?"),
+        ];
+        for (j, url) in urls.iter().enumerate() {
+            let kind = TYPES[(i + j) % TYPES.len()];
+            let d = engine_core::decide(&filters, url, &source, kind, true);
+            totals.decisions += 1;
+            totals.blocked += d.blocked as u64;
+            assert!(d.blocked || d.stand_in.is_empty(), "a stand-in without a block for {url}");
+            if !d.clean_url.is_empty() {
+                totals.cleaned += 1;
+                // only parameters may be gone
+                let before = url.split('?').next().unwrap_or_default();
+                assert!(d.clean_url.starts_with(before), "{url} was cleaned to {}", d.clean_url);
+                assert!(d.clean_url.len() < url.len(), "{url} was cleaned to {}", d.clean_url);
+            }
+            if engine_core::decide(&reloaded, url, &source, kind, true).blocked != d.blocked {
+                totals.reload_differences += 1;
+                totals.first_difference.get_or_insert_with(|| format!("{url} from {source} as {kind}"));
+            }
+            let policy = engine_core::policy(&filters, url, &source, j % 2 == 0);
+            if !policy.is_empty() {
+                totals.policies += 1;
+                assert!(policy.chars().all(|c| c == ' ' || c.is_ascii_graphic()), "a policy that is not plain text: {policy:?}");
+                assert!(!policy.to_ascii_lowercase().contains("report-"), "a policy that asks for reports: {policy}");
+            }
+        }
+        let page = cosmetics::page(&filters, &urls[0]);
+        for line in page.stylesheet.lines() {
+            // one rule per line, and nothing that leaves its rule
+            assert!(
+                line.ends_with('}') && line.matches('{').count() == 1 && line.matches('}').count() == 1,
+                "a style sheet line that is not one rule: {line:?}"
+            );
+        }
+        for rule in &page.procedural {
+            let parsed: serde_json::Value = serde_json::from_str(rule).expect("a rule for the runner must be JSON");
+            assert!(parsed.get("s").is_some() && parsed.get("t").is_some() && parsed.get("a").is_some(), "{rule}");
+            assert!(!rule.contains('<'), "a raw \"<\" in a rule for the runner: {rule}");
+        }
+        if !page.isolated_script.is_empty() {
+            totals.pages_with_runner += 1;
+            assert!(page.isolated_script.starts_with("(function(filters) {"));
+            assert!(page.isolated_script.ends_with("]);\n"));
+        }
+        let generic = cosmetics::generic_stylesheet(&filters, &urls[0], &classes, &ids);
+        for line in generic.lines() {
+            assert!(line.ends_with("{display:none!important}") && line.matches('{').count() == 1, "{line:?}");
+        }
+    }
+    totals.rounds += 1;
+}
+
+fn read_resources(path: Option<&String>) -> Option<Vec<Resource>> {
+    let text = std::fs::read_to_string(path?).ok()?;
+    serde_json::from_str(&text).ok()
+}
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().collect();
+    let mut totals = Totals::default();
+    if args.len() >= 3 && args[1] == "--replay" {
+        let Ok(text) = std::fs::read_to_string(&args[2]) else {
+            eprintln!("fuzz_lists: cannot read {}", args[2]);
+            return ExitCode::FAILURE;
+        };
+        exercise(&text, read_resources(args.get(3)).as_ref(), &mut totals);
+        println!("fuzz_lists: the input was read without an abort ({} decisions)", totals.decisions);
+        return ExitCode::SUCCESS;
+    }
+    let (Some(lists), Some(seconds)) = (args.get(1), args.get(2).and_then(|s| s.parse::<u64>().ok())) else {
+        eprintln!("usage: fuzz_lists <lists.txt> <seconds> [resources.json] [seed]");
+        return ExitCode::FAILURE;
+    };
+    let Ok(text) = std::fs::read_to_string(lists) else {
+        eprintln!("fuzz_lists: cannot read {lists}");
+        return ExitCode::FAILURE;
+    };
+    let lines: Vec<&str> = text.lines().filter(|l| !l.is_empty() && !l.starts_with("! ") && l.len() < 2000).collect();
+    if lines.len() < 100 {
+        eprintln!("fuzz_lists: {lists} is not a lists file");
+        return ExitCode::FAILURE;
+    }
+    let resources = read_resources(args.get(3));
+    let seed = args.get(4).and_then(|s| s.parse::<u64>().ok()).unwrap_or(0x9E3779B97F4A7C15);
+    println!(
+        "fuzz_lists: {} seed lines, {} resources, seed {seed}, {seconds} s",
+        lines.len(),
+        resources.as_ref().map(Vec::len).unwrap_or(0)
+    );
+    let mut rng = Rng(seed);
+    let start = std::time::Instant::now();
+    while start.elapsed().as_secs() < seconds {
+        let list = compose(&mut rng, &lines);
+        if std::fs::write("fuzz_lists_last.txt", &list).is_err() {
+            eprintln!("fuzz_lists: cannot write fuzz_lists_last.txt");
+            return ExitCode::FAILURE;
+        }
+        // every fourth round with the scriptlets and stand-ins, as the browser has them
+        let with = if totals.rounds % 4 == 0 { resources.as_ref() } else { None };
+        exercise(&list, with, &mut totals);
+    }
+    println!(
+        "fuzz_lists: {} lists read without an abort; {} decisions ({} blocked, {} cleaned), {} policies, {} pages with \
+         rules for the runner, {} decisions that differ after saving and loading{}",
+        totals.rounds,
+        totals.decisions,
+        totals.blocked,
+        totals.cleaned,
+        totals.policies,
+        totals.pages_with_runner,
+        totals.reload_differences,
+        totals.first_difference.map(|d| format!(" (first: {d})")).unwrap_or_default()
+    );
+    ExitCode::SUCCESS
+}
