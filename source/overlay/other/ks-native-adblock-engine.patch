+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/websocket.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/feature_list.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "content/public/browser/render_frame_host.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "net/http/http_request_headers.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+bool BlocksWebSocket(content::RenderFrameHost& frame,
+                     const GURL& url,
+                     const HostContentSettingsMap* settings) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock)) {
+    return false;
+  }
+  const GURL page = frame.GetOutermostMainFrame()->GetLastCommittedURL();
+  if (!page.SchemeIsHTTPOrHTTPS() ||
+      ProxyingURLLoaderFactory::AdsAllowedOn(settings, page)) {
+    return false;
+  }
+  EngineService::Get().EnsureStarted();
+  if (!EngineService::Get().BlocksWebSocket(
+          url, frame.GetLastCommittedOrigin().GetURL())) {
+    return false;
+  }
+  BlockedCount::Record(frame.GetGlobalId());
+  return true;
+}
+
+void ConnectWebSocket(
+    content::ContentBrowserClient::WebSocketFactory factory,
+    const GURL& url,
+    const std::optional<std::string>& user_agent,
+    mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+        handshake_client,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> header_client) {
+  std::vector<network::mojom::HttpHeaderPtr> headers;
+  if (user_agent) {
+    headers.push_back(network::mojom::HttpHeader::New(
+        net::HttpRequestHeaders::kUserAgent, *user_agent));
+  }
+  std::move(factory).Run(url, std::move(headers), std::move(handshake_client),
+                         mojo::NullRemote(), std::move(header_client));
+}
+
+}  // namespace thoron_adblock
