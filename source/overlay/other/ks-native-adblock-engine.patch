index 0000000000000000000000000000000000000000..6376322631d71e15b5b223f4e797c6dd4d584b8d
--- /dev/null
+++ b/components/thoron_adblock/proxying_url_loader_factory.cc
@@ -0,0 +1,256 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/byte_size.h"
+#include "base/containers/span.h"
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/redirect_watcher.h"
+#include "content/public/browser/render_frame_host.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "net/base/data_url.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "services/network/public/cpp/parsed_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace thoron_adblock {
+
+using FactoryType = content::ContentBrowserClient::URLLoaderFactoryType;
+
+namespace {
+
+// How the page may use the stand-in, as the network would have labelled a
+// real answer: its own site's answer, a CORS answer, or an opaque one.
+network::mojom::FetchResponseType StandInType(
+    const network::ResourceRequest& request) {
+  if (request.request_initiator &&
+      request.request_initiator->IsSameOriginWith(request.url)) {
+    return network::mojom::FetchResponseType::kBasic;
+  }
+  switch (request.mode) {
+    case network::mojom::RequestMode::kCors:
+    case network::mojom::RequestMode::kCorsWithForcedPreflight:
+      return network::mojom::FetchResponseType::kCors;
+    case network::mojom::RequestMode::kNoCors:
+      return network::mojom::FetchResponseType::kOpaque;
+    default:
+      return network::mojom::FetchResponseType::kBasic;
+  }
+}
+
+}  // namespace
+
+// static
+bool ProxyingURLLoaderFactory::AnswerWithStandIn(
+    const std::string& stand_in,
+    const network::ResourceRequest& request,
+    network::mojom::URLLoaderClient& client) {
+  const GURL data_url(stand_in);
+  if (!data_url.is_valid() || !data_url.SchemeIs(url::kDataScheme)) {
+    return false;
+  }
+  std::string mime_type;
+  std::string charset;
+  std::string body;
+  scoped_refptr<net::HttpResponseHeaders> headers;
+  if (net::DataURL::BuildResponse(data_url, "GET", &mime_type, &charset, &body,
+                                  &headers) != net::OK ||
+      !headers) {
+    return false;
+  }
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  if (mojo::CreateDataPipe(std::max<size_t>(body.size(), 1u), producer,
+                           consumer) != MOJO_RESULT_OK) {
+    return false;
+  }
+  if (!body.empty() &&
+      producer->WriteAllData(base::as_byte_span(body)) != MOJO_RESULT_OK) {
+    return false;
+  }
+  producer.reset();
+
+  auto head = network::mojom::URLResponseHead::New();
+  head->request_time = base::Time::Now();
+  head->response_time = head->request_time;
+  head->headers = headers;
+  head->mime_type = mime_type;
+  head->charset = charset;
+  head->content_length = static_cast<int64_t>(body.size());
+  head->response_type = StandInType(request);
+  head->parsed_headers =
+      network::PopulateParsedHeaders(headers.get(), request.url);
+  client.OnReceiveResponse(std::move(head), std::move(consumer), std::nullopt);
+
+  network::URLLoaderCompletionStatus status(net::OK);
+  status.encoded_data_length = base::ByteSize(body.size());
+  status.encoded_body_length = base::ByteSize(body.size());
+  status.decoded_body_length = base::ByteSize(body.size());
+  client.OnComplete(status);
+  return true;
+}
+
+// static
+bool ProxyingURLLoaderFactory::AdsAllowedOn(
+    const HostContentSettingsMap* settings,
+    const GURL& top_site) {
+  return settings && top_site.is_valid() &&
+         settings->GetContentSetting(top_site, top_site,
+                                     ContentSettingsType::ADS) ==
+             CONTENT_SETTING_ALLOW;
+}
+
+// static
+void ProxyingURLLoaderFactory::MaybeProxy(
+    FactoryType type,
+    network::URLLoaderFactoryBuilder& factory_builder,
+    const HostContentSettingsMap* settings,
+    const net::IsolationInfo& isolation_info,
+    const url::Origin& request_initiator,
+    content::RenderFrameHost* frame) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock)) {
+    return;
+  }
+  // Load the engine at the first sign of a page, so it is ready when the
+  // page's document commits and its first requests arrive.
+  EngineService::Get().EnsureStarted();
+  // Everything a page, a worker or a service worker loads comes through
+  // here, the scripts a worker or a service worker is started from included
+  // (a service worker may import them from another site). Not here:
+  // documents (a page, a frame in one), which are
+  // DocumentRequestInterceptor's; downloads, which the person asked for;
+  // pages fetched ahead of a visit, since a page's own request is never
+  // blocked; and DevTools' own requests.
+  const bool worker_script = type == FactoryType::kWorkerMainResource ||
+                             type == FactoryType::kServiceWorkerScript;
+  if (type != FactoryType::kDocumentSubResource &&
+      type != FactoryType::kWorkerSubResource &&
+      type != FactoryType::kServiceWorkerSubResource && !worker_script) {
+    return;
+  }
+  // Decided once per document or worker: a changed setting applies from the
+  // next load, as page info says.
+  url::Origin top = isolation_info.top_frame_origin().has_value()
+                        ? *isolation_info.top_frame_origin()
+                        : request_initiator;
+  if (type == FactoryType::kWorkerMainResource && frame &&
+      !isolation_info.top_frame_origin().has_value()) {
+    // A worker's script is fetched without a word about the page: the page
+    // of the document that starts the worker decides.
+    top = frame->GetOutermostMainFrame()->GetLastCommittedOrigin();
+  }
+  if (AdsAllowedOn(settings, top.GetURL())) {
+    return;
+  }
+  auto [receiver, target_factory] = factory_builder.Append();
+  // Owns itself: deleted when its pipes close.
+  new ProxyingURLLoaderFactory(
+      frame ? frame->GetGlobalId() : content::GlobalRenderFrameHostId(),
+      std::move(receiver), std::move(target_factory));
+}
+
+ProxyingURLLoaderFactory::ProxyingURLLoaderFactory(
+    content::GlobalRenderFrameHostId frame,
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory)
+    : frame_(frame) {
+  // base::Unretained is safe: the callbacks are owned by this object.
+  target_factory_.Bind(std::move(target_factory));
+  target_factory_.set_disconnect_handler(
+      base::BindOnce(&ProxyingURLLoaderFactory::OnTargetFactoryDisconnect,
+                     base::Unretained(this)));
+  proxy_receivers_.Add(this, std::move(receiver));
+  proxy_receivers_.set_disconnect_handler(base::BindRepeating(
+      &ProxyingURLLoaderFactory::OnProxyDisconnect, base::Unretained(this)));
+}
+
+ProxyingURLLoaderFactory::~ProxyingURLLoaderFactory() = default;
+
+void ProxyingURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  const GURL source = request.request_initiator
+                          ? request.request_initiator->GetURL()
+                          : GURL();
+  const EngineService::Decision decision =
+      EngineService::Get().Check(request.url, source, request.destination);
+  if (decision.blocked) {
+    mojo::Remote<network::mojom::URLLoaderClient> remote(std::move(client));
+    if (decision.stand_in.empty() ||
+        !AnswerWithStandIn(decision.stand_in, request, *remote)) {
+      remote->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+    }
+    if (frame_) {
+      BlockedCount::Record(frame_);
+    }
+    return;
+  }
+  // The request goes out, with a watcher between its loader and its client
+  // that looks at the redirects it may meet.
+  mojo::PendingRemote<network::mojom::URLLoader> target_loader;
+  mojo::PendingRemote<network::mojom::URLLoaderClient> watcher_client;
+  mojo::PendingReceiver<network::mojom::URLLoaderClient>
+      watcher_client_receiver = watcher_client.InitWithNewPipeAndPassReceiver();
+  if (decision.clean_url.is_valid()) {
+    // `$removeparam`: the request goes out without the parameters the lists
+    // name. The page is not told (no redirect): it asked for one address and
+    // gets that resource.
+    network::ResourceRequest cleaned = request;
+    cleaned.url = decision.clean_url;
+    target_factory_->CreateLoaderAndStart(
+        target_loader.InitWithNewPipeAndPassReceiver(), request_id, options,
+        cleaned, std::move(watcher_client), traffic_annotation);
+  } else {
+    target_factory_->CreateLoaderAndStart(
+        target_loader.InitWithNewPipeAndPassReceiver(), request_id, options,
+        request, std::move(watcher_client), traffic_annotation);
+  }
+  RedirectWatcher::Start({source, request.destination, frame_},
+                         std::move(loader_receiver), std::move(client),
+                         std::move(target_loader),
+                         std::move(watcher_client_receiver));
+}
+
+void ProxyingURLLoaderFactory::Clone(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+  proxy_receivers_.Add(this, std::move(receiver));
+}
+
+void ProxyingURLLoaderFactory::OnTargetFactoryDisconnect() {
+  delete this;
+}
+
+void ProxyingURLLoaderFactory::OnProxyDisconnect() {
+  if (proxy_receivers_.empty()) {
+    delete this;
+  }
+}
+
+}  // namespace thoron_adblock
