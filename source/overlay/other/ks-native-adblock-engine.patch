+
+EngineService::Decision EngineService::Check(
+    const GURL& url,
+    const GURL& source,
+    network::mojom::RequestDestination destination,
+    std::string_view method) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!engine_ || !IsBlockableScheme(url) || !source.is_valid() ||
+      !base::IsStringASCII(method)) {
+    return {};
+  }
+  // The option of uBlock Origin's: the reports a page's security policy asks
+  // the browser to send (where they go is up to the page).
+  if (destination == network::mojom::RequestDestination::kReport &&
+      Option("block-csp-reports")) {
+    return {true, std::string(), GURL(), std::string()};
+  }
+  const std::string& u = url.spec();
+  const std::string& s = source.spec();
+  const std::string_view t = RequestType(destination);
+  RequestDecision found = (*engine_)->check_request(
+      rust::Str(u.data(), u.size()), rust::Str(s.data(), s.size()),
+      rust::Str(t.data(), t.size()), rust::Str(method.data(), method.size()));
+  GURL instead = CheckedTransform(url, std::string(found.transformed_url),
+                                  IsDocument(destination));
+  if (!instead.is_valid()) {
+    instead = CheckedClean(url, std::string(found.clean_url));
+  }
+  return {found.blocked, std::string(found.stand_in), std::move(instead),
+          std::string(found.header_tests)};
+}
+
+// static
+bool EngineService::HeaderTestsBlock(const std::string& tests,
+                                     const net::HttpResponseHeaders* headers) {
+  // "Non-Authoritative-Reason" marks a redirect the browser made up itself
+  // (to https, or to an address without tracking parameters).
+  if (tests.empty() || !headers ||
+      headers->HasHeader("Non-Authoritative-Reason")) {
+    return false;
+  }
+  // One "name:value" per line, in the order the headers came. A value is
+  // whatever bytes the server sent; a line break is never among them.
+  std::string lines;
+  size_t iter = 0;
+  std::string name;
+  std::string value;
+  while (headers->EnumerateHeaderLines(&iter, &name, &value)) {
+    base::StrAppend(&lines, {name, ":", value, "\n"});
+  }
+  return header_tests_block(
+      rust::Str(tests.data(), tests.size()),
+      rust::Slice<const uint8_t>(
+          reinterpret_cast<const uint8_t*>(lines.data()), lines.size()));
+}
