+        let saved = trusted.serialize();
+        assert_eq!(engine_from_serialized(&saved).skip_url(url, url), "https://shop.example/p");
+        // a redirector the lists block is skipped only by a rule that says so
+        let blocked = engine_from_rules(
+            "! thoron-list: ublock-privacy\n||out.example^$doc\n||out.example/go^$doc,urlskip=?url\n\
+             ||out.example/strict^$doc,urlskip=?url -blocked\n",
+        );
+        assert_eq!(blocked.skip_url(url, url), "");
+        let strict = "https://out.example/strict?url=https%3A%2F%2Fshop.example%2Fp";
+        assert_eq!(blocked.skip_url(strict, strict), "https://shop.example/p");
+    }
+
+    #[test]
+    fn a_saved_engine_keeps_selectors_and_trust_but_not_resources() {
+        let rules = "! thoron-list: ublock-filters\nnews.example##+js(trusted-set-cookie, a=b)\nnews.example##.ad-box\n";
+        let mut restored = engine_from_serialized(&engine_from_rules(rules).serialize());
+        assert!(restored.is_valid());
+        let before = restored.document_resources("https://news.example/");
+        assert_eq!(before.hide_selectors, vec![".ad-box".to_string()]);
+        assert!(before.script.is_empty());
+        assert_eq!(restored.use_resources(RESOURCES), 4);
+        assert!(restored.document_resources("https://news.example/").script.contains("trustedSetCookie("));
+    }
+
+    const NEWS: &str = "https://news.example/";
+
+    #[test]
+    fn removeparam_cleans_the_address() {
+        let e = engine_from_rules("$removeparam=utm_source\n||shop.example^$doc,removeparam=ref\n||ads.example^\n");
+        // a rule without a type is for documents, frames and fetches
+        for kind in ["document", "subdocument", "xmlhttprequest"] {
+            let d = e.check_request("https://news.example/a?utm_source=mail&id=7", NEWS, kind);
+            assert!(!d.blocked);
+            assert_eq!(d.clean_url, "https://news.example/a?id=7", "{kind}");
+        }
+        assert!(e.check_request("https://news.example/a.js?utm_source=mail", NEWS, "script").clean_url.is_empty());
+        // nothing to remove: the address stays
+        assert!(e.check_request("https://news.example/a?id=7", NEWS, "document").clean_url.is_empty());
+        assert!(e.check_request("https://news.example/a", NEWS, "document").clean_url.is_empty());
+        // the last parameter takes the "?" with it; the fragment stays
+        assert_eq!(e.clean_url("https://news.example/a?utm_source=x#top", NEWS, "document"), "https://news.example/a#top");
+        // a blocked request is blocked, not cleaned; clean_url alone still answers
+        let d = e.check_request("https://ads.example/p?utm_source=x", NEWS, "xmlhttprequest");
+        assert!(d.blocked && d.clean_url.is_empty());
+        assert_eq!(e.clean_url("https://ads.example/p?utm_source=x", NEWS, "xmlhttprequest"), "https://ads.example/p");
+        // a rule for documents of one site
+        assert_eq!(e.clean_url("https://shop.example/?ref=a&x=1", "https://shop.example/", "document"), "https://shop.example/?x=1");
+        assert!(e.clean_url("https://shop.example/?ref=a&x=1", "https://shop.example/", "xmlhttprequest").is_empty());
+        assert!(e.clean_url("not a url?utm_source=x", NEWS, "document").is_empty());
+        assert!(engine_from_serialized(b"not an engine").clean_url("https://news.example/a?utm_source=x", NEWS, "document").is_empty());
+    }
+
+    #[test]
+    fn removeparam_rules_the_engine_drops_are_applied_too() {
+        let rules = "$removeparam=gclid\n$removeparam=fbclid\n\
+                     ||video.example/api$xhr,removeparam=/^ad/\n\
+                     ||strip.example^$removeparam\n\
+                     @@||keep.example/book/$removeparam\n\
+                     @@||one.example^$removeparam=gclid\n";
+        let e = engine_from_rules(rules);
+        let check = |e: &Engine| {
+            let clean = |url: &str, kind: &str| e.clean_url(url, NEWS, kind);
+            // a pattern: every parameter it matches, where its rule matches
+            assert_eq!(clean("https://video.example/api?ad=1&adNetworkId=2&v=9", "xmlhttprequest"), "https://video.example/api?v=9");
+            assert!(clean("https://video.example/api?ad=1&v=9", "document").is_empty());
+            assert!(clean("https://other.example/api?ad=1&v=9", "xmlhttprequest").is_empty());
+            // no value: every parameter
+            assert_eq!(clean("https://strip.example/p?a=1&b=2", "document"), "https://strip.example/p");
+            // an exception for everything, only where it matches
+            assert!(clean("https://keep.example/book/?gclid=1&fbclid=2", "document").is_empty());
+            assert_eq!(clean("https://keep.example/other?gclid=1&x=2", "document"), "https://keep.example/other?x=2");
+            // an exception for one parameter
+            assert_eq!(clean("https://one.example/?gclid=1&fbclid=2&x=3", "document"), "https://one.example/?gclid=1&x=3");
+            assert!(clean("https://one.example/?gclid=1&x=3", "document").is_empty());
+        };
+        check(&e);
+        // the same from a saved engine
+        let restored = engine_from_serialized(&e.serialize());
+        assert!(restored.is_valid());
+        check(&restored);
+    }
+
+    #[test]
+    fn csp_rules_give_a_document_its_policy() {
+        let e = engine_from_rules(
+            "||video.example^$csp=script-src 'self'\n\
+             $csp=worker-src 'none',domain=miner.example\n\
+             @@||video.example/embed/$csp\n",
+        );
+        let video = "https://video.example/watch";
+        assert_eq!(e.document_policy(video, video, true), "script-src 'self'");
+        assert_eq!(e.document_policy("https://video.example/frame", NEWS, false), "script-src 'self'");
+        // by the page a frame is in
+        assert_eq!(e.document_policy("https://cdn.example/f.html", "https://miner.example/", false), "worker-src 'none'");
+        assert_eq!(e.document_policy("https://miner.example/", "https://miner.example/", true), "worker-src 'none'");
+        // an exception, a page no rule names, an address that is not one, no engine
+        let embed = "https://video.example/embed/1";
+        assert!(e.document_policy(embed, embed, true).is_empty());
+        assert!(e.document_policy(NEWS, NEWS, true).is_empty());
+        assert!(e.document_policy("not a url", NEWS, true).is_empty());
+        assert!(engine_from_serialized(b"not an engine").document_policy(video, video, true).is_empty());
+    }
+
+    #[test]
+    fn a_policy_that_is_not_plain_text_is_not_passed_on() {
+        assert!(safe_policy("script-src 'self' https://a.example; worker-src 'none'"));
+        for bad in ["", " ", "a\nb", "script-src 'self'\r\nX-Other: 1", "sandbox \u{e9}", "a\u{0}b"] {
+            assert!(!safe_policy(bad), "{bad:?}");
+        }
+        assert!(!safe_policy(&"a".repeat(5000)));
+        // nothing that makes the page report to someone
+        for bad in ["default-src 'self'; report-uri https://collect.example/r", "script-src 'none'; Report-To grp"] {
+            assert!(!safe_policy(bad), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn a_csp_rule_that_asks_for_reports_is_not_applied() {
+        let e = engine_from_rules(
+            "||video.example^$csp=worker-src 'none'\n\
+             ||video.example^$csp=img-src 'self'; report-uri https://collect.example/r\n\
+             ||spy.example^$csp=default-src *; report-to grp\n",
+        );
+        let video = "https://video.example/watch";
+        // the rule without reports still applies
+        assert_eq!(e.document_policy(video, video, true), "worker-src 'none'");
+        let spy = "https://spy.example/";
+        assert!(e.document_policy(spy, spy, true).is_empty());
+        // several policies for one document
+        let both = engine_from_rules("||video.example^$csp=worker-src 'none'\n||video.example^$csp=frame-src 'self'\n");
+        assert_eq!(both.document_policy(video, video, true), "frame-src 'self', worker-src 'none'");
+    }
+
+    /// The mark at the end of a rule for the runner: ...,"a":["mark","abcdefghijkl"]}
+    fn mark_of(rule: &str) -> &str {
+        let mark = &rule[rule.len() - 15..rule.len() - 3];
+        assert!(rule.ends_with(&format!("\"a\":[\"mark\",\"{mark}\"]}}")), "{rule}");
+        assert!(mark.chars().all(|c| c.is_ascii_lowercase()), "{rule}");
+        mark
+    }
+
+    #[test]
+    fn procedural_rules_go_to_the_runner() {
+        let e = engine_from_rules(
+            "news.example##div.card:has-text(Sponsored)\n\
+             news.example##.plain\n\
+             news.example##a:shadow(b)\n\
+             other.example##p:has-text(x)\n",
+        );
+        let d = e.document_resources(NEWS);
+        assert_eq!(d.hide_selectors, vec![".plain".to_string()]);
+        assert_eq!(d.procedural.len(), 1, "{:?}", d.procedural);
+        let rule = &d.procedural[0];
+        assert!(rule.starts_with(r#"{"s":"div.card","t":[["has-text","Sponsored"]],"a":["mark",""#), "{rule}");
+        let mark = mark_of(rule);
+        // what carries the mark is hidden by the style sheet
+        assert_eq!(d.stylesheet, format!(".plain{{display:none!important}}\n[{mark}]{{display:none!important}}\n"));
+        // the runner, without its comments, called with the rules
+        assert!(d.isolated_script.starts_with("(function(filters) {\n"), "{}", &d.isolated_script[..80]);
+        assert!(d.isolated_script.ends_with(&format!("\n}})([{rule}]);\n")));
+        assert!(!d.isolated_script.lines().any(|l| l.trim_start().starts_with("//")));
+        // a new mark for every document
+        assert_ne!(e.document_resources(NEWS).procedural, d.procedural);
+        // a page without such rules gets no runner
+        let plain = e.document_resources("https://shop.example/");
+        assert!(plain.procedural.is_empty() && plain.isolated_script.is_empty() && plain.stylesheet.is_empty());
+    }
+
+    #[test]
+    fn action_rules_restyle_remove_or_strip() {
+        let e = engine_from_rules(
+            "news.example##.wall:style(opacity: 1 !important;)\n\
+             news.example##.bg:style(background: url(https://x.example/a.png))\n\
+             news.example##.banner:remove()\n\
+             news.example##a.locked:remove-class(locked)\n\
+             news.example##.go[disabled]:remove-attr(disabled)\n\
+             news.example##div:has-text(Ad):style(visibility: hidden !important)\n\
+             news.example##p:has-text(Ad):style(visibility: hidden !important)\n\
+             news.example##li:has-text(Promo):remove()\n",
+        );
+        let d = e.document_resources(NEWS);
+        assert!(d.hide_selectors.is_empty());
+        // a style rule with a CSS selector is CSS; one that would fetch something is left out
+        assert!(d.stylesheet.contains(".wall{opacity: 1 !important;}\n"), "{}", d.stylesheet);
+        assert!(!d.stylesheet.contains("url("), "{}", d.stylesheet);
+        // removing and stripping are the runner's
+        let has = |rule: &str| d.procedural.contains(&rule.to_string());
+        assert!(has(r#"{"s":".banner","t":[],"a":["remove"]}"#), "{:?}", d.procedural);
+        assert!(has(r#"{"s":"a.locked","t":[],"a":["remove-class","locked"]}"#), "{:?}", d.procedural);
+        assert!(has(r#"{"s":".go[disabled]","t":[],"a":["remove-attr","disabled"]}"#), "{:?}", d.procedural);
+        assert!(has(r#"{"s":"li","t":[["has-text","Promo"]],"a":["remove"]}"#), "{:?}", d.procedural);
+        // a procedural selector with a style: the elements are marked and the mark is styled; two
+        // rules with the same style share a mark
+        let styled: Vec<&String> = d.procedural.iter().filter(|r| r.contains("\"Ad\"")).collect();
+        assert_eq!(styled.len(), 2);
+        let mark = mark_of(styled[0]);
+        assert_eq!(mark_of(styled[1]), mark);
+        assert_eq!(d.stylesheet.matches(&format!("[{mark}]{{visibility: hidden !important}}\n")).count(), 1, "{}", d.stylesheet);
+        assert_eq!(d.procedural.len(), 6);
+        assert!(!d.isolated_script.is_empty());
+    }
+
+    #[test]
+    fn a_generic_rule_with_an_operator_is_not_sent_as_css() {
+        let e = engine_from_rules("##.ad-banner\n##.promo:has-text(Ad)\n");
+        let names = |list: &[&str]| list.iter().map(|s| s.to_string()).collect::<Vec<String>>();
+        let sheet = e.generic_stylesheet("https://shop.example/", &names(&["ad-banner", "promo"]), &names(&[]));
+        assert_eq!(sheet, ".ad-banner{display:none!important}\n");
+        assert!(!e.document_resources("https://shop.example/").stylesheet.contains("has-text"));
+    }
+
+    #[test]
+    fn a_procedural_rule_needs_a_site() {
+        let e = engine_from_rules(
+            "##div:has-text(Ad)\n##a[href^=\"http\"]:upward(2)\n##[data-ad]\nnews.example##p:has-text(Ad)\n",
+        );
+        // a page no rule names gets the plain rule for every site, and no runner
+        let d = e.document_resources("https://shop.example/");
+        assert_eq!(d.hide_selectors, vec!["[data-ad]".to_string()]);
+        assert!(d.procedural.is_empty(), "{:?}", d.procedural);
+        assert!(d.isolated_script.is_empty());
+        assert_eq!(d.stylesheet, "[data-ad]{display:none!important}\n");
+        // the site's own procedural rule still runs, alone
+        let d = e.document_resources(NEWS);
+        assert_eq!(d.procedural.len(), 1, "{:?}", d.procedural);
+        assert!(d.procedural[0].starts_with(r#"{"s":"p","t":[["has-text","Ad"]]"#), "{:?}", d.procedural);
+        // the same from a saved engine
+        let restored = engine_from_serialized(&e.serialize());
+        assert!(restored.document_resources("https://shop.example/").procedural.is_empty());
+        assert_eq!(restored.document_resources(NEWS).procedural.len(), 1);
+    }
+
+    #[test]
+    fn a_saved_engine_of_another_layout_is_refused() {
+        let e = engine_from_rules(RULES);
+        let saved = e.serialize();
+        assert!(engine_from_serialized(&saved).is_valid());
+        // adblock-rust's own bytes without Thoron's header (the layout before P5.22)
+        assert!(!engine_from_serialized(&saved[12..]).is_valid());
+        // cut short, or with a length that points past the end
+        assert!(!engine_from_serialized(&saved[..10]).is_valid());
+        let mut wrong = saved.clone();
+        wrong[8..12].copy_from_slice(&u32::MAX.to_le_bytes());
+        assert!(!engine_from_serialized(&wrong).is_valid());
+    }
+}
