+// The folder may not be there yet: on a new profile nothing else wrote to it.
+void WriteStoreFile(const base::FilePath& path, const std::string& text) {
+  if (base::CreateDirectory(path.DirName())) {
+    base::ImportantFileWriter::WriteFileAtomically(path, text);
+  }
+}
+
+void WriteJson(base::FilePath path, base::Value value) {
+  std::string text;
+  if (base::JSONWriter::Write(value, &text)) {
+    WriteStoreFile(path, text);
+  }
+}
