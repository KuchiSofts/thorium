+    /// The mark at the end of a rule for the runner: ...,"a":["mark","abcdefghijkl","<declarations>"]}
+    fn mark_of(rule: &str) -> &str {
+        let at = rule.rfind("\"a\":[\"mark\",\"").expect(rule) + 13;
+        let mark = &rule[at..at + 12];
+        assert!(rule[at + 12..].starts_with("\",\""), "{rule}");
+        assert!(rule.ends_with("\"]}"), "{rule}");
+        assert!(mark.chars().all(|c| c.is_ascii_lowercase()), "{rule}");
+        mark
+    }
