+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_DOCUMENT_LOADER_THROTTLE_H_
+#define COMPONENTS_THORON_ADBLOCK_DOCUMENT_LOADER_THROTTLE_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "components/thoron_adblock/document_request.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+#include "url/gurl.h"
+
+class HostContentSettingsMap;
+
+namespace content {
+class WebContents;
+}
+
+namespace net {
+class HttpResponseHeaders;
+}
+
+namespace network {
+struct ResourceRequest;
+}
+
+namespace thoron_adblock {
+
+// `$csp` and `$permissions`: when the response for a document arrives (a
+// page's, or a frame's inside one), the content security policy the lists ask
+// for is added to the document's own, and the features they switch off.
+// `$header`: a frame whose server answers with a header a rule names is not
+// loaded. It lives in the browser, on the navigation's loader. Nothing is
+// done on a site where the person allowed ads. (What happens to a document's
+// request before it goes out is DocumentRequestInterceptor's.)
+class DocumentLoaderThrottle : public blink::URLLoaderThrottle {
+ public:
+  // Null when native ad blocking is off, or `request` is not for a document.
+  // `web_contents` is the tab the navigation is in (may be null).
+  static std::unique_ptr<blink::URLLoaderThrottle> MaybeCreate(
+      const network::ResourceRequest& request,
+      scoped_refptr<HostContentSettingsMap> settings,
+      content::WebContents* web_contents,
+      content::FrameTreeNodeId frame_tree_node_id);
+
+  DocumentLoaderThrottle(const DocumentLoaderThrottle&) = delete;
+  DocumentLoaderThrottle& operator=(const DocumentLoaderThrottle&) = delete;
+  ~DocumentLoaderThrottle() override;
+
+  // Adds `policy` (the value of a Content-Security-Policy header) to a
+  // document's response, as the header and in parsed form, which is the form
+  // the navigation reads. Public for tests.
+  static void AddPolicy(const std::string& policy,
+                        const GURL& response_url,
+                        network::mojom::URLResponseHead* response_head);
+
+ private:
+  DocumentLoaderThrottle(scoped_refptr<HostContentSettingsMap> settings,
+                         DocumentRequest document,
+                         const network::ResourceRequest& request);
+
+  // blink::URLLoaderThrottle:
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override;
+  void WillProcessResponse(const GURL& response_url,
+                           network::mojom::URLResponseHead* response_head,
+                           bool* defer) override;
+
+  // `$header`, for a frame: true when the answer with `headers` to the
+  // request for `url_` ended the navigation.
+  bool EndedByAnswer(const net::HttpResponseHeaders* headers);
+
+  const scoped_refptr<HostContentSettingsMap> settings_;
+  const DocumentRequest document_;
+  const network::mojom::RequestDestination destination_;
+  // The address the request is at, and its method: both change at a redirect.
+  GURL url_;
+  std::string method_;
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_DOCUMENT_LOADER_THROTTLE_H_
