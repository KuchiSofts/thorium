--- /dev/null
+++ b/components/thoron_adblock/procedural.rs
@@ -0,0 +1,486 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Hide rules that plain CSS cannot express. Filter lists write them with extra operators, a syntax
+//! defined by uBlock Origin (and Adblock Plus and AdGuard before it):
+//!     example.com##div.card:has-text(Sponsored)
+//!     example.com##span:has-text(/^Ad$/):upward(2)
+//! adblock-rust is built here without its CSS parser, so it hands such a selector over as one string.
+//! This module splits it into a CSS selector to start from and a list of tasks, which the page-side
+//! runner (procedural.js) carries out. A selector with no such operator comes back as plain CSS. One
+//! that cannot be understood is refused, and its rule is left out.
+//!
+//! Nothing here depends on the engine, so the tests run on their own.
+
+/// One step of a procedural selector.
+#[derive(Debug, PartialEq, Clone)]
+pub enum Task {
+    /// An operator and its argument as written: ("has-text", "Sponsored"). "spath" is CSS that
+    /// continues from the elements found so far.
+    Op(&'static str, String),
+    /// "has" or "not" around a selector that is itself procedural.
+    Nested(&'static str, Program),
+}
+
+/// A procedural selector: where to start, then what to do with what was found.
+#[derive(Debug, PartialEq, Clone)]
+pub struct Program {
+    /// Plain CSS. Empty: start at the document itself.
+    pub selector: String,
+    pub tasks: Vec<Task>,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum Compiled {
+    /// No procedural operator: a selector a style sheet can use (`:-abp-has()` written as `:has()`).
+    Css(String),
+    Procedural(Program),
+}
+
+/// Operators that take text, with the name the runner knows them by.
+const TEXT_OPS: &[(&str, &str)] = &[
+    ("has-text", "has-text"),
+    ("-abp-contains", "has-text"),
+    ("contains", "has-text"),
+    ("matches-attr", "matches-attr"),
+    ("matches-css", "matches-css"),
+    ("matches-css-before", "matches-css-before"),
+    ("matches-css-after", "matches-css-after"),
+    ("matches-media", "matches-media"),
+    ("matches-path", "matches-path"),
+    ("min-text-length", "min-text-length"),
+    ("others", "others"),
+    ("upward", "upward"),
+    ("watch-attr", "watch-attr"),
+    ("xpath", "xpath"),
+];
+
+/// Operators the runner does not have (two rules in the lists use `:shadow()`), and action
+/// operators, which belong at the end of a rule and are taken off before the selector gets here.
+const REFUSED: &[&str] =
+    &["shadow", "matches-prop", "if", "if-not", "remove", "style", "remove-attr", "remove-class"];
+
+fn text_op(name: &str) -> Option<&'static str> {
+    TEXT_OPS.iter().find(|(written, _)| *written == name).map(|(_, known)| *known)
+}
+
+/// True when `text` uses a procedural operator anywhere.
+fn has_procedural_operator(text: &str) -> bool {
+    let names = TEXT_OPS.iter().map(|(written, _)| *written).chain(REFUSED.iter().copied());
+    names.chain(["-abp-has"]).any(|name| text.contains(&format!(":{name}(")))
+}
+
+/// The index of the quote that closes the string opened at `open`.
+fn end_of_string(b: &[u8], open: usize) -> Option<usize> {
+    let mut i = open + 1;
+    while i < b.len() {
+        match b[i] {
+            b'\\' => i += 2,
+            c if c == b[open] => return Some(i),
+            _ => i += 1,
+        }
+    }
+    None
+}
+
+/// The index of the `]` that closes the attribute selector opened at `open`.
+fn end_of_brackets(b: &[u8], open: usize) -> Option<usize> {
+    let mut i = open + 1;
+    while i < b.len() {
+        match b[i] {
+            b'\\' => i += 2,
+            b'"' | b'\'' => i = end_of_string(b, i)? + 1,
+            b']' => return Some(i),
+            _ => i += 1,
+        }
+    }
+    None
+}
+
+/// The index of the `)` that closes the `(` at `open`. With `strings`, parentheses inside quotes do
+/// not count; an argument like `Don't miss` has a lone quote, so the caller tries both ways.
+fn end_of_parens(b: &[u8], open: usize, strings: bool) -> Option<usize> {
+    let (mut depth, mut i) = (0usize, open);
+    while i < b.len() {
+        match b[i] {
+            b'\\' => {
+                i += 2;
+                continue;
+            }
+            b'"' | b'\'' if strings => i = end_of_string(b, i)?,
+            b'(' => depth += 1,
+            b')' => {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(i);
+                }
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    None
+}
+
+/// The argument of a text operator, refused when the runner could do nothing with it.
+fn checked_arg(op: &str, arg: &str) -> Option<String> {
+    let arg = arg.trim();
+    let ok = match op {
+        "others" => arg.is_empty(),
+        "watch-attr" => true,
+        "min-text-length" => arg.parse::<u32>().is_ok(),
+        "upward" => match arg.parse::<u32>() {
+            Ok(n) => (1..256).contains(&n),
+            Err(_) => !arg.is_empty() && !has_procedural_operator(arg),
+        },
+        "matches-css" | "matches-css-before" | "matches-css-after" => {
+            matches!(arg.split_once(':'), Some((name, value)) if !name.trim().is_empty() && !value.trim().is_empty())
+        }
+        _ => !arg.is_empty(),
+    };
+    ok.then(|| arg.to_string())
+}
+
+/// Ends the CSS collected so far: the first piece is where the program starts, a later one
+/// continues from the elements found so far.
+fn flush(css: &mut String, root: &mut Option<String>, tasks: &mut Vec<Task>) {
+    let text = std::mem::take(css);
+    if root.is_none() {
+        *root = Some(text.trim().to_string());
+    } else if !text.trim().is_empty() {
+        tasks.push(Task::Op("spath", text.trim_end().to_string()));
+    }
+}
+
+/// Splits a rule's selector into CSS and procedural tasks. `None`: the selector cannot be used.
+pub fn compile(selector: &str) -> Option<Compiled> {
+    let b = selector.as_bytes();
+    let mut css = String::new();
+    let mut root: Option<String> = None;
+    let mut tasks: Vec<Task> = Vec::new();
+    // `start`: where the CSS not yet copied into `css` begins.
+    let (mut i, mut start) = (0usize, 0usize);
+    while i < b.len() {
+        match b[i] {
+            b'\\' => i += 2,
+            b'"' | b'\'' => i = end_of_string(b, i)? + 1,
+            b'[' => i = end_of_brackets(b, i)? + 1,
+            // "a:has-text(x), b" is not one program
+            b',' if !tasks.is_empty() => return None,
+            b':' => {
+                let name_start = i + 1;
+                let mut j = name_start;
+                while j < b.len() && (b[j].is_ascii_alphanumeric() || b[j] == b'-') {
+                    j += 1;
+                }
+                if j == name_start || j >= b.len() || b[j] != b'(' {
+                    i = j.max(i + 1); // ":hover", "::before"
+                    continue;
+                }
+                let name = &selector[name_start..j];
+                let close = end_of_parens(b, j, true).or_else(|| end_of_parens(b, j, false))?;
+                let arg = &selector[j + 1..close];
+                if let Some(op) = text_op(name) {
+                    css.push_str(&selector[start..i]);
+                    flush(&mut css, &mut root, &mut tasks);
+                    tasks.push(Task::Op(op, checked_arg(op, arg)?));
+                    start = close + 1;
+                } else if matches!(name, "has" | "not" | "-abp-has") {
+                    match compile(arg)? {
+                        Compiled::Css(inner) => {
+                            if name == "-abp-has" {
+                                css.push_str(&selector[start..i]);
+                                css.push_str(&format!(":has({inner})"));
+                                start = close + 1;
+                            } // ":has()" and ":not()" stay in the CSS as written
+                        }
+                        Compiled::Procedural(program) => {
+                            css.push_str(&selector[start..i]);
+                            flush(&mut css, &mut root, &mut tasks);
+                            tasks.push(Task::Nested(if name == "not" { "not" } else { "has" }, program));
+                            start = close + 1;
+                        }
+                    }
+                } else if REFUSED.contains(&name) || has_procedural_operator(arg) {
+                    // an operator the runner lacks, or one inside ":is(...)" and the like
+                    return None;
+                }
+                i = close + 1;
+            }
+            _ => i += 1,
+        }
+    }
+    css.push_str(selector.get(start..)?);
+    if tasks.is_empty() {
+        let css = css.trim();
+        return (!css.is_empty()).then(|| Compiled::Css(css.to_string()));
+    }
+    flush(&mut css, &mut root, &mut tasks);
+    Some(Compiled::Procedural(Program { selector: root.unwrap_or_default(), tasks }))
+}
+
+/// The declarations of a `:style(...)` rule go into a style sheet as `selector{declarations}`. As in
+/// uBlock Origin, a list may restyle an element but not make the page fetch anything, so `url(` and
+/// its relatives are refused, and so is anything that could end the rule or hide what follows.
+pub fn safe_style(declarations: &str) -> bool {
+    let lower = declarations.to_ascii_lowercase();
+    !declarations.trim().is_empty()
+        && !declarations.contains(['{', '}', '\\', '<', '@'])
+        && !declarations.contains("/*")
+        && !declarations.chars().any(|c| c.is_control())
+        && !["url(", "image-set(", "image(", "expression(", "src("].iter().any(|bad| lower.contains(bad))
+}
+
+/// An attribute or class name for `:remove-attr()` and `:remove-class()`.
+pub fn safe_name(name: &str) -> bool {
+    !name.is_empty() && name.len() <= 128 && name.chars().all(|c| c.is_ascii_alphanumeric() || "-_:.".contains(c))
+}
+
+/// `text` as a JSON string. Also valid inside a script: "<" is written as an escape.
+pub fn json_string(text: &str) -> String {
+    let mut out = String::with_capacity(text.len() + 2);
+    out.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if c.is_control() || c == '<' || c == '\u{2028}' || c == '\u{2029}' => {
+                out.push_str(&format!("\\u{:04x}", c as u32))
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+impl Program {
+    /// `{"s":"div","t":[["has-text","Ad"],["has",{"s":"a","t":[...]}]]}`, as procedural.js reads it.
+    pub fn to_json(&self) -> String {
+        let tasks: Vec<String> = self
+            .tasks
+            .iter()
+            .map(|task| match task {
+                Task::Op(name, arg) => format!("[{},{}]", json_string(name), json_string(arg)),
+                Task::Nested(name, program) => format!("[{},{}]", json_string(name), program.to_json()),
+            })
+            .collect();
+        format!("{{\"s\":{},\"t\":[{}]}}", json_string(&self.selector), tasks.join(","))
+    }
+
+    /// One filter for the runner: the program and what to do with the elements it finds. `action`
+    /// is ["mark", attribute], ["remove"], ["remove-attr", name] or ["remove-class", name].
+    pub fn filter_json(&self, action: &[&str]) -> String {
+        let action: Vec<String> = action.iter().map(|part| json_string(part)).collect();
+        let program = self.to_json();
+        format!("{},\"a\":[{}]}}", &program[..program.len() - 1], action.join(","))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn op(name: &'static str, arg: &str) -> Task {
+        Task::Op(name, arg.to_string())
+    }
+
+    fn program(selector: &str) -> Program {
+        match compile(selector) {
+            Some(Compiled::Procedural(p)) => p,
+            other => panic!("{selector}: {other:?}"),
+        }
+    }
+
+    fn css(selector: &str) -> String {
+        match compile(selector) {
+            Some(Compiled::Css(s)) => s,
+            other => panic!("{selector}: {other:?}"),
+        }
+    }
+
+    #[test]
+    fn plain_css_stays_css() {
+        for s in [
+            ".ad-box",
+            "#promo > a:not(.keep)",
+            "div[class^=\"ad-\"]:nth-child(2n+1)",
+            ".MuiBox-root:has(> .adsbygoogle)",
+            "a[href*=\":has-text(\"]",
+            "div:is(h3, h4) span",
+            ".dark\\:border:hover::before",
+            "a, b",
+        ] {
+            assert_eq!(css(s), s);
+        }
+        assert_eq!(css("  .x  "), ".x");
+        assert_eq!(compile(""), None);
+        assert_eq!(compile("   "), None);
+    }
+
+    #[test]
+    fn abp_has_becomes_native_has() {
+        assert_eq!(css("li:-abp-has(> div:not(.c))"), "li:has(> div:not(.c))");
+        assert_eq!(css("a:-abp-has(b) > c"), "a:has(b) > c");
+    }
+
+    #[test]
+    fn operators_become_tasks() {
+        let p = program("div.card:has-text(Sponsored)");
+        assert_eq!(p.selector, "div.card");
+        assert_eq!(p.tasks, vec![op("has-text", "Sponsored")]);
+
+        let p = program("[onclick] p:has-text(/Ad/):xpath(../../..)");
+        assert_eq!(p.selector, "[onclick] p");
+        assert_eq!(p.tasks, vec![op("has-text", "/Ad/"), op("xpath", "../../..")]);
+
+        let p = program("span:has-text(/^Ad$/):upward(2)");
+        assert_eq!(p.tasks, vec![op("has-text", "/^Ad$/"), op("upward", "2")]);
+
+        // the older names
+        assert_eq!(program("a:-abp-contains(Ad)").tasks, vec![op("has-text", "Ad")]);
+        assert_eq!(program("a:contains(Ad)").tasks, vec![op("has-text", "Ad")]);
+    }
+
+    #[test]
+    fn css_after_an_operator_continues_from_the_elements_found() {
+        let p = program("h2:has-text(Sponsored) + div");
+        assert_eq!(p.selector, "h2");
+        assert_eq!(p.tasks, vec![op("has-text", "Sponsored"), op("spath", " + div")]);
+
+        let p = program("div:has-text(x):not(.keep) > a");
+        assert_eq!(p.tasks, vec![op("has-text", "x"), op("spath", ":not(.keep) > a")]);
+    }
+
+    #[test]
+    fn a_program_may_start_at_the_document() {
+        let p = program(":matches-path(/search/) div[role=\"article\"]");
+        assert_eq!(p.selector, "");
+        assert_eq!(p.tasks, vec![op("matches-path", "/search/"), op("spath", " div[role=\"article\"]")]);
+
+        let p = program(":xpath(//div[contains(text(),\"Ad\")])");
+        assert_eq!(p.selector, "");
+        assert_eq!(p.tasks, vec![op("xpath", "//div[contains(text(),\"Ad\")]")]);
+    }
+
+    #[test]
+    fn has_and_not_around_an_operator_are_nested_programs() {
+        let p = program("a[role=\"button\"]:has(p:has-text(Sponsored))");
+        assert_eq!(p.selector, "a[role=\"button\"]");
+        assert_eq!(
+            p.tasks,
+            vec![Task::Nested("has", Program { selector: "p".into(), tasks: vec![op("has-text", "Sponsored")] })]
+        );
+
+        let p = program("p:matches-css-before(content:/Ad /):xpath(../..):not(p:has-text(/MAHA/i))");
+        assert_eq!(p.tasks.len(), 3);
+        assert_eq!(p.tasks[0], op("matches-css-before", "content:/Ad /"));
+        assert_eq!(
+            p.tasks[2],
+            Task::Nested("not", Program { selector: "p".into(), tasks: vec![op("has-text", "/MAHA/i")] })
+        );
+
+        // a relative selector inside
+        let p = program("div:has(> span:has-text(Ad))");
+        assert_eq!(
+            p.tasks,
+            vec![Task::Nested("has", Program { selector: "> span".into(), tasks: vec![op("has-text", "Ad")] })]
+        );
+    }
+
+    #[test]
+    fn arguments_keep_parentheses_and_quotes() {
+        assert_eq!(program("a:has-text(/\\(ad\\)/)").tasks, vec![op("has-text", "/\\(ad\\)/")]);
+        assert_eq!(program("a:has-text(Don't miss)").tasks, vec![op("has-text", "Don't miss")]);
+        assert_eq!(program("a:has-text(\"a)b\")").tasks, vec![op("has-text", "\"a)b\"")]);
+        assert_eq!(
+            program("div:matches-css(background-image: /url\\(.*ad/)").tasks,
+            vec![op("matches-css", "background-image: /url\\(.*ad/")]
+        );
+        assert_eq!(
+            program("header:matches-media((max-width: 767px))").tasks,
+            vec![op("matches-media", "(max-width: 767px)")]
+        );
+    }
+
+    #[test]
+    fn others_and_watch_attr() {
+        let p = program("#gen, #link:others()");
+        assert_eq!(p.selector, "#gen, #link");
+        assert_eq!(p.tasks, vec![op("others", "")]);
+        assert_eq!(program(".btn:watch-attr(disabled)").tasks, vec![op("watch-attr", "disabled")]);
+    }
+
+    #[test]
+    fn what_cannot_be_run_is_refused() {
+        for s in [
+            "div:shadow(div)",                 // not built
+            "div:matches-prop(a.b)",           // not built
+            "a:has-text(x), b",                // two rules in one
+            "a:has-text()",                    // nothing to look for
+            "a:upward(0)",
+            "a:upward(999)",
+            "a:min-text-length(many)",
+            "a:matches-css(color)",
+            "a:others(x)",
+            "a:is(b:has-text(x))",             // an operator where only CSS may be
+            "a:has-text(unclosed",
+            "a[title=\"unclosed:has-text(x)",
+            "a:has(b:shadow(c))",
+            "a:upward(b:has-text(x))",
+        ] {
+            assert_eq!(compile(s), None, "{s}");
+        }
+    }
+
+    #[test]
+    fn a_program_is_written_as_json() {
+        let p = program("a:has(p:has-text(\"Ad\")):upward(2)");
+        assert_eq!(
+            p.to_json(),
+            r#"{"s":"a","t":[["has",{"s":"p","t":[["has-text","\"Ad\""]]}],["upward","2"]]}"#
+        );
+        assert_eq!(
+            p.filter_json(&["mark", "abc"]),
+            r#"{"s":"a","t":[["has",{"s":"p","t":[["has-text","\"Ad\""]]}],["upward","2"]],"a":["mark","abc"]}"#
+        );
+        assert_eq!(Program { selector: ".x".into(), tasks: vec![] }.filter_json(&["remove"]), r#"{"s":".x","t":[],"a":["remove"]}"#);
+        // "<" leaves as an escape (u+003c), so a closing script tag cannot appear in the text
+        let escaped = json_string("a\\b\n</script>\u{1}");
+        assert_eq!(escaped, format!("\"a\\\\b\\n\\u{}/script>\\u0001\"", "003c"));
+        assert!(!escaped.contains('<'));
+    }
+
+    #[test]
+    fn style_declarations_cannot_fetch_or_escape() {
+        for good in ["opacity: 1 !important;", "margin-top: 0 !important", "grid-template-columns: minmax(180px,250px) 0 !important;"] {
+            assert!(safe_style(good), "{good}");
+        }
+        for bad in [
+            "",
+            "  ",
+            "background: url(https://x.example/a.png)",
+            "background: URL( 'x' )".replace("URL( ", "URL(").as_str(),
+            "background-image: image-set('a.png' 1x)",
+            "color: red} body{display:none",
+            "color: red; /* open",
+            "content: '\\75rl('",
+            "color: red;\n@import 'x'",
+        ] {
+            assert!(!safe_style(bad), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn names_for_remove_attr_and_remove_class() {
+        for good in ["disabled", "data-ad", "is-locked", "xlink:href"] {
+            assert!(safe_name(good), "{good}");
+        }
+        for bad in ["", "a b", "/re/", "\"x\"", "a>b"] {
+            assert!(!safe_name(bad), "{bad:?}");
+        }
+    }
+}
