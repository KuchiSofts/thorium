+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_adblock/new_window.h"
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+// The page of the tab that `opener` is in, when the blocker works there.
+GURL OpenerSite(content::RenderFrameHost& opener,
+                const HostContentSettingsMap* settings) {
+  // As in uBlock Origin, a pop-up rule's `domain=` and its first or third
+  // party are read against the page of the tab that opens the window.
+  const GURL top = opener.GetOutermostMainFrame()->GetLastCommittedURL();
+  if (!top.SchemeIsHTTPOrHTTPS() || !settings ||
+      ProxyingURLLoaderFactory::AdsAllowedOn(settings, top)) {
+    return GURL();
+  }
+  return top;
+}
+
+void Close(base::WeakPtr<content::WebContents> tab) {
+  if (tab) {
+    tab->ClosePage();
+  }
+}
+
+}  // namespace
+
+bool BlocksNewWindow(content::RenderFrameHost& opener,
+                     const GURL& target_url,
+                     const HostContentSettingsMap* settings) {
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock)) {
+    return false;
+  }
+  const GURL top = OpenerSite(opener, settings);
+  if (!top.is_valid()) {
+    return false;
+  }
+  const EngineService& engine = EngineService::Get();
+  const bool blocked = engine.SiteSwitch(top, "popups") ||
+                       engine.BlocksPopup(target_url, top);
+  if (blocked) {
+    BlockedCount::Record(opener.GetGlobalId(), target_url);
+  }
+  return blocked;
+}
+
+bool ClosesOpenedWindow(content::WebContents& tab,
+                        const GURL& url,
+                        const HostContentSettingsMap* settings) {
+  content::RenderFrameHost* opener = tab.GetOpener();
+  if (!base::FeatureList::IsEnabled(kThoronNativeAdblock) || !opener) {
+    return false;
+  }
+  // Nothing but its first blank document yet: window.open() commits
+  // about:blank at once, so the controller no longer calls it the initial
+  // navigation.
+  const GURL& now = tab.GetPrimaryMainFrame()->GetLastCommittedURL();
+  if (tab.GetController().GetEntryCount() > 1 ||
+      !(now.is_empty() || now.IsAboutBlank())) {
+    return false;
+  }
+  const GURL top = OpenerSite(*opener, settings);
+  if (!top.is_valid() || !EngineService::Get().BlocksPopup(url, top)) {
+    return false;
+  }
+  BlockedCount::Record(opener->GetGlobalId(), url);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&Close, tab.GetWeakPtr()));
+  return true;
+}
+
+}  // namespace thoron_adblock
