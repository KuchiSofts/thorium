@@ -0,0 +1,61 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_PAGE_BLOCK_THROTTLE_H_
+#define COMPONENTS_THORON_ADBLOCK_PAGE_BLOCK_THROTTLE_H_
+
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/navigation_throttle.h"
+
+class GURL;
+class HostContentSettingsMap;
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace thoron_adblock {
+
+// Strict blocking, as in uBlock Origin: a page whose own address the lists
+// block (a rule for whole pages, `$doc` or `$all`, or one that names its whole
+// host) is not opened. A page that says why, and how to open it anyway, is shown in its
+// place. Only for the main frame of a tab, and not on a site where ads are
+// allowed (the shield's power button is the way to open such a page).
+class PageBlockThrottle : public content::NavigationThrottle {
+ public:
+  // Adds the throttle when native ad blocking is on.
+  static void MaybeAdd(content::NavigationThrottleRegistry& registry,
+                       HostContentSettingsMap* settings);
+
+  PageBlockThrottle(content::NavigationThrottleRegistry& registry,
+                    scoped_refptr<HostContentSettingsMap> settings);
+  PageBlockThrottle(const PageBlockThrottle&) = delete;
+  PageBlockThrottle& operator=(const PageBlockThrottle&) = delete;
+  ~PageBlockThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+  // The page shown in place of a blocked one: plain HTML without scripts.
+  // `onward`, when valid, is where the blocked page would send the person on
+  // to (written in its own address); the page offers it as a link.
+  static std::string BlockedPage(const GURL& url, const GURL& onward);
+
+  // The first web address written in a parameter of `url`, as a redirector
+  // writes where it sends on to ("?url=https%3A%2F%2F..."). Invalid when there
+  // is none.
+  static GURL Onward(const GURL& url);
+
+ private:
+  ThrottleCheckResult Check();
+
+  scoped_refptr<HostContentSettingsMap> settings_;
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_PAGE_BLOCK_THROTTLE_H_
diff --git a/components/thoron_adblock/permissions.rs b/components/thoron_adblock/permissions.rs
new file mode 100644
index 0000000000000000000000000000000000000000..00523ed2ab49618d8acc12bcd40a1fdc6390d444
--- /dev/null
+++ b/components/thoron_adblock/permissions.rs
@@ -0,0 +1,194 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `$permissions`: the lists switch browser features off for a document, by a Permissions-Policy
+//! header. uBlock Origin's lists use it against the features that were built for ad targeting and
+//! for telling browsers apart (`*$permissions=browsing-topics=(),from=~localhost|...`).
+//!
+//! adblock-rust does not know the option. It does know `$csp`, which works the same way: the
+//! values of all the rules that match a document are collected, without those an exception takes
+//! away. So the rules are read as `$csp` rules by an engine of their own.
+//!
+//! Only rules of trusted lists are taken (engine_core.rs), and only values that switch features
+//! off ("name=()"): a rule can take a feature away from a page, never give one.
+
+use adblock::lists::{FilterSet, ParseOptions};
+use adblock::request::Request;
+
+/// True for "name=()": the feature `name` is off for the document and everything in it.
+fn switches_off(policy: &str) -> bool {
+    match policy.strip_suffix("=()") {
+        Some(name) => {
+            (1..=64).contains(&name.len())
+                && name.starts_with(|c: char| c.is_ascii_lowercase())
+                && name.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-')
+        }
+        None => false,
+    }
+}
+
+/// The `$permissions` line of a list as the `$csp` rule adblock-rust reads; `None` for every other
+/// line and for a rule that is not understood in full or does more than switch features off.
+pub fn as_csp_rule(line: &str) -> Option<String> {
+    let line = line.trim();
+    if line.is_empty() || line.starts_with('!') || line.contains("##") || line.contains("#@#") {
+        return None;
+    }
+    // The option, not the word inside a pattern.
+    let dollar = line.match_indices("permissions").find_map(|(at, _)| {
+        let dollar = line[..at].rfind('$')?;
+        (dollar + 1 == at || line[..at].ends_with(',')).then_some(dollar)
+    })?;
+    let pattern = &line[..dollar];
+    let exception = pattern.starts_with("@@");
+    let mut options = Vec::new();
+    let mut found = false;
+    for option in line[dollar + 1..].split(',').filter(|o| !o.is_empty()) {
+        if option == "permissions" {
+            // without a value: an exception that takes every such policy away
+            if !exception {
+                return None;
+            }
+            options.push("csp".to_string());
+            found = true;
+        } else if let Some(value) = option.strip_prefix("permissions=") {
+            // several features are written with "|" between them
+            if !value.split('|').all(switches_off) {
+                return None;
+            }
+            options.push(format!("csp={value}"));
+            found = true;
+        } else if let Some(sites) = option.strip_prefix("from=") {
+            options.push(format!("domain={sites}"));
+        } else if option.starts_with("to=") || option.starts_with("csp") {
+            return None;
+        } else {
+            options.push(option.to_string());
+        }
+    }
+    found.then(|| format!("{pattern}${}", options.join(",")))
+}
+
+/// Every `$permissions` rule of the trusted lists.
+#[derive(Default)]
+pub struct PermissionRules {
+    engine: Option<adblock::Engine>,
+    /// The rules as the lists wrote them, one per line: what is saved with the engine.
+    pub text: String,
+}
+
+impl PermissionRules {
+    /// From lines of trusted lists; every line that is not a `$permissions` rule is skipped.
+    pub fn from_trusted_text(lines: &str) -> PermissionRules {
+        let mut rules = PermissionRules::default();
+        let mut filters = Vec::new();
+        for line in lines.lines().filter(|l| l.contains("permissions")) {
+            let Some(rule) = as_csp_rule(line) else { continue };
+            rules.text.push_str(line.trim());
+            rules.text.push('\n');
+            filters.push(rule);
+        }
+        if !filters.is_empty() {
+            let mut set = FilterSet::new(false);
+            set.add_filter_list(filters.join("\n"), ParseOptions::default());
+            rules.engine = Some(adblock::Engine::new_with_filter_set(set));
+        }
+        rules
+    }
+
+    /// The value of the Permissions-Policy header the rules give a document, or "".
+    pub fn policy(&self, url: &str, source_url: &str, main_frame: bool) -> String {
+        let Some(engine) = &self.engine else { return String::new() };
+        let request_type = if main_frame { "document" } else { "subdocument" };
+        let Ok(request) = Request::new(url, source_url, request_type, "GET") else { return String::new() };
+        let Some(found) = engine.get_csp_directives(&request) else { return String::new() };
+        let mut features: Vec<&str> =
+            found.split(|c| c == ',' || c == '|').map(str::trim).filter(|p| switches_off(p)).collect();
+        features.sort_unstable();
+        features.dedup();
+        let header = features.join(", ");
+        if header.len() <= 2048 {
+            header
+        } else {
+            String::new()
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const LOCAL: &str = "from=~localhost|~127.0.0.1|~[::1]|~0.0.0.0|~[::]|~local";
+
+    #[test]
+    fn a_rule_is_read_as_a_csp_rule() {
+        assert_eq!(
+            as_csp_rule("*$permissions=browsing-topics=(),from=~localhost|~local").as_deref(),
+            Some("*$csp=browsing-topics=(),domain=~localhost|~local")
+        );
+        assert_eq!(
+            as_csp_rule("||ads.example^$permissions=run-ad-auction=()|join-ad-interest-group=()").as_deref(),
+            Some("||ads.example^$csp=run-ad-auction=()|join-ad-interest-group=()")
+        );
+        assert_eq!(
+            as_csp_rule("@@||shop.example^$permissions=browsing-topics=()").as_deref(),
+            Some("@@||shop.example^$csp=browsing-topics=()")
+        );
+        assert_eq!(as_csp_rule("@@||shop.example^$permissions").as_deref(), Some("@@||shop.example^$csp"));
+    }
+
+    #[test]
+    fn a_rule_that_gives_a_feature_or_is_not_understood_is_left_out() {
+        for not_taken in [
+            "*$permissions=camera=*",                      // gives the camera to every frame
+            "*$permissions=camera=(self)",
+            "*$permissions=geolocation=(\"https://x.example\")",
+            "*$permissions=browsing-topics=()|camera=*",
+            "*$permissions=",
+            "*$permissions",                               // a rule needs a value
+            "*$permissions=Browsing-Topics=()",
+            "*$permissions=browsing-topics=(),to=x.example",
+            "*$permissions=browsing-topics=(),csp=script-src 'none'",
+            "! *$permissions=browsing-topics=()",
+            "news.example##.permissions",
+            "||x.example/permissions^$doc",
+            "*$nopermissions=browsing-topics=()",
+        ] {
+            assert!(as_csp_rule(not_taken).is_none(), "{not_taken}");
+        }
+    }
+
+    #[test]
+    fn a_document_gets_the_features_that_are_switched_off() {
+        let rules = PermissionRules::from_trusted_text(&format!(
+            "*$permissions=browsing-topics=(),{LOCAL}\n*$permissions=run-ad-auction=(),{LOCAL}\n\
+             ||special.example^$permissions=idle-detection=()|keyboard-map=()\n\
+             @@||shop.example^$permissions=browsing-topics=()\n@@||bank.example^$permissions\n||ads.example^\n"
+        ));
+        assert_eq!(rules.text.lines().count(), 5, "{}", rules.text);
+        let page = |url: &str| rules.policy(url, url, true);
+        assert_eq!(page("https://news.example/story"), "browsing-topics=(), run-ad-auction=()");
+        assert_eq!(
+            page("https://special.example/"),
+            "browsing-topics=(), idle-detection=(), keyboard-map=(), run-ad-auction=()"
+        );
+        // an exception takes one policy away, or all of them
+        assert_eq!(page("https://shop.example/"), "run-ad-auction=()");
+        assert_eq!(page("https://bank.example/"), "");
+        // pages on the PC itself are left alone, as the lists ask
+        assert_eq!(page("http://localhost/"), "");
+        assert_eq!(page("http://127.0.0.1:8080/x"), "");
+        // a frame is a document too; the site of the page it is in decides
+        assert_eq!(rules.policy("https://frame.example/", "https://news.example/", false), "browsing-topics=(), run-ad-auction=()");
+        assert_eq!(rules.policy("https://frame.example/", "http://localhost/", false), "");
+        assert_eq!(page("not a url"), "");
+    }
+
+    #[test]
+    fn no_rules_no_policy() {
+        let none = PermissionRules::from_trusted_text("||ads.example^\n*$permissions=camera=*\n");
+        assert!(none.text.is_empty());
+        assert_eq!(none.policy("https://news.example/", "https://news.example/", true), "");
+    }
+}
