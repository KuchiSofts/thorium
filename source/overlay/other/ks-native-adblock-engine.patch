@@ -0,0 +1,98 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_INTERCEPTOR_H_
+#define COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_INTERCEPTOR_H_
+
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "content/public/browser/url_loader_request_interceptor.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/http_request_headers_update_params.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "url/gurl.h"
+
+class HostContentSettingsMap;
+
+namespace thoron_adblock {
+
+// Looks at the request for a document before it goes out: at the start of a
+// navigation and again after every redirect, for a page and for a frame
+// inside one. One per navigation, on the UI thread.
+// - `$removeparam`: an address with parameters the lists name is answered
+//   with an internal redirect to the address without them, so the address
+//   bar, the history and the page see the clean address and the server never
+//   sees the parameter. If a site sends the browser back to the address just
+//   cleaned, it is loaded as it is, so a site that insists cannot make the
+//   navigation go in circles.
+// - A frame whose address the lists block ends with ERR_BLOCKED_BY_CLIENT, or
+//   is answered with a stand-in when a filter asks for one. A page's own
+//   request is never blocked.
+// Nothing is done on a site where the person allowed ads.
+class DocumentRequestInterceptor : public content::URLLoaderRequestInterceptor,
+                                   public network::mojom::URLLoader {
+ public:
+  // Null when native ad blocking is off.
+  static std::unique_ptr<content::URLLoaderRequestInterceptor> MaybeCreate(
+      scoped_refptr<HostContentSettingsMap> settings,
+      content::FrameTreeNodeId frame_tree_node_id);
+
+  DocumentRequestInterceptor(const DocumentRequestInterceptor&) = delete;
+  DocumentRequestInterceptor& operator=(const DocumentRequestInterceptor&) =
+      delete;
+  ~DocumentRequestInterceptor() override;
+
+  // content::URLLoaderRequestInterceptor:
+  void MaybeCreateLoader(
+      const network::ResourceRequest& tentative_resource_request,
+      content::BrowserContext* browser_context,
+      content::URLLoaderRequestInterceptor::LoaderCallback callback) override;
+
+ private:
+  DocumentRequestInterceptor(scoped_refptr<HostContentSettingsMap> settings,
+                             content::FrameTreeNodeId frame_tree_node_id);
+
+  // network::mojom::URLLoader. Nothing to do: after the redirect, or the
+  // refusal, the navigation drops this loader.
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams headers_update_params,
+      const std::optional<GURL>& new_url) override {}
+  void SetPriority(net::RequestPriority priority,
+                   int intra_priority_value) override {}
+
+  // Takes the request over (the two pipe ends of its loader).
+  void Bind(mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+            mojo::PendingRemote<network::mojom::URLLoaderClient> client);
+  void OnConnectionClosed();
+
+  // The ways a request is handled here.
+  void RedirectTo(const GURL& clean,
+                  const network::ResourceRequest& request,
+                  mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+                  mojo::PendingRemote<network::mojom::URLLoaderClient> client);
+  void Refuse(const std::string& stand_in,
+              const network::ResourceRequest& request,
+              mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+              mojo::PendingRemote<network::mojom::URLLoaderClient> client);
+
+  const scoped_refptr<HostContentSettingsMap> settings_;
+  const content::FrameTreeNodeId frame_tree_node_id_;
+  // Clean addresses this navigation was already sent to.
+  std::set<GURL> cleaned_;
+  mojo::Receiver<network::mojom::URLLoader> receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  base::WeakPtrFactory<DocumentRequestInterceptor> weak_factory_{this};
+};
+
+}  // namespace thoron_adblock
+
+#endif  // COMPONENTS_THORON_ADBLOCK_DOCUMENT_REQUEST_INTERCEPTOR_H_
diff --git a/components/thoron_adblock/engine.rs b/components/thoron_adblock/engine.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c961bbb3c8aa83baf24c1e2d5b47d088a82e00c3
--- /dev/null
+++ b/components/thoron_adblock/engine.rs
@@ -0,0 +1,766 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Thoron's native ad-blocking engine: a thin bridge to adblock-rust for Chromium's C++ code.
+//! The engine is built from filter list text (or loaded from a saved, compiled engine) once, is given
+//! its resources (scriptlets and stand-ins), and then answers three questions: what to do with a
+//! request, what a document needs (elements to hide, scriptlets to run), and which content security
+//! policy a document gets on top of its own.
+
+mod cosmetics;
+mod engine_core;
+mod procedural;
+mod query;
+mod urlskip;
+
+#[cxx::bridge(namespace = "thoron_adblock")]
+mod ffi {
+    /// What to do with one request.
+    struct RequestDecision {
+        /// The request must not reach the network.
+        blocked: bool,
+        /// Only with `blocked`, and only when a filter asks for it (`$redirect`, `redirect-rule`)
+        /// and the resource is installed: a data: URL holding a harmless stand-in to answer the
+        /// request with, so the page does not break. Empty: end the request with an error.
+        stand_in: String,
+        /// Only without `blocked`: the address to ask for instead, the request's own without the
+        /// parameters `$removeparam` rules take out. Empty: the address stays as it is.
+        clean_url: String,
+    }
+
+    /// What one document needs.
+    struct DocumentResources {
+        /// A style sheet for this site: one `selector{display:none!important}` rule per line for
+        /// what is hidden, then the `:style()` rules, then the rules for the marks the procedural
+        /// runner puts on elements. Only selectors and declarations that cannot break out of
+        /// their rule. Empty: none.
+        stylesheet: String,
+        /// The CSS selectors hidden in `stylesheet`.
+        hide_selectors: Vec<String>,
+        /// The rules CSS alone cannot carry out (`:has-text()`, `:upward()`, `:remove()`...), each
+        /// as JSON the way procedural.js reads it.
+        procedural: Vec<String>,
+        /// Selectors that generic hiding must leave alone on this site.
+        exceptions: Vec<String>,
+        /// The scriptlets for this site, ready to run at document start, inside one function (as
+        /// uBlock Origin runs them) so their helpers stay out of the page's global scope. Empty: none.
+        script: String,
+        /// The procedural runner with this document's `procedural` rules, to run in an isolated
+        /// world. Empty: none.
+        isolated_script: String,
+        /// Generic hiding is switched off for this document (a `$generichide` exception).
+        generichide: bool,
+    }
+
+    extern "Rust" {
+        type Engine;
+
+        /// Builds an engine from the lists file: filter list text (EasyList syntax), each list after
+        /// its "! thoron-list: <id>" line. A list's id decides whether it may use trusted scriptlets.
+        fn engine_from_rules(rules: &str) -> Box<Engine>;
+
+        /// Loads an engine saved with `serialize`. Chromium builds C++ without exceptions, so a
+        /// failure is not an error value: data that is not a saved engine gives an engine whose
+        /// `is_valid` is false and which blocks nothing.
+        fn engine_from_serialized(data: &[u8]) -> Box<Engine>;
+
+        /// False only for an engine that could not be loaded.
+        fn is_valid(self: &Engine) -> bool;
+
+        /// The compiled engine, for saving. Resources are not part of it.
+        fn serialize(self: &Engine) -> Vec<u8>;
+
+        /// Gives the engine its resources: the JSON list written by assemble_resources.mjs. Returns
+        /// how many were taken; 0 for text that is not such a list, which leaves the engine as it
+        /// was (it still blocks, without stand-ins or scriptlets).
+        fn use_resources(self: &mut Engine, json: &str) -> usize;
+
+        /// What to do with a request. `request_type` is one of the filter-list types: "document",
+        /// "subdocument", "script", "image", "stylesheet", "font", "media", "xmlhttprequest",
+        /// "websocket", "ping", "other". Invalid URLs are never blocked.
+        fn check_request(self: &Engine, url: &str, source_url: &str, request_type: &str) -> RequestDecision;
+
+        /// True when the request should be blocked (`check_request` without the stand-in).
+        fn should_block(self: &Engine, url: &str, source_url: &str, request_type: &str) -> bool;
+
+        /// `RequestDecision::clean_url` on its own, also for a request that would be blocked: a
+        /// page's own navigation is never blocked, but its address is still cleaned.
+        fn clean_url(self: &Engine, url: &str, source_url: &str, request_type: &str) -> String;
+
+        /// The content security policy `$csp` rules add to the document at `url`: the value of a
+        /// Content-Security-Policy header (several policies are separated by commas). `source_url`
+        /// is the page a frame is in; for a page itself, its own address. Empty: none.
+        fn document_policy(self: &Engine, url: &str, source_url: &str, main_frame: bool) -> String;
+
+        /// Where a navigation of the main frame to `url` should go instead, by a `$urlskip` rule of
+        /// a trusted list: the address written inside the address of a redirector. "" when the
+        /// navigation stays as it is. Only a suggestion: the caller checks the address it gets.
+        fn skip_url(self: &Engine, url: &str, source_url: &str) -> String;
+
+        /// What the document at `url` needs. Empty for an invalid URL.
+        fn document_resources(self: &Engine, url: &str) -> DocumentResources;
+
+        /// Generic hide rules ("##.ad-banner") for the class names and ids a document at `url`
+        /// uses (without "." or "#"): a style sheet like `DocumentResources::stylesheet`, without
+        /// the selectors the site has exceptions for. Empty when generic hiding is off for the
+        /// document, or nothing matches.
+        fn generic_stylesheet(self: &Engine, url: &str, classes: &Vec<String>, ids: &Vec<String>) -> String;
+
+        /// The number of rules in a filter list: lines that are not empty, comments ("!") or
+        /// headers ("[Adblock Plus 2.0]").
+        fn count_rules(text: &str) -> usize;
+
+        /// True when a list holds an exception that allows every request (for example "@@*",
+        /// "@@||^" or "@@|http"), with no site limit. A downloaded list with one is refused: no
+        /// real list has one, and it would turn blocking off.
+        fn has_allow_all_rule(text: &str) -> bool;
+
+        /// The settings page (chrome://adblock): its document and its script. They are part of
+        /// this library, so the page needs no entry in a resource pack.
+        fn settings_page_html() -> &'static str;
+
+        fn settings_page_js() -> &'static str;
+    }
+}
+
+use cosmetics::safe_selector;
+use engine_core::safe_policy;
+use ffi::{DocumentResources, RequestDecision};
+
+/// The engine the browser holds: the filters of the lists, or nothing when a saved engine could
+/// not be loaded. What it answers is worked out in engine_core.rs and cosmetics.rs.
+pub struct Engine(Option<engine_core::Filters>);
+
+fn engine_from_rules(rules: &str) -> Box<Engine> {
+    Box::new(Engine(Some(engine_core::build(rules))))
+}
+
+fn engine_from_serialized(data: &[u8]) -> Box<Engine> {
+    Box::new(Engine(engine_core::load(data)))
+}
+
+impl Engine {
+    fn is_valid(&self) -> bool {
+        self.0.is_some()
+    }
+
+    fn skip_url(&self, url: &str, source_url: &str) -> String {
+        self.0.as_ref().map(|f| engine_core::skip(f, url, source_url)).unwrap_or_default()
+    }
+
+    fn serialize(&self) -> Vec<u8> {
+        self.0.as_ref().map(engine_core::save).unwrap_or_default()
+    }
+
+    fn use_resources(&mut self, json: &str) -> usize {
+        let Some(filters) = &mut self.0 else { return 0 };
+        let Ok(resources) = serde_json::from_str::<Vec<adblock::resources::Resource>>(json) else { return 0 };
+        let count = resources.len();
+        if count > 0 {
+            filters.engine.use_resources(resources);
+        }
+        count
+    }
+
+    fn decide(&self, url: &str, source_url: &str, request_type: &str, clean_blocked: bool) -> RequestDecision {
+        let Some(filters) = &self.0 else {
+            return RequestDecision { blocked: false, stand_in: String::new(), clean_url: String::new() };
+        };
+        let d = engine_core::decide(filters, url, source_url, request_type, clean_blocked);
+        RequestDecision { blocked: d.blocked, stand_in: d.stand_in, clean_url: d.clean_url }
+    }
+
+    fn check_request(&self, url: &str, source_url: &str, request_type: &str) -> RequestDecision {
+        self.decide(url, source_url, request_type, false)
+    }
+
+    fn should_block(&self, url: &str, source_url: &str, request_type: &str) -> bool {
+        self.check_request(url, source_url, request_type).blocked
+    }
+
+    fn clean_url(&self, url: &str, source_url: &str, request_type: &str) -> String {
+        self.decide(url, source_url, request_type, true).clean_url
+    }
+
+    fn document_policy(&self, url: &str, source_url: &str, main_frame: bool) -> String {
+        self.0.as_ref().map(|f| engine_core::policy(f, url, source_url, main_frame)).unwrap_or_default()
+    }
+
+    fn generic_stylesheet(&self, url: &str, classes: &Vec<String>, ids: &Vec<String>) -> String {
+        self.0.as_ref().map(|f| cosmetics::generic_stylesheet(f, url, classes, ids)).unwrap_or_default()
+    }
+
+    fn document_resources(&self, url: &str) -> DocumentResources {
+        let Some(filters) = &self.0 else {
+            return DocumentResources {
+                stylesheet: String::new(),
+                hide_selectors: Vec::new(),
+                procedural: Vec::new(),
+                exceptions: Vec::new(),
+                script: String::new(),
+                isolated_script: String::new(),
+                generichide: false,
+            };
+        };
+        let page = cosmetics::page(filters, url);
+        DocumentResources {
+            stylesheet: page.stylesheet,
+            hide_selectors: page.hide_selectors,
+            procedural: page.procedural,
+            exceptions: page.exceptions,
+            script: page.script,
+            isolated_script: page.isolated_script,
+            generichide: page.generichide,
+        }
+    }
+}
+
+fn rule_lines(text: &str) -> impl Iterator<Item = &str> {
+    text.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('!') && !l.starts_with('['))
+}
+
+fn count_rules(text: &str) -> usize {
+    rule_lines(text).count()
+}
+
+fn allows_all(line: &str) -> bool {
+    let Some(rest) = line.strip_prefix("@@") else { return false };
+    if rest.contains("##") || rest.contains("#@#") {
+        return false;
+    }
+    let (pattern, options) = rest.split_once('$').unwrap_or((rest, ""));
+    let edge: &[char] = &['|', '*', '^', '/', ':', '.'];
+    let mut core = pattern.trim_matches(edge);
+    for scheme in ["https", "http", "wss", "ws"] {
+        if let Some(after) = core.strip_prefix(scheme) {
+            core = after;
+            break;
+        }
+    }
+    let limited = options
+        .split(',')
+        .any(|o| o.starts_with("domain=") || o.starts_with("from=") || o.starts_with("to="));
+    core.trim_matches(edge).is_empty() && !limited
+}
+
+fn has_allow_all_rule(text: &str) -> bool {
+    rule_lines(text).any(allows_all)
+}
+
+fn settings_page_html() -> &'static str {
+    include_str!("settings_page.html")
+}
+
+fn settings_page_js() -> &'static str {
+    include_str!("settings_page.js")
+}
