+
+class ThoronAdblockMenuUI;
+
+class ThoronAdblockMenuUIConfig
+    : public DefaultTopChromeWebUIConfig<ThoronAdblockMenuUI> {
+ public:
+  ThoronAdblockMenuUIConfig();
+
+  // TopChromeWebUIConfig:
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+  bool ShouldAutoResizeHost() override;
+};
+
+class ThoronAdblockMenuUI : public TopChromeWebUIController {
+ public:
+  explicit ThoronAdblockMenuUI(content::WebUI* web_ui);
+  ThoronAdblockMenuUI(const ThoronAdblockMenuUI&) = delete;
+  ThoronAdblockMenuUI& operator=(const ThoronAdblockMenuUI&) = delete;
+  ~ThoronAdblockMenuUI() override;
+
+  static constexpr std::string_view GetWebUIName() {
