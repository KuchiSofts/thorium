+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "content/public/common/url_constants.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kScriptPath[] = "/adblock.js";
+// What the page may send: an address, and rules of at most the size the store
+// accepts (it checks again).
+constexpr size_t kMaxUrlLength = 2048;
+constexpr size_t kMaxRulesLength = 1024 * 1024;
+
+// Serves the page and its script. Both are part of the engine library
+// (components/thoron_adblock/settings_page.html and .js). The default security
+// policy of a data source stays in force: script only from this page and from
+// chrome://resources, and no markup made from text.
+class ThoronAdblockDataSource : public content::URLDataSource {
+ public:
+  ThoronAdblockDataSource() = default;
+  ThoronAdblockDataSource(const ThoronAdblockDataSource&) = delete;
+  ThoronAdblockDataSource& operator=(const ThoronAdblockDataSource&) = delete;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kThoronAdblockHost; }
+
+  std::string GetMimeType(const GURL& url) override {
+    return url.path() == kScriptPath ? "text/javascript" : "text/html";
+  }
+
+  // A module script is only run when it comes with its type.
+  bool ShouldServeMimeTypeAsContentTypeHeader() override { return true; }
+
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    const std::string path(url.path());
+    if (path == kScriptPath) {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          std::string(thoron_adblock::settings_page_js())));
+    } else if (path.empty() || path == "/") {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          std::string(thoron_adblock::settings_page_html())));
+    } else {
+      std::move(callback).Run(nullptr);
+    }
+  }
+};
+
+// Takes what the page asks for (settings_page.js) to the engine service and
+// brings the answer back. Every message starts with the id of its answer.
+class ThoronAdblockHandler : public content::WebUIMessageHandler {
+ public:
+  ThoronAdblockHandler() = default;
+  ThoronAdblockHandler(const ThoronAdblockHandler&) = delete;
+  ThoronAdblockHandler& operator=(const ThoronAdblockHandler&) = delete;
+  ~ThoronAdblockHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getState", &ThoronAdblockHandler::GetState);
+    Register("setListEnabled", &ThoronAdblockHandler::SetListEnabled);
+    Register("addList", &ThoronAdblockHandler::AddList);
+    Register("removeList", &ThoronAdblockHandler::RemoveList);
+    Register("setMyFilters", &ThoronAdblockHandler::SetMyFilters);
+    Register("updateNow", &ThoronAdblockHandler::UpdateNow);
+    Register("getSites", &ThoronAdblockHandler::GetSites);
+    Register("allowSite", &ThoronAdblockHandler::AllowSite);
+    Register("forgetSite", &ThoronAdblockHandler::ForgetSite);
+    Register("clearSwitches", &ThoronAdblockHandler::ClearSwitches);
+    Register("getLog", &ThoronAdblockHandler::GetLog);
+  }
+
+  void OnJavascriptDisallowed() override { weak_factory_.InvalidateWeakPtrs(); }
+
+ private:
+  using Method = void (ThoronAdblockHandler::*)(const base::ListValue&);
+
+  void Register(std::string_view message, Method method) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(method, base::Unretained(this)));
+  }
+
+  // The service, set up the way the request hook sets it up, for a page that
+  // is opened before any other page was loaded.
+  static thoron_adblock::EngineService& Service() {
+    thoron_adblock::EngineService& service =
+        thoron_adblock::EngineService::Get();
+    if (!service.is_configured()) {
+      service.Configure(
+          base::PathService::CheckedGet(chrome::DIR_USER_DATA),
+          base::BindRepeating(
+              []() -> scoped_refptr<network::SharedURLLoaderFactory> {
+                return g_browser_process
+                           ? g_browser_process->shared_url_loader_factory()
+                           : nullptr;
+              }));
+    }
+    return service;
+  }
+
+  // The id of the answer, when the message has the shape `count` arguments
+  // after it give; else nothing, and the message is dropped.
+  const std::string* AnswerId(const base::ListValue& args, size_t count) {
+    AllowJavascript();
+    return args.size() == count + 1 ? args[0].GetIfString() : nullptr;
+  }
+
+  thoron_adblock::EngineService::Changed Changed(const std::string& id) {
+    return base::BindOnce(&ThoronAdblockHandler::Answer,
+                          weak_factory_.GetWeakPtr(), id);
+  }
+
+  void Answer(const std::string& id, std::string error) {
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), base::Value(std::move(error)));
+    }
+  }
+
+  void AnswerState(const std::string& id, base::DictValue state) {
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), state);
+    }
+  }
+
+  HostContentSettingsMap* SiteSettings() {
+    return HostContentSettingsMapFactory::GetForProfile(
+        Profile::FromWebUI(web_ui()));
+  }
+
+  // Sites where ads are allowed (the person's own choices), the menu's
+  // switches, and the total.
+  void GetSites(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    base::ListValue allowed;
+    for (const ContentSettingPatternSource& setting :
+         SiteSettings()->GetSettingsForOneType(ContentSettingsType::ADS)) {
+      if (setting.source == content_settings::ProviderType::kPrefProvider &&
+          setting.GetContentSetting() == CONTENT_SETTING_ALLOW) {
+        allowed.Append(setting.primary_pattern.ToString());
+      }
+    }
+    base::ListValue switches;
+    for (const auto& [host, names] : Service().site_switches()) {
+      base::ListValue list;
+      for (const std::string& name : names) {
+        list.Append(name);
+      }
+      switches.Append(base::DictValue().Set("host", host).Set("names", std::move(list)));
+    }
+    // the menu's Chrome switches (pop-ups, JavaScript) are site settings of
+    // their own and are listed on the site settings pages
+    ResolveJavascriptCallback(
+        base::Value(*id),
+        base::DictValue()
+            .Set("allowed", std::move(allowed))
+            .Set("switches", std::move(switches))
+            .Set("total", static_cast<double>(
+                              thoron_adblock::BlockedCount::Total())));
+  }
+
+  void AllowSite(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& host = args[1].GetString();
+    const GURL url("https://" + host + "/");
+    if (host.empty() || host.size() > 253 || !url.is_valid() ||
+        url.host() != host) {
+      Answer(*id, "This is not the name of a site.");
+      return;
+    }
+    SiteSettings()->SetContentSettingCustomScope(
+        ContentSettingsPattern::FromString("[*.]" + host),
+        ContentSettingsPattern::Wildcard(), ContentSettingsType::ADS,
+        CONTENT_SETTING_ALLOW);
+    Answer(*id, std::string());
+  }
+
+  void ForgetSite(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const ContentSettingsPattern pattern =
+        ContentSettingsPattern::FromString(args[1].GetString());
+    if (pattern.IsValid()) {
+      SiteSettings()->SetContentSettingCustomScope(
+          pattern, ContentSettingsPattern::Wildcard(), ContentSettingsType::ADS,
+          CONTENT_SETTING_DEFAULT);
+    }
+    Answer(*id, std::string());
+  }
+
+  void ClearSwitches(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    Service().ClearSiteSwitches(args[1].GetString());
+    Answer(*id, std::string());
+  }
+
+  // Every open tab of this profile that has blocked requests, and the last
+  // of them. Kept in memory with each page; nothing is stored.
+  void GetLog(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    Profile* profile = Profile::FromWebUI(web_ui());
+    base::ListValue tabs;
+    for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+      if (browser->GetProfile() != profile) {
+        continue;
+      }
+      TabStripModel* strip = browser->GetTabStripModel();
+      for (int i = 0; i < strip->count(); ++i) {
+        content::WebContents* tab = strip->GetWebContentsAt(i);
+        std::vector<thoron_adblock::BlockedCount::Entry> entries =
+            thoron_adblock::BlockedCount::Recent(tab->GetPrimaryPage());
+        if (entries.empty()) {
+          continue;
+        }
+        base::ListValue list;
+        for (const auto& entry : entries) {
+          list.Append(base::DictValue()
+                          .Set("time", entry.time.InMillisecondsFSinceUnixEpoch())
+                          .Set("url", entry.url));
+        }
+        tabs.Append(base::DictValue()
+                        .Set("title", base::UTF16ToUTF8(tab->GetTitle()))
+                        .Set("url", tab->GetLastCommittedURL().spec())
+                        .Set("entries", std::move(list)));
+      }
+    }
+    ResolveJavascriptCallback(base::Value(*id), tabs);
+  }
+
+  void GetState(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().DescribeSettings(
+          base::BindOnce(&ThoronAdblockHandler::AnswerState,
+                         weak_factory_.GetWeakPtr(), *id));
+    }
+  }
+
+  void SetListEnabled(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_bool()) {
+      return;
+    }
+    Service().SetListEnabled(args[1].GetString(), args[2].GetBool(),
+                             Changed(*id));
+  }
+
+  void AddList(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& address = args[1].GetString();
+    const GURL url(address);
+    if (address.size() > kMaxUrlLength || !url.is_valid()) {
+      Answer(*id, "This is not an address.");
+      return;
+    }
+    Service().AddList(url, Changed(*id));
+  }
+
+  void RemoveList(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    Service().RemoveList(args[1].GetString(), Changed(*id));
+  }
+
+  void SetMyFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    if (args[1].GetString().size() > kMaxRulesLength) {
+      Answer(*id, "Your filters are larger than 1 MB.");
+      return;
+    }
+    Service().SetMyFilters(args[1].GetString(), Changed(*id));
+  }
+
+  void UpdateNow(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().UpdateNow(Changed(*id));
+    }
+  }
+
+  base::WeakPtrFactory<ThoronAdblockHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+ThoronAdblockUIConfig::ThoronAdblockUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme,
+                         kThoronAdblockHost) {}
+
+bool ThoronAdblockUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return base::FeatureList::IsEnabled(thoron_adblock::kThoronNativeAdblock);
+}
+
+ThoronAdblockUI::ThoronAdblockUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<ThoronAdblockDataSource>());
+  web_ui->AddMessageHandler(std::make_unique<ThoronAdblockHandler>());
+}
+
+ThoronAdblockUI::~ThoronAdblockUI() = default;
