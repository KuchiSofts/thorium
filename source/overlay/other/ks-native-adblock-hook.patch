+
+class BrowserWindowInterface;
+class WebUIBubbleManager;
+
+namespace content {
+class Page;
+}
+
+// The shield of Thoron's built-in ad blocking in the toolbar, where an ad
+// blocker's icon sits. Its badge counts what was blocked on the active tab's
+// page; pressed, it opens the blocker's menu (thoron_adblock_popup_ui.h). It
+// is greyed out on a site where ads are allowed. Shown only while the
+// ThoronNativeAdblock feature is on.
+class ThoronAdblockButton : public ToolbarButton,
+                            public TabStripModelObserver,
+                            public content::WebContentsObserver {
+  METADATA_HEADER(ThoronAdblockButton, ToolbarButton)
+
+ public:
+  explicit ThoronAdblockButton(BrowserWindowInterface* browser);
+  ThoronAdblockButton(const ThoronAdblockButton&) = delete;
+  ThoronAdblockButton& operator=(const ThoronAdblockButton&) = delete;
+  ~ThoronAdblockButton() override;
+
+  // ToolbarButton:
+  void UpdateIcon() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+ private:
+  void ButtonPressed();
+  // A request was blocked on `page`.
+  void OnBlocked(content::Page& page);
+  // The active tab's count, or -1 when the blocker does not work there (not a
+  // web page) and 0 on a site where ads are allowed.
+  int ActiveCount();
+  bool BlockingOffForActiveSite();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<WebUIBubbleManager> menu_;
+  base::CallbackListSubscription blocked_subscription_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_ADBLOCK_BUTTON_H_
diff --git a/chrome/browser/ui/webui/thoron_adblock_popup_ui.cc b/chrome/browser/ui/webui/thoron_adblock_popup_ui.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f80e9adcf1b20575ec0b9b4526a5b6d32e33f226
--- /dev/null
+++ b/chrome/browser/ui/webui/thoron_adblock_popup_ui.cc
@@ -0,0 +1,294 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/thoron_adblock_popup_ui.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/values.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/thoron_adblock/engine.rs.h"
+#include "components/thoron_adblock/engine_service.h"
+#include "components/thoron_adblock/features.h"
+#include "components/thoron_adblock/picker.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "content/public/common/url_constants.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kScriptPath[] = "/popup_page.js";
+constexpr char kDashboardUrl[] = "chrome://adblock/";
+constexpr char kLoggerUrl[] = "chrome://adblock/#logger";
+
+// Serves the menu and its script, both part of the engine library
+// (components/thoron_adblock/popup_page.html and .js). The default security
+// policy of a data source stays in force.
+class MenuDataSource : public content::URLDataSource {
+ public:
+  MenuDataSource() = default;
+  MenuDataSource(const MenuDataSource&) = delete;
+  MenuDataSource& operator=(const MenuDataSource&) = delete;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kThoronAdblockMenuHost; }
+  std::string GetMimeType(const GURL& url) override {
+    return url.path() == kScriptPath ? "text/javascript" : "text/html";
+  }
+  bool ShouldServeMimeTypeAsContentTypeHeader() override { return true; }
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    const std::string path(url.path());
+    if (path == kScriptPath) {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          std::string(thoron_adblock::popup_page_js())));
+    } else if (path.empty() || path == "/") {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          std::string(thoron_adblock::popup_page_html())));
+    } else {
+      std::move(callback).Run(nullptr);
+    }
+  }
+};
+
+// The switch of the menu that is Chrome's own site setting: "on" means
+// JavaScript is blocked on the site. "popups" is the blocker's own, as in
+// uBlock Origin: Chrome's pop-up setting still lets a click open a window.
+ContentSettingsType ChromeSwitch(const std::string& name) {
+  if (name == "javascript") {
+    return ContentSettingsType::JAVASCRIPT;
+  }
+  return ContentSettingsType::DEFAULT;
+}
+
+class MenuHandler : public content::WebUIMessageHandler {
+ public:
+  explicit MenuHandler(ThoronAdblockMenuUI* controller)
+      : controller_(controller) {}
+  MenuHandler(const MenuHandler&) = delete;
+  MenuHandler& operator=(const MenuHandler&) = delete;
+  ~MenuHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getPopupState", &MenuHandler::GetState);
+    Register("setSiteEnabled", &MenuHandler::SetSiteEnabled);
+    Register("setSwitch", &MenuHandler::SetSwitch);
+    Register("startPicker", &MenuHandler::StartPicker);
+    Register("startZapper", &MenuHandler::StartZapper);
+    Register("openLogger", &MenuHandler::OpenLogger);
+    Register("openDashboard", &MenuHandler::OpenDashboard);
+    Register("menuReady", &MenuHandler::MenuReady);
+    Register("closeMenu", &MenuHandler::CloseMenu);
+  }
+
+ private:
+  using Method = void (MenuHandler::*)(const base::ListValue&);
+  void Register(std::string_view message, Method method) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(method, base::Unretained(this)));
+  }
+
+  // The tab the menu is about: the active tab of its window. Opened as a tab
+  // itself (the automated checks), the tab before it.
+  content::WebContents* Tab() {
+    BrowserWindowInterface* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    TabStripModel* tabs = browser ? browser->GetTabStripModel() : nullptr;
+    content::WebContents* active =
+        tabs ? tabs->GetActiveWebContents() : nullptr;
+    if (!active || active != web_ui()->GetWebContents()) {
+      return active;
+    }
+    const int index = tabs->GetIndexOfWebContents(active);
+    return index > 0 ? tabs->GetWebContentsAt(index - 1) : nullptr;
+  }
+
+  // The site of that tab, when it is one the blocker works on.
+  GURL Site(content::WebContents* tab) {
+    if (!tab) {
+      return GURL();
+    }
+    const GURL url = tab->GetPrimaryMainFrame()->GetLastCommittedURL();
+    return url.SchemeIsHTTPOrHTTPS() ? url : GURL();
+  }
+
+  HostContentSettingsMap* Settings() {
+    return HostContentSettingsMapFactory::GetForProfile(
+        Profile::FromWebUI(web_ui()));
+  }
+
+  void GetState(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    base::DictValue state;
+    state.Set("applicable", site.is_valid());
+    state.Set("site", site.is_valid() ? std::string(site.host()) : std::string());
+    state.Set("enabled",
+              site.is_valid() &&
+                  Settings()->GetContentSetting(site, site,
+                                                ContentSettingsType::ADS) !=
+                      CONTENT_SETTING_ALLOW);
+    base::ListValue sites;
+    int page_count = 0;
+    if (tab) {
+      content::Page& page = tab->GetPrimaryPage();
+      page_count = thoron_adblock::BlockedCount::Get(page);
+      for (const auto& [host, count] :
+           thoron_adblock::BlockedCount::Hosts(page)) {
+        sites.Append(base::DictValue().Set("host", host).Set("count", count));
+      }
+    }
+    state.Set("pageCount", page_count);
+    state.Set("sites", std::move(sites));
+    state.Set("totalCount", static_cast<double>(
+                                thoron_adblock::BlockedCount::Total()));
+    base::DictValue switches;
+    if (site.is_valid()) {
+      switches.Set("javascript",
+                   Settings()->GetContentSetting(
+                       site, site, ContentSettingsType::JAVASCRIPT) ==
+                       CONTENT_SETTING_BLOCK);
+      for (const char* name : {"popups", "media", "cosmetic", "fonts"}) {
+        switches.Set(name,
+                     thoron_adblock::EngineService::Get().SiteSwitch(site, name));
+      }
+    }
+    state.Set("switches", std::move(switches));
+    ResolveJavascriptCallback(args[0], state);
+  }
+
+  void Reload(content::WebContents* tab) {
+    if (tab) {
+      tab->GetController().Reload(content::ReloadType::NORMAL, true);
+    }
+  }
+
+  void SetSiteEnabled(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (!site.is_valid() || args.size() != 1 || !args[0].is_bool()) {
+      return;
+    }
+    // The per-site switch the blocker already follows (the "Ads and
+    // trackers" site setting): allowed means blocking is off there.
+    Settings()->SetContentSettingDefaultScope(
+        site, GURL(), ContentSettingsType::ADS,
+        args[0].GetBool() ? CONTENT_SETTING_DEFAULT : CONTENT_SETTING_ALLOW);
+    Reload(tab);
+  }
+
+  void SetSwitch(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (!site.is_valid() || args.size() != 2 || !args[0].is_string() ||
+        !args[1].is_bool()) {
+      return;
+    }
+    const std::string& name = args[0].GetString();
+    const bool on = args[1].GetBool();
+    const ContentSettingsType chrome_type = ChromeSwitch(name);
+    if (chrome_type != ContentSettingsType::DEFAULT) {
+      Settings()->SetContentSettingDefaultScope(
+          site, GURL(), chrome_type,
+          on ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_DEFAULT);
+    } else if (name == "popups" || name == "media" || name == "cosmetic" ||
+               name == "fonts") {
+      thoron_adblock::EngineService::Get().SetSiteSwitch(site, name, on);
+    } else {
+      return;
+    }
+    Reload(tab);
+  }
+
+  void StartPicker(const base::ListValue& args) {
+    thoron_adblock::StartPicker(Tab(), /*zapper=*/false);
+    CloseMenu(args);
+  }
+
+  void StartZapper(const base::ListValue& args) {
+    thoron_adblock::StartPicker(Tab(), /*zapper=*/true);
+    CloseMenu(args);
+  }
+
+  void Open(const char* url) {
+    BrowserWindowInterface* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    if (browser) {
+      browser->OpenGURL(GURL(url), WindowOpenDisposition::kNewForegroundTab);
+    }
+  }
+
+  void OpenLogger(const base::ListValue& args) {
+    Open(kLoggerUrl);
+    CloseMenu(args);
+  }
+
+  void OpenDashboard(const base::ListValue& args) {
+    Open(kDashboardUrl);
+    CloseMenu(args);
+  }
+
+  void MenuReady(const base::ListValue& args) {
+    if (auto embedder = controller_->embedder()) {
+      embedder->ShowUI();
+    }
+  }
+
+  void CloseMenu(const base::ListValue& args) {
+    if (auto embedder = controller_->embedder()) {
+      embedder->CloseUI();
+    }
+  }
+
+  const raw_ptr<ThoronAdblockMenuUI> controller_;
+};
+
+}  // namespace
+
+ThoronAdblockMenuUIConfig::ThoronAdblockMenuUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  kThoronAdblockMenuHost) {}
+
+bool ThoronAdblockMenuUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return base::FeatureList::IsEnabled(thoron_adblock::kThoronNativeAdblock);
+}
+
+bool ThoronAdblockMenuUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+ThoronAdblockMenuUI::ThoronAdblockMenuUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<MenuDataSource>());
+  web_ui->AddMessageHandler(std::make_unique<MenuHandler>(this));
+}
+
+ThoronAdblockMenuUI::~ThoronAdblockMenuUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(ThoronAdblockMenuUI)
