+        base::NumberToString16(hosts[i].second)));
+  }
+  if (hosts.size() > kShown) {
+    lines.push_back(l10n_util::GetPluralStringFUTF16(
+        IDS_THORON_ADBLOCK_BUBBLE_MORE_SITES,
+        static_cast<int>(hosts.size() - kShown)));
+  }
+  return lines;
+}
