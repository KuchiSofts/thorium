+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/thoron_adblock_button.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/extensions/icon_with_badge_image_source.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/bubble/webui_bubble_manager.h"
+#include "chrome/browser/ui/webui/thoron_adblock_popup_ui.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/strings/grit/components_strings.h"
+#include "components/thoron_adblock/blocked_count.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/bubble/bubble_border.h"
+
+namespace {
+
+// The badge as uBlock Origin draws it: red, white text, at most four
+// characters ("999", "1k", "12k").
+constexpr SkColor kBadgeBackground = SkColorSetRGB(0xD9, 0x30, 0x25);
+constexpr SkColor kBadgeText = SK_ColorWHITE;
+
+std::string BadgeText(int count) {
+  if (count <= 0) {
+    return std::string();
+  }
+  if (count < 1000) {
+    return base::NumberToString(count);
+  }
+  if (count < 1000000) {
+    return base::NumberToString(count / 1000) + "k";
+  }
+  return "1M+";
+}
+
+}  // namespace
+
+ThoronAdblockButton::ThoronAdblockButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&ThoronAdblockButton::ButtonPressed,
+                                        base::Unretained(this))),
+      browser_(browser) {
+  SetTooltipText(u"Ad blocking");
+  GetViewAccessibility().SetName(u"Ad blocking");
+  browser_->GetTabStripModel()->AddObserver(this);
+  Observe(browser_->GetTabStripModel()->GetActiveWebContents());
+  // base::Unretained is safe: the subscription ends with this button.
+  blocked_subscription_ = thoron_adblock::BlockedCount::AddObserver(
+      base::BindRepeating(&ThoronAdblockButton::OnBlocked,
+                          base::Unretained(this)));
+  // The icon is drawn once the button is in a window (ToolbarButton calls
+  // UpdateIcon() when the theme is known).
+}
+
+ThoronAdblockButton::~ThoronAdblockButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+int ThoronAdblockButton::ActiveCount() {
+  content::WebContents* tab = web_contents();
+  if (!tab || !tab->GetPrimaryMainFrame()
+                   ->GetLastCommittedURL()
+                   .SchemeIsHTTPOrHTTPS()) {
+    return -1;
+  }
+  return thoron_adblock::BlockedCount::Get(tab->GetPrimaryPage());
+}
+
+bool ThoronAdblockButton::BlockingOffForActiveSite() {
+  content::WebContents* tab = web_contents();
+  if (!tab) {
+    return false;
+  }
+  const GURL url = tab->GetPrimaryMainFrame()->GetLastCommittedURL();
+  return url.SchemeIsHTTPOrHTTPS() &&
+         HostContentSettingsMapFactory::GetForProfile(browser_->GetProfile())
+                 ->GetContentSetting(url, url, ContentSettingsType::ADS) ==
+             CONTENT_SETTING_ALLOW;
+}
+
+void ThoronAdblockButton::UpdateIcon() {
+  if (!GetWidget() || !GetColorProvider()) {
+    return;
+  }
+  const int count = ActiveCount();
+  const bool off = count < 0 || BlockingOffForActiveSite();
+  const int size = GetIconSize();
+  const SkColor color = GetForegroundColor(off ? ButtonState::STATE_DISABLED
+                                               : ButtonState::STATE_NORMAL);
+  const gfx::ImageSkia shield =
+      gfx::CreateVectorIcon(vector_icons::kShieldIcon, size, color);
+  // The badge is drawn over the icon the way an extension's badge is.
+  auto source = std::make_unique<IconWithBadgeImageSource>(
+      gfx::Size(size, size),
+      base::BindRepeating(
+          [](views::View* view) -> const ui::ColorProvider* {
+            return view->GetColorProvider();
+          },
+          base::Unretained(this)));
+  source->SetIcon(gfx::Image(shield));
+  const std::string text = off ? std::string() : BadgeText(count);
+  if (!text.empty()) {
+    source->SetBadge(std::make_unique<IconWithBadgeImageSource::Badge>(
+        text, kBadgeText, kBadgeBackground));
+  }
+  const ui::ImageModel image = ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia(std::move(source), gfx::Size(size, size)));
+  for (auto state : kButtonStates) {
+    SetImageModel(state, image);
+  }
+  const std::u16string tooltip =
+      off ? u"Ad blocking: off on this page"
+          : (count == 1 ? u"Ad blocking: 1 blocked on this page"
+                        : u"Ad blocking: " + base::NumberToString16(count) +
+                              u" blocked on this page");
+  SetTooltipText(tooltip);
+}
+
+void ThoronAdblockButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Observe(tab_strip_model->GetActiveWebContents());
+    UpdateIcon();
+  }
+}
+
+void ThoronAdblockButton::PrimaryPageChanged(content::Page& page) {
+  // a new page starts at 0
+  UpdateIcon();
+}
+
+void ThoronAdblockButton::OnBlocked(content::Page& page) {
+  content::WebContents* tab = web_contents();
+  if (tab && &tab->GetPrimaryPage() == &page) {
+    UpdateIcon();
+  }
+}
+
+void ThoronAdblockButton::ButtonPressed() {
+  if (!menu_) {
+    menu_ = WebUIBubbleManager::Create<ThoronAdblockMenuUI>(
+        browser_, GURL(kThoronAdblockMenuUrl), IDS_THORON_ADBLOCK_MENU);
+  }
+  if (menu_->GetBubbleWidget()) {
+    menu_->CloseBubble();
+    return;
+  }
+  menu_->ShowBubble(this, views::BubbleBorder::TOP_RIGHT);
+}
+
+BEGIN_METADATA(ThoronAdblockButton)
+END_METADATA
