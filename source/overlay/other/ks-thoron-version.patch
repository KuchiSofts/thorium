@@ -73,6 +77,20 @@ using content::WebUIDataSource;
 
 namespace {
 
+// Thoron: the Chromium version a build is based on. Its last number is the
+// Chromium patch x 100 + the rebuild when chrome/VERSION carries
+// THORON_REBUILD (tools/release/version.py in the Thoron repository).
+std::string ThoronChromiumBase() {
+  const std::string_view rebuild = THORON_REBUILD_STRING;
+  const base::Version& version = version_info::GetVersion();
+  if (rebuild.empty() || rebuild.front() == '@' || !version.IsValid() ||
+      version.components().size() != 4) {
+    return std::string(version_info::GetVersionNumber());
+  }
+  const auto& c = version.components();
+  return base::StringPrintf("%u.%u.%u.%u", c[0], c[1], c[2], c[3] / 100);
+}
+
 void CreateAndAddVersionUIDataSource(Profile* profile) {
   WebUIDataSource* html_source =
       WebUIDataSource::CreateAndAdd(profile, chrome::kChromeUIVersionHost);
@@ -248,9 +266,15 @@ void VersionUI::AddVersionDetailStrings(content::WebUIDataSource* html_source) {
   html_source->AddLocalizedString(version_ui::kVersionProcessorVariation,
                                   VersionProcessorVariation());
 
-  // Data strings.
-  html_source->AddString(version_ui::kVersion,
-                         version_info::GetVersionNumber());
+  // Data strings. Thoron: its own version first, then the Chromium version it
+  // is based on and the build number.
+  const std::string thoron = ThoronVersion();
+  html_source->AddString(
+      version_ui::kVersion,
+      thoron.empty()
+          ? std::string(version_info::GetVersionNumber())
+          : base::StrCat({thoron, " (based on Chromium ", ThoronChromiumBase(),
+                          ", build ", version_info::GetVersionNumber(), ")"}));
   html_source->AddString(version_ui::kVersionSuffix,
                          GetVersionInformationalSuffix());
 
@@ -337,12 +361,28 @@ void VersionUI::AddVersionDetailStrings(content::WebUIDataSource* html_source) {
                          version_info::GetSanitizerList());
 }
 
+// static
+std::string VersionUI::ThoronVersion() {
+  const std::string_view version = THORON_VERSION_STRING;
+  if (version.empty() || version.front() == '@') {
+    return std::string();
+  }
+  return std::string(version);
+}
+
+// static
+std::string VersionUI::VersionForPeople() {
+  const std::string thoron = ThoronVersion();
+  return thoron.empty() ? std::string(version_info::GetVersionNumber())
+                        : thoron;
+}
