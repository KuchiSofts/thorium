 // Thoron: the rebuild number from tools/release/version.py; left unsubstituted when unset.
 #define THORON_REBUILD_STRING "@THORON_REBUILD@"
+// Thoron: its own version, the one people see ("0.1.1"); left unsubstituted when unset.
