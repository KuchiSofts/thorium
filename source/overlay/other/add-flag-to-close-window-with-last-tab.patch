+  const std::string flag_value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "close-window-with-last-tab");
+  if (flag_value == "never" && browser->GetTabStripModel()->count() == 1 &&
+      browser->GetTabStripModel()->selection_model().size() == 1) {
+    content::WebContents* contents_to_close =
+        browser->GetTabStripModel()->GetActiveWebContents();
+    NewTab(browser, NewTabTypes::kNoUserAction);
+    const int index_to_close =
+        browser->GetTabStripModel()->GetIndexOfWebContents(contents_to_close);
+    if (index_to_close != TabStripModel::kNoTab) {
+      RecordTabCloseCount(1);
+      browser->GetTabStripModel()->CloseWebContentsAt(
+          index_to_close, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB |
+                              TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+    return;
+  }
